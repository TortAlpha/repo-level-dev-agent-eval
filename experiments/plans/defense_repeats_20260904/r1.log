#!/usr/bin/env python
"""Regression tests for naturalsize rounding at unit boundaries."""
from __future__ import annotations

import pytest

import humanize


@pytest.mark.parametrize(
    "value, expected",
    [
        # just below a decimal boundary carries to the next unit
        (999_949_999_999, "1.0 TB"),
        (10**33 - 1, "1.0 QB"),
        # just below a binary boundary carries to the next unit
        (1024**4 - 1, "1.0 TiB"),
        # just below a GNU boundary carries to the next unit
        (1024**4 - 1, "1.0T"),
    ],
)
def test_naturalsize_rounds_up_to_next_unit(value, expected):
    kwargs = {}
    if "T" in expected and "TiB" not in expected:
        kwargs["gnu"] = True
    elif "TiB" in expected:
        kwargs["binary"] = True
    assert humanize.naturalsize(value, **kwargs) == expected


def test_naturalsize_largest_suffix_stays_in_place():
    # A value in the largest supported suffix keeps its unit even if
    # formatting round-pushes the mantissa toward the next (nonexistent) unit.
    assert humanize.naturalsize(10**36 - 1) == "1000.0 QB"
    assert humanize.naturalsize(10**33) == "1.0 QB"

