import pytest

from tinydb import TinyDB, where


def test_update_missing_doc_ids_skipped(tmp_path):
    db = TinyDB(tmp_path / "db.json")
    db.insert({'a': 1})
    db.insert({'a': 2})

    result = db.update({'a': 99}, doc_ids=[1, 99])

    assert result == [1]
    assert db.all() == [{'a': 99}, {'a': 2}]


def test_update_all_missing_doc_ids_returns_empty(tmp_path):
    db = TinyDB(tmp_path / "db.json")
    db.insert({'a': 1})

    result = db.update({'a': 99}, doc_ids=[99])

    assert result == []
    assert db.all() == [{'a': 1}]


def test_remove_missing_doc_ids_skipped(tmp_path):
    db = TinyDB(tmp_path / "db.json")
    db.insert({'a': 1})
    db.insert({'a': 2})

    result = db.remove(doc_ids=[1, 99])

    assert result == [1]
    assert db.all() == [{'a': 2}]


def test_remove_all_missing_doc_ids_returns_empty(tmp_path):
    db = TinyDB(tmp_path / "db.json")
    db.insert({'a': 1})

    result = db.remove(doc_ids=[99])

    assert result == []
    assert db.all() == [{'a': 1}]

