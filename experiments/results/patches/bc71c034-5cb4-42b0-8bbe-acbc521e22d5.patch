@@ -0,0 +1,31 @@
+import pytest
+
+import parse
+
+
+def test_precision_zero_float_no_decimal():
+    # precision-0 float renders without a decimal point; parse must accept it
+    r = parse.parse("a {:.0f} b", "a 12 b")
+    assert r is not None
+    assert r[0] == 12.0
+    assert isinstance(r[0], float)
+
+
+def test_precision_zero_float_zero_padded():
+    r = parse.parse("foo_{:02.0f}t", "foo_20t")
+    assert r is not None
+    assert r[0] == 20.0
+    assert isinstance(r[0], float)
+
+
+def test_precision_zero_float_rejects_decimal():
+    # input with a decimal point must not match a precision-0 float field
+    assert parse.parse("a {:.0f} b", "a 12.0 b") is None
+
+
+def test_default_float_unchanged():
+    # existing float parsing behavior must remain unchanged
+    r = parse.parse("{:f}", "12.5")
+    assert r is not None
+    assert r[0] == 12.5
+    assert isinstance(r[0], float)
