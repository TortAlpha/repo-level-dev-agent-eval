+def test_get_hookcallers_no_duplicates_for_multiple_impls(pm: PluginManager) -> None:
+    """A plugin with multiple implementations on the same hook should not
+    produce duplicate hook caller entries."""
+
+    class Hooks:
+        @hookspec
+        def he_method1(self) -> None: ...
+
+    pm.add_hookspecs(Hooks)
+
+    class Plugin:
+        @hookimpl(specname="he_method1")
+        def first(self) -> None: ...
+
+        @hookimpl(specname="he_method1")
+        def second(self) -> None: ...
+
+    plugin = Plugin()
+    pm.register(plugin)
+
+    hookcallers = pm.get_hookcallers(plugin)
+    assert hookcallers is not None
+    assert len(hookcallers) == 1
+    assert hookcallers[0].name == "he_method1"
+
+
+def test_unregister_removes_all_impls_for_multiple_impls(pm: PluginManager) -> None:
+    """Unregistering a plugin should remove all of its implementations on a
+    hook, not only the first one."""
+
+    class Hooks:
+        @hookspec
+        def he_method1(self) -> None: ...
+
+    pm.add_hookspecs(Hooks)
+
+    class Plugin:
+        @hookimpl(specname="he_method1")
+        def first(self) -> None: ...
+
+        @hookimpl(specname="he_method1")
+        def second(self) -> None: ...
+
+    plugin = Plugin()
+    pm.register(plugin)
+
+    assert len(pm.hook.he_method1.get_hookimpls()) == 2
+    pm.unregister(plugin)
+    assert pm.hook.he_method1.get_hookimpls() == []
+    assert pm.get_hookcallers(plugin) is None
+
+
