+    def get_window(self):
+        """Return the window of the function.
+
+        For a named window (``foo(5) OVER win1``) the window identifier is
+        returned. For an inline window (``foo(5) OVER (PARTITION BY c1)``)
+        the parenthesised window definition is returned. ``None`` is returned
+        when the function has no ``OVER`` clause.
+        """
+        _, over = self.token_next_by(i=Over)
+        if over is None:
+            return None
+        # The token following the OVER keyword is the window reference:
+        # either a Parenthesis (inline window) or a Name (named window).
+        _, window = over.token_next_by(i=(Parenthesis, Identifier), t=T.Name)
+        return window
+
+    def _get_parenthesis_token(self):
+        """Return the Parenthesis token holding the parameters."""
+        _, parenthesis = self.token_next_by(i=Parenthesis)
+        return parenthesis
