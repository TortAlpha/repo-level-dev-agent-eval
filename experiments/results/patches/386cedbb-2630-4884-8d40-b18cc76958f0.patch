diff --git a/tests/test_window_function.py b/tests/test_window_function.py
new file mode 100644
index 0000000..99de9d4
--- /dev/null
+++ b/tests/test_window_function.py
@@ -0,0 +1,47 @@
+import sqlparse
+from sqlparse.sql import Function, Identifier, Over, Parenthesis
+
+
+def _find_function(tokens):
+    for token in tokens:
+        if isinstance(token, Function):
+            return token
+        if token.is_group:
+            found = _find_function(token.tokens)
+            if found is not None:
+                return found
+    return None
+
+
+def parse_function(sql):
+    parsed = sqlparse.parse(sql)[0]
+    func = _find_function(parsed.tokens)
+    assert func is not None, "No Function token found in: %r" % sql
+    return func
+
+
+def test_no_over_clause():
+    func = parse_function('SELECT foo(5) FROM t')
+    assert func.get_window() is None
+    params = func.get_parameters()
+    assert len(params) == 1
+
+
+def test_named_window():
+    func = parse_function('SELECT foo(5) OVER win1 FROM t')
+    window = func.get_window()
+    assert window is not None
+    assert isinstance(window, Identifier)
+    assert window.get_real_name() == 'win1'
+    params = func.get_parameters()
+    assert len(params) == 1
+
+
+def test_inline_window():
+    func = parse_function('SELECT foo(5) OVER (PARTITION BY c1) FROM t')
+    window = func.get_window()
+    assert window is not None
+    assert isinstance(window, Parenthesis)
+    assert 'PARTITION BY c1' in str(window)
+    params = func.get_parameters()
+    assert len(params) == 1
