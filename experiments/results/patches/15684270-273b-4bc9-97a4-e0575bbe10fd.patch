+def strptime_pattern(format):
+    """Build a non-capturing regular expression for a strptime format."""
+    pattern = []
+    i = 0
+    while i < len(format):
+        if format[i] == "%" and i + 1 < len(format):
+            directive = format[i + 1]
+            pattern.append(_STRPTIME_PATTERNS.get(directive, r".+?"))
+            i += 2
+        else:
+            pattern.append(re.escape(format[i]))
+            i += 1
+    return "".join(pattern)
+
+
+def strptime_convert(format, string, match):
+    value = datetime.strptime(string, format)
+    directives = {format[i + 1] for i in range(len(format) - 1) if format[i] == "%"}
+    has_date = bool(directives & _STRPTIME_DATE_DIRECTIVES)
+    has_time = bool(directives & _STRPTIME_TIME_DIRECTIVES)
+    if has_date and not has_time:
+        return value.date()
+    if has_time and not has_date:
+        return value.timetz() if value.tzinfo else value.time()
+    return value
