diff --git a/tests/test_strptime_formats.py b/tests/test_strptime_formats.py
new file mode 100644
index 0000000000000000000000000000000000000000..93f5da370ce8598dc3121ff28d1a49d4eed4c8dd
--- /dev/null
+++ b/tests/test_strptime_formats.py
@@ -0,0 +1,21 @@
+from datetime import date, datetime, time, timedelta, timezone
+
+import parse
+
+
+def test_strptime_fields_convert_dates_times_timezones_and_mix_with_types():
+    result = parse.parse(
+        "dates {:%Y-%b-%d} / {when:%Y-%m-%dT%H:%M:%S%z} / {count:d} / {:%H:%M:%S}",
+        "dates 1997-Feb-16 / 2020-01-02T03:04:05+0530 / 7 / 09:08:07",
+    )
+
+    assert result[0] == date(1997, 2, 16)
+    assert result.named["when"] == datetime(
+        2020, 1, 2, 3, 4, 5, tzinfo=timezone(timedelta(hours=5, minutes=30))
+    )
+    assert result[1] == 7
+    assert result[2] == time(9, 8, 7)
+
+
+def test_strptime_date_format_requires_matching_input():
+    assert parse.parse("a {:%Y-%m-%d} b", "a 1997/07/16 b") is None
