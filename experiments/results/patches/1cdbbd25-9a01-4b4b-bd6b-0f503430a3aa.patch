@@ -0,0 +1,50 @@
+"""Tests for strftime/strptime-style datetime format support."""
+from datetime import date, datetime, time
+
+import parse
+
+
+def test_date_ymd():
+    res = parse.parse("a {:%Y-%m-%d} b", "a 1997-07-16 b")
+    assert res is not None
+    assert res[0] == date(1997, 7, 16)
+
+
+def test_date_yb():
+    res = parse.parse("a {:%Y-%b-%d} b", "a 1997-Feb-16 b")
+    assert res is not None
+    assert res[0] == date(1997, 2, 16)
+
+
+def test_datetime_with_time():
+    res = parse.parse("a {:%Y-%m-%d %H:%M:%S} b", "a 1997-07-16 19:39:00 b")
+    assert res is not None
+    assert res[0] == datetime(1997, 7, 16, 19, 39, 0)
+
+
+def test_datetime_with_tz():
+    res = parse.parse("a {:%Y-%m-%d %H:%M:%S%z} b", "a 1997-07-16 19:39:00+0500 b")
+    assert res is not None
+    dt = res[0]
+    assert dt == datetime(1997, 7, 16, 19, 39, 0, tzinfo=dt.tzinfo)
+    assert dt.utcoffset() is not None
+    assert dt.utcoffset().total_seconds() == 5 * 3600
+
+
+def test_time_only():
+    res = parse.parse("a {:%H:%M:%S} b", "a 19:39:00 b")
+    assert res is not None
+    assert res[0] == time(19, 39, 0)
+
+
+def test_named_field():
+    res = parse.parse("a {when:%Y-%m-%d} b", "a 1997-07-16 b")
+    assert res is not None
+    assert res.named["when"] == date(1997, 7, 16)
+
+
+def test_mixed_with_other_type():
+    res = parse.parse("a {:%Y-%m-%d} b {:d} c", "a 1997-07-16 b 42 c")
+    assert res is not None
+    assert res[0] == date(1997, 7, 16)
+    assert res[1] == 42
