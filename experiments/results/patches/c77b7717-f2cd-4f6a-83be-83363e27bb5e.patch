--- /dev/null
+++ b/tests/test_strftime_formats.py
@@ -0,0 +1,29 @@
+from datetime import date, datetime, time, timedelta, timezone
+
+import parse
+
+
+def test_strftime_date_fields_return_dates():
+    assert parse.parse("a {:%Y-%m-%d} b", "a 1997-07-16 b")[0] == date(1997, 7, 16)
+    assert parse.parse("a {:%Y-%b-%d} b", "a 1997-Feb-16 b")[0] == date(1997, 2, 16)
+
+
+def test_strftime_time_and_datetime_fields_return_correct_types():
+    assert parse.parse("at {:%H:%M:%S}", "at 14:05:09")[0] == time(14, 5, 9)
+    assert parse.parse("at {:%Y-%m-%d %H:%M}", "at 1997-07-16 14:05")[0] == datetime(
+        1997, 7, 16, 14, 5
+    )
+
+
+def test_strftime_timezone_datetime_preserves_tzinfo():
+    result = parse.parse("at {:%Y-%m-%dT%H:%M:%S%z}", "at 1997-07-16T14:05:09+0230")
+    assert result[0] == datetime(1997, 7, 16, 14, 5, 9, tzinfo=timezone(timedelta(hours=2, minutes=30)))
+
+
+def test_multiple_strftime_fields_mix_with_existing_field_types():
+    result = parse.parse(
+        "from {start:%Y-%m-%d} at {clock:%H:%M} count {count:d} until {:%Y-%b-%d}",
+        "from 1997-07-16 at 14:05 count 12 until 1997-Aug-17",
+    )
+    assert result.named == {"start": date(1997, 7, 16), "clock": time(14, 5), "count": 12}
+    assert result.fixed == (date(1997, 8, 17),)
