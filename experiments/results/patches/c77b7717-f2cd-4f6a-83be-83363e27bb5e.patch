+class strftime_convert:
+    """Convert a strftime-formatted field using ``datetime.strptime``."""
+
+    DATE_DIRECTIVES = set("aAbBcdDjGgmUuVWwyYx")
+    TIME_DIRECTIVES = set("cHIklMpPrRSTXf")
+    TIMEZONE_DIRECTIVES = set("zZ")
+
+    def __init__(self, format):
+        self.format = format
+        directives = []
+        i = 0
+        while i < len(format):
+            if format[i] == "%" and i + 1 < len(format):
+                i += 1
+                while i < len(format) and format[i] in "-_0^#EO":
+                    i += 1
+                if i < len(format):
+                    directives.append(format[i])
+            i += 1
+        self.has_date = bool(set(directives) & self.DATE_DIRECTIVES)
+        self.has_time = bool(set(directives) & self.TIME_DIRECTIVES)
+        self.has_timezone = bool(set(directives) & self.TIMEZONE_DIRECTIVES)
+
+    def __call__(self, string, match):
+        value = datetime.strptime(string, self.format)
+        if self.has_timezone or (self.has_date and self.has_time):
+            return value
+        if self.has_date:
+            return value.date()
+        if self.has_time:
+            return value.time()
+        return value
+
+
