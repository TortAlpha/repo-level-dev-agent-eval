diff --git a/testing/test_multi_impl_regression.py b/testing/test_multi_impl_regression.py
new file mode 100644
index 0000000000000000000000000000000000000000..2482417a5a7c6653afb25ffdc9e0ed33b06e49b1
--- /dev/null
+++ b/testing/test_multi_impl_regression.py
@@ -0,0 +1,110 @@
+"""Regression tests for plugin removal with multiple hook implementations.
+
+These tests cover the scenario where a single plugin registers multiple
+implementations on the same hook (including via ``specname``), ensuring:
+- ``get_hookcallers`` returns each ``HookCaller`` at most once.
+- ``unregister`` removes ALL hook implementations belonging to the plugin.
+- ``unregister`` still raises ``ValueError`` when the plugin has zero matching
+  impls on a given hook caller.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from pluggy import HookimplMarker
+from pluggy import HookspecMarker
+from pluggy import PluginManager
+from pluggy._hooks import HookCaller
+
+hookspec = HookspecMarker("example")
+hookimpl = HookimplMarker("example")
+
+
+def test_get_hookcallers_no_duplicates_multi_impl(pm: PluginManager) -> None:
+    """A plugin with two impls on the same hook (one via specname) should
+    get exactly one HookCaller entry from get_hookcallers."""
+
+    class Hooks:
+        @hookspec
+        def some_hook(self): ...
+
+    pm.add_hookspecs(Hooks)
+
+    class Plugin:
+        @hookimpl
+        def some_hook(self): ...
+
+        @hookimpl(specname="some_hook")
+        def aliased_hook(self): ...
+
+    plugin = Plugin()
+    pm.register(plugin)
+
+    hookcallers = pm.get_hookcallers(plugin)
+    assert hookcallers is not None
+    assert len(hookcallers) == 1
+    assert isinstance(hookcallers[0], HookCaller)
+    # Even though there are two hookimpls from this plugin, the caller appears once.
+    impls = pm.hook.some_hook.get_hookimpls()
+    assert sum(1 for i in impls if i.plugin is plugin) == 2
+
+
+def test_unregister_removes_all_multi_impls(pm: PluginManager) -> None:
+    """Unregistering a plugin with multiple impls on the same hook should
+    remove ALL of them, leaving no stale entries."""
+
+    class Hooks:
+        @hookspec
+        def some_hook(self): ...
+
+    pm.add_hookspecs(Hooks)
+
+    class Plugin:
+        @hookimpl
+        def some_hook(self): ...
+
+        @hookimpl(specname="some_hook")
+        def aliased_hook(self): ...
+
+    plugin = Plugin()
+    pm.register(plugin)
+
+    # Confirm two impls present before unregister.
+    impls_before = pm.hook.some_hook.get_hookimpls()
+    assert sum(1 for i in impls_before if i.plugin is plugin) == 2
+
+    # Unregister should not raise and should remove all impls.
+    result = pm.unregister(plugin)
+    assert result is plugin
+
+    impls_after = pm.hook.some_hook.get_hookimpls()
+    assert all(i.plugin is not plugin for i in impls_after)
+    assert len(impls_after) == 0
+
+
+def test_unregister_no_matching_impls_raises_valueerror(pm: PluginManager) -> None:
+    """Edge case: if _remove_plugin is called with a plugin that has no
+    matching impls, it should still raise ValueError."""
+
+    class Hooks:
+        @hookspec
+        def some_hook(self): ...
+
+    pm.add_hookspecs(Hooks)
+
+    class Plugin:
+        @hookimpl
+        def some_hook(self): ...
+
+    plugin = Plugin()
+    pm.register(plugin)
+
+    # Directly call _remove_plugin on the hook caller with a different plugin
+    # that has no impls on this hook.
+    class Other:
+        pass
+
+    other = Other()
+    with pytest.raises(ValueError):
+        pm.hook.some_hook._remove_plugin(other)
