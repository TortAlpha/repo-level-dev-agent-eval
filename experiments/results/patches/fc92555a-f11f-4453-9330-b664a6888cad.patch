+++ b/tests/test_cachedmethod_autospec.py
@@ -0,0 +1,22 @@
+import warnings
+from unittest import mock
+
+from cachetools import cachedmethod
+
+
+class SomeClass:
+    def __init__(self):
+        self.cache = {}
+
+    @cachedmethod(lambda self: self.cache)
+    def foo(self, x):
+        return x * 2
+
+
+def test_create_autospec_no_warnings_with_cachedmethod():
+    # Should not warn when autospec-ing a class whose methods use @cachedmethod
+    with warnings.catch_warnings():
+        warnings.simplefilter("error")
+        spec = mock.create_autospec(SomeClass, instance=True)
+    # Autospec should succeed and produce a foo attribute
+    assert hasattr(spec, 'foo'), "Autospec did not produce a foo attribute"
