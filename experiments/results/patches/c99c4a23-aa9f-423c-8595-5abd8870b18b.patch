+++ b/tests/test_create_table_case.py
@@ -0,0 +1,37 @@
+import sqlparse
+from sqlparse import sql
+
+
+def _parse(sql_text):
+    return sqlparse.parse(sql_text)[0]
+
+
+def _structure(stmt):
+    result = []
+    for token in stmt.tokens:
+        if token.is_whitespace:
+            continue
+        ttype = token.ttype
+        if ttype is not None:
+            result.append((str(ttype), token.normalized))
+        else:
+            result.append((type(token).__name__, _structure(token)))
+    return result
+
+
+def test_lowercase_create_table_grouped_like_uppercase():
+    lower = _parse('create table foo (id integer, name text)')
+    upper = _parse('CREATE TABLE foo (id integer, name text)')
+    assert _structure(lower) == _structure(upper)
+
+
+def test_mixed_case_create_table_grouped_like_uppercase():
+    mixed = _parse('Create Table foo (id integer, name text)')
+    upper = _parse('CREATE TABLE foo (id integer, name text)')
+    assert _structure(mixed) == _structure(upper)
+
+
+def test_lowercase_create_table_as_grouped_like_uppercase():
+    lower = _parse('create table tbl1 as select coalesce(t1.col1, 0) as col1 from t1')
+    upper = _parse('CREATE TABLE tbl1 AS SELECT coalesce(t1.col1, 0) AS col1 FROM t1')
+    assert _structure(lower) == _structure(upper)
