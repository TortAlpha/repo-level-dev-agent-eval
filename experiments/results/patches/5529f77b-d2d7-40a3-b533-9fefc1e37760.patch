         return result
 
+    def get_window(self):
+        """Return the window of the function.
+        
+        Returns:
+        - For a named window (foo(5) OVER win1), the window identifier
+        - For an inline window (foo(5) OVER (PARTITION BY c1)), the parenthesised window definition
+        - None when the function has no OVER clause
+        """
+        # Look for an Over token in the function
+        for token in self.tokens:
+            if isinstance(token, Over):
+                # Find the content after OVER keyword
+                over_tokens = token.tokens
+                if len(over_tokens) >= 3:  # OVER + whitespace + content
+                    content = over_tokens[2]  # Skip OVER keyword and whitespace
+                    if isinstance(content, Parenthesis):
+                        return content  # Inline window definition
+                    elif isinstance(content, Identifier):
+                        return content  # Named window
+                    else:
+                        # Handle case where it's just a name token
+                        return content
+        return None
+
 
