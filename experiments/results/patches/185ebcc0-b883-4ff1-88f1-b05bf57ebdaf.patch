diff --git a/tests/dialects/test_doris_date_add.py b/tests/dialects/test_doris_date_add.py
new file mode 100644
index 00000000..e2b86163
--- /dev/null
+++ b/tests/dialects/test_doris_date_add.py
@@ -0,0 +1,42 @@
+from tests.dialects.test_dialect import Validator
+
+
+class TestDorisDateAdd(Validator):
+    dialect = "doris"
+
+    def test_two_arg_date_add_sub(self):
+        self.validate_all(
+            "DATE_ADD(x, 7)",
+            write={
+                "doris": "DATE_ADD(x, INTERVAL 7 DAY)",
+                "starrocks": "DATE_ADD(x, INTERVAL 7 DAY)",
+            },
+        )
+        self.validate_all(
+            "DATE_SUB(x, 3)",
+            write={
+                "doris": "DATE_SUB(x, INTERVAL 3 DAY)",
+                "starrocks": "DATE_SUB(x, INTERVAL 3 DAY)",
+            },
+        )
+        self.validate_all(
+            "ADDDATE(x, 7)",
+            write={
+                "doris": "DATE_ADD(x, INTERVAL 7 DAY)",
+                "starrocks": "DATE_ADD(x, INTERVAL 7 DAY)",
+            },
+        )
+        self.validate_all(
+            "SUBDATE(x, 3)",
+            write={
+                "doris": "DATE_SUB(x, INTERVAL 3 DAY)",
+                "starrocks": "DATE_SUB(x, INTERVAL 3 DAY)",
+            },
+        )
+        self.validate_all(
+            "DATE_ADD(x, INTERVAL '3' DAY)",
+            write={
+                "doris": "DATE_ADD(x, INTERVAL '3' DAY)",
+                "starrocks": "DATE_ADD(x, INTERVAL '3' DAY)",
+            },
+        )
