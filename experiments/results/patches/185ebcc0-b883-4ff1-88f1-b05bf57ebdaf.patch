 from sqlglot import exp
+from sqlglot.dialects.dialect import build_date_delta_with_interval
 from sqlglot.helper import seq_get
 from sqlglot.parsers.mysql import MySQLParser
 from sqlglot.tokens import TokenType
 
 
+def build_date_delta(expression_class):
+    def _builder(args):
+        if len(args) == 2 and isinstance(args[1], exp.Literal) and args[1].is_int:
+            args = [args[0], exp.Interval(this=args[1].copy(), unit=exp.var('DAY'))]
+        return build_date_delta_with_interval(expression_class)(args)
+
+    return _builder
+
+
