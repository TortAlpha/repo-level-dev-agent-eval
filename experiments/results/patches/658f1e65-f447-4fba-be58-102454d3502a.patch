+    def get_window(self):
+        """Return the window defined by an ``OVER`` clause or ``None``.
+
+        For a named window (``foo(5) OVER win1``) the window identifier
+        is returned. For an inline window
+        (``foo(5) OVER (PARTITION BY c1)``) the parenthesised window
+        definition is returned. ``None`` is returned when the function
+        has no ``OVER`` clause.
+        """
