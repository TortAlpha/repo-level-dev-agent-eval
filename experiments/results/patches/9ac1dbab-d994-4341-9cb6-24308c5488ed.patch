+    def get_window(self):
+        """Return the window of this function if any.
+
+        Returns the window identifier for a named window
+        (e.g. ``foo(5) OVER win1``), the parenthesised window definition
+        for an inline window (e.g. ``foo(5) OVER (PARTITION BY c1)``) or
+        ``None`` if the function has no ``OVER`` clause.
