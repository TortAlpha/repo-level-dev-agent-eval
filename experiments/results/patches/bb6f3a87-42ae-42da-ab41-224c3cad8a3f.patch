diff --git a/test/units/module_utils/common/test_sys_info_nonlinux.py b/test/units/module_utils/common/test_sys_info_nonlinux.py
new file mode 100644
index 0000000000..97b234c207
--- /dev/null
+++ b/test/units/module_utils/common/test_sys_info_nonlinux.py
@@ -0,0 +1,31 @@
+# -*- coding: utf-8 -*-
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+import pytest
+
+from units.compat.mock import patch
+
+from ansible.module_utils.common.sys_info import get_distribution
+from ansible.module_utils.common.sys_info import get_distribution_version
+
+
+@pytest.mark.parametrize('system, expected', [
+    ('Darwin', 'Darwin'),
+    ('FreeBSD', 'Freebsd'),
+    ('SunOS', 'Solaris'),
+])
+def test_get_distribution_nonlinux(system, expected):
+    with patch('platform.system', return_value=system):
+        assert get_distribution() == expected
+
+
+@pytest.mark.parametrize('system, release, expected', [
+    ('Darwin', '19.6.0', '19.6.0'),
+    ('SunOS', '11.4', '11.4'),
+    ('FreeBSD', '12.1-RELEASE', '12.1'),
+])
+def test_get_distribution_version_nonlinux(system, release, expected):
+    with patch('platform.system', return_value=system):
+        with patch('platform.release', return_value=release):
+            assert get_distribution_version() == expected
