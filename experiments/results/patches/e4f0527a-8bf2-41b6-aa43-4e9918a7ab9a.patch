@@ -0,0 +1,23 @@
+import datetime
+import pytest
+
+from croniter import croniter
+
+
+def test_expand_from_start_time_month_divisible_step_does_not_raise():
+    # Previously, a month divisible by the step would error when expand_from_start_time=True.
+    dt = datetime.datetime(2024, 6, 1)
+    croniter("0 0 1 */3 *", dt, expand_from_start_time=True)
+
+
+@pytest.mark.parametrize("start_month, expected_months", [
+    (6, [9, 12, 3, 6]),
+    (3, [6, 9, 12, 3]),
+    (9, [12, 3, 6, 9]),
+    (12, [3, 6, 9, 12]),
+])
+def test_expand_from_start_time_month_sequence(start_month, expected_months):
+    dt = datetime.datetime(2024, start_month, 1)
+    ci = croniter("0 0 1 */3 *", dt, expand_from_start_time=True)
+    months = [ci.get_next(datetime.datetime).month for _ in range(len(expected_months))]
+    assert months == expected_months
