+import sqlparse
+
+# Test the current parsing behavior
+p = sqlparse.parse('foo(c1) over win1 as bar')[0]
+print('Full parse tree:')
+p._pprint_tree()
+
+print('\nFunction tokens:', len(p.tokens[0].tokens[0].tokens))
+for i, t in enumerate(p.tokens[0].tokens[0].tokens):
+    print(f'{i}: {type(t).__name__} - {repr(t.value)}')
+
+print('\nExpected: Function should have 4 tokens:')
+print('1. Function name (foo)')
+print('2. Parenthesis ((c1))')
+print('3. Whitespace')
+print('4. OVER clause (over win1)')
