--- /dev/null
+++ b/h11/tests/test_content_length_limit.py
@@ -0,0 +1,24 @@
+import pytest
+
+from h11 import Request, LocalProtocolError
+
+
+def test_pathological_content_length_rejected():
+    with pytest.raises(LocalProtocolError):
+        Request(
+            method="GET",
+            target="/",
+            headers=[("Host", "example.com"), ("Content-Length", b"1" * 100)],
+        )
+
+
+def test_normal_content_length_accepted():
+    req = Request(
+        method="GET",
+        target="/",
+        headers=[("Host", "example.com"), ("Content-Length", "123")],
+    )
+    assert req.headers == [
+        (b"host", b"example.com"),
+        (b"content-length", b"123"),
+    ]
