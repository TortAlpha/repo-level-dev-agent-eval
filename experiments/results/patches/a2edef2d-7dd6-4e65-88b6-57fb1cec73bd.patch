diff --git a/openlibrary/tests/catalog/test_format_languages_new.py b/openlibrary/tests/catalog/test_format_languages_new.py
new file mode 100644
index 000000000..f9890b2fd
--- /dev/null
+++ b/openlibrary/tests/catalog/test_format_languages_new.py
@@ -0,0 +1,33 @@
+import pytest
+
+from openlibrary.catalog.utils import InvalidLanguage, format_languages
+
+
+@pytest.mark.parametrize(
+    ("languages", "expected"),
+    [
+        # Full language name (English)
+        (["German"], [{'key': '/languages/ger'}]),
+        # ISO-639-1 2-letter code
+        (["es"], [{'key': '/languages/spa'}]),
+        # Deduplication of identical MARC codes
+        (["eng", "eng"], [{'key': '/languages/eng'}]),
+        # Mixed names/native/ISO collapsing to same/different languages
+        (["German", "Deutsch", "es"], [{'key': '/languages/ger'}, {'key': '/languages/spa'}]),
+        # Case-insensitive name
+        (["ENGLISH"], [{'key': '/languages/eng'}]),
+        # Native name
+        (["Fran\u00e7ais"], [{'key': '/languages/fre'}]),
+        # Dedup across alternative identifiers for same language
+        (["de", "ger", "German", "Deutsch"], [{'key': '/languages/ger'}]),
+        # Empty still empty
+        ([], []),
+    ],
+)
+def test_format_languages_normalization(languages, expected):
+    assert format_languages(languages) == expected
+
+
+def test_format_languages_invalid_still_raises():
+    with pytest.raises(InvalidLanguage):
+        format_languages(["wtf"])
