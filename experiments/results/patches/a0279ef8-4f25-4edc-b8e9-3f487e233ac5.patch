+# -*- coding: utf-8 -*-
+"""
+Regression test: mixed `=`/`-` Setext underlines must NOT produce a heading.
+"""
+import unittest
+from markdown.test_tools import TestCase
+
+
+class TestSetextMixedUnderline(TestCase):
+
+    def test_mixed_underline_not_heading(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                Some text
+                =-=-
+                """
+            ),
+            self.dedent(
+                """
+                <p>Some text
+                =-=-</p>
+                """
+            )
+        )
+
+    def test_mixed_underline_no_h_tag(self):
+        # Belt-and-suspenders: ensure no heading element is produced.
+        import markdown
+        md = markdown.Markdown()
+        html = md.convert('Some text\n=-=-')
+        self.assertNotIn('<h', html)
+
+    def test_pure_equals_still_heading(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                Some text
+                ====
+                """
+            ),
+            '<h1>Some text</h1>'
+        )
+
+    def test_pure_dashes_still_heading(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                Some text
+                ----
+                """
+            ),
+            '<h2>Some text</h2>'
+        )
+
+
+if __name__ == '__main__':
+    unittest.main()
