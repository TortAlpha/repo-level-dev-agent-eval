index 0000000000000000000000000000000000000000..7015f9da284d50dff3fe0957997738108e89c48c
--- /dev/null
+++ b/tests/test_wait_min_jitter.py
@@ -0,0 +1,26 @@
+import datetime
+
+import tenacity
+
+
+def make_state(attempt):
+    state = tenacity.RetryCallState(None, None, None, None)
+    state.attempt_number = attempt
+    return state
+
+
+def test_wait_exponential_jitter_min_bound():
+    fn = tenacity.wait_exponential_jitter(initial=1, max=60, jitter=1, min=30)
+    assert fn(make_state(1)) >= 30
+    assert fn(make_state(2)) >= 30
+    assert fn(make_state(9)) >= 30
+
+
+def test_wait_exponential_jitter_timedelta_params():
+    fn = tenacity.wait_exponential_jitter(
+        max=datetime.timedelta(seconds=60),
+        jitter=datetime.timedelta(seconds=1),
+        min=datetime.timedelta(seconds=30),
+    )
+    assert fn(make_state(1)) >= 30
+    assert fn(make_state(9)) == 60
