new file mode 100644
index 0000000000000000000000000000000000000000..0fa1c1f6e3dc6b0d744d017b547178eafde914da
--- /dev/null
+++ b/tests/test_missing_doc_ids.py
@@ -0,0 +1,52 @@
+import pytest
+
+from tinydb import TinyDB, where
+from tinydb.storages import MemoryStorage
+
+
+def test_update_missing_doc_ids_skipped_and_returns_updated():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+
+    result = db.update({'a': 99}, doc_ids=[1, 99])
+    assert result == [1]
+    assert db.all() == [{'a': 99}, {'a': 2}]
+
+
+def test_update_missing_before_existing():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+
+    result = db.update({'a': 99}, doc_ids=[99, 1])
+    assert result == [1]
+    assert db.all() == [{'a': 99}, {'a': 2}]
+
+
+def test_update_all_missing_returns_empty():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'a': 1})
+
+    result = db.update({'a': 99}, doc_ids=[99, 100])
+    assert result == []
+    assert db.all() == [{'a': 1}]
+
+
+def test_remove_missing_doc_ids_skipped_and_returns_removed():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+
+    result = db.remove(doc_ids=[1, 99])
+    assert result == [1]
+    assert db.all() == [{'a': 2}]
+
+
+def test_remove_all_missing_returns_empty():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'a': 1})
+
+    result = db.remove(doc_ids=[99, 100])
+    assert result == []
+    assert db.all() == [{'a': 1}]
