diff --git a/h11/tests/test_content_length_limits.py b/h11/tests/test_content_length_limits.py
new file mode 100644
index 0000000000000000000000000000000000000000..2fde866de64e7cb4a1fddbd121ad48805106c975
--- /dev/null
+++ b/h11/tests/test_content_length_limits.py
@@ -0,0 +1,26 @@
+import pytest
+
+from .._headers import normalize_and_validate
+from .._util import LocalProtocolError
+
+
+def test_content_length_max_digits_allowed() -> None:
+    max_value = "9" * 19
+    assert normalize_and_validate([("Content-Length", max_value)]) == [
+        (b"content-length", max_value.encode("ascii"))
+    ]
+
+
+def test_content_length_too_many_digits_is_rejected() -> None:
+    too_long = "9" * 20
+    with pytest.raises(LocalProtocolError):
+        normalize_and_validate([("Content-Length", too_long)])
+
+
+def test_content_length_too_many_digits_with_other_header() -> None:
+    too_long = "9" * 20
+    max_value = "1"
+    with pytest.raises(LocalProtocolError):
+        normalize_and_validate(
+            [("Content-Length", max_value), ("Content-Length", too_long)]
+        )
