index 0000000..ab24161
--- /dev/null
+++ b/tests/test_wait_exponential_jitter_min_timedelta.py
@@ -0,0 +1,93 @@
+import datetime
+
+import pytest
+
+import tenacity
+from tenacity import RetryCallState
+
+
+def make_retry_state(attempt_number: int) -> RetryCallState:
+    retry_state = RetryCallState(None, None, (), {})
+    retry_state.attempt_number = attempt_number
+    retry_state.set_result(None)
+    return retry_state
+
+
+def test_min_lower_bound_applied():
+    fn = tenacity.wait_exponential_jitter(initial=1, max=60, jitter=1, min=5)
+    for attempt in range(1, 10):
+        wait = fn(make_retry_state(attempt))
+        assert wait >= 5
+
+
+def test_min_default_zero_preserves_old_behavior():
+    fn = tenacity.wait_exponential_jitter(max=60)
+    for attempt in range(1, 10):
+        wait = fn(make_retry_state(attempt))
+        assert wait >= 0
+
+
+def test_min_timedelta_accepted():
+    fn = tenacity.wait_exponential_jitter(
+        initial=1, max=60, jitter=1, min=datetime.timedelta(seconds=5)
+    )
+    assert fn.min == 5
+    for attempt in range(1, 10):
+        wait = fn(make_retry_state(attempt))
+        assert wait >= 5
+
+
+def test_max_timedelta_accepted():
+    fn = tenacity.wait_exponential_jitter(
+        initial=1, max=datetime.timedelta(seconds=60), jitter=1
+    )
+    assert fn.max == 60
+    assert fn(make_retry_state(100)) == 60
+
+
+def test_jitter_timedelta_accepted():
+    fn = tenacity.wait_exponential_jitter(
+        initial=1, max=60, jitter=datetime.timedelta(seconds=1)
+    )
+    assert fn.jitter == 1
+    for _ in range(100):
+        wait = fn(make_retry_state(1))
+        assert 1 <= wait <= 2
+
+
+def test_all_timedelta_accepted():
+    fn = tenacity.wait_exponential_jitter(
+        initial=1,
+        max=datetime.timedelta(seconds=60),
+        exp_base=2,
+        jitter=datetime.timedelta(seconds=1),
+        min=datetime.timedelta(seconds=5),
+    )
+    assert fn.max == 60
+    assert fn.jitter == 1
+    assert fn.min == 5
+    for attempt in range(1, 10):
+        wait = fn(make_retry_state(attempt))
+        assert 5 <= wait <= 60
+
+
+def test_plain_numbers_still_work():
+    fn = tenacity.wait_exponential_jitter(10, 5)
+    assert fn(make_retry_state(1)) == 5
+
+
+def test_overflow_respects_min():
+    fn = tenacity.wait_exponential_jitter(
+        initial=1, max=60, jitter=1, min=5
+    )
+    # huge attempt number triggers OverflowError path
+    wait = fn(make_retry_state(10000))
+    assert wait == 60
+
+
+def test_min_greater_than_max_returns_min():
+    fn = tenacity.wait_exponential_jitter(
+        initial=1, max=10, jitter=1, min=20
+    )
+    wait = fn(make_retry_state(1))
+    assert wait == 20
