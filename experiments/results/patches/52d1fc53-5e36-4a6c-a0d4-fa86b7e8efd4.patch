@@ -0,0 +1,24 @@
+import unittest
+
+from more_itertools import numeric_range
+
+
+class NumericRangeReversedEmptyTests(unittest.TestCase):
+    def test_reversed_empty_int(self):
+        self.assertEqual(list(reversed(numeric_range(0))), [])
+
+    def test_reversed_empty_float(self):
+        self.assertEqual(list(reversed(numeric_range(0.0))), [])
+
+    def test_reversed_empty_with_step(self):
+        self.assertEqual(list(reversed(numeric_range(0, 0, 1))), [])
+
+    def test_reversed_empty_descending(self):
+        self.assertEqual(list(reversed(numeric_range(0, 0, -1))), [])
+
+    def test_reversed_nonempty_still_works(self):
+        self.assertEqual(list(reversed(numeric_range(5))), [4, 3, 2, 1, 0])
+
+
+if __name__ == "__main__":
+    unittest.main()
