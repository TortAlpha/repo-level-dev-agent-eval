diff --git a/tests/test_tick_numeric_delta.py b/tests/test_tick_numeric_delta.py
new file mode 100644
index 0000000..da6e6ce
--- /dev/null
+++ b/tests/test_tick_numeric_delta.py
@@ -0,0 +1,45 @@
+import datetime
+from fractions import Fraction
+
+import pytest
+
+from freezegun import freeze_time
+
+
+def test_frozen_datetime_factory_tick_accepts_numeric_deltas() -> None:
+    initial = datetime.datetime(year=1, month=7, day=12, hour=15, minute=6, second=3)
+    with freeze_time(initial) as frozen:
+        # int
+        assert frozen.tick(10) == initial + datetime.timedelta(seconds=10)
+        # float
+        assert frozen.tick(2.5) == initial + datetime.timedelta(seconds=12.5)
+        # Fraction
+        assert frozen.tick(Fraction(1, 2)) == initial + datetime.timedelta(seconds=13)
+        # timedelta still works
+        assert frozen.tick(delta=datetime.timedelta(seconds=1)) == initial + datetime.timedelta(seconds=14)
+
+
+def test_step_tick_time_factory_tick_accepts_numeric_deltas() -> None:
+    initial = datetime.datetime(year=1, month=7, day=12, hour=15, minute=6, second=3)
+    with freeze_time(initial, auto_tick_seconds=15) as frozen:
+        # int
+        assert frozen.tick(10) == initial + datetime.timedelta(seconds=10)
+        # float
+        assert frozen.tick(2.5) == initial + datetime.timedelta(seconds=12.5)
+        # Fraction
+        assert frozen.tick(Fraction(1, 2)) == initial + datetime.timedelta(seconds=13)
+        # timedelta still works
+        assert frozen.tick(delta=datetime.timedelta(seconds=1)) == initial + datetime.timedelta(seconds=14)
+
+
+def test_ticking_datetime_factory_tick_accepts_numeric_deltas() -> None:
+    initial = datetime.datetime(year=1, month=7, day=12, hour=15, minute=6, second=3)
+    with freeze_time(initial, tick=True) as frozen:
+        # int
+        assert frozen.tick(10) == initial + datetime.timedelta(seconds=10)
+        # float
+        assert frozen.tick(2.5) == initial + datetime.timedelta(seconds=12.5)
+        # Fraction
+        assert frozen.tick(Fraction(1, 2)) == initial + datetime.timedelta(seconds=13)
+        # timedelta still works
+        assert frozen.tick(delta=datetime.timedelta(seconds=1)) == initial + datetime.timedelta(seconds=14)
