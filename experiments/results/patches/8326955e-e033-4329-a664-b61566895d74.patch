+++ b/tests/test_autospec_cachedmethod.py
@@ -0,0 +1,33 @@
+import unittest
+import warnings
+from unittest.mock import create_autospec
+
+from cachetools import cachedmethod
+
+
+class CachedMethodClass:
+    def __init__(self):
+        self.cache = {}
+        self.count = 0
+
+    @cachedmethod(lambda self: self.cache)
+    def get(self, value):
+        self.count += 1
+        return value
+
+
+class AutospecCachedMethodTest(unittest.TestCase):
+    def test_autospec_no_warnings(self):
+        with warnings.catch_warnings():
+            warnings.simplefilter("error")
+            create_autospec(CachedMethodClass, instance=True)
+
+    def test_instance_caching_unchanged(self):
+        obj = CachedMethodClass()
+        self.assertEqual(obj.get(1), 1)
+        self.assertEqual(obj.get(1), 1)
+        self.assertEqual(obj.count, 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
