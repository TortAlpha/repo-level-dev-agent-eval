+class SubfactorialTests(TestCase):
+    def test_known_values(self):
+        cases = {0: 1, 1: 0, 2: 1, 3: 2, 4: 9, 5: 44}
+        for n, expected in cases.items():
+            with self.subTest(n=n):
+                self.assertEqual(mi.subfactorial(n), expected)
+
+    def test_matches_derangements(self):
+        for n in range(7):
+            with self.subTest(n=n):
+                self.assertEqual(
+                    mi.subfactorial(n),
+                    len(list(mi.derangements(range(n)))),
+                )
+
+    def test_non_integer_raises(self):
+        for value in (3.5, '3'):
+            with self.subTest(value=value):
+                with self.assertRaises(TypeError):
+                    mi.subfactorial(value)
+
+    def test_negative_raises(self):
+        with self.assertRaises(ValueError):
+            mi.subfactorial(-1)
+
