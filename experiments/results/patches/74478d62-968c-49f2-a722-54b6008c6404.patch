+++ b/tests/test_bytes2human.py
@@ -0,0 +1,25 @@
+from boltons.strutils import bytes2human
+
+
+def test_bytes2human_rollover():
+    assert bytes2human(1024) == '1K'
+    assert bytes2human(1024 ** 2) == '1M'
+    assert bytes2human(1024 ** 3) == '1G'
+
+
+def test_bytes2human_below_boundary():
+    assert bytes2human(1023) == '1023B'
+
+
+def test_bytes2human_mid_range():
+    assert bytes2human(2048) == '2K'
+
+
+def test_bytes2human_zero():
+    assert bytes2human(0) == '0B'
+    assert bytes2human(0, 2) == '0.00B'
+
+
+def test_bytes2human_doctests():
+    assert bytes2human(128991) == '126K'
+    assert bytes2human(100001221) == '95M'
