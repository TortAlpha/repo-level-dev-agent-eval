diff --git a/tests/test_window_functions.py b/tests/test_window_functions.py
new file mode 100644
index 0000000..ca271ef
--- /dev/null
+++ b/tests/test_window_functions.py
@@ -0,0 +1,61 @@
+"""Tests for Function.get_window() and get_parameters() with OVER clauses."""
+
+import sqlparse
+from sqlparse.sql import Function, Identifier, Parenthesis
+from sqlparse import tokens as T
+
+
+def _find_function(stmt):
+    """Find the first Function token in a statement."""
+    func = stmt.token_first(skip_ws=True)
+    if isinstance(func, Function):
+        return func
+    for tok in stmt.flatten():
+        if isinstance(tok, Function):
+            return tok
+    raise AssertionError('No Function found in statement')
+
+
+def test_named_window():
+    parsed = sqlparse.parse('foo(5) OVER win1')[0]
+    func = _find_function(parsed)
+    assert isinstance(func, Function)
+    win = func.get_window()
+    assert win is not None
+    assert str(win) == 'win1'
+    assert win.ttype == T.Name or isinstance(win, Identifier)
+    params = func.get_parameters()
+    assert len(params) == 1
+    assert str(params[0]) == '5'
+
+
+def test_inline_window():
+    parsed = sqlparse.parse('foo(5) OVER (PARTITION BY c1)')[0]
+    func = _find_function(parsed)
+    assert isinstance(func, Function)
+    win = func.get_window()
+    assert isinstance(win, Parenthesis)
+    assert str(win) == '(PARTITION BY c1)'
+    params = func.get_parameters()
+    assert len(params) == 1
+    assert str(params[0]) == '5'
+
+
+def test_no_window():
+    parsed = sqlparse.parse('foo(5)')[0]
+    func = _find_function(parsed)
+    assert isinstance(func, Function)
+    assert func.get_window() is None
+    params = func.get_parameters()
+    assert len(params) == 1
+    assert str(params[0]) == '5'
+
+
+def test_row_number_window():
+    parsed = sqlparse.parse('ROW_NUMBER() OVER (PARTITION BY c1)')[0]
+    func = _find_function(parsed)
+    assert isinstance(func, Function)
+    assert func.get_parameters() == []
+    win = func.get_window()
+    assert isinstance(win, Parenthesis)
+    assert str(win) == '(PARTITION BY c1)'
