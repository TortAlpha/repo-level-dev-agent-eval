index 0000000000000000000000000000000000000000..d8fe2ad9acdfcbcf30412fea6644b96a2077ba57
--- /dev/null
+++ b/tests/test_ipv6_fragment.py
@@ -0,0 +1,16 @@
+from w3lib.url import canonicalize_url, parse_url
+
+
+def test_parse_url_bracketed_ipv6_query_and_fragment():
+    url = "http://[2001:db8::1]?foo=bar#baz"
+    parsed = parse_url(url)
+    assert parsed.scheme == "http"
+    assert parsed.netloc == "[2001:db8::1]"
+    assert parsed.path == ""
+    assert parsed.query == "foo=bar"
+    assert parsed.fragment == "baz"
+
+
+def test_canonicalize_url_bracketed_ipv6_query_and_fragment():
+    url = "http://[2001:db8::1]?foo=bar#baz"
+    assert canonicalize_url(url) == "http://[2001:db8::1]/?foo=bar"
