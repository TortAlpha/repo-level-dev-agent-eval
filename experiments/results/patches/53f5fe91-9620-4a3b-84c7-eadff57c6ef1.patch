diff --git a/tests/test_parse.py b/tests/test_parse.py
index b49dcca..1f69592 100644
--- a/tests/test_parse.py
+++ b/tests/test_parse.py
@@ -138,6 +138,31 @@ def test_parse_casted_params():
     assert len(t) == 2
 
 
+def test_parse_function_named_window():
+    func = sqlparse.parse('foo(5) OVER win1')[0].tokens[0]
+    params = func.get_parameters()
+    assert len(params) == 1
+    assert params[0].ttype is T.Number.Integer
+    window = func.get_window()
+    assert isinstance(window, sql.Over)
+    assert window.tokens[-1].get_real_name() == 'win1'
+
+
+def test_parse_function_inline_window():
+    func = sqlparse.parse('foo(col) OVER (PARTITION BY col2)')[0].tokens[0]
+    params = func.get_parameters()
+    assert len(params) == 1
+    assert params[0].get_real_name() == 'col'
+    window = func.get_window()
+    assert isinstance(window, sql.Over)
+    assert window.tokens[-1].value == '(PARTITION BY col2)'
+
+
+def test_parse_function_without_window():
+    func = sqlparse.parse('foo(5)')[0].tokens[0]
+    assert func.get_window() is None
+
+
 def test_parse_div_operator():
     p = sqlparse.parse('col1 DIV 5 AS div_col1')[0].tokens
     assert p[0].tokens[0].tokens[2].ttype is T.Operator
