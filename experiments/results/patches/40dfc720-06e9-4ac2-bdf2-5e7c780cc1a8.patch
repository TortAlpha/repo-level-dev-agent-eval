--- /dev/null
+++ b/tests/test_window.py
@@ -0,0 +1,49 @@
+"""Tests for window-function OVER clause parsing."""
+
+import sqlparse
+from sqlparse import sql
+
+
+def _find_function(token_list):
+    """Recursively find the first Function token in a token list."""
+    for token in token_list.tokens:
+        if isinstance(token, sql.Function):
+            return token
+        if isinstance(token, sql.TokenList):
+            found = _find_function(token)
+            if found is not None:
+                return found
+    return None
+
+
+def test_function_over_named_window():
+    p = sqlparse.parse('foo(5) OVER win1')[0]
+    func = _find_function(p)
+    assert func is not None
+    win = func.get_window()
+    assert win is not None
+    assert str(win) == 'win1'
+    params = func.get_parameters()
+    assert len(params) == 1
+    assert str(params[0]) == '5'
+
+
+def test_function_over_inline_window():
+    p = sqlparse.parse('foo(5) OVER (PARTITION BY c1)')[0]
+    func = _find_function(p)
+    assert func is not None
+    win = func.get_window()
+    assert isinstance(win, sql.Parenthesis)
+    params = func.get_parameters()
+    assert len(params) == 1
+    assert str(params[0]) == '5'
+
+
+def test_function_without_over():
+    p = sqlparse.parse('foo(5)')[0]
+    func = _find_function(p)
+    assert func is not None
+    assert func.get_window() is None
+    params = func.get_parameters()
+    assert len(params) == 1
+    assert str(params[0]) == '5'
