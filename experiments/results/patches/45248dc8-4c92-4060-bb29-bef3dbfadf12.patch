@@ -0,0 +1,13 @@
+import parse
+
+
+def test_precision_zero_float_no_decimal():
+    assert parse.parse("a {:.0f} b", "a 12 b")[0] == 12.0
+
+
+def test_precision_zero_float_padded():
+    assert parse.parse("foo_{:02.0f}t", "foo_20t")[0] == 20.0
+
+
+def test_precision_zero_float_with_decimal_fails():
+    assert parse.parse("a {:.0f} b", "a 12.0 b") is None
