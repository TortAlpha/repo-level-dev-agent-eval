+    def _get_parenthesis_token(self):
+        """Return the Parenthesis token containing the function arguments."""
+        for token in self.tokens:
+            if isinstance(token, Parenthesis):
+                return token
+        return None
+
+    def get_window(self):
+        """Return the window specification of this function.
+
+        For a named window (``foo(5) OVER win1``) the window identifier
+        is returned. For an inline window (``foo(5) OVER (PARTITION BY c1)``)
+        the parenthesised window definition is returned. ``None`` is returned
+        when the function has no ``OVER`` clause.
+        """
+        for token in self.tokens:
+            if isinstance(token, Over):
+                for subtoken in token.tokens:
+                    if isinstance(subtoken, (Identifier, Parenthesis)):
+                        return subtoken
+        return None
