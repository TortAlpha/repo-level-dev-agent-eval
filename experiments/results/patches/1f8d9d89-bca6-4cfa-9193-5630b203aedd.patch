index 0000000..f61c784
--- /dev/null
+++ b/debug_tokens.py
@@ -0,0 +1,15 @@
+import sqlparse
+from sqlparse.sql import Function, Identifier
+
+for sql in ['foo(5)', 'foo(5) OVER win1', 'foo(5) OVER (PARTITION BY c1)']:
+    p = sqlparse.parse(sql)[0]
+    print(f'=== {sql} ===')
+    for i, tok in enumerate(p.tokens):
+        print(f'  [{i}] {type(tok).__name__}: ttype={tok.ttype} repr={tok!r}')
+        if hasattr(tok, 'tokens'):
+            for j, t in enumerate(tok.tokens):
+                print(f'    [{i}.{j}] {type(t).__name__}: ttype={t.ttype} repr={t!r}')
+                if hasattr(t, 'tokens'):
+                    for k, t2 in enumerate(t.tokens):
+                        print(f'      [{i}.{j}.{k}] {type(t2).__name__}: ttype={t2.ttype} repr={t2!r}')
+    print()
