diff --git a/tests/test_function_window.py b/tests/test_function_window.py
new file mode 100644
index 0000000..e2c661a
--- /dev/null
+++ b/tests/test_function_window.py
@@ -0,0 +1,48 @@
+import sqlparse
+from sqlparse.sql import Function, TokenList
+
+def get_function(sql):
+    p = sqlparse.parse(sql)[0]
+    def find(tok):
+        if isinstance(tok, Function):
+            return tok
+        if isinstance(tok, TokenList):
+            for t in tok.tokens:
+                r = find(t)
+                if r is not None:
+                    return r
+        return None
+    return find(p)
+
+
+def test_function_no_over():
+    sql = 'foo(5)'
+    func = get_function(sql)
+    assert func is not None
+
+
+def test_function_named_window():
+    sql = 'foo(5) OVER win1'
+    func = get_function(sql)
+    assert func is not None
+    assert func.get_window() == 'win1'
+
+
+def test_function_inline_window():
+    sql = 'foo(5) OVER (PARTITION BY c1)'
+    func = get_function(sql)
+    assert func is not None
+    assert func.get_window() == '(PARTITION BY c1)'
+
+
+def test_get_parameters():
+    sql = 'foo(5) OVER win1'
+    func = get_function(sql)
+    params = func.get_parameters()
+    assert len(params) == 1
+    assert params[0].value == '5'
+
+    sql2 = 'foo() OVER (PARTITION BY c1)'
+    func2 = get_function(sql2)
+    params2 = func2.get_parameters()
+    assert len(params2) == 0
