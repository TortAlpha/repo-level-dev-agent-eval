@@ -0,0 +1,21 @@
+import unittest
+
+from more_itertools import numeric_range
+
+
+class NumericRangeReversedEmptyTestCase(unittest.TestCase):
+    def test_reversed_empty_int(self):
+        self.assertEqual(list(reversed(numeric_range(0))), [])
+
+    def test_reversed_empty_start_stop(self):
+        self.assertEqual(list(reversed(numeric_range(5, 5))), [])
+
+    def test_reversed_empty_start_stop_step(self):
+        self.assertEqual(list(reversed(numeric_range(5, 5, 2))), [])
+
+    def test_reversed_empty_descending(self):
+        self.assertEqual(list(reversed(numeric_range(5, 1, 1))), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
