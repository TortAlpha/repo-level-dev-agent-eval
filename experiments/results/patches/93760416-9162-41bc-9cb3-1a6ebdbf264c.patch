diff --git a/tests/test_wait_exponential_jitter_min.py b/tests/test_wait_exponential_jitter_min.py
new file mode 100644
index 0000000000000000000000000000000000000000..4cdfc6e9f2fdb349d8c623b7ff748c13ae507d16
--- /dev/null
+++ b/tests/test_wait_exponential_jitter_min.py
@@ -0,0 +1,64 @@
+import datetime
+
+import tenacity
+
+
+class _RetryState:
+    def __init__(self, attempt_number: int) -> None:
+        self.attempt_number = attempt_number
+
+
+def _make_retry_state(attempt_number: int) -> _RetryState:
+    return _RetryState(attempt_number)
+
+
+def test_min_bound_with_numbers() -> None:
+    fn = tenacity.wait_exponential_jitter(
+        initial=1, max=60, exp_base=2, jitter=0, min=10
+    )
+    # attempt 1: 1*1 + 0 = 1, capped by min -> 10
+    assert fn(_make_retry_state(1)) == 10
+    # attempt 2: 1*2 + 0 = 2, capped by min -> 10
+    assert fn(_make_retry_state(2)) == 10
+    # attempt 3: 1*4 + 0 = 4, capped by min -> 10
+    assert fn(_make_retry_state(3)) == 10
+    # attempt 4: 1*8 + 0 = 8, capped by min -> 10
+    assert fn(_make_retry_state(4)) == 10
+    # attempt 5: 1*16 + 0 = 16, above min -> 16
+    assert fn(_make_retry_state(5)) == 16
+
+
+def test_min_bound_with_timedelta() -> None:
+    fn = tenacity.wait_exponential_jitter(
+        initial=1,
+        max=datetime.timedelta(seconds=60),
+        exp_base=2,
+        jitter=datetime.timedelta(seconds=0),
+        min=datetime.timedelta(seconds=10),
+    )
+    assert fn(_make_retry_state(1)) == 10
+    assert fn(_make_retry_state(2)) == 10
+    assert fn(_make_retry_state(3)) == 10
+    assert fn(_make_retry_state(4)) == 10
+    assert fn(_make_retry_state(5)) == 16
+
+
+def test_min_overrides_max() -> None:
+    fn = tenacity.wait_exponential_jitter(
+        initial=1, max=60, exp_base=2, jitter=0, min=100
+    )
+    assert fn(_make_retry_state(1)) == 100
+    assert fn(_make_retry_state(2)) == 100
+
+
+def test_overflow_respects_min() -> None:
+    fn = tenacity.wait_exponential_jitter(
+        initial=1, max=60, exp_base=10**100, jitter=0, min=10
+    )
+    # attempt 2 makes exp_base**1 overflow; fallback respects min -> max(10,60)=60
+    assert fn(_make_retry_state(2)) == 60
+
+    fn = tenacity.wait_exponential_jitter(
+        initial=1, max=60, exp_base=10**100, jitter=0, min=100
+    )
+    assert fn(_make_retry_state(2)) == 100
