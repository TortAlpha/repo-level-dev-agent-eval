+"""
+Regression test: mixed `=`/`-` underlines must not be treated as Setext headings.
+"""
+from markdown.test_tools import TestCase
+
+
+class TestSetextMixedUnderline(TestCase):
+
+    def test_mixed_underline_eq_dash(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                Some text
+                =-=-
+                """
+            ),
+            self.dedent(
+                """
+                <p>Some text
+                =-=-</p>
+                """
+            )
+        )
+
+    def test_mixed_underline_dash_eq(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                Some text
+                -=
+                """
+            ),
+            self.dedent(
+                """
+                <p>Some text
+                -=</p>
+                """
+            )
+        )
+
+    def test_pure_eq_still_heading(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                Some text
+                ===
+                """
+            ),
+            '<h1>Some text</h1>'
+        )
+
+    def test_pure_dash_still_heading(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                Some text
+                ---
+                """
+            ),
+            '<h2>Some text</h2>'
+        )
