index 0000000..6141f09
--- /dev/null
+++ b/testing/test_multi_impl_removal.py
@@ -0,0 +1,81 @@
+"""Regression tests for plugin removal with multiple hook implementations."""
+
+import pytest
+
+from pluggy import HookimplMarker
+from pluggy import HookspecMarker
+
+hookspec = HookspecMarker("example")
+hookimpl = HookimplMarker("example")
+
+
+def test_unregister_removes_all_implementations(pm):
+    class HookSpec:
+        @hookspec
+        def my_hook(self, arg):
+            ...
+
+    class Plugin:
+        @hookimpl
+        def my_hook(self, arg):
+            return 1
+
+        @hookimpl(specname="my_hook")
+        def my_hook_other(self, arg):
+            return 2
+
+    pm.add_hookspecs(HookSpec)
+    plugin = Plugin()
+    pm.register(plugin, name="plugin")
+
+    assert len(pm.hook.my_hook.get_hookimpls()) == 2
+
+    pm.unregister(plugin)
+    assert len(pm.hook.my_hook.get_hookimpls()) == 0
+
+
+def test_get_hookcallers_no_duplicates(pm):
+    class HookSpec:
+        @hookspec
+        def my_hook(self, arg):
+            ...
+
+    class Plugin:
+        @hookimpl
+        def my_hook(self, arg):
+            return 1
+
+        @hookimpl(specname="my_hook")
+        def my_hook_other(self, arg):
+            return 2
+
+    pm.add_hookspecs(HookSpec)
+    plugin = Plugin()
+    pm.register(plugin, name="plugin")
+
+    callers = pm.get_hookcallers(plugin)
+    assert callers is not None
+    assert len(callers) == 1
+    assert callers[0].name == "my_hook"
+
+
+def test_unregister_preserves_single_impl_semantics(pm):
+    class HookSpec:
+        @hookspec
+        def my_hook(self, arg):
+            ...
+
+    class Plugin:
+        @hookimpl
+        def my_hook(self, arg):
+            return 1
+
+    pm.add_hookspecs(HookSpec)
+    plugin = Plugin()
+    pm.register(plugin, name="plugin")
+
+    assert len(pm.hook.my_hook.get_hookimpls()) == 1
+    pm.unregister(plugin)
+    assert len(pm.hook.my_hook.get_hookimpls()) == 0
+    with pytest.raises(ValueError):
+        pm.hook.my_hook._remove_plugin(plugin)
