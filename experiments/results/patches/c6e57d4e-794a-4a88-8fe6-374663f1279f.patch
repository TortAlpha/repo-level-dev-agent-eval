+"""Tests for qutebrowser.utils.utils._glob_resources."""
+
+import pathlib
+
+import pytest
+
+from qutebrowser.utils import utils
+
+
+class FakeZipEntry:
+
+    """A minimal stand-in for a zipfile.Path entry."""
+
+    def __init__(self, name):
+        self.name = name
+
+
+class FakeZipPath:
+
+    """A minimal stand-in for a zipfile.Path directory."""
+
+    def __init__(self, names):
+        self._names = names
+
+    def __truediv__(self, other):
+        return FakeZipPath(self._names)
+
+    def is_dir(self):
+        return True
+
+    def iterdir(self):
+        for name in self._names:
+            yield FakeZipEntry(name)
+
+
+@pytest.fixture
+def dir_resource_path(tmp_path):
+    resource = tmp_path / 'resource'
+    (resource / 'html').mkdir(parents=True)
+    (resource / 'html' / 'test1.html').write_text('1')
+    (resource / 'html' / 'test2.html').write_text('2')
+    (resource / 'html' / 'README').write_text('readme')
+    (resource / 'html' / 'unrelatedhtml').write_text('nope')
+    (resource / 'javascript').mkdir()
+    (resource / 'javascript' / 'a.js').write_text('a')
+    (resource / 'javascript' / 'b.js').write_text('b')
+    (resource / 'javascript' / 'notjs.txt').write_text('txt')
+    return resource
+
+
+class TestGlobResources:
+
+    def test_directory_html(self, dir_resource_path):
+        result = sorted(utils._glob_resources(dir_resource_path, 'html', '.html'))
+        assert result == ['html/test1.html', 'html/test2.html']
+
+    def test_directory_javascript(self, dir_resource_path):
+        result = sorted(utils._glob_resources(dir_resource_path, 'javascript', '.js'))
+        assert result == ['javascript/a.js', 'javascript/b.js']
+
+    def test_directory_excludes_non_matching(self, dir_resource_path):
+        result = list(utils._glob_resources(dir_resource_path, 'html', '.html'))
+        assert 'html/README' not in result
+        assert 'html/unrelatedhtml' not in result
+
+    def test_zip_html(self):
+        resource_path = FakeZipPath(['test1.html', 'test2.html', 'README', 'unrelatedhtml'])
+        result = sorted(utils._glob_resources(resource_path, 'html', '.html'))
+        assert result == ['html/test1.html', 'html/test2.html']
+
+    def test_zip_javascript(self):
+        resource_path = FakeZipPath(['a.js', 'b.js', 'notjs.txt'])
+        result = sorted(utils._glob_resources(resource_path, 'javascript', '.js'))
+        assert result == ['javascript/a.js', 'javascript/b.js']
+
+    def test_zip_excludes_non_matching(self):
+        resource_path = FakeZipPath(['test1.html', 'README', 'unrelatedhtml'])
+        result = list(utils._glob_resources(resource_path, 'html', '.html'))
+        assert 'html/README' not in result
+        assert 'html/unrelatedhtml' not in result
