+def _glob_resources(resource_path: Any, subdir: str,
+                     ext: str) -> Iterator[str]:
+    """Find resource files under a subdirectory matching an extension.
+
+    Args:
+        resource_path: The base resource path (a pathlib.Path when running from
+            a directory, or a zipfile.Path/importlib-resources path when
+            running from a .egg).
+        subdir: The subdirectory to search in (e.g. 'html').
+        ext: The file extension to match, including the dot (e.g. '.html').
+            Must not contain wildcards.
+
+    Return:
+        An iterable of POSIX-style relative path strings (e.g. 'html/test.html')
+        for files under the given subdir whose names end with ext.
+    """
+    assert ext.startswith('.'), ext
+    assert '*' not in ext, ext
+
+    directory = resource_path / subdir
+    if isinstance(resource_path, pathlib.Path):
+        for full_path in directory.glob('*' + ext):
+            yield full_path.relative_to(resource_path).as_posix()
+    else:
+        assert directory.is_dir(), directory
+        for entry in directory.iterdir():
+            if entry.name.endswith(ext):
+                yield '/'.join([subdir, entry.name])
+
+
 def preload_resources() -> None:
