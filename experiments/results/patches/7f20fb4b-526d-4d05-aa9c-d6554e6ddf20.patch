+#!/usr/bin/env python
+
+"""Tests for naturalsize rounding at unit boundaries."""
+
+from __future__ import annotations
+
+import pytest
+
+import humanize
+
+
+@pytest.mark.parametrize(
+    "test_args, expected",
+    [
+        # Values just below a decimal unit boundary round up to the next unit.
+        ([999999], "1.0 MB"),
+        ([999999999], "1.0 GB"),
+        # Values just below a binary unit boundary round up to the next unit.
+        ([1024**2 - 1, True], "1.0 MiB"),
+        ([1024**3 - 1, True], "1.0 GiB"),
+        # GNU format round up use (binary base 1024).
+        ([1024**2 - 1, False, True], "1.0M"),
+        # Values exactly at boundary keep existing behavior.
+        ([1000**2], "1.0 MB"),
+        ([1024**2, True], "1.0 MiB"),
+        # Values not crossing a rounded boundary keep existing behavior.
+        ([999400], "999.4 kB"),
+        ([1024**2 - 100, True], "1023.9 KiB"),
+        # Custom format round up use at decimal boundary.
+        ([1000**2 - 1, False, False, "%.1f"], "1.0 MB"),
+    ],
+)
+def test_naturalsize_rounding(test_args: list[int] | list[int | bool], expected: str) -> None:
+    assert humanize.naturalsize(*test_args) == expected
