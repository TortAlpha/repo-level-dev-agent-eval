+def _running_extreme_windowed(iterator, maxlen, *, better):
+    "Yield values that are better within a sliding window."
+
+    window = deque()
+    candidates = deque()
+
+    for value in iterator:
+        window.append(value)
+        while candidates and better(value, candidates[-1]):
+            candidates.pop()
+        candidates.append(value)
+
+        if len(window) > maxlen:
+            expired = window.popleft()
+            if candidates and candidates[0] == expired:
+                candidates.popleft()
+
+        yield candidates[0]
+
