+def running_min(iterable, *, maxlen=None):
+    """Yield the running minimum of values seen so far or in a sliding window.
+
+    Set *maxlen* to a positive integer to restrict the window size.  The
+    default of *None* is equivalent to considering all values seen so far.  The
+    values yielded are never greater than any value emitted previously and work
+    with any objects that support ordering operations.
+    """
+
+    iterator = iter(iterable)
+
+    if maxlen is not None:
+        maxlen = index(maxlen)
+        if maxlen <= 0:
+            raise ValueError('Window size should be positive')
+        return _running_extreme_windowed(iterator, maxlen, better=lt)
+
+    return _running_extreme_unbounded(iterator, better=lt)
+
+
