@@ -0,0 +1,16 @@
+import pytest
+from parse import parse
+
+def test_precision_zero_float_without_decimal_point():
+    result = parse("a {:.0f} b", "a 12 b")
+    assert result is not None
+    assert result[0] == 12.0
+
+def test_precision_zero_float_with_decimal_point_should_fail():
+    # Should not match a decimal point when precision is zero
+    assert parse("a {:.0f} b", "a 12.0 b") is None
+
+def test_precision_zero_float_with_width_and_zero_fill():
+    result = parse("foo_{:02.0f}t", "foo_20t")
+    assert result is not None
+    assert result[0] == 20.0
