+++ b/h11/tests/test_content_length_limits.py
@@ -0,0 +1,12 @@
+import pytest
+
+import h11
+
+
+def test_response_rejects_oversized_content_length_as_protocol_error() -> None:
+    connection = h11.Connection(h11.CLIENT)
+    connection.receive_data(
+        b"HTTP/1.1 200 OK\r\nContent-Length: " + b"1" * 19 + b"\r\n\r\n"
+    )
+    with pytest.raises(h11.ProtocolError):
+        connection.next_event()
