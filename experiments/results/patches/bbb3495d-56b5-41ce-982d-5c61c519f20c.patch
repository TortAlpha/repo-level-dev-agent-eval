diff --git a/tests/test_doc_ids_missing.py b/tests/test_doc_ids_missing.py
new file mode 100644
index 0000000000000000000000000000000000000000..3bb8725078fdd6b2931819a52b5925fa96b32d1a
--- /dev/null
+++ b/tests/test_doc_ids_missing.py
@@ -0,0 +1,27 @@
+import pytest
+
+from tinydb import TinyDB
+from tinydb.storages import MemoryStorage
+
+
+def test_update_remove_doc_ids_missing():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+
+    # Update skips missing IDs and returns only IDs actually updated
+    assert db.update({'a': 99}, doc_ids=[1, 99]) == [1]
+    assert db.get(doc_id=1) == {'a': 99}
+    assert db.get(doc_id=2) == {'a': 2}
+
+    # None of the IDs exist: succeeds and returns empty list
+    assert db.update({'a': 0}, doc_ids=[77, 88]) == []
+    assert db.all() == [{'a': 99}, {'a': 2}]
+
+    # Remove skips missing IDs and returns only IDs actually removed
+    assert db.remove(doc_ids=[1, 99]) == [1]
+    assert db.get(doc_id=2) == {'a': 2}
+
+    # None of the IDs exist: succeeds and returns empty list
+    assert db.remove(doc_ids=[77, 88]) == []
+    assert db.all() == [{'a': 2}]
