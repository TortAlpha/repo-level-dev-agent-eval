+"""Tests for naturalsize rounding up to the next unit at unit boundaries."""
+
+import pytest
+import humanize
+
+@pytest.mark.parametrize(
+    "value, binary, gnu, expected",
+    [
+        # Decimal mode: just below 1 MB boundary (1_000_000 bytes)
+        (10**6 - 1, False, False, "1.0 MB"),
+        # Binary mode: just below 1 MiB boundary (1024**2 bytes)
+        (1024**2 - 1, True, False, "1.0 MiB"),
+        # GNU mode: just below 1M boundary (1024**2 bytes)
+        (1024**2 - 1, False, True, "1.0M"),
+    ],
+)
+def test_rounding_bumps_unit(value, binary, gnu, expected):
+    assert humanize.naturalsize(value, binary=binary, gnu=gnu) == expected
+    # Negative input should match with a leading minus
+    assert humanize.naturalsize(-value, binary=binary, gnu=gnu) == "-" + expected
+
+@pytest.mark.parametrize(
+    "value, fmt, expected",
+    [
+        # Decimal custom format: 999950 bytes -> rounds to 1000 kB -> bump to MB -> "1 MB"
+        (10**6 - 50, "%.0f", "1 MB"),
+    ],
+)
+def test_rounding_bumps_unit_with_custom_format(value, fmt, expected):
+    assert humanize.naturalsize(value, False, False, fmt) == expected
+    assert humanize.naturalsize(-value, False, False, fmt) == "-" + expected
