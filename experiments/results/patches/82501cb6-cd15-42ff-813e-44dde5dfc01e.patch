index 000000000..ccc379249
--- /dev/null
+++ b/scripts/solr_builder/tests/test_fn_to_cli_paths_lists.py
@@ -0,0 +1,142 @@
+from pathlib import Path
+import asyncio
+
+import pytest
+
+from scripts.solr_builder.solr_builder.fn_to_cli import FnToCLI
+
+
+class TestPathAndLists:
+    def test_path_argument_converts_to_path(self):
+        def fn(input: Path):
+            return input
+
+        cli = FnToCLI(fn)
+        ns = cli.parse_args(['some/file.txt'])
+        assert ns.input == Path('some/file.txt')
+        assert isinstance(ns.input, Path)
+
+    def test_required_list_int_positional(self):
+        def fn(values: list[int]):
+            return values
+
+        cli = FnToCLI(fn)
+        ns = cli.parse_args(['1', '2', '3'])
+        assert ns.values == [1, 2, 3]
+
+    def test_required_list_path_positional(self):
+        def fn(files: list[Path]):
+            return files
+
+        cli = FnToCLI(fn)
+        ns = cli.parse_args(['a/b', 'c/d'])
+        assert ns.files == [Path('a/b'), Path('c/d')]
+
+    def test_optional_list_path_none_default(self):
+        def fn(files: list[Path] | None = None):
+            return files
+
+        cli = FnToCLI(fn)
+        ns = cli.parse_args([])
+        assert ns.files is None
+
+    def test_optional_list_path_provided(self):
+        def fn(files: list[Path] | None = None):
+            return files
+
+        cli = FnToCLI(fn)
+        ns = cli.parse_args(['--files', 'a/b', 'c/d'])
+        assert ns.files == [Path('a/b'), Path('c/d')]
+
+    def test_optional_list_str_default_none(self):
+        def fn(works: list[str] | None = None):
+            return works
+
+        cli = FnToCLI(fn)
+        ns = cli.parse_args([])
+        assert ns.works is None
+
+    def test_optional_list_str_provided(self):
+        def fn(works: list[str] | None = None):
+            return works
+
+        cli = FnToCLI(fn)
+        ns = cli.parse_args(['--works', 'a', 'b'])
+        assert ns.works == ['a', 'b']
+
+    def test_run_returns_sync_result(self):
+        def fn(values: list[int]):
+            return sum(values)
+
+        cli = FnToCLI(fn)
+        result = cli.parse_args(['1', '2', '3'])
+        assert cli.run() == 6
+
+    def test_run_returns_async_result(self):
+        async def fn(values: list[int]):
+            return sum(values)
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['1', '2', '3'])
+        assert cli.run() == 6
+
+    def test_parse_args_accepts_args_sequence(self):
+        def fn(input: Path):
+            return input
+
+        cli = FnToCLI(fn)
+        ns = cli.parse_args(args=['x/y'])
+        assert ns.input == Path('x/y')
+
+    def test_option_name_maps_to_param_name(self):
+        def fn(my_files: list[str] | None = None):
+            return my_files
+
+        cli = FnToCLI(fn)
+        ns = cli.parse_args(['--my-files', 'a', 'b'])
+        assert ns.my_files == ['a', 'b']
+
+    def test_existing_int_optional_unchanged(self):
+        def fn(count: int = 5):
+            return count
+
+        cli = FnToCLI(fn)
+        ns = cli.parse_args(['--count', '7'])
+        assert ns.count == 7
+        ns = cli.parse_args([])
+        assert ns.count == 5
+
+    def test_existing_bool_unchanged(self):
+        def fn(flag: bool = False):
+            return flag
+
+        cli = FnToCLI(fn)
+        ns = cli.parse_args(['--flag'])
+        assert ns.flag is True
+        ns = cli.parse_args(['--no-flag'])
+        assert ns.flag is False
+
+    def test_existing_literal_unchanged(self):
+        def fn(color: typing.Literal['red', 'black'] = 'red'):  # noqa: UP006
+            return color
+
+        cli = FnToCLI(fn)
+        ns = cli.parse_args(['--color', 'black'])
+        assert ns.color == 'black'
+
+
+class TestTypeToArgparseExtended:
+    def test_path_type(self):
+        assert FnToCLI.type_to_argparse(Path) == {'type': Path}
+
+    def test_list_int_type(self):
+        assert FnToCLI.type_to_argparse(list[int]) == {'type': int}
+
+    def test_list_path_type(self):
+        assert FnToCLI.type_to_argparse(list[Path]) == {'type': Path}
+
+    def test_optional_list_path_type(self):
+        assert FnToCLI.type_to_argparse(list[Path] | None) == {'type': Path}
+
+
+import typing  # noqa: E402
