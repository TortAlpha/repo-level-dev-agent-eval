index 0000000000000000000000000000000000000000..e767b7960dd205774bd5e0d2a9be7079b343c9c0
--- /dev/null
+++ b/tests/test_strftime.py
@@ -0,0 +1,21 @@
+import datetime
+from parse import parse
+
+
+def test_strftime_date():
+    assert parse("a {:%Y-%m-%d} b", "a 1997-07-16 b")[0] == datetime.date(1997, 7, 16)
+    assert parse("a {:%Y-%b-%d} b", "a 1997-Feb-16 b")[0] == datetime.date(1997, 2, 16)
+
+
+def test_strftime_datetime_with_tz():
+    result = parse("{:%Y-%m-%d %H:%M:%S %z}", "2020-01-02 03:04:05 +0000")[0]
+    assert result == datetime.datetime(2020, 1, 2, 3, 4, 5, tzinfo=datetime.timezone.utc)
+
+
+def test_strftime_time():
+    assert parse("{:%H:%M:%S}", "12:34:56")[0] == datetime.time(12, 34, 56)
+
+
+def test_strftime_mixed_with_other_fields():
+    assert parse("{:%Y-%m-%d} {}", "2020-01-02 hello")[0] == datetime.date(2020, 1, 2)
+    assert parse("{:%Y-%m-%d} {}", "2020-01-02 hello")[1] == "hello"
