+_STRFTIME_DATE_DIRECTIVES = set("%Y%y%m%d%j%U%W%a%A%b%B%x%c")
+_STRFTIME_TIME_DIRECTIVES = set("%H%M%S%I%p%X%c")
+
+_STRFTIME_REGEX = {
+    "%Y": r"\d{4}",
+    "%y": r"\d{2}",
+    "%m": r"\d{2}",
+    "%d": r"\d{2}",
+    "%H": r"\d{2}",
+    "%M": r"\d{2}",
+    "%S": r"\d{2}",
+    "%f": r"\d{6}",
+    "%z": r"[+-]\d{4}|[+-]\d{2}:\d{2}",
+    "%Z": r"[A-Za-z]+(?:\s[A-Za-z]+)*",
+    "%a": r"[A-Za-z]{3}",
+    "%A": r"[A-Za-z]+",
+    "%b": r"[A-Za-z]{3}",
+    "%B": r"[A-Za-z]+",
+    "%p": r"[AP]M",
+    "%I": r"\d{2}",
+    "%j": r"\d{3}",
+    "%U": r"\d{2}",
+    "%W": r"\d{2}",
+    "%c": r".+?",
+    "%x": r".+?",
+    "%X": r".+?",
+    "%%": r"%",
+}
+
+
+def _strftime_to_regex(format):
+    """Convert a strftime format string to a regular expression pattern."""
+    parts = []
+    i = 0
+    while i < len(format):
+        ch = format[i]
+        if ch == "%":
+            if i + 1 >= len(format):
+                raise ValueError("trailing %% in strftime format")
+            directive = format[i : i + 2]
+            if directive not in _STRFTIME_REGEX:
+                raise ValueError("unsupported strftime directive %r" % directive)
+            parts.append(_STRFTIME_REGEX[directive])
+            i += 2
+        else:
+            j = i
+            while j < len(format) and format[j] != "%":
+                j += 1
+            parts.append(re.escape(format[i:j]))
+            i = j
+    return "".join(parts)
+
+
+def _strftime_convert(string, match, format):
+    """Convert a matched string using strptime, returning date/datetime/time."""
+    value = datetime.strptime(string, format)
+    has_date = any(d in format for d in _STRFTIME_DATE_DIRECTIVES)
+    has_time = any(d in format for d in _STRFTIME_TIME_DIRECTIVES)
+    if has_date and has_time:
+        return value
+    if has_date:
+        return value.date()
+    return value.time()
+
