@@ -0,0 +1,29 @@
+import pytest
+
+import h11
+from h11._headers import normalize_and_validate
+from h11._util import LocalProtocolError, RemoteProtocolError
+
+
+def test_normalize_rejects_huge_content_length():
+    # A Content-Length value with more than 20 digits must be rejected
+    huge = b"1" * 100
+    with pytest.raises(LocalProtocolError):
+        normalize_and_validate([(b"Content-Length", huge)])
+
+
+def test_connection_rejects_huge_content_length_response():
+    conn = h11.Connection(h11.SERVER)
+    # Send a response with a huge Content-Length value
+    data = (
+        b"HTTP/1.1 200 OK\r\n"
+        b"Content-Length: " + b"1" * 100 + b"\r\n"
+        b"\r\n"
+    )
+    with pytest.raises(RemoteProtocolError):
+        conn.receive_data(data)
+
+
+def test_normal_content_length_still_works():
+    headers = normalize_and_validate([(b"Content-Length", b"123")])
+    assert headers == [(b"content-length", b"123")]
