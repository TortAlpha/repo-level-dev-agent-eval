@@ -0,0 +1,15 @@
+import warnings
+from cachetools import cachedmethod
+from cachetools.keys import hashkey
+from unittest.mock import create_autospec
+
+def test_create_autospec_no_warning():
+    class C:
+        @cachedmethod(lambda self: {}, key=hashkey)
+        def f(self, x):
+            return x
+
+    with warnings.catch_warnings(record=True) as w:
+        warnings.simplefilter('always')
+        create_autospec(C, instance=True)
+    assert not w, f"Autospec of class with @cachedmethod should not emit warnings, got: {w}"
