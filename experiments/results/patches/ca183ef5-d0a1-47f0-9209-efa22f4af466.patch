index 0000000..4042cac
--- /dev/null
+++ b/tests/test_tick_delta.py
@@ -0,0 +1,46 @@
+import datetime
+import fractions
+
+import pytest
+
+from freezegun import freeze_time
+
+
+@pytest.mark.parametrize(
+    "delta, expected",
+    [
+        (1, datetime.datetime(2012, 1, 14, 0, 0, 1)),
+        (1.5, datetime.datetime(2012, 1, 14, 0, 0, 1, 500000)),
+        (fractions.Fraction(3, 2), datetime.datetime(2012, 1, 14, 0, 0, 1, 500000)),
+    ],
+)
+def test_frozen_factory_tick_numeric_delta(delta, expected) -> None:
+    with freeze_time("2012-01-14 00:00:00") as ft:
+        ft.tick(delta)
+        assert ft.time_to_freeze == expected
+
+
+def test_frozen_factory_tick_timedelta_delta() -> None:
+    with freeze_time("2012-01-14 00:00:00") as ft:
+        ft.tick(datetime.timedelta(minutes=2))
+        assert ft.time_to_freeze == datetime.datetime(2012, 1, 14, 0, 2, 0)
+
+
+@pytest.mark.parametrize(
+    "delta, expected",
+    [
+        (1, datetime.datetime(2012, 1, 14, 0, 0, 1)),
+        (1.5, datetime.datetime(2012, 1, 14, 0, 0, 1, 500000)),
+        (fractions.Fraction(3, 2), datetime.datetime(2012, 1, 14, 0, 0, 1, 500000)),
+    ],
+)
+def test_step_tick_factory_tick_numeric_delta(delta, expected) -> None:
+    with freeze_time("2012-01-14 00:00:00", auto_tick_seconds=1) as ft:
+        ft.tick(delta)
+        assert ft.time_to_freeze == expected
+
+
+def test_step_tick_factory_tick_timedelta_delta() -> None:
+    with freeze_time("2012-01-14 00:00:00", auto_tick_seconds=1) as ft:
+        ft.tick(datetime.timedelta(minutes=2))
+        assert ft.time_to_freeze == datetime.datetime(2012, 1, 14, 0, 2, 0)
