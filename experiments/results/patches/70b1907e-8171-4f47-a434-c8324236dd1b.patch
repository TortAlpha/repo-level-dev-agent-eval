diff --git a/tests/test_wait_exponential_jitter_min_timedelta.py b/tests/test_wait_exponential_jitter_min_timedelta.py
new file mode 100644
index 0000000000000000000000000000000000000000..29cd80a366f3367ebf24626341f6c6a811425327
--- /dev/null
+++ b/tests/test_wait_exponential_jitter_min_timedelta.py
@@ -0,0 +1,25 @@
+import datetime
+import tenacity
+import tests.test_tenacity as test_tenacity
+
+
+def _assert_inclusive_range(val, start, end):
+    assert start <= val <= end, f"{val} not in [{start}, {end}]"
+
+
+def test_timedelta_support_and_min_bound_wait_exponential_jitter():
+    td_max = datetime.timedelta(seconds=5)
+    td_jitter = datetime.timedelta(seconds=2)
+    td_min = datetime.timedelta(seconds=3)
+    fn = tenacity.wait_exponential_jitter(max=td_max, jitter=td_jitter, min=td_min)
+
+    # For attempt 1: initial=1 * exp_base**0 + jitter in [0,2] -> raw [1,3]
+    # clamp at max=5 -> [1,3], clamp at min=3 -> always 3
+    for _ in range(100):
+        assert fn(test_tenacity.make_retry_state(1, 0)) == 3
+
+    # For attempt 3: initial=1 * exp_base**2 + jitter in [0,2] -> raw [4,6]
+    # clamp at max=5 -> [4,5], clamp at min=3 -> [4,5]
+    for _ in range(100):
+        result = fn(test_tenacity.make_retry_state(3, 0))
+        _assert_inclusive_range(result, 4, 5)
