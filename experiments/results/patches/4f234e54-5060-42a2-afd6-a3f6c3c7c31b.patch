diff --git a/openlibrary/tests/core/test_vendors_languages.py b/openlibrary/tests/core/test_vendors_languages.py
new file mode 100644
index 000000000..b6f7542b3
--- /dev/null
+++ b/openlibrary/tests/core/test_vendors_languages.py
@@ -0,0 +1,103 @@
+from dataclasses import dataclass, field
+from typing import Any
+
+from openlibrary.core.vendors import AmazonAPI
+
+
+@dataclass
+class ProductGroup:
+    display_value: str | None
+
+
+@dataclass
+class Binding:
+    display_value: str | None
+
+
+@dataclass
+class Classifications:
+    product_group: ProductGroup | None
+    binding: Binding
+
+
+@dataclass
+class Language:
+    type: str | None
+    display_value: str | None
+
+
+@dataclass
+class Languages:
+    display_values: list[Language] | None
+
+
+@dataclass
+class DisplayValue:
+    display_value: str | None
+
+
+@dataclass
+class ContentInfo:
+    languages: Languages | None = None
+    publication_date: DisplayValue | None = None
+    pages_count: DisplayValue | None = None
+    edition: DisplayValue | None = None
+
+
+@dataclass
+class ItemInfo:
+    classifications: Classifications | None
+    content_info: Any
+    by_line_info: None
+    title: str
+
+
+@dataclass
+class AmazonAPIReply:
+    item_info: ItemInfo
+    images: str
+    offers: str
+    asin: str
+
+
+def _product(languages):
+    classification = Classifications(
+        product_group=ProductGroup('Book'), binding=Binding('paperback')
+    )
+    content_info = ContentInfo(languages=Languages(display_values=languages))
+    item_info = ItemInfo(
+        classifications=classification,
+        content_info=content_info,
+        by_line_info=None,
+        title='',
+    )
+    return AmazonAPIReply(item_info=item_info, images='', offers='', asin='')
+
+
+def test_serialize_includes_languages_excluding_original_language():
+    product = _product(
+        [
+            Language('Published', 'English'),
+            Language('Original Language', 'Latin'),
+            Language('Published', 'Spanish'),
+            Language('Published', 'English'),
+        ]
+    )
+    result = AmazonAPI.serialize(product)
+    assert result['languages'] == ['English', 'Spanish']
+
+
+def test_serialize_omits_languages_when_empty():
+    product = _product(
+        [
+            Language('Original Language', 'Latin'),
+        ]
+    )
+    result = AmazonAPI.serialize(product)
+    assert 'languages' not in result
+
+
+def test_serialize_omits_languages_when_none():
+    product = _product(None)
+    result = AmazonAPI.serialize(product)
+    assert 'languages' not in result
