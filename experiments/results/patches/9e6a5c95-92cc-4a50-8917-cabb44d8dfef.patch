diff --git a/tests/test_skip_missing_doc_ids.py b/tests/test_skip_missing_doc_ids.py
new file mode 100644
index 0000000000000000000000000000000000000000..39143314052a088e8e0c5f697885da3d46724f8c
--- /dev/null
+++ b/tests/test_skip_missing_doc_ids.py
@@ -0,0 +1,70 @@
+import pytest
+
+from tinydb import TinyDB, where
+
+
+@pytest.fixture(params=['memory', 'json'])
+def db(request, tmp_path):
+    if request.param == 'json':
+        db = TinyDB(tmp_path / 'test.json')
+    else:
+        db = TinyDB(storage=MemoryStorage)
+    yield db
+    db.close()
+
+
+from tinydb.storages import MemoryStorage
+
+
+def test_update_missing_doc_ids_skipped(db):
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+    result = db.update({'a': 99}, doc_ids=[1, 99])
+    assert result == [1]
+    assert db.all() == [{'a': 99}, {'a': 2}]
+
+
+def test_update_all_missing_returns_empty(db):
+    db.insert({'a': 1})
+    result = db.update({'a': 99}, doc_ids=[99])
+    assert result == []
+    assert db.all() == [{'a': 1}]
+
+
+def test_update_missing_between_existing(db):
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+    result = db.update({'a': 99}, doc_ids=[1, 99, 2])
+    assert result == [1, 2]
+    assert db.all() == [{'a': 99}, {'a': 99}]
+
+
+def test_update_no_partial_update(db):
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+    result = db.update({'a': 99}, doc_ids=[1, 99])
+    assert result == [1]
+    assert db.all() == [{'a': 99}, {'a': 2}]
+
+
+def test_remove_missing_doc_ids_skipped(db):
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+    result = db.remove(doc_ids=[1, 99])
+    assert result == [1]
+    assert db.all() == [{'a': 2}]
+
+
+def test_remove_all_missing_returns_empty(db):
+    db.insert({'a': 1})
+    result = db.remove(doc_ids=[99])
+    assert result == []
+    assert db.all() == [{'a': 1}]
+
+
+def test_remove_update_order(db):
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+    result = db.remove(doc_ids=[99, 1, 98, 2])
+    assert result == [1, 2]
+    assert db.all() == []
