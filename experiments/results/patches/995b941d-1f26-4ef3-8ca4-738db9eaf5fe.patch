+def _compile_datetime_format(fmt):
+    """Compile a strftime-style datetime format into a regex pattern and converter."""
+    directive_patterns = {
+        '%%': '%',
+        '%Y': r'\d{4}',
+        '%y': r'\d{2}',
+        '%m': r'\d{2}',
+        '%d': r'\d{2}',
+        '%H': r'\d{2}',
+        '%I': r'\d{2}',
+        '%M': r'\d{2}',
+        '%S': r'\d{2}',
+        '%f': r'\d{1,6}',
+        '%b': r'(?:' + '|'.join(re.escape(m) for m in calendar.month_abbr[1:]) + ')',
+        '%B': r'(?:' + '|'.join(re.escape(m) for m in calendar.month_name[1:] if m) + ')',
+        '%p': r'(?:AM|PM)',
+        '%z': r'[+-]\d{2}:?\d{2}',
+        '%Z': r'[A-Za-z/_]+',
+    }
+    regex = ''
+    i = 0
+    while i < len(fmt):
+        if fmt[i] == '%' and i + 1 < len(fmt):
+            directive = fmt[i:i+2]
+            pattern = directive_patterns.get(directive)
+            if pattern:
+                regex += pattern
+                i += 2
+                continue
+        regex += re.escape(fmt[i])
+        i += 1
+    has_date = any(d in fmt for d in ('%Y','%y','%m','%b','%B','%d'))
+    has_time = any(d in fmt for d in ('%H','%I','%M','%S','%f','%p'))
+    def converter(text):
+        dt = datetime.strptime(text, fmt)
+        if has_date and not has_time:
+            return dt.date()
+        if has_time and not has_date:
+            return dt.time()
+        return dt
+    return regex, converter
 
 
