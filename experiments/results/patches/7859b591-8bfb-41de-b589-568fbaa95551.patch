index 0000000000000000000000000000000000000000..fc6e5dc0949e8b0199fba008ccfe8f2e38080cd1
--- /dev/null
+++ b/tests/test_tenacity_wait_exponential_jitter_min.py
@@ -0,0 +1,62 @@
+import datetime
+import unittest
+from unittest import mock
+
+import tenacity
+
+from tests.test_tenacity import make_retry_state
+
+
+class TestWaitExponentialJitterMinAndTimedelta(unittest.TestCase):
+    def test_min_bound_plain_number(self) -> None:
+        fn = tenacity.wait_exponential_jitter(max=60, min=20)
+        # For low attempts, exponential+jitter is below min, so result should be at least 20
+        for _ in range(1000):
+            self.assertGreaterEqual(fn(make_retry_state(1, 0)), 20)
+            self.assertGreaterEqual(fn(make_retry_state(2, 0)), 20)
+            self.assertGreaterEqual(fn(make_retry_state(3, 0)), 20)
+        # For high attempts, result is capped at max, but still at least min
+        for _ in range(1000):
+            self.assertEqual(fn(make_retry_state(10, 0)), 60)
+
+    def test_min_zero_does_not_alter_computed_value(self) -> None:
+        # With min=0, the result must equal the capped exponential+jitter value.
+        # Use a fixed jitter to make the assertion deterministic.
+        fn_without_min = tenacity.wait_exponential_jitter(max=60)
+        fn_with_min_zero = tenacity.wait_exponential_jitter(max=60, min=0)
+        for attempt in range(1, 7):
+            state = make_retry_state(attempt, 0)
+            for fixed_jitter in (0.0, 0.5, 1.0):
+                with mock.patch("random.uniform", return_value=fixed_jitter):
+                    expected = min(60, 2 ** (attempt - 1) + fixed_jitter)
+                    self.assertEqual(fn_without_min(state), expected)
+                    self.assertEqual(fn_with_min_zero(state), expected)
+
+    def test_timedelta_acceptance(self) -> None:
+        # All three parameters accept timedelta and are converted to seconds
+        fn = tenacity.wait_exponential_jitter(
+            max=datetime.timedelta(seconds=60),
+            jitter=datetime.timedelta(seconds=1),
+            min=datetime.timedelta(seconds=20),
+        )
+        self.assertEqual(fn.max, 60)
+        self.assertEqual(fn.jitter, 1)
+        self.assertEqual(fn.min, 20)
+        # Functional check: min bound applies with timedelta values
+        for _ in range(1000):
+            state = make_retry_state(1, 0)
+            self.assertGreaterEqual(fn(state), 20)
+
+    def test_constructor_signature_backward_compatible(self) -> None:
+        # Plain numbers still work with old positional ordering
+        fn = tenacity.wait_exponential_jitter(10, 5)
+        self.assertEqual(fn.initial, 10)
+        self.assertEqual(fn.max, 5)
+        self.assertEqual(fn.jitter, 1)
+        self.assertEqual(fn.min, 0)
+        # Verify old default behaviour
+        self.assertEqual(fn(make_retry_state(1, 0)), 5)
+
+
+if __name__ == "__main__":
+    unittest.main()
