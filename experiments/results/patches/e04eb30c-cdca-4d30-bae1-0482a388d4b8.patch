diff --git a/openlibrary/plugins/openlibrary/tests/test_lists_regression.py b/openlibrary/plugins/openlibrary/tests/test_lists_regression.py
new file mode 100644
index 000000000..963c1cc91
--- /dev/null
+++ b/openlibrary/plugins/openlibrary/tests/test_lists_regression.py
@@ -0,0 +1,84 @@
+import web
+
+from openlibrary.plugins.openlibrary import lists
+from openlibrary.plugins.upstream import utils
+
+
+def _patch_input(monkeypatch, post=None, get=None):
+    """Patch web.input so from_input sees the given POST/GET storages."""
+
+    def fake_input(*requireds, **defaults):
+        method = defaults.get("_method", "both").lower()
+        if method == "post":
+            data = web.storage(post or {})
+        elif method == "get":
+            data = web.storage(get or {})
+        else:
+            data = web.storage({})
+        # Apply defaults like storify would for missing keys
+        for k, v in defaults.items():
+            if k.startswith("_"):
+                continue
+            if k not in data:
+                data[k] = v
+        return data
+
+    monkeypatch.setattr(web, "input", fake_input)
+
+
+def test_from_input_ignores_query_when_body_present(monkeypatch):
+    _patch_input(
+        monkeypatch,
+        post={"name": "My List", "description": "desc", "seeds--0": "/books/OL1M"},
+        get={"name": "Query List", "seeds": "/books/OL2M"},
+    )
+    record = lists.ListRecord.from_input()
+    assert record.name == "My List"
+    assert record.description == "desc"
+    assert record.seeds == [{"key": "/books/OL1M"}]
+
+
+def test_from_input_does_not_inject_default_for_seeds_when_nested(monkeypatch):
+    _patch_input(
+        monkeypatch,
+        post={"name": "My List", "seeds--0--key": "/books/OL1M"},
+    )
+    record = lists.ListRecord.from_input()
+    assert record.name == "My List"
+    assert record.seeds == [{"key": "/books/OL1M"}]
+
+
+def test_from_input_falls_back_to_get_when_no_body(monkeypatch):
+    _patch_input(
+        monkeypatch,
+        post={},
+        get={"name": "Query List", "seeds": "/subjects/love"},
+    )
+    record = lists.ListRecord.from_input()
+    assert record.name == "Query List"
+    assert record.seeds == ["/subjects/love"]
+
+
+def test_from_input_ignores_empty_seeds(monkeypatch):
+    _patch_input(
+        monkeypatch,
+        post={"name": "My List", "seeds--0": "", "seeds--1": "/books/OL1M"},
+    )
+    record = lists.ListRecord.from_input()
+    assert record.seeds == [{"key": "/books/OL1M"}]
+
+
+def test_unflatten_last_simple_assignment_wins():
+    result = utils.unflatten(
+        utils.Storage({"seeds": "/books/OL1M", "seeds--0--key": "/books/OL2M"})
+    )
+    # The nested assignment must produce a list; the simple assignment must not
+    # block the nested reconstruction.
+    assert result["seeds"] == [{"key": "/books/OL2M"}]
+
+
+def test_unflatten_last_assignment_overrides_simple():
+    result = utils.unflatten(
+        utils.Storage({"seeds--0--key": "/books/OL1M", "seeds": "/books/OL2M"})
+    )
+    assert result["seeds"] == "/books/OL2M"
