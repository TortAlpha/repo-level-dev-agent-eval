diff --git a/tests/test_typed_literal_params.py b/tests/test_typed_literal_params.py
new file mode 100644
index 0000000..598b63e
--- /dev/null
+++ b/tests/test_typed_literal_params.py
@@ -0,0 +1,48 @@
+import sqlparse
+from sqlparse.sql import Function, TypedLiteral
+
+
+def _function(sql_text):
+    parsed = sqlparse.parse(sql_text)[0]
+    stack = [parsed]
+    while stack:
+        tok = stack.pop()
+        if isinstance(tok, Function):
+            return tok
+        if isinstance(tok, sqlparse.sql.TokenList):
+            stack.extend(tok.tokens)
+    raise AssertionError('No Function token found in: %r' % sql_text)
+
+
+def test_single_typed_literal_parameter():
+    func = _function("foo(DATE '2023-11-14')")
+    params = list(func.get_parameters())
+    assert len(params) == 1
+    assert isinstance(params[0], TypedLiteral)
+
+
+def test_two_typed_literal_parameters():
+    func = _function("foo(DATE '2023-11-14', TIMESTAMP '2023-11-15')")
+    params = list(func.get_parameters())
+    assert len(params) == 2
+    assert isinstance(params[0], TypedLiteral)
+    assert isinstance(params[1], TypedLiteral)
+
+
+def test_mixed_parameters():
+    func = _function("foo(DATE '2023-11-14', bar)")
+    params = list(func.get_parameters())
+    assert len(params) == 2
+    assert isinstance(params[0], TypedLiteral)
+
+
+def test_plain_identifier_still_works():
+    func = _function('foo(bar)')
+    params = list(func.get_parameters())
+    assert len(params) == 1
+
+
+def test_plain_literal_still_works():
+    func = _function("foo('2023-11-14')")
+    params = list(func.get_parameters())
+    assert len(params) == 1
