diff --git a/h11/tests/test_content_length_limit.py b/h11/tests/test_content_length_limit.py
new file mode 100644
index 0000000000000000000000000000000000000000..201239c7afbd07776bfb2952f5376c4caae75e77
--- /dev/null
+++ b/h11/tests/test_content_length_limit.py
@@ -0,0 +1,23 @@
+import pytest
+
+from .._headers import normalize_and_validate
+from .._util import LocalProtocolError
+
+
+def test_content_length_pathological_rejected() -> None:
+    # A pathological Content-Length with 100 digits should be rejected.
+    with pytest.raises(LocalProtocolError):
+        normalize_and_validate([(b"content-length", b"1" * 100)])
+
+
+def test_content_length_16_digits_accepted() -> None:
+    # A 16-digit value is at the boundary and should be accepted.
+    assert normalize_and_validate([(b"content-length", b"1234567890123456")]) == [
+        (b"content-length", b"1234567890123456")
+    ]
+
+
+def test_content_length_17_digits_rejected() -> None:
+    # A 17-digit value exceeds the limit and should be rejected.
+    with pytest.raises(LocalProtocolError):
+        normalize_and_validate([(b"content-length", b"12345678901234567")])
