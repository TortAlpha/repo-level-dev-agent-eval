+"""
+Regression test for Setext-style heading underlines.
+
+A mixed `=`/`-` underline must not be treated as a heading.
+"""
+
+from markdown.test_tools import TestCase
+
+
+class TestSetextMixedUnderline(TestCase):
+
+    def test_mixed_underline_not_heading(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                Some text
+                =-=-
+                """
+            ),
+            self.dedent(
+                """
+                <p>Some text
+                =-=-</p>
+                """
+            )
+        )
+
+    def test_mixed_underline_dash_equals_not_heading(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                Some text
+                -=-
+                """
+            ),
+            self.dedent(
+                """
+                <p>Some text
+                -=-</p>
+                """
+            )
+        )
+
+    def test_pure_equals_still_heading(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                Some text
+                ===
+                """
+            ),
+            '<h1>Some text</h1>'
+        )
+
+    def test_pure_dashes_still_heading(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                Some text
+                ---
+                """
+            ),
+            '<h2>Some text</h2>'
+        )
