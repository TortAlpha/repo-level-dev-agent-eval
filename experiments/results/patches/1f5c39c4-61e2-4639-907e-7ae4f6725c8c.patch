+++ b/tests/test_autospec_cachedmethod.py
@@ -0,0 +1,21 @@
+import unittest.mock
+import warnings
+
+import cachetools
+
+
+def test_create_autospec_cachedmethod_no_warnings():
+    class SomeClass:
+        def __init__(self):
+            self.cache = cachetools.LRUCache(maxsize=1)
+
+        @cachetools.cachedmethod(lambda self: self.cache)
+        def compute(self, x):
+            return x
+
+    with warnings.catch_warnings():
+        warnings.simplefilter("error")
+        mock = unittest.mock.create_autospec(SomeClass, instance=True)
+
+    assert mock.compute is not None
+    assert callable(mock.compute)
