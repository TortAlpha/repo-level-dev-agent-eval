diff --git a/tests/test_missing_doc_ids.py b/tests/test_missing_doc_ids.py
new file mode 100644
index 0000000000000000000000000000000000000000..bab0ed4fb31ed8ebbbaac3c0dae58ca5b02f6d59
--- /dev/null
+++ b/tests/test_missing_doc_ids.py
@@ -0,0 +1,105 @@
+import pytest
+
+from tinydb import TinyDB
+
+
+def test_update_skips_missing_doc_ids(db: TinyDB):
+    db.drop_tables()
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+
+    # A missing id before an existing one must not short-circuit the update
+    updated = db.update({'a': 99}, doc_ids=[99, 1])
+    assert updated == [1]
+    assert db.get(doc_id=1)['a'] == 99
+    assert db.get(doc_id=2)['a'] == 2
+
+
+def test_update_all_missing_doc_ids_returns_empty(db: TinyDB):
+    db.drop_tables()
+    db.insert({'a': 1})
+
+    updated = db.update({'a': 99}, doc_ids=[10, 11])
+    assert updated == []
+    assert db.get(doc_id=1)['a'] == 1
+
+
+def test_update_missing_doc_ids_does_not_raise(db: TinyDB):
+    db.drop_tables()
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+
+    # Mixed existing/missing ids must not leave the table half-updated
+    with pytest.raises(Exception):
+        pass
+    updated = db.update({'a': 99}, doc_ids=[1, 99])
+    assert updated == [1]
+    assert db.get(doc_id=1)['a'] == 99
+    assert db.get(doc_id=2)['a'] == 2
+
+
+def test_update_callable_skips_missing_doc_ids(db: TinyDB):
+    db.drop_tables()
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+
+    def increment(doc):
+        doc['a'] += 1
+
+    updated = db.update(increment, doc_ids=[99, 2, 100])
+    assert updated == [2]
+    assert db.get(doc_id=1)['a'] == 1
+    assert db.get(doc_id=2)['a'] == 3
+
+
+def test_remove_skips_missing_doc_ids(db: TinyDB):
+    db.drop_tables()
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+
+    removed = db.remove(doc_ids=[99, 1])
+    assert removed == [1]
+    assert db.get(doc_id=1) is None
+    assert db.get(doc_id=2)['a'] == 2
+
+
+def test_remove_all_missing_doc_ids_returns_empty(db: TinyDB):
+    db.drop_tables()
+    db.insert({'a': 1})
+
+    removed = db.remove(doc_ids=[10, 11])
+    assert removed == []
+    assert db.get(doc_id=1)['a'] == 1
+
+
+def test_update_query_unchanged(db: TinyDB):
+    db.drop_tables()
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+
+    updated = db.update({'a': 99}, where('a') == 2)
+    assert updated == [2]
+    assert db.get(doc_id=1)['a'] == 1
+    assert db.get(doc_id=2)['a'] == 99
+
+
+def test_remove_query_unchanged(db: TinyDB):
+    db.drop_tables()
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+
+    removed = db.remove(where('a') == 2)
+    assert removed == [2]
+    assert db.get(doc_id=1)['a'] == 1
+    assert db.get(doc_id=2) is None
+
+
+def test_update_all_unchanged(db: TinyDB):
+    db.drop_tables()
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+
+    updated = db.update({'a': 99})
+    assert sorted(updated) == [1, 2]
+    assert db.get(doc_id=1)['a'] == 99
+    assert db.get(doc_id=2)['a'] == 99
