diff --git a/tests/test_filesize_rounding.py b/tests/test_filesize_rounding.py
new file mode 100644
index 0000000000000000000000000000000000000000..0f878fc339713931091afa58cf1312e5982e06c9
--- /dev/null
+++ b/tests/test_filesize_rounding.py
@@ -0,0 +1,25 @@
+import humanize
+
+
+def _boundary_bytes(base: float) -> float:
+    """Return a value just below the square of the base that still rounds up."""
+
+    return (base ** 2) - (0.05 * base)
+
+
+def test_naturalsize_decimal_rounds_up_to_next_suffix() -> None:
+    bytes_ = _boundary_bytes(1000)
+    assert humanize.naturalsize(bytes_) == "1.0 MB"
+    assert humanize.naturalsize(-bytes_) == "-1.0 MB"
+
+
+def test_naturalsize_binary_rounds_up_to_next_suffix() -> None:
+    bytes_ = _boundary_bytes(1024)
+    assert humanize.naturalsize(bytes_, True) == "1.0 MiB"
+    assert humanize.naturalsize(-bytes_, True) == "-1.0 MiB"
+
+
+def test_naturalsize_gnu_rounds_up_to_next_suffix() -> None:
+    bytes_ = _boundary_bytes(1024)
+    assert humanize.naturalsize(bytes_, False, True) == "1.0M"
+    assert humanize.naturalsize(-bytes_, False, True) == "-1.0M"
