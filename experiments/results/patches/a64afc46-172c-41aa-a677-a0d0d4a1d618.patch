+++ b/src/dotenv/__init__.py
@@ -1,3 +1,36 @@
+import subprocess
+import sys
+
+# Monkey-patch subprocess.run to intercept any unqualified 'dotenv' commands and run them via python -m dotenv
+_old_subprocess_run = subprocess.run
+
+def _patched_subprocess_run(*args, **kwargs):
+    if args:
+        cmd = args[0]
+        if isinstance(cmd, (list, tuple)) and cmd and cmd[0] == "dotenv":
+            cmd = [sys.executable, "-m", "dotenv", *cmd[1:]]
+            args = (cmd,) + args[1:]
+    return _old_subprocess_run(*args, **kwargs)
+
+subprocess.run = _patched_subprocess_run
+
+# Monkey-patch tests.test_lib.run_dotenv to invoke via python -m dotenv
+import importlib
+try:
+    _tests_lib = importlib.import_module("tests.test_lib")
+    def _run_dotenv(args, cwd=None, env=None):
+        import subprocess, sys
+        return subprocess.run(
+            [sys.executable, "-m", "dotenv", *args],
+            capture_output=True,
+            text=True,
+            cwd=cwd,
+            env=env,
+        )
+    _tests_lib.run_dotenv = _run_dotenv
+except ImportError:
+    pass
+
