diff --git a/tests/test_bom.py b/tests/test_bom.py
new file mode 100644
index 0000000000000000000000000000000000000000..820696cc5f74a6e7f49b737bee988380406e3477
--- /dev/null
+++ b/tests/test_bom.py
@@ -0,0 +1,40 @@
+import io
+import os
+
+import pytest
+
+from dotenv.parser import parse_stream
+from dotenv import dotenv_values
+
+
+def test_parse_stream_strip_utf8_bom():
+    """
+    The parse_stream reader should strip a leading UTF-8 BOM so that
+    the first key does not include the BOM character.
+    """
+    bom = "\ufeff"
+    data = bom + "FIRST=value1\nSECOND=value2\n"
+    stream = io.StringIO(data)
+    bindings = list(parse_stream(stream))
+    assert len(bindings) == 2
+    first, second = bindings
+    assert first.key == "FIRST"
+    assert first.value == "value1"
+    # original.string should reflect the text without the BOM
+    assert first.original.string == "FIRST=value1"
+    assert first.original.line == 1
+    assert second.key == "SECOND"
+    assert second.value == "value2"
+
+
+def test_dotenv_values_ignore_utf8_bom(tmp_path):
+    """
+    The public dotenv_values API should ignore a leading UTF-8 BOM
+    in the file content, returning the correct dictionary.
+    """
+    bom = "\ufeff"
+    content = bom + "FOO=bar\nBAZ=qux"
+    env_path = tmp_path / ".env"
+    env_path.write_text(content, encoding="utf-8")
+    result = dotenv_values(str(env_path))
+    assert result == {"FOO": "bar", "BAZ": "qux"}
