+
+import pytest
+
+from qutebrowser.utils import urlutils
+
+
+@pytest.mark.parametrize('hostname, expected', [
+    ('a.b.c', ['a.b.c', 'b.c', 'c']),
+    ('foobarbaz', ['foobarbaz']),
+    ('', []),
+    ('.c', ['.c', 'c']),
+    ('c.', ['c.']),
+    ('.c.', ['.c.', 'c.']),
+    (None, []),
+])
+def test_widened_hostnames(hostname, expected):
+    assert list(urlutils.widened_hostnames(hostname)) == expected
