+def widened_hostnames(hostname: str) -> Iterable[str]:
+    """Generate parent-domain variants of a hostname.
+
+    Successively removes the leftmost label from the hostname, yielding the
+    original host and each parent domain.
+
+    Examples:
+        a.b.c -> ["a.b.c", "b.c", "c"]
+        foobarbaz -> ["foobarbaz"]
+        "" -> []
+        ".c" -> [".c", "c"]
+        "c." -> ["c."]
+        ".c." -> [".c.", "c."]
+        None -> []
+    """
+    if hostname is None:
+        return
+    while hostname:
+        yield hostname
+        hostname = hostname.partition(".")[-1]
+
+
