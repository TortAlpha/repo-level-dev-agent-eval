+def running_min(iterable, *, maxlen=None):
+    """Yield the running minimum while optionally constraining to a window."""
+    if maxlen is None:
+        initialized = False
+        current = None
+        for item in iterable:
+            if not initialized or item < current:
+                current = item
+                initialized = True
+            yield current
+        return
+    if maxlen <= 0:
+        raise ValueError('maxlen must be greater than zero')
+    window = deque()
+    minima = deque()
+    for item in iterable:
+        window.append(item)
+        while minima and minima[-1] > item:
+            minima.pop()
+        minima.append(item)
+        if len(window) > maxlen:
+            removed = window.popleft()
+            if minima and removed == minima[0]:
+                minima.popleft()
+        yield minima[0]
+
+
+def running_max(iterable, *, maxlen=None):
+    """Yield the running maximum while optionally constraining to a window."""
+    if maxlen is None:
+        initialized = False
+        current = None
+        for item in iterable:
+            if not initialized or current < item:
+                current = item
+                initialized = True
+            yield current
+        return
+    if maxlen <= 0:
+        raise ValueError('maxlen must be greater than zero')
+    window = deque()
+    maxima = deque()
+    for item in iterable:
+        window.append(item)
+        while maxima and maxima[-1] < item:
+            maxima.pop()
+        maxima.append(item)
+        if len(window) > maxlen:
+            removed = window.popleft()
+            if maxima and removed == maxima[0]:
+                maxima.popleft()
+        yield maxima[0]
+
+
