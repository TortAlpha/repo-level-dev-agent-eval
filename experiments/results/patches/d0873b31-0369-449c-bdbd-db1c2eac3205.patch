+class RunningMinMaxTests(TestCase):
+    def test_cumulative(self):
+        values = [8.5, 9.5, 7.5, 6.5]
+        self.assertEqual(
+            list(mi.running_min(values)), [8.5, 8.5, 7.5, 6.5]
+        )
+        self.assertEqual(
+            list(mi.running_max(values)), [8.5, 9.5, 9.5, 9.5]
+        )
+
+    def test_sliding_window(self):
+        values = [3, 1, 4, 2, 5]
+        self.assertEqual(
+            list(mi.running_min(values, maxlen=3)), [3, 1, 1, 1, 2]
+        )
+        self.assertEqual(
+            list(mi.running_max(values, maxlen=3)), [3, 3, 4, 4, 5]
+        )
+
+    def test_invalid_maxlen(self):
+        values = [1, 2, 3]
+        for func in (mi.running_min, mi.running_max):
+            with self.subTest(func=func):
+                with self.assertRaises(ValueError):
+                    list(func(values, maxlen=0))
+                with self.assertRaises(ValueError):
+                    list(func(values, maxlen=-1))
+
