diff --git a/h11/tests/test_content_length_limit.py b/h11/tests/test_content_length_limit.py
new file mode 100644
index 0000000000000000000000000000000000000000..d43f2c709b38b3eeb7b98c90f8b0c526ec09bc22
--- /dev/null
+++ b/h11/tests/test_content_length_limit.py
@@ -0,0 +1,18 @@
+import pytest
+
+from .._headers import normalize_and_validate
+from .._util import LocalProtocolError
+
+
+def test_reject_absurdly_long_content_length() -> None:
+    # A Content-Length value with far too many digits must be rejected
+    # promptly as a protocol error rather than being parsed as an int.
+    with pytest.raises(LocalProtocolError):
+        normalize_and_validate([("Content-Length", "1" * 100)])
+
+
+def test_accept_normal_content_length() -> None:
+    # Normal valid Content-Length values still work.
+    assert normalize_and_validate([("Content-Length", "12345")]) == [
+        (b"content-length", b"12345")
+    ]
