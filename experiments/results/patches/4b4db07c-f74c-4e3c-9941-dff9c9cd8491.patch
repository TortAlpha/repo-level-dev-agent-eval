diff --git a/testing/test_plugin_removal_multiple_impls.py b/testing/test_plugin_removal_multiple_impls.py
new file mode 100644
index 0000000000000000000000000000000000000000..c8ce72f0e3b341600086534fb94a6975d3ded033
--- /dev/null
+++ b/testing/test_plugin_removal_multiple_impls.py
@@ -0,0 +1,82 @@
+"""Regression tests for plugin removal with multiple hook implementations
+on the same hook, including specname-based implementations."""
+
+from pluggy import HookimplMarker
+from pluggy import HookspecMarker
+from pluggy import PluginManager
+
+hookspec = HookspecMarker("example")
+hookimpl = HookimplMarker("example")
+
+
+def test_unregister_removes_all_impls_on_same_hook() -> None:
+    pm = PluginManager("example")
+
+    class Spec:
+        @hookspec
+        def myhook(self) -> None:
+            pass
+
+    class Plugin:
+        @hookimpl
+        def myhook(self) -> None:
+            pass
+
+        @hookimpl(specname="myhook")
+        def another_myhook(self) -> None:
+            pass
+
+    pm.add_hookspecs(Spec)
+    plugin = Plugin()
+    pm.register(plugin)
+
+    hookcaller = pm.hook.myhook
+    impls = hookcaller.get_hookimpls()
+    assert len(impls) == 2
+
+    # get_hookcallers should return each hookcaller only once even though
+    # the plugin has multiple implementations on the same hook.
+    hookcallers = pm.get_hookcallers(plugin)
+    assert len(hookcallers) == 1
+    assert hookcallers[0] is hookcaller
+
+    pm.unregister(plugin)
+    assert len(hookcaller.get_hookimpls()) == 0
+    assert pm.get_hookcallers(plugin) is None
+
+
+def test_unregister_plugin_with_multiple_plain_impls() -> None:
+    pm = PluginManager("example")
+
+    class Spec:
+        @hookspec
+        def myhook(self) -> None:
+            pass
+
+    # Two distinct plugins, each registering one implementation on the same hook,
+    # then unregister one and confirm only that plugin's impl is removed.
+    class Plugin1:
+        @hookimpl
+        def myhook(self) -> None:
+            pass
+
+    class Plugin2:
+        @hookimpl
+        def myhook(self) -> None:
+            pass
+
+    pm.add_hookspecs(Spec)
+    p1 = Plugin1()
+    p2 = Plugin2()
+    pm.register(p1)
+    pm.register(p2)
+
+    hookcaller = pm.hook.myhook
+    assert len(hookcaller.get_hookimpls()) == 2
+
+    pm.unregister(p1)
+    remaining = hookcaller.get_hookimpls()
+    assert len(remaining) == 1
+    assert remaining[0].plugin is p2
+    assert pm.get_hookcallers(p1) is None
+    assert len(pm.get_hookcallers(p2)) == 1
