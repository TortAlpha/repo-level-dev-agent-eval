diff --git a/tests/test_missing_docids.py b/tests/test_missing_docids.py
new file mode 100644
index 0000000..c38e428
--- /dev/null
+++ b/tests/test_missing_docids.py
@@ -0,0 +1,72 @@
+import pytest
+
+from tinydb import TinyDB, where
+from tinydb.storages import MemoryStorage
+
+
+@pytest.fixture
+def db():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+    return db
+
+
+def test_update_missing_doc_ids_mixed(db):
+    # existing id before missing id: should update doc 1 and skip 99
+    assert db.update({'a': 99}, doc_ids=[1, 99]) == [1]
+    assert db.get(doc_id=1) == {'a': 99}
+    assert db.get(doc_id=2) == {'a': 2}
+
+
+def test_update_missing_doc_ids_after(db):
+    # missing id before existing id: should skip 99 and update doc 2
+    assert db.update({'a': 99}, doc_ids=[99, 2]) == [2]
+    assert db.get(doc_id=1) == {'a': 1}
+    assert db.get(doc_id=2) == {'a': 99}
+
+
+def test_update_all_missing_doc_ids(db):
+    assert db.update({'a': 99}, doc_ids=[99, 100]) == []
+    assert db.get(doc_id=1) == {'a': 1}
+    assert db.get(doc_id=2) == {'a': 2}
+
+
+def test_update_no_half_update(db):
+    # previously this raised KeyError after mutating doc 1
+    db.update({'a': 99}, doc_ids=[1, 99])
+    assert db.get(doc_id=1) == {'a': 99}
+    assert db.get(doc_id=2) == {'a': 2}
+
+
+def test_remove_missing_doc_ids_mixed(db):
+    assert db.remove(doc_ids=[1, 99]) == [1]
+    assert db.get(doc_id=1) is None
+    assert db.get(doc_id=2) == {'a': 2}
+
+
+def test_remove_missing_doc_ids_after(db):
+    assert db.remove(doc_ids=[99, 2]) == [2]
+    assert db.get(doc_id=1) == {'a': 1}
+    assert db.get(doc_id=2) is None
+
+
+def test_remove_all_missing_doc_ids(db):
+    assert db.remove(doc_ids=[99, 100]) == []
+    assert len(db) == 2
+
+
+def test_update_query_unchanged(db):
+    assert db.update({'a': 99}, where('a') == 1) == [1]
+    assert db.get(doc_id=1) == {'a': 99}
+
+
+def test_remove_query_unchanged(db):
+    assert db.remove(where('a') == 1) == [1]
+    assert db.get(doc_id=1) is None
+    assert len(db) == 1
+
+
+def test_update_all_unchanged(db):
+    assert db.update({'a': 99}) == [1, 2]
+    assert db.all() == [{'a': 99}, {'a': 99}]
