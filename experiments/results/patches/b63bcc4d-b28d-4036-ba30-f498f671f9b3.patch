diff --git a/tests/test_update_remove_missing_doc_ids.py b/tests/test_update_remove_missing_doc_ids.py
new file mode 100644
index 0000000000000000000000000000000000000000..f8cec4f7b65f93dec0e95f5014c47481cb9f9543
--- /dev/null
+++ b/tests/test_update_remove_missing_doc_ids.py
@@ -0,0 +1,34 @@
+from tinydb import where
+
+
+def test_update_ids_skips_missing_ids(db):
+    updated_ids = db.update({'int': 7}, doc_ids=[99, 3, 1])
+
+    assert updated_ids == [3, 1]
+    assert db.get(doc_id=3)['int'] == 7
+    assert db.get(doc_id=1)['int'] == 7
+    assert db.get(doc_id=2)['int'] == 1
+
+
+def test_update_ids_all_missing_returns_empty(db):
+    updated_ids = db.update({'int': 8}, doc_ids=[99, 100])
+
+    assert updated_ids == []
+    assert db.count(where('int') == 1) == 3
+
+
+def test_remove_ids_skips_missing_ids(db):
+    removed_ids = db.remove(doc_ids=[99, 3, 1])
+
+    assert removed_ids == [3, 1]
+    assert not db.contains(doc_id=1)
+    assert not db.contains(doc_id=3)
+    assert db.contains(doc_id=2)
+    assert len(db) == 1
+
+
+def test_remove_ids_all_missing_returns_empty(db):
+    removed_ids = db.remove(doc_ids=[99, 100])
+
+    assert removed_ids == []
+    assert len(db) == 3
