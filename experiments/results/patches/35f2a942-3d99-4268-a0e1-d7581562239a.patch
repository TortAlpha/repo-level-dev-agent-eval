diff --git a/openlibrary/core/wikidata.py b/openlibrary/core/wikidata.py
index c20e101b7..7a826d8bb 100644
--- a/openlibrary/core/wikidata.py
+++ b/openlibrary/core/wikidata.py
@@ -36,6 +36,30 @@ class WikidataEntity:
     sitelinks: dict[str, dict]
     _updated: datetime  # This is when we fetched the data, not when the entity was changed in Wikidata
 
+    def get_statement_values(self, property_id: str) -> list[str]:
+        """
+        Return the list of string values contained in the statements for the
+        given property identifier.
+
+        The statements for a property are expected to be a list of structured
+        objects, each of which may contain a nested ``value`` dict with a
+        ``content`` key. Values are collected in the original order, skipping
+        any entries that are malformed or whose ``content`` is not a non-empty
+        string. Returns an empty list when the property is absent or no valid
+        values are present.
+        """
+        values: list[str] = []
+        for statement in self.statements.get(property_id, []):
+            if not isinstance(statement, dict):
+                continue
+            value = statement.get('value')
+            if not isinstance(value, dict):
+                continue
+            content = value.get('content')
+            if isinstance(content, str) and content:
+                values.append(content)
+        return values
+
     def get_description(self, language: str = 'en') -> str | None:
         """If a description isn't available in the requested language default to English"""
         return self.descriptions.get(language) or self.descriptions.get('en')
diff --git a/openlibrary/tests/core/test_wikidata.py b/openlibrary/tests/core/test_wikidata.py
index e448c7d85..1715868fb 100644
--- a/openlibrary/tests/core/test_wikidata.py
+++ b/openlibrary/tests/core/test_wikidata.py
@@ -118,3 +118,48 @@ def test_get_wikipedia_link() -> None:
         'es',
     )
     assert entity_no_english.get_wikipedia_link('en') is None
+
+
+def test_get_statement_values() -> None:
+    entity = createWikidataEntity()
+    entity.statements = {
+        'P31': [
+            {'value': {'content': 'Q5'}},
+            {'value': {'content': 'Q1234'}},
+        ],
+        'P569': [{'value': {'content': '1942-01-08'}}],
+        'P570': [{'value': {'content': '2018-03-14'}}],
+    }
+
+    # Multiple values preserve order
+    assert entity.get_statement_values('P31') == ['Q5', 'Q1234']
+    # Single value
+    assert entity.get_statement_values('P569') == ['1942-01-08']
+    # Missing property returns empty list
+    assert entity.get_statement_values('P999') == []
+
+
+def test_get_statement_values_skips_malformed() -> None:
+    entity = createWikidataEntity()
+    entity.statements = {
+        'P31': [
+            {'value': {'content': 'Q5'}},
+            'not a dict',
+            {'value': 'not a dict'},
+            {'value': {'content': 1234}},
+            {'value': {'content': ''}},
+            {'value': {}},
+            {},
+            {'value': {'content': 'Q1234'}},
+        ],
+    }
+
+    # Only valid non-empty string contents are collected, in order
+    assert entity.get_statement_values('P31') == ['Q5', 'Q1234']
+
+
+def test_get_statement_values_empty_statements() -> None:
+    entity = createWikidataEntity()
+    entity.statements = {}
+
+    assert entity.get_statement_values('P31') == []
