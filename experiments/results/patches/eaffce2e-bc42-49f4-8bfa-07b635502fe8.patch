diff --git a/tests/test_strftime.py b/tests/test_strftime.py
new file mode 100644
index 0000000000000000000000000000000000000000..d76f3caa0e4a11df8eb53898ddc7a3e9be2148e9
--- /dev/null
+++ b/tests/test_strftime.py
@@ -0,0 +1,45 @@
+from datetime import date, datetime, time
+from parse import parse
+
+
+def test_strftime_date_ymd():
+    result = parse("a {:%Y-%m-%d} b", "a 1997-07-16 b")
+    assert result[0] == date(1997, 7, 16)
+
+
+def test_strftime_date_ybd():
+    result = parse("a {:%Y-%b-%d} b", "a 1997-Feb-16 b")
+    assert result[0] == date(1997, 2, 16)
+
+
+def test_strftime_datetime():
+    result = parse("{:%Y-%m-%d %H:%M:%S}", "1997-07-16 19:20:30")
+    assert result[0] == datetime(1997, 7, 16, 19, 20, 30)
+
+
+def test_strftime_datetime_with_tz():
+    result = parse("{:%Y-%m-%d %H:%M:%S%z}", "1997-07-16 19:20:30+0700")
+    dt = result[0]
+    assert dt == datetime(1997, 7, 16, 19, 20, 30, tzinfo=dt.tzinfo)
+    assert dt.utcoffset().total_seconds() == 7 * 3600
+
+
+def test_strftime_time_only():
+    result = parse("{:%H:%M:%S}", "19:20:30")
+    assert result[0] == time(19, 20, 30)
+
+
+def test_strftime_multiple_fields():
+    result = parse("{:%Y-%m-%d} and {:d}", "1997-07-16 and 42")
+    assert result[0] == date(1997, 7, 16)
+    assert result[1] == 42
+
+
+def test_strftime_named_field():
+    result = parse("a {when:%Y-%m-%d} b", "a 1997-07-16 b")
+    assert result["when"] == date(1997, 7, 16)
+
+
+def test_percentage_type_still_works():
+    result = parse("{:%%}", "50%")
+    assert result[0] == 0.5
