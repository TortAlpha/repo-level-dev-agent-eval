+    "z": r"(?:[-+]\d{2}:?\d{2}|Z)",
+    "Z": r"[A-Za-z]+",
+    "w": r"\d",
+    "U": r"\d{1,2}",
+    "W": r"\d{1,2}",
+    "%": r"%",
+    "c": r".+?",
+    "x": r".+?",
+    "X": r".+?",
+}
+
+_STRPTIME_DETECT = re.compile(r"%[aAbBcdHIMjmSpSUWwxXyYzZf]")
+
+
+def _strftime_to_regex(fmt):
+    """Convert a strftime format string into a regex pattern string."""
+    parts = []
+    i = 0
+    n = len(fmt)
+    while i < n:
+        c = fmt[i]
+        if c == "%" and i + 1 < n:
+            directive = fmt[i + 1]
+            if directive in STRPTIME_DIRECTIVES:
+                parts.append(STRPTIME_DIRECTIVES[directive])
+                i += 2
+                continue
+        parts.append(re.escape(c))
+        i += 1
+    return "".join(parts)
+
+
+def _strftime_converter(fmt):
+    """Return a converter that parses a matched string with datetime.strptime."""
+
+    def converter(string, match):
+        dt = datetime.strptime(string, fmt)
+        date_directives = set("YybBdjawWx")
+        time_directives = set("HIMSpfzZX")
+        has_date = any(
+            fmt[i] == "%" and i + 1 < len(fmt) and fmt[i + 1] in date_directives
+            for i in range(len(fmt))
+        ) or "%c" in fmt
+        has_time = any(
+            fmt[i] == "%" and i + 1 < len(fmt) and fmt[i + 1] in time_directives
+            for i in range(len(fmt))
+        ) or "%c" in fmt
+        if has_date and not has_time:
+            return dt.date()
+        if has_time and not has_date:
+            if "%z" in fmt or "%Z" in fmt:
+                return dt.timetz()
+            return dt.time()
+        return dt
+
+    return converter
+
 
