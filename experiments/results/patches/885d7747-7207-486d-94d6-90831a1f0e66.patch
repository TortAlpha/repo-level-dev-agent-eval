@@ -0,0 +1,44 @@
+import io
+
+import pytest
+
+from dotenv.parser import Binding, Original, parse_stream
+
+
+@pytest.mark.parametrize(
+    "test_input,expected",
+    [
+        (
+            "\ufeffFIRST=value1",
+            [
+                Binding(
+                    key="FIRST",
+                    value="value1",
+                    original=Original(string="FIRST=value1", line=1),
+                    error=False,
+                )
+            ],
+        ),
+        (
+            "a=b\n\ufeffc=d",
+            [
+                Binding(
+                    key="a",
+                    value="b",
+                    original=Original(string="a=b\n", line=1),
+                    error=False,
+                ),
+                Binding(
+                    key="\ufeffc",
+                    value="d",
+                    original=Original(string="\ufeffc=d", line=2),
+                    error=False,
+                ),
+            ],
+        ),
+    ],
+)
+def test_parse_stream_bom(test_input, expected):
+    result = parse_stream(io.StringIO(test_input))
+
+    assert list(result) == expected
