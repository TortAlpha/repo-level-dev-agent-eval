@@ -0,0 +1,32 @@
+import io
+
+from dotenv.parser import parse_stream
+
+
+def test_parse_strips_leading_utf8_bom():
+    content = "\ufeffFIRST=value1\nSECOND=value2\n"
+    bindings = list(parse_stream(io.StringIO(content)))
+
+    assert [b.key for b in bindings] == ["FIRST", "SECOND"]
+    assert [b.value for b in bindings] == ["value1", "value2"]
+    assert bindings[0].original.string == "FIRST=value1\n"
+    assert bindings[0].original.line == 1
+    assert bindings[1].original.string == "SECOND=value2\n"
+    assert bindings[1].original.line == 2
+
+
+def test_parse_without_bom_unchanged():
+    content = "FIRST=value1\nSECOND=value2\n"
+    bindings = list(parse_stream(io.StringIO(content)))
+
+    assert [b.key for b in bindings] == ["FIRST", "SECOND"]
+    assert bindings[0].original.string == "FIRST=value1\n"
+
+
+def test_parse_does_not_strip_bom_not_at_start():
+    content = "FIRST=\ufeffvalue1\n"
+    bindings = list(parse_stream(io.StringIO(content)))
+
+    assert bindings[0].key == "FIRST"
+    assert bindings[0].value == "\ufeffvalue1"
+    assert bindings[0].original.string == "FIRST=\ufeffvalue1\n"
