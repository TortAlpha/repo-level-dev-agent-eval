diff --git a/openlibrary/tests/catalog/test_format_languages_regression.py b/openlibrary/tests/catalog/test_format_languages_regression.py
new file mode 100644
index 000000000..0bc0f1eff
--- /dev/null
+++ b/openlibrary/tests/catalog/test_format_languages_regression.py
@@ -0,0 +1,44 @@
+import pytest
+
+from openlibrary.catalog.utils import InvalidLanguage, format_languages
+
+
+def test_iso639_1_two_letter_code_normalized_to_marc():
+    assert format_languages(["es"]) == [{"key": "/languages/spa"}]
+
+
+def test_english_language_name_normalized_to_marc():
+    assert format_languages(["German"]) == [{"key": "/languages/ger"}]
+
+
+def test_native_language_name_normalized_to_marc():
+    assert format_languages(["Deutsch"]) == [{"key": "/languages/ger"}]
+
+
+def test_marc_code_case_insensitive():
+    assert format_languages(["FRE"]) == [{"key": "/languages/fre"}]
+
+
+def test_deduplication_preserves_first_occurrence():
+    assert format_languages(["eng", "eng"]) == [{"key": "/languages/eng"}]
+
+
+def test_deduplication_across_alternate_identifiers():
+    assert format_languages(["German", "Deutsch", "es"]) == [
+        {"key": "/languages/ger"},
+        {"key": "/languages/spa"},
+    ]
+
+
+def test_empty_input_returns_empty_list():
+    assert format_languages([]) == []
+
+
+def test_invalid_language_raises():
+    with pytest.raises(InvalidLanguage):
+        format_languages(["wtf"])
+
+
+def test_invalid_language_raises_after_valid_one():
+    with pytest.raises(InvalidLanguage):
+        format_languages(["eng", "wtf"])
