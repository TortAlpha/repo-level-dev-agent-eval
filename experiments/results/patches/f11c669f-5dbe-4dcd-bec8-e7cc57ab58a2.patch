+def _normalize_language_code(language: str) -> str:
+    """Resolve an input language identifier to a MARC 21 three-letter code."""
+    candidate = language.lower()
+
+    # Direct MARC 3-letter codes are accepted as-is (case-insensitively).
+    if len(candidate) == 3:
+        return candidate
+
+    # Native language names not covered by the upstream map.
+    if candidate in _NATIVE_LANGUAGE_NAMES:
+        return _NATIVE_LANGUAGE_NAMES[candidate]
+
+    # ISO-639-1 two-letter codes and English language names.
+    from openlibrary.plugins.upstream.utils import get_marc21_language
+
+    mapped = get_marc21_language(candidate)
+    if mapped is not None:
+        return mapped
+
+    # Fall back to the lowercased token; it may still be a valid MARC code.
+    return candidate
+
+
+def _is_valid_language_code(code: str) -> bool:
+    """Whether a MARC 21 three-letter code is a known Open Library language."""
+    site = getattr(web.ctx, 'site', None)
+    if site is not None:
+        return site.get(f"/languages/{code}") is not None
+    # Outside of a request context (e.g. unit tests), fall back to the upstream
+    # language map so canonical MARC codes are still recognised.
+    from openlibrary.plugins.upstream.utils import get_marc21_language
+
+    return get_marc21_language(code) is not None
+
