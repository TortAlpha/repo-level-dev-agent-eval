diff --git a/test_window_comprehensive.py b/test_window_comprehensive.py
new file mode 100644
index 0000000..4951ebb
--- /dev/null
+++ b/test_window_comprehensive.py
@@ -0,0 +1,56 @@
+import sqlparse
+from sqlparse import sql
+
+# Test comprehensive window function scenarios
+test_cases = [
+    # Basic cases
+    ("foo(5) OVER win1", "5", "win1"),
+    ("foo(5) OVER (PARTITION BY c1)", "5", "(PARTITION BY c1)"),
+    ("SUM(a) OVER (PARTITION BY b ORDER BY c)", "a", "(PARTITION BY b ORDER BY c)"),
+    ("ROW_NUMBER() OVER (ORDER BY id)", None, "(ORDER BY id)"),
+    
+    # Multiple parameters
+    ("SUBSTRING(name, 1, 3) OVER win1", "name, 1, 3", "win1"),
+    
+    # Function without OVER clause
+    ("foo(5)", "5", None),
+    ("SUM(a)", "a", None),
+    
+    # Complex window specifications
+    ("LAG(value, 1) OVER (PARTITION BY group_id ORDER BY date ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)", 
+     "value, 1", 
+     "(PARTITION BY group_id ORDER BY date ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)"),
+]
+
+print("Testing window function parsing...\n")
+
+for i, (test_sql, expected_params, expected_window) in enumerate(test_cases):
+    print(f"Test {i+1}: {test_sql}")
+    
+    parsed = sqlparse.parse(test_sql)[0]
+    assert len(parsed.tokens) == 1, f"Expected 1 token, got {len(parsed.tokens)}"
+    
+    func = parsed.tokens[0]
+    assert isinstance(func, sql.Function), f"Expected Function, got {type(func)}"
+    
+    # Test get_parameters
+    params = list(func.get_parameters())
+    if expected_params is None:
+        assert len(params) == 0, f"Expected no parameters, got {[str(p) for p in params]}"
+    else:
+        param_str = ", ".join(str(p) for p in params)
+        assert param_str == expected_params, f"Expected params '{expected_params}', got '{param_str}'"
+    
+    # Test get_window
+    window = func.get_window()
+    if expected_window is None:
+        assert window is None, f"Expected no window, got {window}"
+    else:
+        assert window is not None, f"Expected window '{expected_window}', got None"
+        assert str(window) == expected_window, f"Expected window '{expected_window}', got '{str(window)}'"
+    
+    print(f"  ✓ Parameters: {[str(p) for p in params]}")
+    print(f"  ✓ Window: {str(window) if window else None}")
+    print()
+
+print("All tests passed!")
diff --git a/test_window_detailed.py b/test_window_detailed.py
new file mode 100644
index 0000000..6eb4e2c
--- /dev/null
+++ b/test_window_detailed.py
@@ -0,0 +1,30 @@
+import sqlparse
+from sqlparse import sql
+
+# Test detailed parsing of window functions
+test_sql = "foo(5) OVER win1"
+print(f"Testing: {test_sql}")
+parsed = sqlparse.parse(test_sql)[0]
+print(f"Tokens: {len(parsed.tokens)}")
+
+func = parsed.tokens[0]
+print(f"Function tokens: {len(func.tokens)}")
+for i, token in enumerate(func.tokens):
+    print(f"  {i}: {type(token).__name__} '{token.value}' (ttype: {token.ttype})")
+    if isinstance(token, sql.Parenthesis):
+        print(f"    Parenthesis tokens: {len(token.tokens)}")
+        for j, ptoken in enumerate(token.tokens):
+            print(f"      {j}: {type(ptoken).__name__} '{ptoken.value}' (ttype: {ptoken.ttype})")
+    elif isinstance(token, sql.Over):
+        print(f"    Over tokens: {len(token.tokens)}")
+        for j, otoken in enumerate(token.tokens):
+            print(f"      {j}: {type(otoken).__name__} '{otoken.value}' (ttype: {otoken.ttype})")
+
+print("\n" + "="*50)
+test_sql2 = "foo(5) OVER (PARTITION BY c1)"
+print(f"Testing: {test_sql2}")
+parsed2 = sqlparse.parse(test_sql2)[0]
+func2 = parsed2.tokens[0]
+print(f"Function tokens: {len(func2.tokens)}")
+for i, token in enumerate(func2.tokens):
+    print(f"  {i}: {type(token).__name__} '{token.value}' (ttype: {token.ttype})")
