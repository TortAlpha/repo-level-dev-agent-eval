+import sqlparse
+from sqlparse import sql
+
+# Test current behavior with window functions
+test_cases = [
+    "foo(5) OVER win1",
+    "foo(5) OVER (PARTITION BY c1)",
+    "SUM(a) OVER (PARTITION BY b ORDER BY c)",
+    "ROW_NUMBER() OVER (ORDER BY id)"
+]
+
+for test_sql in test_cases:
+    print(f"\nTesting: {test_sql}")
+    parsed = sqlparse.parse(test_sql)[0]
+    print(f"Tokens: {len(parsed.tokens)}")
+    for i, token in enumerate(parsed.tokens):
+        print(f"  {i}: {type(token).__name__} '{token.value}' (ttype: {token.ttype})")
+        if isinstance(token, sql.Function):
+            print(f"    Function parameters: {list(token.get_parameters())}")
+            if hasattr(token, 'get_window'):
+                print(f"    Window: {token.get_window()}")
+            else:
+                print(f"    No get_window method")
