--- /dev/null
+++ b/scripts/solr_builder/tests/test_fn_to_cli_types.py
@@ -0,0 +1,81 @@
+import asyncio
+import typing
+from pathlib import Path
+
+import pytest
+
+from scripts.solr_builder.solr_builder.fn_to_cli import FnToCLI
+
+
+class TestFnToCLITypedListsAndPath:
+    def test_type_to_argparse_path(self):
+        assert FnToCLI.type_to_argparse(Path) == {'type': Path}
+
+    def test_type_to_argparse_list_of_int(self):
+        assert FnToCLI.type_to_argparse(list[int]) == {'type': int, 'nargs': '*'}
+
+    def test_type_to_argparse_list_of_path(self):
+        assert FnToCLI.type_to_argparse(list[Path]) == {'type': Path, 'nargs': '*'}
+
+    def test_type_to_argparse_optional_list(self):
+        assert FnToCLI.type_to_argparse(
+            typing.Optional[list[Path]]  # noqa: UP007
+        ) == {'type': Path, 'nargs': '*'}
+
+    def test_path_argument_converted(self):
+        def fn(path: Path):
+            return path
+
+        cli = FnToCLI(fn)
+        args = cli.parse_args(['some/file.txt'])
+        assert args.path == Path('some/file.txt')
+
+    def test_required_list_int_positional(self):
+        def fn(values: list[int]):
+            return values
+
+        cli = FnToCLI(fn)
+        args = cli.parse_args(['1', '2', '3'])
+        assert args.values == [1, 2, 3]
+
+    def test_optional_list_path_none_when_omitted(self):
+        def fn(files: list[Path] | None = None):
+            return files
+
+        cli = FnToCLI(fn)
+        args = cli.parse_args([])
+        assert args.files is None
+
+    def test_optional_list_path_flagged_values(self):
+        def fn(files: list[Path] | None = None):
+            return files
+
+        cli = FnToCLI(fn)
+        args = cli.parse_args(['--files', 'a/b', 'c/d'])
+        assert args.files == [Path('a/b'), Path('c/d')]
+
+    def test_run_returns_sync_result(self):
+        def fn(a: int, b: int = 10):
+            return a + b
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['5'])
+        assert cli.run() == 15
+
+    def test_run_returns_async_result(self):
+        async def fn(a: int, b: int = 10):
+            await asyncio.sleep(0)
+            return a + b
+
+        cli = FnToCLI(fn)
+        cli.parse_args(['5'])
+        assert cli.run() == 15
+
+    def test_parse_args_accepts_none(self):
+        def fn(value: str):
+            return value
+
+        cli = FnToCLI(fn)
+        # Should not raise when called without arguments.
+        with pytest.raises(SystemExit):
+            cli.parse_args(None)
