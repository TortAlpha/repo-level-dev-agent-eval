+
+
+class TestNxosVrfAfRouteTargetsModule(TestNxosModule):
+
+    module = nxos_vrf_af
+
+    def setUp(self):
+        super(TestNxosVrfAfRouteTargetsModule, self).setUp()
+
+        self.mock_load_config = patch('ansible.modules.network.nxos.nxos_vrf_af.load_config')
+        self.load_config = self.mock_load_config.start()
+
+        self.mock_get_config = patch('ansible.modules.network.nxos.nxos_vrf_af.get_config')
+        self.get_config = self.mock_get_config.start()
+
+    def tearDown(self):
+        super(TestNxosVrfAfRouteTargetsModule, self).tearDown()
+        self.mock_load_config.stop()
+        self.mock_get_config.stop()
+
+    def load_fixtures(self, commands=None, device=''):
+        self.load_config.return_value = None
+
+    # --- match_current_rt helper tests ---
+
+    def test_match_current_rt_present_adds_when_missing(self):
+        rt = {'rt': '1:1', 'direction': 'import', 'state': 'present'}
+        cmds = nxos_vrf_af.match_current_rt(rt, 'import', 'some config', [])
+        self.assertEqual(cmds, ['route-target import 1:1'])
+
+    def test_match_current_rt_present_noop_when_exists(self):
+        rt = {'rt': '1:1', 'direction': 'import', 'state': 'present'}
+        current = 'route-target import 1:1\n'
+        cmds = nxos_vrf_af.match_current_rt(rt, 'import', current, [])
+        self.assertEqual(cmds, [])
+
+    def test_match_current_rt_absent_removes_when_exists(self):
+        rt = {'rt': '1:1', 'direction': 'export', 'state': 'absent'}
+        current = 'route-target export 1:1\n'
+        cmds = nxos_vrf_af.match_current_rt(rt, 'export', current, [])
+        self.assertEqual(cmds, ['no route-target export 1:1'])
+
+    def test_match_current_rt_absent_noop_when_missing(self):
+        rt = {'rt': '1:1', 'direction': 'export', 'state': 'absent'}
+        cmds = nxos_vrf_af.match_current_rt(rt, 'export', 'some config', [])
+        self.assertEqual(cmds, [])
+
+    def test_match_current_rt_absent_noop_when_current_none(self):
+        rt = {'rt': '1:1', 'direction': 'import', 'state': 'absent'}
+        cmds = nxos_vrf_af.match_current_rt(rt, 'import', None, [])
+        self.assertEqual(cmds, [])
+
+    def test_match_current_rt_present_adds_when_current_none(self):
+        rt = {'rt': '1:1', 'direction': 'import', 'state': 'present'}
+        cmds = nxos_vrf_af.match_current_rt(rt, 'import', None, [])
+        self.assertEqual(cmds, ['route-target import 1:1'])
+
+    def test_match_current_rt_default_state_present(self):
+        rt = {'rt': '1:1', 'direction': 'import'}
+        cmds = nxos_vrf_af.match_current_rt(rt, 'import', '', [])
+        self.assertEqual(cmds, ['route-target import 1:1'])
+
+    def test_match_current_rt_appends_to_existing_list(self):
+        rt = {'rt': '2:2', 'direction': 'export', 'state': 'present'}
+        cmds = nxos_vrf_af.match_current_rt(rt, 'export', '', ['route-target import 1:1'])
+        self.assertEqual(cmds, ['route-target import 1:1', 'route-target export 2:2'])
+
+    # --- Module-level tests: new AF block (no existing config) ---
+
+    def test_route_targets_new_af_import_export(self):
+        set_module_args(dict(
+            vrf='ntc', afi='ipv4', state='present',
+            route_targets=[
+                {'rt': '1:1', 'direction': 'import'},
+                {'rt': '2:2', 'direction': 'export'},
+            ]
+        ))
+        result = self.execute_module(changed=True)
+        self.assertEqual(sorted(result['commands']), sorted([
