+def match_current_rt(rt, direction, current, rt_commands):
+    """Compare a desired route-target entry against the current config block.
+
+    Appends add/remove commands to C(rt_commands} and returns the updated list.
+    """
+    target = 'route-target %s %s' % (direction, rt['rt'])
+    state = rt.get('state', 'present')
+    if state == 'present':
+        if current is None or target not in current:
+            rt_commands.append(target)
+    elif state == 'absent':
+        if current is not None and target in current:
+            rt_commands.append('no ' + target)
+    return rt_commands
+
