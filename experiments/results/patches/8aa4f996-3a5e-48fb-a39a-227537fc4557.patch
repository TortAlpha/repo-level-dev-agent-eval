diff --git a/testing/test_plugin_removal_multiple_impl.py b/testing/test_plugin_removal_multiple_impl.py
new file mode 100644
index 0000000000000000000000000000000000000000..975738c30569efefc3008a9bf2fc102db60e85d6
--- /dev/null
+++ b/testing/test_plugin_removal_multiple_impl.py
@@ -0,0 +1,60 @@
+from pluggy import HookimplMarker, HookspecMarker, PluginManager
+
+hookspec = HookspecMarker("example")
+hookimpl = HookimplMarker("example")
+
+
+def test_unregister_removes_all_impls_for_plugin():
+    pm = PluginManager("example")
+
+    class Hooks:
+        @hookspec
+        def myhook(self, arg): ...
+
+    pm.add_hookspecs(Hooks)
+
+    class Plugin:
+        @hookimpl(specname="myhook")
+        def impl_one(self, arg):
+            return arg
+
+        @hookimpl(specname="myhook")
+        def impl_two(self, arg):
+            return arg * 2
+
+        @hookimpl(specname="other")
+        def impl_other(self, arg):
+            return arg
+
+    # one hook caller matching, one irrelevant
+    plugin = Plugin()
+    pm.register(plugin)
+
+    assert len(pm.hook.myhook.get_hookimpls()) == 2
+    pm.unregister(plugin)
+    assert len(pm.hook.myhook.get_hookimpls()) == 0
+
+
+def test_get_hookcallers_no_duplicate_for_same_hook():
+    pm = PluginManager("example")
+
+    class Hooks:
+        @hookspec
+        def myhook(self, arg): ...
+
+    pm.add_hookspecs(Hooks)
+
+    class Plugin:
+        @hookimpl(specname="myhook")
+        def impl_one(self, arg): return arg
+
+        @hookimpl(specname="myhook")
+        def impl_two(self, arg): return arg
+
+    plugin = Plugin()
+    pm.register(plugin)
+
+    callers = pm.get_hookcallers(plugin)
+    assert callers is not None
+    assert len(callers) == 1
+    assert callers[0].name == "myhook"
