@@ -0,0 +1,45 @@
+from __future__ import annotations
+
+import pytest
+
+from w3lib._url import _urlsplit
+from w3lib.url import canonicalize_url, parse_url, safe_url_string
+
+
+class TestUrlsplitIpv6Fragment:
+    @pytest.mark.parametrize(
+        "url",
+        [
+            "http://[::1]?q#f",
+            "http://[2001:db8::1]?q#frag",
+            "http://[fe80::1%eth0]/path?q#frag",
+        ],
+    )
+    def test_urlsplit_ipv6_query_fragment(self, url):
+        result = _urlsplit(url)
+        assert result.fragment == url.rsplit("#", 1)[1]
+        assert result.query
+        assert result.fragment
+
+    def test_urlsplit_ipv6_query_fragment_exact(self):
+        result = _urlsplit("http://[::1]?q#f")
+        assert result.scheme == "http"
+        assert result.netloc == "[::1]"
+        assert result.path == ""
+        assert result.query == "q"
+        assert result.fragment == "f"
+
+    def test_canonicalize_url_keeps_fragment_separate(self):
+        # canonicalize_url strips fragments by default; the key check is that
+        # the fragment is not folded into the query.
+        assert canonicalize_url("http://[::1]?q#f") == "http://[::1]/?q="
+
+    def test_safe_url_string_keeps_fragment(self):
+        assert safe_url_string("http://[::1]?q#f") == "http://[::1]?q#f"
+
+    def test_parse_url_keeps_fragment(self):
+        result = parse_url("http://[::1]?q#f")
+        assert result.scheme == "http"
+        assert result.netloc == "[::1]"
+        assert result.query == "q"
+        assert result.fragment == "f"
