index 0000000000000000000000000000000000000000..cb0e05425609d0e8a3b2efe24057772e43ffe424
--- /dev/null
+++ b/tests/test_update_remove_missing_ids.py
@@ -0,0 +1,47 @@
+import pytest
+from tinydb import TinyDB
+from tinydb.storages import MemoryStorage
+
+
+def test_update_skip_missing_doc_ids():
+    db = TinyDB(storage=MemoryStorage)
+    table = db.table()
+    id1 = table.insert({'a': 1})
+    id2 = table.insert({'a': 2})
+
+    # Mix existing and missing IDs
+    processed = table.update({'a': 99}, doc_ids=[id1, id2 + 10])
+    assert processed == [id1]
+    assert table.get(doc_id=id1)['a'] == 99
+    assert table.get(doc_id=id2)['a'] == 2
+
+    # Missing ID before existing ID
+    processed = table.update({'a': 100}, doc_ids=[id2 + 11, id2])
+    assert processed == [id2]
+    assert table.get(doc_id=id2)['a'] == 100
+
+    # Only missing IDs
+    processed = table.update({'b': 42}, doc_ids=[id1 + 100])
+    assert processed == []
+
+
+def test_remove_skip_missing_doc_ids():
+    db = TinyDB(storage=MemoryStorage)
+    table = db.table()
+    id1 = table.insert({'a': 1})
+    id2 = table.insert({'a': 2})
+
+    # Mix existing and missing IDs
+    removed = table.remove(doc_ids=[id1, id2 + 10])
+    assert removed == [id1]
+    assert table.get(doc_id=id1) is None
+    assert table.get(doc_id=id2)['a'] == 2
+
+    # Missing ID before existing ID
+    removed = table.remove(doc_ids=[id2 + 11, id2])
+    assert removed == [id2]
+    assert table.get(doc_id=id2) is None
+
+    # Only missing IDs
+    removed = table.remove(doc_ids=[id1 + 100])
+    assert removed == []
