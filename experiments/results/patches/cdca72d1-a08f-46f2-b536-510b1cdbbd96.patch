diff --git a/markdown/extensions/footnotes.py b/markdown/extensions/footnotes.py
index 30c0811..e77a21f 100644
--- a/markdown/extensions/footnotes.py
+++ b/markdown/extensions/footnotes.py
@@ -168,9 +168,43 @@ class FootnoteExtension(Extension):
         else:
             return self.unique_ref('fnref{}{}'.format(self.get_separator(), id), found)
 
+    def reorderFootnotes(self, root: etree.Element) -> None:
+        """ Reorder footnotes by order of first reference in the text. """
+        ref_order: list[str] = []
+        seen: set[str] = set()
+
+        def traverse(element: etree.Element) -> None:
+            if element.text:
+                for m in re.finditer(r'\[\^([^\]]*)\]', element.text):
+                    id = m.group(1)
+                    if id in self.footnotes and id not in seen:
+                        seen.add(id)
+                        ref_order.append(id)
+            for child in element:
+                traverse(child)
+                if child.tail:
+                    for m in re.finditer(r'\[\^([^\]]*)\]', child.tail):
+                        id = m.group(1)
+                        if id in self.footnotes and id not in seen:
+                            seen.add(id)
+                            ref_order.append(id)
+
+        traverse(root)
+
+        if ref_order:
+            new_footnotes: OrderedDict[str, str] = OrderedDict()
+            for id in ref_order:
+                new_footnotes[id] = self.footnotes[id]
+            for id in self.footnotes:
+                if id not in new_footnotes:
+                    new_footnotes[id] = self.footnotes[id]
+            self.footnotes = new_footnotes
+
     def makeFootnotesDiv(self, root: etree.Element) -> etree.Element | None:
         """ Return `div` of footnotes as `etree` Element. """
 
+        self.reorderFootnotes(root)
+
         if not list(self.footnotes.keys()):
             return None
 
