@@ -0,0 +1,41 @@
+"""
+Test that footnotes are numbered and listed by order of first reference,
+not by order of definition.
+"""
+
+from markdown.test_tools import TestCase
+
+
+class TestFootnoteOrder(TestCase):
+
+    default_kwargs = {'extensions': ['footnotes']}
+    maxDiff = None
+
+    def test_order_by_reference(self):
+        """Footnotes should be numbered by order of first reference in text,
+        not by order of definition."""
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                paragraph with [^first] then [^last].
+
+                [^last]: Last footnote
+                [^first]: First footnote
+                """
+            ),
+            '<p>paragraph with <sup id="fnref:first"><a class="footnote-ref" href="#fn:first">1</a></sup>'
+            ' then <sup id="fnref:last"><a class="footnote-ref" href="#fn:last">2</a></sup>.</p>\n'
+            '<div class="footnote">\n'
+            '<hr />\n'
+            '<ol>\n'
+            '<li id="fn:first">\n'
+            '<p>First footnote&#160;<a class="footnote-backref" href="#fnref:first"'
+            ' title="Jump back to footnote 1 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '<li id="fn:last">\n'
+            '<p>Last footnote&#160;<a class="footnote-backref" href="#fnref:last"'
+            ' title="Jump back to footnote 2 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '</ol>\n'
+            '</div>'
+        )
