--- /dev/null
+++ b/openlibrary/catalog/add_book/tests/test_process_cover_url.py
@@ -0,0 +1,66 @@
+import pytest
+
+from openlibrary.catalog.add_book import ALLOWED_COVER_HOSTS, process_cover_url
+
+
+def test_missing_cover_returns_none_and_leaves_edition_unchanged():
+    edition = {"title": "A Book"}
+    cover_url, updated = process_cover_url(dict(edition))
+    assert cover_url is None
+    assert "cover" not in updated
+    assert updated == edition
+
+
+def test_valid_cover_url_is_extracted_and_key_removed():
+    edition = {"cover": "https://covers.openlibrary.org/b/id/123-M.jpg"}
+    cover_url, updated = process_cover_url(dict(edition))
+    assert cover_url == "https://covers.openlibrary.org/b/id/123-M.jpg"
+    assert "cover" not in updated
+
+
+def test_unsupported_host_is_ignored_and_key_removed():
+    edition = {"cover": "https://example.com/image.jpg"}
+    cover_url, updated = process_cover_url(dict(edition))
+    assert cover_url is None
+    assert "cover" not in updated
+
+
+def test_host_comparison_is_case_insensitive():
+    edition = {"cover": "http://COVERS.OPENLIBRARY.ORG/b/id/1-M.jpg"}
+    cover_url, updated = process_cover_url(dict(edition))
+    assert cover_url == "http://COVERS.OPENLIBRARY.ORG/b/id/1-M.jpg"
+    assert "cover" not in updated
+
+
+def test_http_and_https_are_supported():
+    for scheme in ("http", "https"):
+        edition = {"cover": f"{scheme}://covers.openlibrary.org/b/id/1-M.jpg"}
+        cover_url, updated = process_cover_url(dict(edition))
+        assert cover_url == edition["cover"]
+        assert "cover" not in updated
+
+
+def test_non_http_scheme_is_ignored():
+    edition = {"cover": "ftp://covers.openlibrary.org/b/id/1-M.jpg"}
+    cover_url, updated = process_cover_url(dict(edition))
+    assert cover_url is None
+    assert "cover" not in updated
+
+
+def test_custom_allowed_hosts():
+    edition = {"cover": "https://archive.org/image.jpg"}
+    cover_url, updated = process_cover_url(dict(edition), ["archive.org"])
+    assert cover_url == "https://archive.org/image.jpg"
+    assert "cover" not in updated
+
+
+def test_allowed_cover_hosts_constant_is_defined():
+    assert isinstance(ALLOWED_COVER_HOSTS, list)
+    assert "covers.openlibrary.org" in ALLOWED_COVER_HOSTS
+
+
+def test_empty_cover_value_returns_none_and_removes_key():
+    edition = {"cover": ""}
+    cover_url, updated = process_cover_url(dict(edition))
+    assert cover_url is None
+    assert "cover" not in updated
