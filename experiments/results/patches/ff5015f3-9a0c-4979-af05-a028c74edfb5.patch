+def process_cover_url(
+    edition: dict, allowed_cover_hosts: Iterable[str] = ALLOWED_COVER_HOSTS
+) -> tuple[str | None, dict]:
+    """
+    Validates and extracts the ``cover`` URL from an edition dictionary.
+
+    The ``cover`` key is removed from ``edition`` regardless of whether the URL
+    is valid. The URL is only returned when its host matches an entry in
+    ``allowed_cover_hosts`` (case-insensitive) and it uses the http or https
+    scheme; otherwise ``None`` is returned.
+
+    :param dict edition: The edition dictionary which may contain a ``cover``
+        key with a URL as its value.
+    :param Iterable[str] allowed_cover_hosts: The collection of hostnames that
+        are considered valid for cover URLs.
+    :rtype: tuple[str | None, dict]
+    :return: A tuple where the first element is the cover URL if it is valid,
+        otherwise ``None``. The second element is the updated edition dictionary
+        with the ``cover`` key removed (if it was present).
+    """
+    cover_url = edition.pop('cover', None)
+    if not cover_url:
+        return None, edition
+
+    parsed = urlparse(cover_url)
+    if parsed.scheme in ('http', 'https') and parsed.hostname and any(
+        parsed.hostname.lower() == host.lower() for host in allowed_cover_hosts
+    ):
+        return cover_url, edition
+    return None, edition
+
+
