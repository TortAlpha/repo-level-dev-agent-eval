+def subfactorial(n):
+    """Return the number of derangements of *n* distinct items (OEIS A000166).
+
+    The value is also called the subfactorial of *n*.
+
+        >>> subfactorial(4)
+        9
+
+    The sequence satisfies the recurrence ``D(n) = n * D(n - 1) + (-1) ** n`` with
+    ``D(0) = 1``.
+
+    Non-integer input raises ``TypeError`` and negative values raise
+    ``ValueError``.
+    """
+    if not isinstance(n, Integral):
+        raise TypeError('n must be an integer')
+    if n < 0:
+        raise ValueError('n must be >= 0')
+    result = 1
+    for k in range(1, n + 1):
+        result = k * result + (-1) ** k
+    return result
+
