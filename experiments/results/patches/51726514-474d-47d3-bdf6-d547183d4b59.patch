+def _running_extreme(iterator, *, maxlen, extreme_compare):
+    if maxlen is None:
+        extreme_value = None
+        has_extreme = False
+        for value in iterator:
+            if not has_extreme or extreme_compare(value, extreme_value):
+                extreme_value = value
+                has_extreme = True
+            yield extreme_value
+        return
+
+    maxlen = index(maxlen)
+    if maxlen <= 0:
+        raise ValueError('Window size should be positive')
+
+    window = deque()
+    candidates = deque()
+
+    for value in iterator:
+        window.append(value)
+        while candidates and extreme_compare(value, candidates[-1]):
+            candidates.pop()
+        candidates.append(value)
+
+        if len(window) > maxlen:
+            expired = window.popleft()
+            if candidates and candidates[0] == expired:
+                candidates.popleft()
+
+        yield candidates[0]
+
