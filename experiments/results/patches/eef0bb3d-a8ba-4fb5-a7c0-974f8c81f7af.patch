+class RunningMinMaxTests(TestCase):
+    def test_running_min_and_max_cumulative(self):
+        values = [8.5, 9.5, 7.5, 6.5]
+        self.assertEqual(list(mi.running_min(values)), [8.5, 8.5, 7.5, 6.5])
+        self.assertEqual(list(mi.running_max(values)), [8.5, 9.5, 9.5, 9.5])
+
+    def test_running_with_fraction(self):
+        values = [Fraction(5, 2), Fraction(3, 2), Fraction(7, 2)]
+        self.assertEqual(
+            list(mi.running_min(values)),
+            [Fraction(5, 2), Fraction(3, 2), Fraction(3, 2)],
+        )
+        self.assertEqual(
+            list(mi.running_max(values)),
+            [Fraction(5, 2), Fraction(5, 2), Fraction(7, 2)],
+        )
+
+    def test_running_windowed(self):
+        window_data = [4, 2, 5, 1]
+        self.assertEqual(
+            list(mi.running_min(window_data, maxlen=2)), [4, 2, 2, 1]
+        )
+        self.assertEqual(
+            list(mi.running_max(window_data, maxlen=2)), [4, 4, 5, 5]
+        )
+
+    def test_running_maxlen_requires_positive(self):
+        with self.assertRaises(ValueError):
+            list(mi.running_min([1, 2, 3], maxlen=0))
+        with self.assertRaises(ValueError):
+            list(mi.running_max([1, 2, 3], maxlen=-1))
+
+    def test_running_window_longer_than_iterable(self):
+        data = [3, 1, 2]
+        self.assertEqual(
+            list(mi.running_min(data, maxlen=10)), [3, 1, 1]
+        )
+        self.assertEqual(
+            list(mi.running_max(data, maxlen=10)), [3, 3, 3]
+        )
+
