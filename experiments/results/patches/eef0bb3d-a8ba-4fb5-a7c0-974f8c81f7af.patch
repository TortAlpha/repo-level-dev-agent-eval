+def running_min(iterable, *, maxlen=None):
+    """Yield the running minimum (or sliding window minimum) of *iterable*."""
+    if maxlen is None:
+        iterator = iter(iterable)
+        try:
+            current_min = next(iterator)
+        except StopIteration:
+            return
+        yield current_min
+        for value in iterator:
+            if value < current_min:
+                current_min = value
+            yield current_min
+        return
+
+    if maxlen <= 0:
+        raise ValueError('maxlen must be greater than zero')
+
+    candidates = deque()
+    for index, value in enumerate(iterable):
+        while candidates and candidates[-1][0] > value:
+            candidates.pop()
+        candidates.append((value, index))
+        cutoff = index - maxlen + 1
+        if cutoff > 0:
+            while candidates and candidates[0][1] < cutoff:
+                candidates.popleft()
+        yield candidates[0][0]
+
+
+def running_max(iterable, *, maxlen=None):
+    """Yield the running maximum (or sliding window maximum) of *iterable*."""
+    if maxlen is None:
+        iterator = iter(iterable)
+        try:
+            current_max = next(iterator)
+        except StopIteration:
+            return
+        yield current_max
+        for value in iterator:
+            if current_max < value:
+                current_max = value
+            yield current_max
+        return
+
+    if maxlen <= 0:
+        raise ValueError('maxlen must be greater than zero')
+
+    candidates = deque()
+    for index, value in enumerate(iterable):
+        while candidates and candidates[-1][0] < value:
+            candidates.pop()
+        candidates.append((value, index))
+        cutoff = index - maxlen + 1
+        if cutoff > 0:
+            while candidates and candidates[0][1] < cutoff:
+                candidates.popleft()
+        yield candidates[0][0]
+
+
