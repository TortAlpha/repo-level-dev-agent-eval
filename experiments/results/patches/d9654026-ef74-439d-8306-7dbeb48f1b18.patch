diff --git a/tests/dialects/test_groupconcat_param.py b/tests/dialects/test_groupconcat_param.py
new file mode 100644
index 00000000..0f0d8999
--- /dev/null
+++ b/tests/dialects/test_groupconcat_param.py
@@ -0,0 +1,18 @@
+import sqlglot
+from sqlglot import exp
+
+
+def test_clickhouse_parametric_group_concat():
+    sql = "SELECT groupConcat(', ')(part_name) FROM system.parts"
+    parsed = sqlglot.parse_one(sql, read="clickhouse")
+
+    gc = parsed.find(exp.GroupConcat)
+    assert gc is not None, "expected a GroupConcat expression"
+    assert gc.this is not None, "GroupConcat.this is None"
+    assert gc.this.name == "part_name", f"this.name={gc.this.name!r}"
+    sep = gc.args.get("separator")
+    assert sep is not None, "separator arg is None"
+    assert sep.name == ", ", f"separator.name={sep.name!r}"
+
+    out = parsed.sql(dialect="clickhouse")
+    assert out == sql, f"round-trip failed: {out!r} != {sql!r}"
