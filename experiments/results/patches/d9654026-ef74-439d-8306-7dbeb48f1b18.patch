+    def _parse_group_concat(self) -> exp.GroupConcat:
+        # Parse groupConcat(separator)(column)
+        # The opening '(' has already been consumed by _parse_function_call
+        # Parse the separator expression directly
+        separator = self._parse_expression()
+        # Consume the closing ')'
+        self._match_r_paren()
+        # Then parse the column argument in the second ()
+        params = self._parse_func_params()
+        if params:
+            return self.expression(exp.GroupConcat, this=params[0], separator=separator)
+        # Fallback if no params (shouldn't happen with valid syntax)
+        return self.expression(exp.GroupConcat, this=separator)
+
