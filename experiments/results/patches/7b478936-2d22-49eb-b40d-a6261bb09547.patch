+Stats = namedtuple(
+    'Stats',
+    ('size', 'minimum', 'median', 'maximum', 'mean'),
+)
+
+
+def running_statistics(iterable, *, maxlen=None):
+    """Yield running statistics over an iterable.
+
+    After each element of *iterable* is consumed, yield a :class:`Stats`
+    namedtuple summarizing the values seen so far:
+
+        ``Stats(size, minimum, median, maximum, mean)``
+
+    *size* is the number of values in the current window, *minimum* and
+    *maximum* are the smallest and largest values, *mean* is the arithmetic
+    mean, and *median* is the median (the average of the two middle values
+    when the window size is even).
+
+    If *maxlen* is a positive integer, every statistic is computed over a
+    sliding window of at most the last *maxlen* elements instead of over all
+    values seen so far.
+
+        >>> it = running_statistics(iter([4, 3, 7]))
+        >>> next(it)
+        Stats(size=1, minimum=4, median=4, maximum=4, mean=4.0)
+        >>> next(it)
+        Stats(size=2, minimum=3, median=3.5, maximum=4, mean=3.5)
+        >>> next(it)
+        Stats(size=3, minimum=3, median=4, maximum=7, mean=4.666666666666667)
+
+    """
+    if maxlen is not None and maxlen < 0:
+        raise ValueError('maxlen must be non-negative')
+
+    window = deque(maxlen=maxlen)
+    sorted_window = []
+    total = 0.0
+
+    for value in iterable:
+        if window and window.maxlen is not None and len(window) == window.maxlen:
+            old = window[0]
+            total -= old
+            sorted_window.remove(old)
+
+        window.append(value)
+        bisect.insort(sorted_window, value)
+        total += value
+
+        size = len(sorted_window)
+        minimum = sorted_window[0]
+        maximum = sorted_window[-1]
+        mean = total / size
+        middle = size // 2
+        if size % 2:
+            median = sorted_window[middle]
+        else:
+            median = (sorted_window[middle - 1] + sorted_window[middle]) / 2
+
+        yield Stats(size, minimum, median, maximum, mean)
