@@ -0,0 +1,33 @@
+import pytest
+from w3lib.url import urlsplit, canonicalize_url
+
+@pytest.mark.parametrize(
+    "url, expected_parts",
+    [
+        (
+            "http://[2001:db8::1]/path?param=value#frag",
+            ("http", "[2001:db8::1]", "/path", "param=value", "frag"),
+        ),
+        (
+            "http://[2001:db8::1]:8080/path/to/resource?foo=bar&baz=qux#section",
+            ("http", "[2001:db8::1]:8080", "/path/to/resource", "foo=bar&baz=qux", "section"),
+        ),
+    ],
+)
+def test_ipv6_query_and_fragment_urlsplit(url, expected_parts):
+    scheme, netloc, path, query, fragment = expected_parts
+    split = urlsplit(url)
+    assert split.scheme == scheme
+    assert split.netloc == netloc
+    assert split.path == path
+    assert split.query == query
+    assert split.fragment == fragment
+
+
+def test_ipv6_fragment_removed_by_canonicalize_url():
+    url = "http://[2001:db8::1]/path?param=value#frag"
+    canonical = canonicalize_url(url)
+    # Fragment should be removed, not folded into the query
+    assert "#" not in canonical
+    assert canonical.endswith("?param=value")
+    assert canonical == "http://[2001:db8::1]/path?param=value"
