diff --git a/repro_footnotes.py b/repro_footnotes.py
new file mode 100644
index 0000000..6aa4684
--- /dev/null
+++ b/repro_footnotes.py
@@ -0,0 +1,10 @@
+import markdown
+
+text = """
+First reference[^first] appears before last reference[^last].
+
+[^last]: The last footnote text.
+[^first]: The first footnote text.
+"""
+
+print(markdown.markdown(text, extensions=['markdown.extensions.footnotes']))
