@@ -0,0 +1,57 @@
+import io
+
+from dotenv.parser import Binding, Original, parse_stream
+
+
+def test_parse_stream_strips_leading_utf8_bom():
+    content = "\ufeffFIRST=value1\nSECOND=value2\n"
+    result = list(parse_stream(io.StringIO(content)))
+
+    assert result == [
+        Binding(
+            key="FIRST",
+            value="value1",
+            original=Original(string="FIRST=value1\n", line=1),
+            error=False,
+        ),
+        Binding(
+            key="SECOND",
+            value="value2",
+            original=Original(string="SECOND=value2\n", line=2),
+            error=False,
+        ),
+    ]
+
+
+def test_parse_stream_without_bom_unchanged():
+    content = "FIRST=value1\nSECOND=value2\n"
+    result = list(parse_stream(io.StringIO(content)))
+
+    assert result == [
+        Binding(
+            key="FIRST",
+            value="value1",
+            original=Original(string="FIRST=value1\n", line=1),
+            error=False,
+        ),
+        Binding(
+            key="SECOND",
+            value="value2",
+            original=Original(string="SECOND=value2\n", line=2),
+            error=False,
+        ),
+    ]
+
+
+def test_parse_stream_bom_only_in_value_preserved():
+    content = "FIRST=\ufeffvalue1\n"
+    result = list(parse_stream(io.StringIO(content)))
+
+    assert result == [
+        Binding(
+            key="FIRST",
+            value="\ufeffvalue1",
+            original=Original(string="FIRST=\ufeffvalue1\n", line=1),
+            error=False,
+        ),
+    ]
