index 0000000000000000000000000000000000000000..cf4476518d8552417d5b18b4295c7f5fa95006fb
--- /dev/null
+++ b/tests/test_tick_numeric_delta.py
@@ -0,0 +1,50 @@
+import datetime
+import fractions
+
+from freezegun import freeze_time
+
+
+def test_frozen_datetime_factory_tick_numeric_deltas() -> None:
+    with freeze_time("2012-01-14 23:59:59") as ft:
+        # int delta advances by whole seconds
+        assert ft.tick(1) == datetime.datetime(2012, 1, 15, 0, 0, 0)
+        assert ft.tick(60) == datetime.datetime(2012, 1, 15, 0, 1, 0)
+
+        # float delta advances by fractional seconds
+        assert ft.tick(1.5) == datetime.datetime(2012, 1, 15, 0, 1, 1, 500000)
+
+        # fractions.Fraction delta is converted to seconds correctly
+        assert ft.tick(fractions.Fraction(120, 2)) == datetime.datetime(
+            2012, 1, 15, 0, 2, 1, 500000
+        )
+
+        # timedelta keeps working as before
+        assert ft.tick(datetime.timedelta(seconds=30)) == datetime.datetime(
+            2012, 1, 15, 0, 2, 31, 500000
+        )
+
+
+def test_step_tick_time_factory_tick_numeric_deltas() -> None:
+    with freeze_time("2012-01-14 23:59:59", auto_tick_seconds=60) as ft:
+        # int delta advances by whole seconds
+        assert ft.tick(61) == datetime.datetime(2012, 1, 15, 0, 1, 0)
+
+        # float delta advances by fractional seconds
+        assert ft.tick(1.5) == datetime.datetime(2012, 1, 15, 0, 1, 1, 500000)
+
+        # fractions.Fraction delta is converted to seconds correctly
+        assert ft.tick(fractions.Fraction(90, 2)) == datetime.datetime(
+            2012, 1, 15, 0, 1, 46, 500000
+        )
+
+        # timedelta keeps working as before
+        assert ft.tick(datetime.timedelta(minutes=2)) == datetime.datetime(
+            2012, 1, 15, 0, 3, 46, 500000
+        )
+
+
+def test_step_tick_time_factory_default_step_preserved() -> None:
+    with freeze_time("2012-01-14 23:59:59", auto_tick_seconds=60) as ft:
+        # Calling tick() with no argument uses auto_tick_seconds
+        assert ft.tick() == datetime.datetime(2012, 1, 15, 0, 0, 59)
+        assert ft.tick() == datetime.datetime(2012, 1, 15, 0, 1, 59)
