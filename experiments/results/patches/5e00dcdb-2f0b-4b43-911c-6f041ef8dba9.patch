+from dataclasses import dataclass
+
+from openlibrary.core.vendors import AmazonAPI, clean_amazon_metadata_for_load
+
+
+@dataclass
+class DisplayValue:
+    display_value: str | None
+    type: str | None
+
+
+@dataclass
+class Languages:
+    display_values: list[DisplayValue] | None
+
+
+@dataclass
+class ContentInfo:
+    languages: Languages | None
+    publication_date: object | None = None
+    pages_count: object | None = None
+    edition: object | None = None
+
+
+@dataclass
+class Title:
+    display_value: str | None
+
+
+@dataclass
+class ItemInfo:
+    classifications: object | None
+    content_info: ContentInfo | None
+    by_line_info: object | None
+    title: Title | None
+
+
+@dataclass
+class Images:
+    primary: object | None = None
+
+
+@dataclass
+class AmazonAPIReply:
+    item_info: ItemInfo
+    images: Images
+    offers: object
+    asin: str
+
+
+def _make_product(languages):
+    content_info = ContentInfo(languages=Languages(display_values=languages))
+    item_info = ItemInfo(
+        classifications=None,
+        content_info=content_info,
+        by_line_info=None,
+        title=Title('Test Title'),
+    )
+    return AmazonAPIReply(item_info=item_info, images=Images(), offers=None, asin='059035342X')
+
+
+def test_serialize_includes_languages():
+    product = _make_product([
+        DisplayValue('English', 'Published'),
+        DisplayValue('Spanish', 'Published'),
+    ])
+    result = AmazonAPI.serialize(product)
+    assert result.get('languages') == ['English', 'Spanish']
+
+
+def test_serialize_excludes_original_language():
+    product = _make_product([
+        DisplayValue('English', 'Original Language'),
+        DisplayValue('Spanish', 'Published'),
+    ])
+    result = AmazonAPI.serialize(product)
+    assert result.get('languages') == ['Spanish']
+
+
+def test_serialize_deduplicates_languages():
+    product = _make_product([
+        DisplayValue('English', 'Published'),
+        DisplayValue('English', 'Published'),
+    ])
+    result = AmazonAPI.serialize(product)
+    assert result.get('languages') == ['English']
+
+
+def test_serialize_omits_languages_when_empty():
+    product = _make_product([
+        DisplayValue('English', 'Original Language'),
+    ])
+    result = AmazonAPI.serialize(product)
+    assert 'languages' not in result
+
+
+def test_serialize_omits_languages_when_none():
+    product = _make_product(None)
+    result = AmazonAPI.serialize(product)
+    assert 'languages' not in result
+
+
+def test_clean_amazon_metadata_for_load_preserves_languages():
+    amazon = {
+        'title': 'Test Title',
+        'source_records': ['amazon:059035342X'],
+        'languages': ['English', 'Spanish'],
+    }
+    result = clean_amazon_metadata_for_load(amazon)
+    assert result.get('languages') == ['English', 'Spanish']
