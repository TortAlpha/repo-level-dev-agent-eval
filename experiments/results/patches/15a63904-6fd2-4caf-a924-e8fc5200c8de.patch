@@ -0,0 +1,47 @@
+import pytest
+
+from .._headers import normalize_and_validate
+from .._util import LocalProtocolError, RemoteProtocolError
+
+
+def test_huge_content_length_rejected_in_normalize() -> None:
+    with pytest.raises(LocalProtocolError) as excinfo:
+        normalize_and_validate([("Content-Length", "1" * 100)])
+    assert "Content-Length" in str(excinfo.value)
+
+
+def test_boundary_content_length_accepted() -> None:
+    # 16-digit value should still be accepted
+    assert normalize_and_validate([("Content-Length", "1" * 16)]) == [
+        (b"content-length", b"1" * 16)
+    ]
+
+
+def test_over_boundary_content_length_rejected() -> None:
+    with pytest.raises(LocalProtocolError):
+        normalize_and_validate([("Content-Length", "1" * 17)])
+
+
+def test_normal_content_length_accepted() -> None:
+    assert normalize_and_validate([("Content-Length", "0")]) == [
+        (b"content-length", b"0")
+    ]
+    assert normalize_and_validate([("Content-Length", "10000")]) == [
+        (b"content-length", b"10000")
+    ]
+
+
+def test_huge_content_length_response_rejected() -> None:
+    import h11
+
+    c = h11.Connection(our_role=h11.CLIENT)
+    c.send(h11.Request(method="GET", target="/", headers=[("Host", "example.com")]))
+    # Response with a pathological Content-Length value
+    data = (
+        b"HTTP/1.1 200 OK\r\n"
+        b"Content-Length: " + b"1" * 100 + b"\r\n"
+        b"\r\n"
+    )
+    with pytest.raises(RemoteProtocolError):
+        c.receive_data(data)
+        c.next_event()
