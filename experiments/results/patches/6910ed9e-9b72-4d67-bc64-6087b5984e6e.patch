+++ b/tests/test_bom.py
@@ -0,0 +1,61 @@
+import io
+
+from dotenv.parser import Binding, Original, parse_stream
+
+
+def parse(content):
+    return list(parse_stream(io.StringIO(content)))
+
+
+def test_bom_stripped_from_first_key():
+    bindings = parse("\ufeffFIRST=value1")
+    assert bindings == [
+        Binding(
+            key="FIRST",
+            value="value1",
+            original=Original(string="FIRST=value1", line=1),
+            error=False,
+        ),
+    ]
+
+
+def test_no_bom_unchanged():
+    bindings = parse("FIRST=value1")
+    assert bindings == [
+        Binding(
+            key="FIRST",
+            value="value1",
+            original=Original(string="FIRST=value1", line=1),
+            error=False,
+        ),
+    ]
+
+
+def test_bom_with_multiple_lines():
+    bindings = parse("\ufeffFIRST=value1\nSECOND=value2")
+    assert len(bindings) == 2
+    assert bindings[0].key == "FIRST"
+    assert bindings[0].value == "value1"
+    assert "\ufeff" not in bindings[0].original.string
+    assert bindings[1].key == "SECOND"
+    assert bindings[1].value == "value2"
+
+
+def test_only_leading_bom_stripped():
+    # A BOM elsewhere must be preserved as content.
+    bindings = parse("FIRST=\ufeffvalue1")
+    assert len(bindings) == 1
+    assert bindings[0].key == "FIRST"
+    assert bindings[0].value == "\ufeffvalue1"
+    assert bindings[0].original.string == "FIRST=\ufeffvalue1"
+
+
+def test_empty_bom_only():
+    assert parse("\ufeff") == []
+
+
+def test_bom_first_key_accessible():
+    """The first binding's key must be 'FIRST', not '\ufeffFIRST'."""
+    bindings = parse("\ufeffFIRST=value1")
+    assert bindings[0].key == "FIRST"
+    assert bindings[0].key != "\ufeffFIRST"
