+def test_bytes2human_rollover():
+    assert strutils.bytes2human(0) == '0B'
+    assert strutils.bytes2human(1023) == '1023B'
+    assert strutils.bytes2human(1024) == '1K'
+    assert strutils.bytes2human(2048) == '2K'
+    assert strutils.bytes2human(1024 ** 2) == '1M'
+    assert strutils.bytes2human(1024 ** 3) == '1G'
+    assert strutils.bytes2human(1024, ndigits=2) == '1.00K'
+    assert strutils.bytes2human(1024 ** 2, ndigits=3) == '1.000M'
+
