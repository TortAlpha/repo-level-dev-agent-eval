diff --git a/h11/tests/test_content_length_limit.py b/h11/tests/test_content_length_limit.py
new file mode 100644
index 0000000..03d547c
--- /dev/null
+++ b/h11/tests/test_content_length_limit.py
@@ -0,0 +1,21 @@
+import pytest
+
+from .._headers import normalize_and_validate
+from .._util import LocalProtocolError
+
+
+def test_content_length_too_many_digits() -> None:
+    # A pathological Content-Length with far too many digits must be rejected
+    # as a protocol error rather than being parsed as an int.
+    huge = b"9" * 100
+    with pytest.raises(LocalProtocolError):
+        normalize_and_validate([("Content-Length", huge)])
+
+
+def test_content_length_normal_values_still_work() -> None:
+    assert normalize_and_validate([("Content-Length", "0")]) == [
+        (b"content-length", b"0")
+    ]
+    assert normalize_and_validate([("Content-Length", "12345")]) == [
+        (b"content-length", b"12345")
+    ]
