@@ -0,0 +1,41 @@
+import pytest
+
+from parse import parse
+
+
+def test_precision0_float_no_decimal():
+    # precision 0 float with no decimal point must match and return float
+    r = parse("a {:.0f} b", "a 12 b")
+    assert r is not None
+    assert r[0] == 12.0
+    assert isinstance(r[0], float)
+
+
+def test_precision0_float_decimal_rejected():
+    # decimal form must NOT match precision 0 float
+    assert parse("a {:.0f} b", "a 12.0 b") is None
+
+
+def test_precision0_float_with_width_and_zero():
+    # width and zero-pad with precision 0
+    r = parse("foo_{:02.0f}t", "foo_20t")
+    assert r is not None
+    assert r[0] == 20.0
+    assert isinstance(r[0], float)
+
+
+def test_precision0_float_negative():
+    r = parse("{:.0f}", "-3")
+    assert r is not None
+    assert r[0] == -3.0
+    assert isinstance(r[0], float)
+
+
+def test_existing_float_behaviors_unchanged():
+    r = parse("{:f}", "12.5")
+    assert r is not None
+    assert r[0] == 12.5
+
+    r = parse("{:.2f}", "12.50")
+    assert r is not None
+    assert r[0] == 12.5
