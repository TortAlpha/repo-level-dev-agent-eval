index 0000000000000000000000000000000000000000..26601dc4afbb6fddfc5bb84efac078e02e3e50d7
--- /dev/null
+++ b/tests/test_ticking_numeric_delta.py
@@ -0,0 +1,52 @@
+import datetime
+from fractions import Fraction
+
+import pytest
+
+from freezegun import freeze_time
+
+
+def test_frozen_datetime_factory_tick_accepts_fraction():
+    initial = datetime.datetime(2022, 1, 1, 12, 0, 0)
+    delta = Fraction(3, 2)
+    final = initial + datetime.timedelta(seconds=float(delta))
+    with freeze_time(initial) as factory:
+        returned = factory.tick(delta)
+        assert returned == final
+        # subsequent call returns the same time
+        assert factory() == final
+
+
+def test_step_tick_time_factory_manual_tick_accepts_fraction():
+    initial = datetime.datetime(2022, 1, 1, 12, 0, 0)
+    delta = Fraction(5, 2)
+    final = initial + datetime.timedelta(seconds=float(delta))
+    with freeze_time(initial, auto_tick_seconds=0) as factory:
+        returned = factory.tick(delta)
+        assert returned == final
+        assert factory() == final
+
+
+def test_step_tick_time_factory_auto_tick_accepts_fraction():
+    initial = datetime.datetime(2022, 1, 1, 12, 0, 0)
+    step = Fraction(7, 2)
+    final = initial + datetime.timedelta(seconds=float(step))
+    with freeze_time(initial, auto_tick_seconds=step) as factory:
+        first = factory()
+        assert first == initial
+        second = factory()
+        assert second == final
+
+
+def test_frozen_datetime_factory_tick_invalid_type_raises():
+    initial = datetime.datetime(2022, 1, 1)
+    with freeze_time(initial) as factory:
+        with pytest.raises(TypeError):
+            factory.tick("invalid")
+
+
+def test_step_tick_time_factory_manual_invalid_type_raises():
+    initial = datetime.datetime(2022, 1, 1)
+    with freeze_time(initial, auto_tick_seconds=0) as factory:
+        with pytest.raises(TypeError):
+            factory.tick("invalid")
