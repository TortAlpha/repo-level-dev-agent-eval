diff --git a/tests/test_ticking_factory_numeric_delta.py b/tests/test_ticking_factory_numeric_delta.py
new file mode 100644
index 0000000000000000000000000000000000000000..dadbd73300099174f352ea27f4e3b6ee06996834
--- /dev/null
+++ b/tests/test_ticking_factory_numeric_delta.py
@@ -0,0 +1,23 @@
+import datetime
+from fractions import Fraction
+
+import pytest
+
+from freezegun import freeze_time
+
+
+def test_ticking_datetime_factory_tick_accepts_fraction():
+    initial = datetime.datetime(2022, 1, 1, 12, 0, 0)
+    delta = Fraction(3, 2)
+    final = initial + datetime.timedelta(seconds=float(delta))
+    with freeze_time(initial, tick=True) as factory:
+        returned = factory.tick(delta)
+        assert returned == final
+        assert factory.time_to_freeze == final
+
+
+def test_ticking_datetime_factory_tick_invalid_type_raises():
+    initial = datetime.datetime(2022, 1, 1, 12, 0, 0)
+    with freeze_time(initial, tick=True) as factory:
+        with pytest.raises(TypeError):
+            factory.tick("invalid")
diff --git a/tests/test_ticking_numeric_delta.py b/tests/test_ticking_numeric_delta.py
