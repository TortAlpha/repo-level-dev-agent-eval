index 000000000..76696a708
--- /dev/null
+++ b/openlibrary/catalog/add_book/tests/test_process_cover_url.py
@@ -0,0 +1,78 @@
+import pytest
+
+from openlibrary.catalog.add_book import ALLOWED_COVER_HOSTS, process_cover_url
+
+
+def test_missing_cover_returns_none_and_unchanged():
+    edition = {"title": "A Book"}
+    cover_url, result = process_cover_url(edition)
+    assert cover_url is None
+    assert result == {"title": "A Book"}
+    assert "cover" not in result
+
+
+def test_unsupported_host_returns_none_and_removes_key():
+    edition = {"title": "A Book", "cover": "http://example.com/image.jpg"}
+    cover_url, result = process_cover_url(edition)
+    assert cover_url is None
+    assert "cover" not in result
+    assert result == {"title": "A Book"}
+
+
+def test_supported_host_returns_url_and_removes_key():
+    url = "https://archive.org/image.jpg"
+    edition = {"title": "A Book", "cover": url}
+    cover_url, result = process_cover_url(edition)
+    assert cover_url == url
+    assert "cover" not in result
+    assert result == {"title": "A Book"}
+
+
+def test_supported_host_http():
+    url = "http://covers.openlibrary.org/image.jpg"
+    edition = {"cover": url}
+    cover_url, result = process_cover_url(edition)
+    assert cover_url == url
+    assert "cover" not in result
+
+
+def test_host_comparison_case_insensitive():
+    url = "https://ARCHIVE.ORG/image.jpg"
+    edition = {"cover": url}
+    cover_url, result = process_cover_url(edition)
+    assert cover_url == url
+    assert "cover" not in result
+
+
+def test_allowed_hosts_case_insensitive():
+    url = "https://archive.org/image.jpg"
+    edition = {"cover": url}
+    cover_url, result = process_cover_url(edition, allowed_cover_hosts=["ARCHIVE.ORG"])
+    assert cover_url == url
+    assert "cover" not in result
+
+
+def test_non_http_scheme_ignored():
+    edition = {"cover": "ftp://archive.org/image.jpg"}
+    cover_url, result = process_cover_url(edition)
+    assert cover_url is None
+    assert "cover" not in result
+
+
+def test_malformed_url_returns_none_and_removes_key():
+    edition = {"cover": "not a url"}
+    cover_url, result = process_cover_url(edition)
+    assert cover_url is None
+    assert "cover" not in result
+
+
+def test_default_allowed_hosts_constant():
+    assert "archive.org" in ALLOWED_COVER_HOSTS
+    assert "covers.openlibrary.org" in ALLOWED_COVER_HOSTS
+
+
+def test_ediction_mutated_in_place():
+    edition = {"cover": "http://example.com/image.jpg"}
+    _, result = process_cover_url(edition)
+    assert result is edition
+    assert "cover" not in edition
