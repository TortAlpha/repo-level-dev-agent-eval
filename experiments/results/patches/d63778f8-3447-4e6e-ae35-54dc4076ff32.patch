+def process_cover_url(
+    edition: dict,
+    allowed_cover_hosts: Iterable[str] = ALLOWED_COVER_HOSTS,
+) -> tuple[str | None, dict]:
+    """
+    Validate and extract the ``cover`` URL from an edition dictionary.
+
+    Removes the ``cover`` key from ``edition`` whenever it is present. If the
+    URL's host matches an entry in ``allowed_cover_hosts`` (case-insensitive)
+    and uses the http or https scheme, the URL is returned; otherwise ``None``
+    is returned. The updated edition dictionary is always returned as the
+    second element of the tuple.
+    """
+    if 'cover' not in edition:
+        return None, edition
+    cover_url = edition.pop('cover')
+    allowed = {host.lower() for host in allowed_cover_hosts}
+    try:
+        parsed = urlparse(cover_url)
+        if parsed.scheme in ('http', 'https') and (parsed.hostname or '').lower() in allowed:
+            return cover_url, edition
+    except Exception:
+        pass
+    return None, edition
+
+
