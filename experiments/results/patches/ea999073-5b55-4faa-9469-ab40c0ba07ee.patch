diff --git a/tests/test_missing_doc_ids.py b/tests/test_missing_doc_ids.py
new file mode 100644
index 0000000..ffce15f
--- /dev/null
+++ b/tests/test_missing_doc_ids.py
@@ -0,0 +1,92 @@
+import pytest
+from tinydb import TinyDB, where
+
+
+def test_update_missing_doc_ids_skipped(db: TinyDB):
+    db.drop_tables()
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+
+    # Missing ID after an existing one
+    updated = db.update({'a': 99}, doc_ids=[1, 99])
+    assert updated == [1]
+    assert db.all() == [{'a': 99}, {'a': 2}]
+
+    # Missing ID before an existing one
+    updated = db.update({'a': 100}, doc_ids=[99, 2])
+    assert updated == [2]
+    assert db.all() == [{'a': 99}, {'a': 100}]
+
+
+def test_update_all_missing_doc_ids_returns_empty(db: TinyDB):
+    db.drop_tables()
+    db.insert({'a': 1})
+    updated = db.update({'a': 99}, doc_ids=[10, 20])
+    assert updated == []
+    assert db.all() == [{'a': 1}]
+
+
+def test_update_callable_fields_missing_doc_ids(db: TinyDB):
+    db.drop_tables()
+    db.insert({'a': 1})
+    updated = db.update(lambda d: d.update({'a': d['a'] + 1}), doc_ids=[1, 99])
+    assert updated == [1]
+    assert db.all() == [{'a': 2}]
+
+
+def test_remove_missing_doc_ids_skipped(db: TinyDB):
+    db.drop_tables()
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+
+    removed = db.remove(doc_ids=[1, 99])
+    assert removed == [1]
+    assert db.all() == [{'a': 2}]
+
+    removed = db.remove(doc_ids=[99, 2])
+    assert removed == [2]
+    assert db.all() == []
+
+
+def test_remove_all_missing_doc_ids_returns_empty(db: TinyDB):
+    db.drop_tables()
+    db.insert({'a': 1})
+    removed = db.remove(doc_ids=[10, 20])
+    assert removed == []
+    assert db.all() == [{'a': 1}]
+
+
+def test_update_query_based_unchanged(db: TinyDB):
+    db.drop_tables()
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+    updated = db.update({'a': 99}, where('a') == 1)
+    assert updated == [1]
+    assert db.all() == [{'a': 99}, {'a': 2}]
+
+
+def test_update_whole_table_unchanged(db: TinyDB):
+    db.drop_tables()
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+    updated = db.update({'a': 99})
+    assert sorted(updated) == [1, 2]
+    assert db.all() == [{'a': 99}, {'a': 99}]
+
+
+def test_remove_query_based_unchanged(db: TinyDB):
+    db.drop_tables()
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+    removed = db.remove(where('a') == 1)
+    assert removed == [1]
+    assert db.all() == [{'a': 2}]
+
+
+def test_upsert_missing_doc_id_still_inserts(db: TinyDB):
+    from tinydb.table import Document
+    db.drop_tables()
+    db.insert({'a': 1})
+    result = db.upsert(Document({'a': 2}, 99))
+    assert result == [99]
+    assert db.get(doc_id=99) == {'a': 2}
