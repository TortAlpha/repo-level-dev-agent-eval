+++ b/src/croniter/tests/test_expand_from_start_time_regression.py
@@ -0,0 +1,36 @@
+import datetime
+
+from croniter import croniter
+
+
+def _collect_next_months(start_month, step, num_checks=8):
+    start = datetime.datetime(2024, start_month, 1, 0, 0)
+    itr = croniter("0 0 1 */%d *" % step, start, expand_from_start_time=True)
+    months = []
+    for _ in range(num_checks):
+        nxt = itr.get_next(datetime.datetime)
+        assert 1 <= nxt.month <= 12, "month out of range: %d" % nxt.month
+        months.append(nxt.month)
+    return months
+
+
+def _assert_month_cycle(start_month, step):
+    months = _collect_next_months(start_month, step)
+    expected = ((start_month - 1 + step) % 12) + 1
+    for month in months:
+        assert month == expected, "expected month %d, got %d in %r" % (expected, month, months)
+        expected = ((expected - 1 + step) % 12) + 1
+
+
+def test_expand_from_start_time_month_exact_multiple_june():
+    _assert_month_cycle(6, 3)
+
+
+def test_expand_from_start_time_month_exact_multiples():
+    for month in [3, 6, 9, 12]:
+        _assert_month_cycle(month, 3)
+
+
+def test_expand_from_start_time_month_non_multiple():
+    # May (month=5) is not a multiple of 3; behavior must remain unchanged
+    _assert_month_cycle(5, 3)
