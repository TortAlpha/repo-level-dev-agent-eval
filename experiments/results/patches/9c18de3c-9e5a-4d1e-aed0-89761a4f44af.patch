@@ -0,0 +1,25 @@
+import pytest
+
+from parse import parse
+
+
+def test_precision0_float_without_decimal_point():
+    assert parse("a {:.0f} b", "a 12 b")[0] == 12.0
+
+
+def test_precision0_float_with_padded_width():
+    assert parse("foo_{:02.0f}t", "foo_20t")[0] == 20.0
+
+
+def test_precision0_float_rejects_decimal_point():
+    assert parse("a {:.0f} b", "a 12.0 b") is None
+
+
+def test_normal_float_still_accepts_decimal_point():
+    # Default float format (no explicit precision) still requires a decimal point
+    assert parse("a {:f} b", "a 12.5 b")[0] == 12.5
+    assert parse("a {:f} b", "a 12 b") is None
+
+
+def test_precision0_float_rejects_extra_digits_after_decimal():
+    assert parse("x {:.0f} y", "x 12.3 y") is None
