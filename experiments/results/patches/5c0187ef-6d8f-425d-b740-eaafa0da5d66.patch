@@ -0,0 +1,39 @@
+import unittest
+
+import more_itertools
+from more_itertools import derangements, subfactorial
+
+
+class SubfactorialTests(unittest.TestCase):
+    def test_known_values(self):
+        expected = [1, 0, 1, 2, 9, 44, 265, 1854, 14833, 133496]
+        for n, want in enumerate(expected):
+            self.assertEqual(subfactorial(n), want, msg="n=%d" % n)
+
+    def test_public_api(self):
+        self.assertIs(more_itertools.subfactorial, subfactorial)
+
+    def test_agrees_with_derangements(self):
+        for n in range(8):
+            count = sum(1 for _ in derangements("." * n))
+            self.assertEqual(subfactorial(n), count, msg="n=%d" % n)
+
+    def test_large_value(self):
+        # !20 = 895014631192902121
+        self.assertEqual(subfactorial(20), 895014631192902121)
+
+    def test_float_raises_type_error(self):
+        with self.assertRaises(TypeError):
+            subfactorial(3.0)
+
+    def test_str_raises_type_error(self):
+        with self.assertRaises(TypeError):
+            subfactorial("3")
+
+    def test_negative_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            subfactorial(-1)
+
+
+if __name__ == "__main__":
+    unittest.main()
