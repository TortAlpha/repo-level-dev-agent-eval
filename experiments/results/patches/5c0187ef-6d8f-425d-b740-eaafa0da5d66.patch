+def subfactorial(n):
+    """Return the subfactorial of *n*, the number of derangements of *n* items.
+
+    The subfactorial of a non-negative integer *n* gives the number of
+    permutations of *n* elements that leave no element in its original
+    position (OEIS A000166).
+
+        >>> [subfactorial(n) for n in range(10)]
+        [1, 0, 1, 2, 9, 44, 265, 1854, 14833, 133496]
+
+    Non-integer input raises a :exc:`TypeError`, and negative input raises a
+    :exc:`ValueError`.
+    """
+    if not isinstance(n, int) or isinstance(n, bool):
+        raise TypeError('n must be an integer')
+    if n < 0:
+        raise ValueError('n must be non-negative')
+    if n == 0:
+        return 1
+    a, b = 1, 0  # subfactorial(0), subfactorial(1)
+    for k in range(2, n + 1):
+        a, b = b, (k - 1) * (b + a)
+    return b
+
