diff --git a/tests/test_autospec_cachedmethod.py b/tests/test_autospec_cachedmethod.py
new file mode 100644
index 0000000000000000000000000000000000000000..eee404461599cc4d1a07b86d31477eddeef3b037
--- /dev/null
+++ b/tests/test_autospec_cachedmethod.py
@@ -0,0 +1,32 @@
+import warnings
+import unittest.mock
+
+import pytest
+from cachetools import Cache, cachedmethod
+
+
+class C:
+    def __init__(self):
+        self.cache = Cache(maxsize=10)
+        self.calls = 0
+
+    @cachedmethod(lambda self: self.cache)
+    def get(self, key):
+        self.calls += 1
+        return self.calls
+
+
+def test_autospec_no_warnings():
+    with warnings.catch_warnings(record=True) as caught:
+        warnings.simplefilter("always")
+        unittest.mock.create_autospec(C, instance=True)
+    assert caught == [], [str(w.message) for w in caught]
+
+
+def test_normal_cachedmethod_still_works():
+    c = C()
+    assert c.get(1) == 1
+    assert c.get(1) == 1
+    assert c.calls == 1
+    assert c.get(2) == 2
+    assert c.calls == 2
