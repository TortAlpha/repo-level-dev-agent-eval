diff --git a/tests/test_missing_docids.py b/tests/test_missing_docids.py
new file mode 100644
index 0000000..4e8cc01
--- /dev/null
+++ b/tests/test_missing_docids.py
@@ -0,0 +1,85 @@
+import pytest
+
+from tinydb import TinyDB, where
+
+
+@pytest.fixture
+def db(tmp_path):
+    db = TinyDB(tmp_path / 'test.json')
+    db.truncate()
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+    yield db
+    db.close()
+
+
+def test_update_missing_doc_ids_skipped(db):
+    updated = db.update({'a': 99}, doc_ids=[1, 99])
+    assert updated == [1]
+    assert db.get(doc_id=1)['a'] == 99
+    assert db.get(doc_id=2)['a'] == 2
+
+
+def test_update_missing_doc_ids_first(db):
+    updated = db.update({'a': 99}, doc_ids=[99, 1])
+    assert updated == [1]
+    assert db.get(doc_id=1)['a'] == 99
+    assert db.get(doc_id=2)['a'] == 2
+
+
+def test_update_all_missing_doc_ids(db):
+    updated = db.update({'a': 99}, doc_ids=[98, 99])
+    assert updated == []
+    assert db.get(doc_id=1)['a'] == 1
+    assert db.get(doc_id=2)['a'] == 2
+
+
+def test_update_callable_missing_doc_ids_skipped(db):
+    def inc(doc):
+        doc['a'] += 10
+
+    updated = db.update(inc, doc_ids=[1, 99])
+    assert updated == [1]
+    assert db.get(doc_id=1)['a'] == 11
+    assert db.get(doc_id=2)['a'] == 2
+
+
+def test_remove_missing_doc_ids_skipped(db):
+    removed = db.remove(doc_ids=[1, 99])
+    assert removed == [1]
+    assert db.get(doc_id=1) is None
+    assert db.get(doc_id=2)['a'] == 2
+
+
+def test_remove_missing_doc_ids_first(db):
+    removed = db.remove(doc_ids=[99, 1])
+    assert removed == [1]
+    assert db.get(doc_id=1) is None
+    assert db.get(doc_id=2)['a'] == 2
+
+
+def test_remove_all_missing_doc_ids(db):
+    removed = db.remove(doc_ids=[98, 99])
+    assert removed == []
+    assert db.get(doc_id=1)['a'] == 1
+    assert db.get(doc_id=2)['a'] == 2
+
+
+def test_update_query_unchanged(db):
+    updated = db.update({'a': 99}, where('a') == 1)
+    assert updated == [1]
+    assert db.get(doc_id=1)['a'] == 99
+
+
+def test_update_all_unchanged(db):
+    updated = db.update({'a': 99})
+    assert sorted(updated) == [1, 2]
+    assert db.get(doc_id=1)['a'] == 99
+    assert db.get(doc_id=2)['a'] == 99
+
+
+def test_remove_query_unchanged(db):
+    removed = db.remove(where('a') == 1)
+    assert removed == [1]
+    assert db.get(doc_id=1) is None
+    assert db.get(doc_id=2)['a'] == 2
