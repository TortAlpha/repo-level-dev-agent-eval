+++ b/tests/test_syntax/extensions/test_footnotes_reference_order.py
@@ -0,0 +1,32 @@
+from markdown.test_tools import TestCase
+
+
+class TestFootnotesReferenceOrder(TestCase):
+    default_kwargs = {'extensions': ['footnotes']}
+
+    def test_reference_order_definitions_swapped(self):
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                foo[^first] and bar[^second]
+
+                [^second]: Second footnote
+                [^first]: First footnote
+                """
+            ),
+            '<p>foo<sup id="fnref:1"><a class="footnote-ref" href="#fn:1">1</a></sup> and '
+            'bar<sup id="fnref:2"><a class="footnote-ref" href="#fn:2">2</a></sup></p>\n'
+            '<div class="footnote">\n'
+            '<hr />\n'
+            '<ol>\n'
+            '<li id="fn:1">\n'
+            '<p>First footnote&#160;<a class="footnote-backref" href="#fnref:1"'
+            ' title="Jump back to footnote 1 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '<li id="fn:2">\n'
+            '<p>Second footnote&#160;<a class="footnote-backref" href="#fnref:2"'
+            ' title="Jump back to footnote 2 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '</ol>\n'
+            '</div>'
+        )
