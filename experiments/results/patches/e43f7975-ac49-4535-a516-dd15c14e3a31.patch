diff --git a/testing/test_multiple_impl_removal.py b/testing/test_multiple_impl_removal.py
new file mode 100644
index 0000000000000000000000000000000000000000..4640196e1cba902c438614609f0639324eb38b87
--- /dev/null
+++ b/testing/test_multiple_impl_removal.py
@@ -0,0 +1,64 @@
+from pluggy import HookimplMarker, HookspecMarker, PluginManager
+
+hookspec = HookspecMarker("example")
+hookimpl = HookimplMarker("example")
+
+
+def test_remove_plugin_removes_all_impls_same_hook() -> None:
+    class Spec:
+        @hookspec
+        def a_hook(self, arg) -> None:
+            pass
+
+    pm = PluginManager("example")
+    pm.add_hookspecs(Spec)
+
+    class Plugin:
+        @hookimpl
+        def a_hook(self, arg) -> None:
+            return 1
+
+        @hookimpl(specname="a_hook")
+        def another_impl(self, arg) -> None:
+            return 2
+
+    p = Plugin()
+    pm.register(p)
+    callers = pm.hook.a_hook
+    assert len(callers.get_hookimpls()) == 2
+    pm.unregister(p)
+    assert callers.get_hookimpls() == []
+
+
+def test_get_hookcallers_no_duplicates_for_multiple_impls() -> None:
+    class Spec:
+        @hookspec
+        def a_hook(self, arg) -> None:
+            pass
+        @hookspec
+        def b_hook(self, arg) -> None:
+            pass
+
+    pm = PluginManager("example")
+    pm.add_hookspecs(Spec)
+
+    class Plugin:
+        @hookimpl
+        def a_hook(self, arg) -> None:
+            pass
+        @hookimpl(specname="a_hook")
+        def a_hook2(self, arg) -> None:
+            pass
+        @hookimpl
+        def b_hook(self, arg) -> None:
+            pass
+
+    p = Plugin()
+    pm.register(p)
+    callers = pm.get_hookcallers(p)
+    assert callers is not None
+    assert len(callers) == 2
+    assert set(callers) == {pm.hook.a_hook, pm.hook.b_hook}
+
+    pm.unregister(p)
+    assert pm.get_hookcallers(p) is None
