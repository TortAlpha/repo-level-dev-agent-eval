diff --git a/tests/test_strftime.py b/tests/test_strftime.py
new file mode 100644
index 0000000..8f71bb6
--- /dev/null
+++ b/tests/test_strftime.py
@@ -0,0 +1,29 @@
+from datetime import date, datetime, time, timedelta, timezone
+
+import parse
+
+
+def test_strftime_date():
+    result = parse.parse("a {:%Y-%m-%d} b", "a 1997-07-16 b")
+    assert result[0] == date(1997, 7, 16)
+
+
+def test_strftime_date_abbr_month():
+    result = parse.parse("a {:%Y-%b-%d} b", "a 1997-Feb-16 b")
+    assert result[0] == date(1997, 2, 16)
+
+
+def test_strftime_datetime_with_tz():
+    result = parse.parse("{:%Y-%m-%d %H:%M:%S %z}", "1997-07-16 19:20:30 +0100")
+    assert result[0] == datetime(1997, 7, 16, 19, 20, 30, tzinfo=timezone(timedelta(hours=1)))
+
+
+def test_strftime_time_only():
+    result = parse.parse("{:%H:%M:%S}", "19:20:30")
+    assert result[0] == time(19, 20, 30)
+
+
+def test_strftime_mixed_fields():
+    result = parse.parse("{:%Y-%m-%d} and {:d}", "1997-07-16 and 42")
+    assert result[0] == date(1997, 7, 16)
+    assert result[1] == 42
