@@ -271,6 +271,73 @@ def date_convert(
     return d
 
 
+# strftime directive -> regex pattern mapping
+_STRFTIME_DIRECTIVES = {
+    "%Y": r"\d{4}",
+    "%y": r"\d{2}",
+    "%m": r"\d{1,2}",
+    "%d": r"\d{1,2}",
+    "%H": r"\d{1,2}",
+    "%I": r"\d{1,2}",
+    "%M": r"\d{1,2}",
+    "%S": r"\d{1,2}",
+    "%f": r"\d{1,6}",
+    "%b": r"[A-Za-z]{3}",
+    "%B": r"[A-Za-z]+",
+    "%a": r"[A-Za-z]{3}",
+    "%A": r"[A-Za-z]+",
+    "%p": r"[AP]M",
+    "%z": r"[-+]\d{2}:?\d{2}|Z",
+    "%Z": r"[A-Za-z]+",
+    "%j": r"\d{1,3}",
+    "%U": r"\d{1,2}",
+    "%W": r"\d{1,2}",
+    "%w": r"\d",
+    "%e": r"\s\d|\d{1,2}",
+}
+
+# directives that indicate a time component
+_TIME_DIRECTIVES = {"%H", "%I", "%M", "%S", "%f", "%p"}
+# directives that indicate a date component
+_DATE_DIRECTIVES = {"%Y", "%y", "%m", "%d", "%b", "%B", "%a", "%A", "%j", "%U", "%W", "%w", "%e"}
+# directives that indicate a timezone component
+_TZ_DIRECTIVES = {"%z", "%Z"}
+
+
+def _strftime_to_regex(fmt):
+    """Convert a strftime/strptime format string into a regex pattern."""
+    result = []
+    i = 0
+    while i < len(fmt):
+        if fmt[i] == "%" and i + 1 < len(fmt):
+            directive = fmt[i : i + 2]
+            if directive == "%%":
+                result.append(re.escape("%"))
+            elif directive in _STRFTIME_DIRECTIVES:
+                result.append(_STRFTIME_DIRECTIVES[directive])
+            else:
+                result.append(r".+")
+            i += 2
+        else:
+            result.append(re.escape(fmt[i]))
+            i += 1
+    return "".join(result)
+
+
+def strptime_convert(string, match, fmt):
+    """Convert matched text into a date/datetime/time using strptime."""
+    dt = datetime.strptime(string, fmt)
+    directives = set(re.findall(r"%[A-Za-z]", fmt))
+    has_time = bool(directives & _TIME_DIRECTIVES)
+    has_date = bool(directives & _DATE_DIRECTIVES)
+    has_tz = bool(directives & _TZ_DIRECTIVES)
+    if has_date and not has_time:
+        return dt.date()
+    if has_time and not has_date:
+        return dt.time()
+    return dt
+
+
