diff --git a/testing/test_plugin_remove_multi.py b/testing/test_plugin_remove_multi.py
new file mode 100644
index 0000000000000000000000000000000000000000..003c2ab04bdb6b894282fa7fd14f466e7a6b2054
--- /dev/null
+++ b/testing/test_plugin_remove_multi.py
@@ -0,0 +1,33 @@
+import pluggy
+
+
+hookspec = pluggy.HookspecMarker("example")
+hookimpl = pluggy.HookimplMarker("example")
+
+
+def test_remove_plugin_multiple_impls_and_specname() -> None:
+    class Hooks:
+        @hookspec
+        def he_method(self, arg): ...
+
+    class Plugin:
+        @hookimpl
+        def he_method(self, arg):
+            return arg
+
+        @hookimpl(specname="he_method")
+        def other(self, arg):
+            return arg
+
+    pm = pluggy.PluginManager("example")
+    pm.add_hookspecs(Hooks)
+    plugin = Plugin()
+    pm.register(plugin)
+
+    hookcaller = pm.hook.he_method
+    assert len(hookcaller.get_hookimpls()) == 2
+    assert len(pm.get_hookcallers(plugin)) == 1
+
+    pm.unregister(plugin)
+    assert hookcaller.get_hookimpls() == []
+    assert pm.get_hookcallers(plugin) is None
