@@ -0,0 +1,86 @@
+import pytest
+
+from tinydb import TinyDB, where
+from tinydb.storages import MemoryStorage
+from tinydb.table import Document
+
+
+@pytest.fixture
+def db():
+    return TinyDB(storage=MemoryStorage)
+
+
+def test_update_skip_missing_existing_then_missing(db):
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+    updated = db.update({'a': 99}, doc_ids=[1, 99])
+    assert updated == [1]
+    assert db.get(doc_id=1) == {'a': 99}
+    assert db.get(doc_id=2) == {'a': 2}
+
+
+def test_update_skip_missing_missing_first(db):
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+    updated = db.update({'a': 99}, doc_ids=[99, 1])
+    assert updated == [1]
+    assert db.get(doc_id=1) == {'a': 99}
+    assert db.get(doc_id=2) == {'a': 2}
+
+
+def test_update_skip_missing_none_exist(db):
+    db.insert({'a': 1})
+    updated = db.update({'a': 99}, doc_ids=[99, 100])
+    assert updated == []
+    assert db.get(doc_id=1) == {'a': 1}
+
+
+def test_remove_skip_missing_existing_then_missing(db):
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+    removed = db.remove(doc_ids=[1, 99])
+    assert removed == [1]
+    assert db.get(doc_id=1) is None
+    assert db.get(doc_id=2) == {'a': 2}
+
+
+def test_remove_skip_missing_none_exist(db):
+    db.insert({'a': 1})
+    removed = db.remove(doc_ids=[99])
+    assert removed == []
+    assert db.get(doc_id=1) == {'a': 1}
+
+
+def test_update_query_path_unchanged(db):
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+    updated = db.update({'a': 99}, where('a') == 2)
+    assert updated == [2]
+    assert db.get(doc_id=1) == {'a': 1}
+    assert db.get(doc_id=2) == {'a': 99}
+
+
+def test_update_whole_table_path_unchanged(db):
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+    updated = db.update({'a': 99})
+    assert updated == [1, 2]
+    assert db.get(doc_id=1) == {'a': 99}
+    assert db.get(doc_id=2) == {'a': 99}
+
+
+def test_remove_query_path_unchanged(db):
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+    removed = db.remove(where('a') == 2)
+    assert removed == [2]
+    assert db.get(doc_id=1) == {'a': 1}
+    assert db.get(doc_id=2) is None
+
+
+def test_upsert_with_nonexistent_doc_id_inserts(db):
+    db.insert({'a': 1})
+    result = db.upsert(Document({'a': 99}, 77))
+    assert result == [77]
+    assert db.get(doc_id=77) == {'a': 99}
+    assert db.get(doc_id=1) == {'a': 1}
