+#!/usr/bin/env python
+"""Boundary regression tests for naturalsize suffix carry-over."""
+
+from __future__ import annotations
+
+import pytest
+
+import humanize
+
+
+@pytest.mark.parametrize(
+    "test_args, expected",
+    [
+        # Decimal boundaries: values just below 10**6 / 10**9 that round up.
+        ([999950], "1.0 MB"),
+        ([999999999], "1.0 GB"),
+        # Binary boundaries: values just below 1024**2 / 1024**3.
+        ([1024 * 1024 - 1, True], "1.0 MiB"),
+        ([1024**3 - 1, True], "1.0 GiB"),
+        # GNU boundary: just below 1024**2 with gnu=True.
+        ([1024 * 1024 - 1, False, True], "1.0M"),
+        # %.0f boundary carry with gnu.
+        ([1024 * 1024 - 1, False, True, "%.0f"], "1M"),
+        # Negative boundary should carry too.
+        ([-999950], "-1.0 MB"),
+        # Values that do not cross a boundary keep existing behavior.
+        ([999949], "999.9 kB"),
+        ([1023 * 1024, True], "1023.0 KiB"),
+    ],
+)
+def test_naturalsize_boundary(
+    test_args: list[int] | list[int | bool | str], expected: str
+) -> None:
+    assert humanize.naturalsize(*test_args) == expected
+
+
+def test_largest_suffix_no_carry() -> None:
+    # At the largest decimal suffix, even a huge mantissa must not advance.
+    assert humanize.naturalsize(10**34 * 3) == "30000.0 QB"
+    # Binary and gnu use base 1024; mantissa stays large but no further suffix.
+    assert humanize.naturalsize(10**34 * 3, True) == "23665.8 QiB"
+    assert humanize.naturalsize(10**34 * 3, False, True) == "23665.8Q"
