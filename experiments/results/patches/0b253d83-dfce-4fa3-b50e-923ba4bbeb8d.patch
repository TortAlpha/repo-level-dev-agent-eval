+    mantissa = bytes_ / (base**exp)
+
+    # Advance the suffix when the formatted mantissa rounds up to the next
+    # unit (e.g. 999.95 kB -> 1000.0 kB should become 1.0 MB). Values already
+    # at the largest supported suffix keep their existing behavior.
+    if exp < len(suffix) and abs(float(format % mantissa)) >= base:
+        exp += 1
+        mantissa = bytes_ / (base**exp)
+
+    return format % mantissa + space + _(suffix[exp - 1])
