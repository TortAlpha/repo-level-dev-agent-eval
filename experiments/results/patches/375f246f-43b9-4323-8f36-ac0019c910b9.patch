+++ b/src/croniter/tests/test_expand_from_start_time_month_regression.py
@@ -0,0 +1,49 @@
+from datetime import datetime
+
+from croniter import croniter
+
+
+def test_month_exact_multiple_step3_june():
+    # June (6 % 3 == 0) previously caused CroniterBadCronError.
+    c = croniter("0 0 1 */3 *", datetime(2024, 6, 1), expand_from_start_time=True)
+    assert c.get_next(datetime) == datetime(2024, 9, 1)
+    assert c.get_next(datetime) == datetime(2024, 12, 1)
+    assert c.get_next(datetime) == datetime(2025, 3, 1)
+
+
+def test_month_exact_multiple_step3_march():
+    c = croniter("0 0 1 */3 *", datetime(2024, 3, 1), expand_from_start_time=True)
+    assert c.get_next(datetime) == datetime(2024, 6, 1)
+
+
+def test_month_exact_multiple_step3_september():
+    c = croniter("0 0 1 */3 *", datetime(2024, 9, 1), expand_from_start_time=True)
+    assert c.get_next(datetime) == datetime(2024, 12, 1)
+
+
+def test_month_exact_multiple_step3_december():
+    c = croniter("0 0 1 */3 *", datetime(2024, 12, 1), expand_from_start_time=True)
+    assert c.get_next(datetime) == datetime(2025, 3, 1)
+
+
+def test_month_exact_multiple_prev_step3_june():
+    c = croniter("0 0 1 */3 *", datetime(2024, 6, 1), expand_from_start_time=True)
+    assert c.get_prev(datetime) == datetime(2024, 3, 1)
+
+
+def test_month_step2_december():
+    # December (12 % 2 == 0) previously caused CroniterBadCronError for step 2.
+    c = croniter("0 0 1 */2 *", datetime(2024, 12, 1), expand_from_start_time=True)
+    assert c.get_next(datetime) == datetime(2025, 2, 1)
+
+
+def test_month_step4_december():
+    # December (12 % 4 == 0) previously caused CroniterBadCronError for step 4.
+    c = croniter("0 0 1 */4 *", datetime(2024, 12, 1), expand_from_start_time=True)
+    assert c.get_next(datetime) == datetime(2025, 4, 1)
+
+
+def test_month_step6_june():
+    # June (6 % 6 == 0) previously caused CroniterBadCronError for step 6.
+    c = croniter("0 0 1 */6 *", datetime(2024, 6, 1), expand_from_start_time=True)
+    assert c.get_next(datetime) == datetime(2024, 12, 1)
