+# strftime/strptime-style datetime format support
+STRPTIME_DIRECTIVES = {
+    "%%": r"%",
+    "%Y": r"\d{4}",
+    "%y": r"\d{2}",
+    "%m": r"\d{1,2}",
+    "%d": r"\d{1,2}",
+    "%e": r"\s?\d{1,2}",
+    "%H": r"\d{1,2}",
+    "%I": r"\d{1,2}",
+    "%M": r"\d{1,2}",
+    "%S": r"\d{1,2}",
+    "%f": r"\d{1,6}",
+    "%p": r"[AP]M",
+    "%a": r"[A-Za-z]+",
+    "%A": r"[A-Za-z]+",
+    "%b": r"[A-Za-z]+",
+    "%B": r"[A-Za-z]+",
+    "%j": r"\d{1,3}",
+    "%U": r"\d{1,2}",
+    "%W": r"\d{1,2}",
+    "%z": r"(?:[-+]\d{2}:?\d{2}|Z)",
+    "%Z": r"[A-Za-z/_]+",
+}
+
+_STRPTIME_DATE_DIRECTIVES = {
+    "%Y", "%y", "%m", "%d", "%e", "%j", "%U", "%W", "%a", "%A", "%b", "%B",
+}
+_STRPTIME_TIME_DIRECTIVES = {
+    "%H", "%I", "%M", "%S", "%f", "%p", "%z", "%Z",
+}
+
+
+def _is_strptime_format(format):
+    """Return True if the format string contains strftime/strptime directives."""
+    i = 0
+    n = len(format)
+    while i < n:
+        if format[i] == "%" and i + 1 < n:
+            directive = format[i:i + 2]
+            if directive != "%%" and directive in STRPTIME_DIRECTIVES:
+                return True
+            i += 2
+        else:
+            i += 1
+    return False
+
+
+def _strptime_to_regex(format):
+    """Convert a strftime/strptime format string into a regex pattern."""
+    regex = []
+    i = 0
+    n = len(format)
+    while i < n:
+        if format[i] == "%" and i + 1 < n:
+            directive = format[i:i + 2]
+            if directive in STRPTIME_DIRECTIVES:
+                regex.append(STRPTIME_DIRECTIVES[directive])
+                i += 2
+                continue
+        regex.append(re.escape(format[i]))
+        i += 1
+    return "".join(regex)
+
+
+class StrptimeConverter:
+    """Convert matched text into a date/datetime/time using strptime."""
+
+    def __init__(self, format):
+        self.format = format
+        directives = set()
+        i = 0
+        n = len(format)
+        while i < n:
+            if format[i] == "%" and i + 1 < n:
+                directive = format[i:i + 2]
+                if directive != "%%":
+                    directives.add(directive)
+                i += 2
+            else:
+                i += 1
+        self.has_date = bool(directives & _STRPTIME_DATE_DIRECTIVES)
+        self.has_time = bool(directives & _STRPTIME_TIME_DIRECTIVES)
+
+    def __call__(self, string, match):
+        dt = datetime.strptime(string, self.format)
+        if self.has_date and self.has_time:
+            return dt
+        if self.has_date:
+            return dt.date()
+        if self.has_time:
+            return dt.time()
+        return dt
+
