diff --git a/tests/test_strftime.py b/tests/test_strftime.py
new file mode 100644
index 0000000..e0a8c10
--- /dev/null
+++ b/tests/test_strftime.py
@@ -0,0 +1,36 @@
+"""Tests for strftime/strptime-style datetime format support."""
+
+from datetime import date, datetime, time, timedelta, timezone
+
+import parse
+
+
+def test_date_format():
+    r = parse.parse("a {:%Y-%m-%d} b", "a 1997-07-16 b")
+    assert r[0] == date(1997, 7, 16)
+
+
+def test_date_format_with_month_name():
+    r = parse.parse("a {:%Y-%b-%d} b", "a 1997-Feb-16 b")
+    assert r[0] == date(1997, 2, 16)
+
+
+def test_datetime_format_with_tz():
+    r = parse.parse("{:%Y-%m-%dT%H:%M:%S%z}", "2020-01-02T03:04:05+0600")
+    assert r[0] == datetime(2020, 1, 2, 3, 4, 5, tzinfo=timezone(timedelta(hours=6)))
+
+
+def test_time_format():
+    r = parse.parse("{:%H:%M:%S}", "03:04:05")
+    assert r[0] == time(3, 4, 5)
+
+
+def test_named_field():
+    r = parse.parse("a {when:%Y-%m-%d} b", "a 1997-07-16 b")
+    assert r.named["when"] == date(1997, 7, 16)
+
+
+def test_mixed_fields():
+    r = parse.parse("{:%Y-%m-%d} {n}", "1997-07-16 42")
+    assert r[0] == date(1997, 7, 16)
+    assert r["n"] == "42"
