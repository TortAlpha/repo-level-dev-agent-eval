@@ -0,0 +1,15 @@
+from datetime import datetime
+
+import pytest
+from croniter import croniter, CroniterBadCronError
+
+
+def test_expand_from_start_time_month_anchor_multiple_of_step():
+    # June (6) is an exact multiple of 3; should not error and should anchor at 6
+    start = datetime(2024, 6, 1)
+    ci = croniter("0 0 1 */3 *", start, expand_from_start_time=True)
+    # Current should be the start date itself
+    assert ci.get_current(datetime) == start
+    # Subsequent occurrences advance by 3-month increments: 9, 12, then wrap to 3
+    months = [ci.get_next(datetime).month for _ in range(3)]
+    assert months == [9, 12, 3]
