+    def get_locally_reachable_ips(self, ip_path):
+        """Return locally reachable (scope host) IP ranges for IPv4 and IPv6.
+
+        :param ip_path: path to the ``ip`` command.
+        :returns: a dict with ``ipv4`` and ``ipv6`` keys, each a sorted,
+                  de-duplicated list of canonical locally reachable prefixes
+                  and addresses.
+        """
+        reachable = {'ipv4': [], 'ipv6': []}
+        if ip_path is None:
+            return reachable
+
+        commands = {
+            'ipv4': [ip_path, '-4', 'route', 'show', 'table', 'local'],
+            'ipv6': [ip_path, '-6', 'route', 'show', 'table', 'local'],
+        }
+
+        for family, command in commands.items():
+            try:
+                rc, out, err = self.module.run_command(command)
+            except (OSError, IOError) as e:
+                self.module.warn('Unable to read local route table for %s: %s' % (family, to_text(e)))
+                continue
+            if rc != 0:
+                self.module.warn('Unable to read local route table for %s: %s' % (family, to_text(err or 'unknown error')))
+                continue
+
+            entries = set()
+            for line in out.splitlines():
+                line = line.strip()
+                if not line:
+                    continue
+                # Only consider routes that are local to the host (scope host).
+                if 'scope host' not in line and not line.startswith('local '):
+                    continue
+                if 'scope host' not in line:
+                    continue
+                # The destination is the first token after 'local' if present,
+                # otherwise the first token of the route line.
+                tokens = line.split()
+                if tokens and tokens[0] == 'local':
+                    dest = tokens[1] if len(tokens) > 1 else None
+                else:
+                    dest = tokens[0] if tokens else None
+                if not dest:
+                    continue
+                # Normalize to canonical CIDR/IP form.
+                normalized = self._normalize_route_dest(dest, family)
+                if normalized is not None:
+                    entries.add(normalized)
+
+            reachable[family] = sorted(entries)
+
+        return reachable
+
+    @staticmethod
+    def _normalize_route_dest(dest, family):
+        """Normalize a route destination to canonical CIDR or single IP form."""
+        if '/' in dest:
+            network, sep, prefix = dest.partition('/')
+            if not prefix:
+                return None
+            try:
+                prefix_len = int(prefix)
+            except ValueError:
+                return None
+            try:
+                if family == 'ipv4':
+                    packed = socket.inet_pton(socket.AF_INET, LinuxNetwork._strip_ipv4_leading_zeros(network))
+                    canonical = socket.inet_ntop(socket.AF_INET, packed)
+                else:
+                    packed = socket.inet_pton(socket.AF_INET6, network)
+                    canonical = socket.inet_ntop(socket.AF_INET6, packed)
+            except socket.error:
+                return None
+            return '%s/%d' % (canonical, prefix_len)
+        else:
+            try:
+                if family == 'ipv4':
+                    packed = socket.inet_pton(socket.AF_INET, LinuxNetwork._strip_ipv4_leading_zeros(dest))
+                    return socket.inet_ntop(socket.AF_INET, packed)
+                else:
+                    packed = socket.inet_pton(socket.AF_INET6, dest)
+                    return socket.inet_ntop(socket.AF_INET6, packed)
+            except socket.error:
+                return None
+
+    @staticmethod
+    def _strip_ipv4_leading_zeros(addr):
+        """Strip leading zeros from each octet of an IPv4 address string."""
+        parts = addr.split('.')
+        if len(parts) != 4:
+            return addr
+        try:
+            return '.'.join(str(int(p)) for p in parts)
+        except ValueError:
+            return addr
+
