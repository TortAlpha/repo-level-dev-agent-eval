+++ b/test/units/module_utils/facts/test_locally_reachable_ips.py
@@ -0,0 +1,95 @@
+# -*- coding: utf-8 -*-
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+from units.compat.mock import Mock
+
+from ansible.module_utils.facts.network.linux import LinuxNetwork
+
+
+IPV4_LOCAL = """broadcast 127.0.0.0 dev lo proto kernel scope link src 127.0.0.1
+local 127.0.0.0/8 dev lo proto kernel scope host src 127.0.0.1
+local 127.0.0.1 dev lo proto kernel scope host src 127.0.0.1
+local 192.168.0.1 dev eth0 proto kernel scope host src 192.168.0.1
+local 192.168.1.0/24 dev eth0 proto kernel scope host src 192.168.1.1
+broadcast 192.168.0.255 dev eth0 proto kernel scope link src 192.168.0.1
+"""
+
+IPV6_LOCAL = """local ::1 dev lo proto kernel scope host src ::1
+local fe80::/64 dev eth0 proto kernel scope host src fe80::1
+local 2001:db8::1 dev eth0 proto kernel scope host src 2001:db8::1
+"""
+
+
+def _make_network(ipv4_out=IPV4_LOCAL, ipv6_out=IPV6_LOCAL, rc=0, err=''):
+    module = Mock()
+    module.get_bin_path.return_value = '/sbin/ip'
+
+    def run_command(cmd):
+        if '-4' in cmd:
+            return (rc, ipv4_out, err)
+        if '-6' in cmd:
+            return (rc, ipv6_out, err)
+        return (1, '', 'unexpected command')
+
+    module.run_command = Mock(side_effect=run_command)
+    return LinuxNetwork(module, load_on_init=False)
+
+
+def test_get_locally_reachable_ips_structure():
+    net = _make_network()
+    result = net.get_locally_reachable_ips('/sbin/ip')
+    assert isinstance(result, dict)
+    assert set(result.keys()) == {'ipv4', 'ipv6'}
+    assert isinstance(result['ipv4'], list)
+    assert isinstance(result['ipv6'], list)
+
+
+def test_get_locally_reachable_ips_ipv4_contents():
+    net = _make_network()
+    result = net.get_locally_reachable_ips('/sbin/ip')
+    assert '127.0.0.0/8' in result['ipv4']
+    assert '127.0.0.1' in result['ipv4']
+    assert '192.168.0.1' in result['ipv4']
+    assert '192.168.1.0/24' in result['ipv4']
+    # broadcast/scope link routes are not locally reachable (scope host)
+    assert '127.0.0.0' not in result['ipv4']
+    assert '192.168.0.255' not in result['ipv4']
+
+
+def test_get_locally_reachable_ips_ipv6_contents():
+    net = _make_network()
+    result = net.get_locally_reachable_ips('/sbin/ip')
+    assert '::1' in result['ipv6']
+    assert 'fe80::/64' in result['ipv6']
+    assert '2001:db8::1' in result['ipv6']
+
+
+def test_get_locally_reachable_ips_dedup_and_sorted():
+    net = _make_network()
+    result = net.get_locally_reachable_ips('/sbin/ip')
+    assert len(result['ipv4']) == len(set(result['ipv4']))
+    assert result['ipv4'] == sorted(result['ipv4'])
+    assert result['ipv6'] == sorted(result['ipv6'])
+
+
+def test_get_locally_reachable_ips_none_path():
+    net = _make_network()
+    result = net.get_locally_reachable_ips(None)
+    assert result == {'ipv4': [], 'ipv6': []}
+
+
+def test_get_locally_reachable_ips_command_failure():
+    net = _make_network(rc=1, err='nope')
+    result = net.get_locally_reachable_ips('/sbin/ip')
+    assert result == {'ipv4': [], 'ipv6': []}
+    assert net.module.warn.called
+
+
+def test_get_locally_reachable_ips_canonicalization():
+    ipv4 = "local 192.168.000.001 dev eth0 proto kernel scope host src 192.168.0.1\n"
+    ipv6 = "local 2001:0db8:0000:0000:0000:0000:0000:0001 dev eth0 proto kernel scope host src 2001:db8::1\n"
+    net = _make_network(ipv4_out=ipv4, ipv6_out=ipv6)
+    result = net.get_locally_reachable_ips('/sbin/ip')
+    assert '192.168.0.1' in result['ipv4']
+    assert '2001:db8::1' in result['ipv6']
