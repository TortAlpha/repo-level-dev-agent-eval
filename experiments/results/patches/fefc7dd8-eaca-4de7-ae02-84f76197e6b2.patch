+class VersionChange(enum.Enum):
+
+    """Represents the type of version change when comparing two versions."""
+
+    unknown = 0
+    equal = 1
+    downgrade = 2
+    patch = 3
+    minor = 4
+    major = 5
+
+    def matches_filter(self, filterstr: str) -> bool:
+        """Whether this version change matches the given changelog filter.
+
+        The filter is a comma-separated list of version change types, or
+        'major'/'minor'/'patch'/'none'/'all'. 'major' matches major, minor and
+        patch; 'minor' matches minor and patch; 'patch' matches only patch.
+        """
+        if filterstr == 'all':
+            return self not in (VersionChange.equal, VersionChange.unknown)
+        if filterstr == 'none':
+            return False
+        filters = [f.strip() for f in filterstr.split(',')]
+        for filt in filters:
+            if filt == 'major':
+                if self in (VersionChange.major, VersionChange.minor,
+                            VersionChange.patch):
+                    return True
+            elif filt == 'minor':
+                if self in (VersionChange.minor, VersionChange.patch):
+                    return True
+            elif filt == 'patch':
+                if self == VersionChange.patch:
+                    return True
+            elif filt == 'downgrade':
+                if self == VersionChange.downgrade:
+                    return True
+            elif filt == 'equal':
+                if self == VersionChange.equal:
+                    return True
+            elif filt == 'unknown':
+                if self == VersionChange.unknown:
+                    return True
+        return False
+
+
