+"""Tests for --disable-features support in qtargs."""
+
+import pytest
+
+from qutebrowser import qutebrowser
+from qutebrowser.config import qtargs
+from qutebrowser.utils import usertypes
+
+
+class TestDisableFeatures:
+
+    @pytest.fixture
+    def parser(self, mocker):
+        parser = qutebrowser.get_argparser()
+        mocker.patch.object(parser, 'exit', side_effect=Exception)
+        return parser
+
+    @pytest.fixture(autouse=True)
+    def reduce_args(self, monkeypatch, config_stub):
+        monkeypatch.setattr(qtargs.qtutils, 'qVersion', lambda: '5.15.0')
+        config_stub.val.content.headers.referer = 'always'
+        config_stub.val.scrolling.bar = 'never'
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        monkeypatch.setattr(qtargs.utils, 'is_mac', False)
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+
+    def test_prefix_constants(self):
+        assert qtargs.ENABLE_FEATURES_PREFIX == '--enable-features='
+        assert qtargs.DISABLE_FEATURES_PREFIX == '--disable-features='
+
+    @pytest.mark.parametrize('via_commandline', [True, False])
+    def test_disable_features_propagated(self, config_stub, parser,
+                                        via_commandline):
+        stripped = 'disable-features=SomeFeature'
+        full_flag = '--' + stripped
+        config_stub.val.qt.args = ([] if via_commandline else [stripped])
+        parsed = parser.parse_args(['--qt-flag', stripped]
+                                   if via_commandline else [])
+        args = qtargs.qt_args(parsed)
+        assert full_flag in args
+        assert any(a.startswith('--disable-features=') for a in args)
+
+    @pytest.mark.parametrize('via_commandline', [True, False])
+    def test_disable_features_multiple_propagated(self, config_stub, parser,
+                                                 via_commandline):
+        stripped_flags = ['disable-features=Foo', 'disable-features=Bar,Baz']
+        full_flags = ['--' + f for f in stripped_flags]
+        config_stub.val.qt.args = ([] if via_commandline else stripped_flags)
+        parsed = parser.parse_args(['--qt-flag', stripped_flags[0],
+                                    '--qt-flag', stripped_flags[1]]
+                                   if via_commandline else [])
+        args = qtargs.qt_args(parsed)
+        for flag in full_flags:
+            assert flag in args
+
+    @pytest.mark.parametrize('via_commandline', [True, False])
+    def test_enable_and_disable_together(self, config_stub, parser,
+                                         via_commandline):
+        enable_stripped = 'enable-features=CustomFeature'
+        disable_stripped = 'disable-features=BadFeature'
+        enable_full = '--' + enable_stripped
+        disable_full = '--' + disable_stripped
+        config_stub.val.qt.args = (
+            [] if via_commandline else [enable_stripped, disable_stripped])
+        parsed = parser.parse_args(
+            ['--qt-flag', enable_stripped, '--qt-flag', disable_stripped]
+            if via_commandline else [])
+        args = qtargs.qt_args(parsed)
+
+        enable_entries = [a for a in args
+                          if a.startswith('--enable-features=')]
+        disable_entries = [a for a in args
+                           if a.startswith('--disable-features=')]
+        assert len(enable_entries) == 1
+        assert 'CustomFeature' in enable_entries[0]
+        assert disable_full in args
+        assert len(disable_entries) == 1
+
+    @pytest.mark.parametrize('via_commandline', [True, False])
+    def test_disable_features_unmodified(self, config_stub, parser,
+                                         via_commandline):
+        stripped = 'disable-features=Foo,Bar,Baz'
+        full_flag = '--' + stripped
+        config_stub.val.qt.args = ([] if via_commandline else [stripped])
+        parsed = parser.parse_args(['--qt-flag', stripped]
+                                   if via_commandline else [])
+        args = qtargs.qt_args(parsed)
+        assert full_flag in args
+
+    def test_no_disable_features(self, config_stub, parser):
+        parsed = parser.parse_args([])
+        args = qtargs.qt_args(parsed)
+        assert not any(a.startswith('--disable-features=') for a in args)
+
+    @pytest.mark.parametrize('via_commandline', [True, False])
+    def test_enable_merged_disable_separate(self, config_stub, parser,
+                                            via_commandline):
+        enable1_stripped = 'enable-features=FeatureA'
+        enable2_stripped = 'enable-features=FeatureB'
+        disable_stripped = 'disable-features=BadFeature'
+        disable_full = '--' + disable_stripped
+        stripped_flags = [enable1_stripped, enable2_stripped, disable_stripped]
+        config_stub.val.qt.args = ([] if via_commandline else stripped_flags)
+        parsed = parser.parse_args(
+            ['--qt-flag', enable1_stripped,
+             '--qt-flag', enable2_stripped,
+             '--qt-flag', disable_stripped]
+            if via_commandline else [])
+        args = qtargs.qt_args(parsed)
+
+        enable_entries = [a for a in args
+                          if a.startswith('--enable-features=')]
+        disable_entries = [a for a in args
+                           if a.startswith('--disable-features=')]
+        assert len(enable_entries) == 1
+        assert 'FeatureA' in enable_entries[0]
+        assert 'FeatureB' in enable_entries[0]
+        assert disable_full in args
+        assert len(disable_entries) == 1
