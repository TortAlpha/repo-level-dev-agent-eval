+
+"""Tests for the refactored WebEngineVersions version detection methods."""
+
+import pytest
+
+from qutebrowser.utils import version, utils
+
+
+@pytest.mark.parametrize('qt_version, chromium_version', [
+    ('5.12.10', '69.0.3497.128'),
+    ('5.14.2', '77.0.3865.129'),
+    ('5.15.1', '80.0.3987.163'),
+    ('5.15.2', '83.0.4103.122'),
+])
+def test_from_pyqt_importlib(qt_version, chromium_version):
+    expected = version.WebEngineVersions(
+        webengine=utils.parse_version(qt_version),
+        chromium=chromium_version,
+        source='importlib',
+    )
+    assert version.WebEngineVersions.from_pyqt_importlib(qt_version) == expected
+
+
+@pytest.mark.parametrize('qt_version, chromium_version', [
+    ('5.12.10', '69.0.3497.128'),
+    ('5.14.2', '77.0.3865.129'),
+    ('5.15.1', '80.0.3987.163'),
+    ('5.15.2', '83.0.4103.122'),
+])
+def test_from_qt(qt_version, chromium_version):
+    expected = version.WebEngineVersions(
+        webengine=utils.parse_version(qt_version),
+        chromium=chromium_version,
+        source='Qt',
+    )
+    assert version.WebEngineVersions.from_qt(qt_version) == expected
+
+
+def test_from_pyqt_no_source_argument():
+    """Ensure from_pyqt no longer accepts a source argument."""
+    with pytest.raises(TypeError):
+        version.WebEngineVersions.from_pyqt('5.15.2', source='PyQt')  # type: ignore[call-arg]
