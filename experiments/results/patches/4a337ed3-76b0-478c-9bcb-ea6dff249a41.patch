+def _glob_resources(resource_path: Any, subdir: str, ext: str) -> Iterator[str]:
+    """Find resource files under a subdirectory matching an extension.
+
+    Args:
+        resource_path: The base resource path (a pathlib.Path or a
+            zipfile.Path / importlib.resources path).
+        subdir: The subdirectory to search in (e.g. 'html').
+        ext: The file extension to match, including the leading dot (e.g.
+            '.html'). Must not contain wildcards.
+
+    Return:
+        An iterable of POSIX-style relative paths (e.g. 'html/test.html').
+    """
+    assert ext.startswith('.'), ext
+    assert '*' not in ext, ext
+
+    if isinstance(resource_path, pathlib.Path):
+        path = resource_path / subdir
+        for full_path in path.glob(f'*{ext}'):
+            yield full_path.relative_to(resource_path).as_posix()
+    else:
+        directory = resource_path / subdir
+        assert directory.is_dir()
+        for entry in directory.iterdir():
+            if entry.name.endswith(ext):
+                yield posixpath.join(subdir, entry.name)
+
+
