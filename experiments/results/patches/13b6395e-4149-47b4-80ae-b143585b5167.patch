diff --git a/tests/test_missing_doc_ids.py b/tests/test_missing_doc_ids.py
new file mode 100644
index 0000000000000000000000000000000000000000..9c73aece3ded26283456c2bace00ff257882a7e3
--- /dev/null
+++ b/tests/test_missing_doc_ids.py
@@ -0,0 +1,57 @@
+import pytest
+
+from tinydb import TinyDB, where
+
+
+def test_update_missing_ids_skipped(db: TinyDB):
+    # Existing IDs before a missing ID are updated; missing IDs are skipped
+    assert db.update({'int': 99}, doc_ids=[1, 100]) == [1]
+    assert db.get(doc_id=1)['int'] == 99
+
+
+def test_update_missing_ids_after_existing(db: TinyDB):
+    # Existing IDs after a missing ID are still updated
+    assert db.update({'int': 99}, doc_ids=[100, 2]) == [2]
+    assert db.get(doc_id=2)['int'] == 99
+
+
+def test_update_all_missing_ids(db: TinyDB):
+    # When none of the IDs exist, update succeeds and returns an empty list
+    assert db.update({'int': 99}, doc_ids=[100, 101]) == []
+    assert db.count(where('int') == 99) == 0
+
+
+def test_update_missing_ids_not_atomic_regression(db: TinyDB):
+    # Regression for the non-atomic half-update bug: a missing ID must not
+    # leave earlier documents mutated while still raising.
+    db.update({'int': 99}, doc_ids=[1, 100])
+    assert db.get(doc_id=1)['int'] == 99
+    assert db.get(doc_id=2)['int'] == 1
+
+
+def test_remove_missing_ids_skipped(db: TinyDB):
+    # Existing IDs before a missing ID are removed; missing IDs are skipped
+    assert db.remove(doc_ids=[1, 100]) == [1]
+    assert len(db) == 2
+
+
+def test_remove_missing_ids_after_existing(db: TinyDB):
+    # Existing IDs after a missing ID are still removed
+    assert db.remove(doc_ids=[100, 2]) == [2]
+    assert len(db) == 2
+
+
+def test_remove_all_missing_ids(db: TinyDB):
+    # When none of the IDs exist, remove succeeds and returns an empty list
+    assert db.remove(doc_ids=[100, 101]) == []
+    assert len(db) == 3
+
+
+def test_update_query_unchanged(db: TinyDB):
+    # Query-based update behavior must not change
+    assert db.update({'int': 2}, where('char') == 'a') == [1]
+
+
+def test_remove_query_unchanged(db: TinyDB):
+    # Query-based remove behavior must not change
+    assert db.remove(where('char') == 'b') == [2]
