+"""Tests for Function.get_parameters() with typed-literal arguments."""
+import sqlparse
+from sqlparse.sql import Function, TypedLiteral
+
+
+def _get_function(sql):
+    parsed = sqlparse.parse(sql)[0]
+    # find the first Function token
+    for tok in parsed.flatten():
+        if isinstance(tok, Function):
+            return tok
+    for tok in parsed.tokens:
+        if isinstance(tok, Function):
+            return tok
+    raise AssertionError('No Function found in: %r' % sql)
+
+
+def test_single_typed_literal_param():
+    f = _get_function("foo(DATE '2023-11-14')")
+    params = f.get_parameters()
+    assert len(params) == 1
+    assert isinstance(params[0], TypedLiteral)
+
+
+def test_multiple_typed_literal_params():
+    f = _get_function("foo(DATE '2023-11-14', TIMESTAMP '2023-11-15')")
+    params = f.get_parameters()
+    assert len(params) == 2
+    assert isinstance(params[0], TypedLiteral)
+    assert isinstance(params[1], TypedLiteral)
+
+
+def test_mixed_params_typed_literal_and_identifier():
+    f = _get_function("foo(DATE '2023-11-14', bar)")
+    params = f.get_parameters()
+    assert len(params) == 2
+    assert isinstance(params[0], TypedLiteral)
+    assert isinstance(params[1], TypedLiteral) or params[1].get_real_name() == 'bar'
+
+
+def test_ordinary_identifier_still_returned():
+    f = _get_function("foo(bar)")
+    params = f.get_parameters()
+    assert len(params) == 1
+    assert params[0].get_real_name() == 'bar'
+
+
+def test_ordinary_literal_still_returned():
+    f = _get_function("foo(1)")
+    params = f.get_parameters()
+    assert len(params) == 1
+
+
+def test_function_call_param_still_returned():
+    f = _get_function("foo(bar())")
+    params = f.get_parameters()
+    assert len(params) == 1
+    assert isinstance(params[0], Function)
