--- /dev/null
+++ b/tests/test_wait_exponential_jitter.py
@@ -0,0 +1,35 @@
+from datetime import timedelta
+from unittest import mock
+
+import tenacity
+from tenacity import RetryCallState
+
+
+def _make_retry_state(attempt_number: int) -> RetryCallState:
+    state = RetryCallState(None, None, (), {})  # type: ignore[arg-type]
+    state.attempt_number = attempt_number
+    return state
+
+
+@mock.patch("tenacity.wait.random.uniform", return_value=0)
+def test_wait_exponential_jitter_respects_minimum_bound(random_uniform: mock.Mock) -> None:
+    wait = tenacity.wait_exponential_jitter(
+        initial=1, max=10, exp_base=2, jitter=0.5, min=5
+    )
+    assert wait(_make_retry_state(1)) == 5
+    assert wait(_make_retry_state(2)) == 5
+    assert wait(_make_retry_state(5)) == 10
+    assert random_uniform.call_args_list == [mock.call(0, 0.5)] * 3
+
+
+@mock.patch("tenacity.wait.random.uniform", side_effect=[0, 0])
+def test_wait_exponential_jitter_timedelta_parameters(random_uniform: mock.Mock) -> None:
+    wait = tenacity.wait_exponential_jitter(
+        initial=1,
+        max=timedelta(seconds=20),
+        jitter=timedelta(milliseconds=500),
+        min=timedelta(seconds=2),
+    )
+    assert wait(_make_retry_state(1)) == 2
+    assert wait(_make_retry_state(6)) == 20
+    assert random_uniform.call_args_list == [mock.call(0, 0.5)] * 2
