@@ -0,0 +1,22 @@
+import unittest
+import warnings
+from unittest import mock
+
+from cachetools import cachedmethod
+
+
+class CachedMethodClass:
+    def __init__(self):
+        self.cache = {}
+
+    @cachedmethod(lambda self: self.cache)
+    def expensive(self, value):
+        return value
+
+
+class AutoSpecCachedMethodTest(unittest.TestCase):
+    def test_create_autospec_no_warnings_for_cachedmethod(self):
+        with warnings.catch_warnings(record=True) as caught:
+            warnings.simplefilter("always")
+            mock.create_autospec(CachedMethodClass, instance=True)
+        self.assertEqual(len(caught), 0)
