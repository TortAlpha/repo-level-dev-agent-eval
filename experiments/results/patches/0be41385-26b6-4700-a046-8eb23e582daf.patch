+++ b/tests/test_strftime.py
@@ -0,0 +1,23 @@
+import datetime
+
+import parse
+
+
+def test_strftime_date():
+    assert parse.parse("a {:%Y-%m-%d} b", "a 1997-07-16 b")[0] == datetime.date(1997, 7, 16)
+
+
+def test_strftime_month_name():
+    assert parse.parse("a {:%Y-%b-%d} b", "a 1997-Feb-16 b")[0] == datetime.date(1997, 2, 16)
+
+
+def test_strftime_datetime_timezone():
+    result = parse.parse("{:%Y-%m-%d %H:%M:%S %z}", "1997-07-16 14:30:00 +0200")[0]
+    assert isinstance(result, datetime.datetime)
+    assert result == datetime.datetime(1997, 7, 16, 14, 30, 0, tzinfo=datetime.timezone(datetime.timedelta(hours=2)))
+
+
+def test_mixed_with_other_field():
+    result = parse.parse("{num:d}-{:%Y-%m-%d}", "5-1997-07-16")
+    assert result[0] == 5
+    assert result[1] == datetime.date(1997, 7, 16)
