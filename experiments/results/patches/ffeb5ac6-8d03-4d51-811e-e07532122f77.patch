diff --git a/tests/test_window.py b/tests/test_window.py
new file mode 100644
index 0000000..3c19b26
--- /dev/null
+++ b/tests/test_window.py
@@ -0,0 +1,50 @@
+"""Tests for Function.get_window() and OVER clause handling."""
+
+import sqlparse
+from sqlparse.sql import Function, Identifier, Parenthesis
+
+
+def _find_function(token):
+    """Recursively find the first Function token in a token tree."""
+    if isinstance(token, Function):
+        return token
+    if token.is_group:
+        for child in token.tokens:
+            found = _find_function(child)
+            if found is not None:
+                return found
+    return None
+
+
+def _parse_function(sql):
+    parsed = sqlparse.parse(sql)[0]
+    func = _find_function(parsed)
+    assert func is not None, 'No Function found in: %r' % sql
+    return func
+
+
+def test_get_window_without_over():
+    func = _parse_function('foo(5)')
+    assert func.get_window() is None
+    params = func.get_parameters()
+    assert len(params) == 1
+
+
+def test_get_window_named_window():
+    func = _parse_function('foo(5) OVER win1')
+    window = func.get_window()
+    assert window is not None
+    assert isinstance(window, Identifier)
+    assert str(window) == 'win1'
+    params = func.get_parameters()
+    assert len(params) == 1
+
+
+def test_get_window_inline_window():
+    func = _parse_function('foo(5) OVER (PARTITION BY c1)')
+    window = func.get_window()
+    assert window is not None
+    assert isinstance(window, Parenthesis)
+    assert str(window) == '(PARTITION BY c1)'
+    params = func.get_parameters()
+    assert len(params) == 1
