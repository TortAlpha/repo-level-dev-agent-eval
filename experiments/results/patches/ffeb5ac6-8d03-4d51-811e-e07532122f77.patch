+    def get_window(self):
+        """Return the window of the function if it has an OVER clause.
+
+        For a named window (``foo(5) OVER win1``) the window identifier is
+        returned. For an inline window (``foo(5) OVER (PARTITION BY c1)``) the
+        parenthesised window definition is returned. ``None`` is returned when
+        the function has no OVER clause.
+        """
+        _, over = self.token_next_by(i=Over)
+        if over is None:
+            return None
+        idx, _ = over.token_next_by(m=Over.M_OPEN)
+        if idx is None:
+            return None
+        _, window = over.token_next(idx)
+        return window
