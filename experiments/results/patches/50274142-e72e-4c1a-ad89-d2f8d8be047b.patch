diff --git a/tests/test_numeric_delta.py b/tests/test_numeric_delta.py
new file mode 100644
index 0000000000000000000000000000000000000000..94903c9297f4fa72aae37117cf1ba5afa7f817d1
--- /dev/null
+++ b/tests/test_numeric_delta.py
@@ -0,0 +1,58 @@
+import datetime
+from fractions import Fraction
+
+from freezegun import freeze_time
+
+
+def test_frozen_datetime_factory_fraction_delta():
+    with freeze_time("2012-01-14 00:00:00") as ft:
+        result = ft.tick(Fraction(1, 2))
+        assert result == datetime.datetime(2012, 1, 14, 0, 0, 0, 500000)
+        assert ft() == result
+
+
+def test_frozen_datetime_factory_float_delta():
+    with freeze_time("2012-01-14 00:00:00") as ft:
+        result = ft.tick(1.5)
+        assert result == datetime.datetime(2012, 1, 14, 0, 0, 1, 500000)
+        assert ft() == result
+
+
+def test_ticking_datetime_factory_fraction_delta():
+    with freeze_time("2012-01-14 00:00:00", tick=True) as ft:
+        result = ft.tick(Fraction(1, 2))
+        assert result == datetime.datetime(2012, 1, 14, 0, 0, 0, 500000)
+
+
+def test_ticking_datetime_factory_float_delta():
+    with freeze_time("2012-01-14 00:00:00", tick=True) as ft:
+        result = ft.tick(1.5)
+        assert result == datetime.datetime(2012, 1, 14, 0, 0, 1, 500000)
+
+
+def test_step_tick_factory_int_delta():
+    with freeze_time("2012-01-14 00:00:00", auto_tick_seconds=1) as ft:
+        result = ft.tick(2)
+        assert result == datetime.datetime(2012, 1, 14, 0, 0, 2)
+        assert ft() == result
+
+
+def test_step_tick_factory_float_delta():
+    with freeze_time("2012-01-14 00:00:00", auto_tick_seconds=1) as ft:
+        result = ft.tick(1.5)
+        assert result == datetime.datetime(2012, 1, 14, 0, 0, 1, 500000)
+        assert ft() == result
+
+
+def test_step_tick_factory_fraction_delta():
+    with freeze_time("2012-01-14 00:00:00", auto_tick_seconds=1) as ft:
+        result = ft.tick(Fraction(1, 2))
+        assert result == datetime.datetime(2012, 1, 14, 0, 0, 0, 500000)
+        assert ft() == result
+
+
+def test_timedelta_still_works():
+    with freeze_time("2012-01-14 00:00:00") as ft:
+        result = ft.tick(datetime.timedelta(seconds=2))
+        assert result == datetime.datetime(2012, 1, 14, 0, 0, 2)
+        assert ft() == result
