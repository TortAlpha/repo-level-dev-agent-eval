+# -*- coding: utf-8 -*-
+# Copyright (c) 2024 Ansible Project
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import annotations
+
+import pytest
+
+from ansible.module_utils.common.text.formatters import human_to_bytes
+
+
+@pytest.mark.parametrize(
+    'test_input',
+    [
+        '10 BBQ sticks please',
+        '1 EBOOK please',
+        '3 prettybytes',
+        '12,000 MB',
+        u'1\u200b000 MB',  # zero-width space
+        u'8\U00016B5BB',
+        u'\u1B54 MB',  # Balinese digit
+    ]
+)
+def test_human_to_bytes_rejects_malformed_input(test_input):
+    """Malformed inputs must raise ValueError, not silently parse a prefix."""
+    with pytest.raises(ValueError):
+        human_to_bytes(test_input)
+
+
+@pytest.mark.parametrize(
+    'test_input',
+    [
+        '10 BBQ sticks please',
+        '1 EBOOK please',
+        '12,000 MB',
+        u'1\u200b000 MB',  # zero-width space
+    ]
+)
+def test_human_to_bytes_malformed_number_message(test_input):
+    """Malformed numbers should raise a ValueError mentioning interpretation."""
+    with pytest.raises(ValueError, match="can't interpret following string"):
+        human_to_bytes(test_input)
+
+
+@pytest.mark.parametrize(
+    'test_input',
+    [
+        '3 prettybytes',
+    ]
+)
+def test_human_to_bytes_malformed_unit_message(test_input):
+    """Malformed units should raise a ValueError mentioning a valid string."""
+    with pytest.raises(ValueError, match="Value is not a valid string"):
+        human_to_bytes(test_input)
