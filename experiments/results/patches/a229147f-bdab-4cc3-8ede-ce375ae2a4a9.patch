--- /dev/null
+++ b/tests/test_update_remove_missing_doc_ids.py
@@ -0,0 +1,70 @@
+from tinydb import TinyDB
+
+
+def test_update_skip_missing_doc_ids(tmp_path):
+    db = TinyDB(tmp_path / 'db.json')
+    table = db.table('test')
+    id1 = table.insert({'x': 1})
+    id2 = table.insert({'x': 2})
+    missing = id2 + 100
+
+    # missing ID before existing one
+    updated = table.update({'x': 99}, doc_ids=[missing, id1])
+    assert updated == [id1]
+    assert table.get(doc_id=id1)['x'] == 99
+    assert table.get(doc_id=id2)['x'] == 2
+
+    # missing ID after existing one
+    updated = table.update({'x': 100}, doc_ids=[id2, missing])
+    assert updated == [id2]
+    assert table.get(doc_id=id2)['x'] == 100
+
+    # all missing
+    updated = table.update({'x': 777}, doc_ids=[missing, missing + 1])
+    assert updated == []
+
+
+def test_update_empty_doc_ids(tmp_path):
+    db = TinyDB(tmp_path / 'db.json')
+    table = db.table('test')
+    table.insert({'x': 1})
+
+    # empty list should do nothing
+    updated = table.update({'x': 5}, doc_ids=[])
+    assert updated == []
+    # original doc untouched
+    assert table.get(doc_id=1)['x'] == 1
+
+
+def test_remove_skip_missing_doc_ids(tmp_path):
+    db = TinyDB(tmp_path / 'db.json')
+    table = db.table('test')
+    id1 = table.insert({'x': 1})
+    id2 = table.insert({'x': 2})
+    missing = id2 + 100
+
+    # missing first
+    removed = table.remove(doc_ids=[missing, id1])
+    assert removed == [id1]
+    assert table.get(doc_id=id1) is None
+    assert table.get(doc_id=id2) is not None
+
+    # missing last
+    removed = table.remove(doc_ids=[id2, missing])
+    assert removed == [id2]
+    assert table.get(doc_id=id2) is None
+
+    # all missing
+    removed = table.remove(doc_ids=[missing, missing + 1])
+    assert removed == []
+
+
+def test_remove_empty_doc_ids(tmp_path):
+    db = TinyDB(tmp_path / 'db.json')
+    table = db.table('test')
+    table.insert({'x': 1})
+
+    # empty list should do nothing
+    removed = table.remove(doc_ids=[])
+    assert removed == []
+    assert table.get(doc_id=1)['x'] == 1
