diff --git a/tests/dialects/test_doris_date_add.py b/tests/dialects/test_doris_date_add.py
new file mode 100644
index 00000000..cda00e08
--- /dev/null
+++ b/tests/dialects/test_doris_date_add.py
@@ -0,0 +1,52 @@
+from tests.dialects.test_dialect import Validator
+
+
+class TestDorisDateAdd(Validator):
+    dialect = "doris"
+
+    def test_two_arg_date_add_sub(self):
+        # Two-argument DATE_ADD/DATE_SUB/ADDDATE/SUBDATE with a plain integer number of days
+        self.validate_all(
+            "SELECT DATE_ADD(x, INTERVAL 7 DAY)",
+            read={"doris": "SELECT DATE_ADD(x, 7)"},
+        )
+        self.validate_all(
+            "SELECT DATE_SUB(x, INTERVAL 3 DAY)",
+            read={"doris": "SELECT DATE_SUB(x, 3)"},
+        )
+        self.validate_all(
+            "SELECT DATE_ADD(x, INTERVAL 7 DAY)",
+            read={"doris": "SELECT ADDDATE(x, 7)"},
+        )
+        self.validate_all(
+            "SELECT DATE_SUB(x, INTERVAL 3 DAY)",
+            read={"doris": "SELECT SUBDATE(x, 3)"},
+        )
+        # Explicit interval form must round-trip unchanged
+        self.validate_identity("SELECT DATE_ADD(x, INTERVAL '3' DAY)")
+        self.validate_identity("SELECT DATE_SUB(x, INTERVAL '3' DAY)")
+
+
+class TestStarRocksDateAdd(Validator):
+    dialect = "starrocks"
+
+    def test_two_arg_date_add_sub(self):
+        self.validate_all(
+            "SELECT DATE_ADD(x, INTERVAL 7 DAY)",
+            read={"starrocks": "SELECT DATE_ADD(x, 7)"},
+        )
+        self.validate_all(
+            "SELECT DATE_SUB(x, INTERVAL 3 DAY)",
+            read={"starrocks": "SELECT DATE_SUB(x, 3)"},
+        )
+        self.validate_all(
+            "SELECT DATE_ADD(x, INTERVAL 7 DAY)",
+            read={"starrocks": "SELECT ADDDATE(x, 7)"},
+        )
+        self.validate_all(
+            "SELECT DATE_SUB(x, INTERVAL 3 DAY)",
+            read={"starrocks": "SELECT SUBDATE(x, 3)"},
+        )
+        # Explicit interval form must round-trip unchanged
+        self.validate_identity("SELECT DATE_ADD(x, INTERVAL '3' DAY)")
+        self.validate_identity("SELECT DATE_SUB(x, INTERVAL '3' DAY)")
