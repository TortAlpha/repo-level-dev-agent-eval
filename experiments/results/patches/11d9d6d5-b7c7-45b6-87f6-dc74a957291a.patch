 from sqlglot import exp
+from sqlglot.dialects.dialect import build_date_delta_with_interval
 from sqlglot.helper import seq_get
 from sqlglot.parsers.mysql import MySQLParser
 from sqlglot.tokens import TokenType
 
 
+def _build_date_delta(expression_class):
+    interval_builder = build_date_delta_with_interval(expression_class)
+
+    def _builder(args):
+        if len(args) == 2 and not isinstance(args[1], exp.Interval):
+            return expression_class(this=args[0], expression=args[1], unit=exp.var("DAY"))
+        return interval_builder(args)
+
+    return _builder
+
+
