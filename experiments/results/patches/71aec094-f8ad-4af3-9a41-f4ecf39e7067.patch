+++ b/h11/tests/test_content_length_limit.py
@@ -0,0 +1,29 @@
+import pytest
+
+import h11
+from .._headers import normalize_and_validate
+from .._util import LocalProtocolError
+
+
+def test_content_length_digit_limit() -> None:
+    maximum_safe_length = b"9" * 20
+    assert normalize_and_validate([(b"Content-Length", maximum_safe_length)]) == [
+        (b"content-length", maximum_safe_length)
+    ]
+
+    with pytest.raises(LocalProtocolError, match="bad Content-Length"):
+        normalize_and_validate([(b"Content-Length", b"9" * 21)])
+
+
+def test_received_oversized_content_length_is_protocol_error() -> None:
+    client = h11.Connection(h11.CLIENT)
+    client.send(h11.Request(method="GET", target="/", headers=[("Host", "example.com")]))
+    client.send(h11.EndOfMessage())
+
+    client.receive_data(
+        b"HTTP/1.1 200 OK\r\nContent-Length: " + b"9" * 21 + b"\r\n\r\n"
+    )
+
+    with pytest.raises(h11.ProtocolError) as excinfo:
+        client.next_event()
+    assert isinstance(excinfo.value, h11.RemoteProtocolError)
