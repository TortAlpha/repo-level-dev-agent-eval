+    def get_window(self):
+        """Return the window of the function, or ``None`` if none.
+
+        For a named window (``foo(5) OVER win1``) the window
+        identifier is returned. For an inline window
+        (``foo(5) OVER (PARTITION BY c1)``) the parenthesised
+        window definition is returned.
+        """
+        over = self.token_next_by(i=Over)[1]
+        if over is None:
+            return None
+        over_kw_idx = over.token_next_by(m=Over.M_OPEN)[0]
+        return over.token_next(over_kw_idx)[1]
