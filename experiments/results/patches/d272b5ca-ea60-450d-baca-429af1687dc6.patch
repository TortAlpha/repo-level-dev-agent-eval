diff --git a/tests/test_window_functions.py b/tests/test_window_functions.py
new file mode 100644
index 0000000..ca1b2b6
--- /dev/null
+++ b/tests/test_window_functions.py
@@ -0,0 +1,40 @@
+import sqlparse
+from sqlparse.sql import Identifier, Parenthesis
+
+
+def parse_function(sql):
+    stmt = sqlparse.parse(sql)[0]
+    return stmt.tokens[0]
+
+
+def test_get_window_none():
+    f = parse_function('foo(5)')
+    assert f.get_window() is None
+
+
+def test_get_window_named():
+    f = parse_function('foo(5) OVER win1')
+    win = f.get_window()
+    assert isinstance(win, Identifier)
+    assert win.value == 'win1'
+
+
+def test_get_window_inline():
+    f = parse_function('foo(5) OVER (PARTITION BY c1)')
+    win = f.get_window()
+    assert isinstance(win, Parenthesis)
+    assert 'PARTITION BY c1' in win.value
+
+
+def test_parameters_with_over_named():
+    f = parse_function('foo(5) OVER win1')
+    params = f.get_parameters()
+    assert len(params) == 1
+    assert params[0].value == '5'
+
+
+def test_parameters_with_over_inline():
+    f = parse_function('foo(5) OVER (PARTITION BY c1)')
+    params = f.get_parameters()
+    assert len(params) == 1
+    assert params[0].value == '5'
