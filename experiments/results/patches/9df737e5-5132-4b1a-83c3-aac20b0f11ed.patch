diff --git a/tests/test_create_table_case.py b/tests/test_create_table_case.py
new file mode 100644
index 0000000..d3bfbee
--- /dev/null
+++ b/tests/test_create_table_case.py
@@ -0,0 +1,22 @@
+import sqlparse
+from sqlparse import sql
+
+
+def test_create_table_lowercase_grouped_like_uppercase():
+    upper = sqlparse.parse('CREATE TABLE foo (id integer, name text)')[0]
+    lower = sqlparse.parse('create table foo (id integer, name text)')[0]
+    mixed = sqlparse.parse('Create Table foo (id integer, name text)')[0]
+
+    assert len(lower.tokens) == len(upper.tokens)
+    assert len(mixed.tokens) == len(upper.tokens)
+
+    assert isinstance(lower.tokens[-1], sql.Parenthesis)
+    assert isinstance(mixed.tokens[-1], sql.Parenthesis)
+
+    assert str(lower) == 'create table foo (id integer, name text)'
+    assert str(mixed) == 'Create Table foo (id integer, name text)'
+
+
+def test_create_table_lowercase_not_function():
+    p = sqlparse.parse('create table foo (id integer)')[0]
+    assert not any(isinstance(tok, sql.Function) for tok in p.tokens)
