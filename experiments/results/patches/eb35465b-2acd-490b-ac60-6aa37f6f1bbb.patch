--- /dev/null
+++ b/tests/test_fragment_ipv6_regression.py
@@ -0,0 +1,17 @@
+import pytest
+
+from w3lib._url import _urlsplit
+from w3lib.url import canonicalize_url
+
+
+def test_urlsplit_ipv6_query_fragment():
+    result = _urlsplit("http://[::1]/path?query#frag")
+    assert result.path == "/path"
+    assert result.query == "query"
+    assert result.fragment == "frag"
+
+
+def test_canonicalize_url_removes_fragment_with_ipv6_and_query():
+    result = canonicalize_url("http://[::1]/path?query#frag")
+    assert "#frag" not in result
+    assert result.startswith("http://[::1]/path?")
