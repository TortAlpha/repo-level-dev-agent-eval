@@ -0,0 +1,33 @@
+import io
+
+import pytest
+
+from dotenv.parser import parse_stream
+
+
+def test_parse_stream_strips_leading_utf8_bom():
+    # A BOM at the start should be ignored so the first key is parsed correctly.
+    content = "\ufeffFIRST=foo\nSECOND=bar\n"
+    bindings = list(parse_stream(io.StringIO(content)))
+
+    assert len(bindings) == 2
+
+    first = bindings[0]
+    assert first.key == "FIRST"
+    assert first.value == "foo"
+    # The original string for the first binding should not include the BOM
+    assert first.original.string == "FIRST=foo\n"
+
+    second = bindings[1]
+    assert second.key == "SECOND"
+    assert second.value == "bar"
+
+
+def test_parse_stream_preserves_content_without_bom():
+    # Files without a BOM should parse exactly as before
+    content = "FIRST=foo\nSECOND=bar\n"
+    bindings = list(parse_stream(io.StringIO(content)))
+
+    assert len(bindings) == 2
+    assert bindings[0].key == "FIRST"
+    assert bindings[0].original.string == "FIRST=foo\n"
