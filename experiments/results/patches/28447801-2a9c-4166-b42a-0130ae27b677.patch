diff --git a/h11/tests/test_content_length_too_long.py b/h11/tests/test_content_length_too_long.py
new file mode 100644
index 0000000000000000000000000000000000000000..aaa1099b84e2133f44ded9d32a722d4fd839e946
--- /dev/null
+++ b/h11/tests/test_content_length_too_long.py
@@ -0,0 +1,30 @@
+import pytest
+
+from h11._headers import normalize_and_validate, MAX_CONTENT_LENGTH_DIGITS
+from h11._util import LocalProtocolError, RemoteProtocolError
+from h11._connection import Connection
+from h11._state import CLIENT
+
+
+def test_normalize_and_validate_rejects_too_long_content_length():
+    value = b"1" * (MAX_CONTENT_LENGTH_DIGITS + 1)
+    with pytest.raises(LocalProtocolError, match="Content-Length too long"):
+        normalize_and_validate([(b"content-length", value)])
+
+
+def test_normalize_and_validate_accepts_max_digits():
+    value = b"1" * MAX_CONTENT_LENGTH_DIGITS
+    headers = normalize_and_validate([(b"content-length", value)])
+    assert headers == [(b"content-length", value)]
+
+
+def test_receive_data_rejects_too_long_content_length():
+    conn = Connection(our_role=CLIENT)
+    value = b"1" * (MAX_CONTENT_LENGTH_DIGITS + 1)
+    data = (
+        b"HTTP/1.1 200 OK\r\n"
+        b"Content-Length: " + value + b"\r\n"
+        b"\r\n"
+    )
+    with pytest.raises(RemoteProtocolError, match="Content-Length too long"):
+        conn.receive_data(data)
