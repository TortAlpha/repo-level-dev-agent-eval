+#!/usr/bin/env python
+
+"""Regression tests for naturalsize rounding at unit boundaries."""
+
+from __future__ import annotations
+
+import pytest
+
+import humanize
+
+
+@pytest.mark.parametrize(
+    "test_args, expected",
+    [
+        # Decimal: just below a boundary rounds up to the next suffix
+        ([999950], "1.0 MB"),
+        ([999999], "1.0 MB"),
+        ([999999999], "1.0 GB"),
+        # Decimal: not crossing a rounded boundary keeps the suffix
+        ([999949], "999.9 kB"),
+        # Binary: just below a boundary rounds up to the next suffix
+        ([1048575, True], "1.0 MiB"),
+        ([1073741823, True], "1.0 GiB"),
+        # Binary: not crossing a rounded boundary keeps the suffix
+        ([1047576, True], "1023.0 KiB"),
+        # GNU: just below a boundary rounds up to the next suffix
+        ([1048575, False, True], "1.0M"),
+        ([1073741823, False, True], "1.0G"),
+        # GNU: not crossing a rounded boundary keeps the suffix
+        ([1047576, False, True], "1023.0K"),
+        # Largest supported suffix: rounding up must not advance past the end
+        ([10**33 * 0.99995], "999.9 QB"),
+        ([1024**11 * 0.99995, True], "1023.9 QiB"),
+        ([1024**11 * 0.99995, False, True], "1023.9Q"),
+    ],
+)
+def test_naturalsize_boundary(test_args: list, expected: str) -> None:
+    assert humanize.naturalsize(*test_args) == expected
