+Stats = namedtuple('Stats', ['size', 'minimum', 'median', 'maximum', 'mean'])
+
+
+def running_statistics(iterable, *, maxlen=None):
+    """Yield running statistics over an iterable.
+
+    After each element of *iterable* is consumed, yield a :class:`Stats`
+    namedtuple summarizing the values seen so far:
+
+    ``Stats(size, minimum, median, maximum, mean)``
+
+    When *maxlen* is a positive integer, every statistic is computed over a
+    sliding window of at most the last *maxlen* elements.
+
+        >>> it = running_statistics(iter([4, 3, 7]))
+        >>> next(it)
+        Stats(size=1, minimum=4, median=4, maximum=4, mean=4.0)
+        >>> next(it)
+        Stats(size=2, minimum=3, median=3.5, maximum=4, mean=3.5)
+        >>> next(it)
+        Stats(size=3, minimum=3, median=4, maximum=7, mean=4.666666666666667)
+
+    """
+    if maxlen is not None and maxlen < 0:
+        raise ValueError('maxlen must be a non-negative integer')
+
+    window = deque(maxlen=maxlen) if maxlen is not None else deque()
+    sorted_window = []
+
+    for value in iterable:
+        if maxlen is not None and len(window) == maxlen:
+            old = window[0]
+            pos = bisect.bisect_left(sorted_window, old)
+            del sorted_window[pos]
+
+        window.append(value)
+        bisect.insort(sorted_window, value)
+
+        n = len(sorted_window)
+        if n % 2 == 1:
+            median = sorted_window[n // 2]
+        else:
+            median = (sorted_window[n // 2 - 1] + sorted_window[n // 2]) / 2
+
+        mean = sum(sorted_window) / n
+
+        yield Stats(
+            size=n,
+            minimum=sorted_window[0],
+            median=median,
+            maximum=sorted_window[-1],
+            mean=mean,
+        )
