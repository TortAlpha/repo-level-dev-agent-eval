+import pytest
+
+from .._headers import normalize_and_validate
+from .._util import LocalProtocolError
+
+
+def test_content_length_too_large() -> None:
+    # A normal valid Content-Length should still work
+    assert normalize_and_validate([("Content-Length", "123")]) == [
+        (b"content-length", b"123")
+    ]
+
+    # An extremely long Content-Length (e.g., 100 digits) should be rejected promptly
+    long_value = "9" * 100
+    with pytest.raises(LocalProtocolError):
+        normalize_and_validate([("Content-Length", long_value)])
+
+    # Also test with a value that is exactly 20 digits (the boundary) should be accepted
+    boundary_value = "9" * 20
+    assert normalize_and_validate([("Content-Length", boundary_value)]) == [
+        (b"content-length", boundary_value.encode("ascii"))
+    ]
+
+    # And 21 digits should be rejected
+    too_long_value = "9" * 21
+    with pytest.raises(LocalProtocolError):
+        normalize_and_validate([("Content-Length", too_long_value)])
