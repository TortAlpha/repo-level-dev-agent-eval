index 0000000000000000000000000000000000000000..a4f0581fd7341b160cdfd59d092c4aecc39ef00e
--- /dev/null
+++ b/tests/test_wait_exponential_jitter_extra.py
@@ -0,0 +1,40 @@
+import datetime
+from dataclasses import dataclass
+
+import pytest
+
+from tenacity import wait_exponential_jitter
+
+
+@dataclass(frozen=True)
+class DummyRetryState:
+    """Minimal retry state for testing wait strategies."""
+
+    attempt_number: int
+
+
+def test_wait_exponential_jitter_min_bound(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setattr("tenacity.wait.random.uniform", lambda a, b: 0.0)
+
+    wait = wait_exponential_jitter(initial=1, max=10, jitter=1, min=5)
+
+    assert wait(DummyRetryState(attempt_number=1)) == 5.0
+    assert wait(DummyRetryState(attempt_number=2)) == 5.0
+    assert wait(DummyRetryState(attempt_number=10)) == 10.0
+
+
+def test_wait_exponential_jitter_timedelta_parameters(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    monkeypatch.setattr("tenacity.wait.random.uniform", lambda a, b: 0.2)
+
+    wait = wait_exponential_jitter(
+        initial=datetime.timedelta(seconds=0.25),
+        max=datetime.timedelta(seconds=0.9),
+        jitter=datetime.timedelta(seconds=0.5),
+        min=datetime.timedelta(seconds=0.1),
+    )
+
+    assert wait(DummyRetryState(attempt_number=1)) == pytest.approx(0.45)
+    assert wait(DummyRetryState(attempt_number=2)) == pytest.approx(0.7)
+    assert wait(DummyRetryState(attempt_number=3)) == pytest.approx(0.9)
