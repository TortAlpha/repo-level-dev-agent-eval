index 0000000..8c619fb
--- /dev/null
+++ b/tests/test_window_function.py
@@ -0,0 +1,71 @@
+"""Tests for Function.get_window() and get_parameters() with OVER clauses."""
+
+import sqlparse
+import sqlparse.sql as sql
+
+
+def _find_function(token):
+    """Recursively find the first Function token in the parsed statement."""
+    if isinstance(token, sql.Function):
+        return token
+    if isinstance(token, sql.TokenList):
+        for t in token.tokens:
+            found = _find_function(t)
+            if found is not None:
+                return found
+    return None
+
+
+def test_get_window_named():
+    p = sqlparse.parse('foo(5) OVER win1')[0]
+    func = _find_function(p)
+    assert isinstance(func, sql.Function)
+    win = func.get_window()
+    assert win is not None
+    assert isinstance(win, sql.Identifier)
+    assert win.get_name() == 'win1'
+    params = func.get_parameters()
+    assert len(params) == 1
+
+
+def test_get_window_inline():
+    p = sqlparse.parse('foo(5) OVER (PARTITION BY c1)')[0]
+    func = _find_function(p)
+    assert isinstance(func, sql.Function)
+    win = func.get_window()
+    assert win is not None
+    assert isinstance(win, sql.Parenthesis)
+    params = func.get_parameters()
+    assert len(params) == 1
+
+
+def test_get_window_none():
+    p = sqlparse.parse('foo(5)')[0]
+    func = _find_function(p)
+    assert isinstance(func, sql.Function)
+    assert func.get_window() is None
+    params = func.get_parameters()
+    assert len(params) == 1
+
+
+def test_get_window_named_with_alias():
+    p = sqlparse.parse('foo(c1) over win1 as bar')[0]
+    func = _find_function(p)
+    assert isinstance(func, sql.Function)
+    win = func.get_window()
+    assert win is not None
+    assert isinstance(win, sql.Identifier)
+    assert win.get_name() == 'win1'
+    params = func.get_parameters()
+    assert len(params) == 1
+
+
+def test_get_window_inline_with_alias():
+    p = sqlparse.parse('foo(c1) over (partition by c2 order by c3) as bar')[0]
+    func = _find_function(p)
+    assert isinstance(func, sql.Function)
+    win = func.get_window()
+    assert win is not None
+    assert isinstance(win, sql.Parenthesis)
+    params = func.get_parameters()
+    assert len(params) == 1
