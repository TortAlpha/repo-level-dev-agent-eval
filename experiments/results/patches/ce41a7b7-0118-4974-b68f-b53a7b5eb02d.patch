+    def get_window(self):
+        """Return the window specification if present.
+        
+        Returns:
+        - For named windows (e.g., OVER win1): the window identifier
+        - For inline windows (e.g., OVER (PARTITION BY c1)): the parenthesis
+        - None if no OVER clause is present
+        """
+        # Find the Over token in the function
+        over_token = None
+        for token in self.tokens:
+            if isinstance(token, Over):
+                over_token = token
+                break
+        
+        if over_token is None:
+            return None
+        
+        # Extract the window specification from the Over token
+        # Skip the OVER keyword and whitespace, return the first meaningful token
+        for token in over_token.tokens:
+            if token.ttype is T.Keyword:  # Skip OVER keyword
+                continue
+            if token.is_whitespace:  # Skip whitespace
+                continue
+            # Return the first non-keyword, non-whitespace token
+            # This will be either an Identifier/Name (named window) or Parenthesis (inline window)
+            return token
