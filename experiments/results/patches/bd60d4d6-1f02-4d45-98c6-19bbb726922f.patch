+"""Tests for Wikisource-specific find_match behavior.
+
+Verifies that a Wikisource source record does not match an existing edition
+that shares bibliographic details (ocaid/ISBN) but lacks a matching
+identifiers.wikisource value.
+"""
+
+from openlibrary.catalog.add_book import build_pool, find_match
+
+
+def test_find_match_wikisource_skips_quick_match_on_ocaid(mock_site):
+    """A Wikisource record sharing ocaid with an existing edition must not match."""
+    etype = '/type/edition'
+    ekey = mock_site.new_key(etype)
+    existing = {
+        'title': 'A Tale',
+        'type': {'key': etype},
+        'ocaid': 'tale00tale',
+        'isbn_13': ['9780190906764'],
+        'key': ekey,
+    }
+    mock_site.save(existing)
+
+    rec = {
+        'title': 'A Tale',
+        'ocaid': 'tale00tale',
+        'isbn_13': ['9780190906764'],
+        'source_records': ['wikisource:fr99999'],
+    }
+    pool = build_pool(rec)
+    assert pool == {}
+    assert find_match(rec, pool) is None
+
+
+def test_find_match_wikisource_matches_same_identifier(mock_site):
+    """A Wikisource record must match an edition with the same wikisource identifier."""
+    etype = '/type/edition'
+    ekey = mock_site.new_key(etype)
+    existing = {
+        'title': 'A Tale',
+        'type': {'key': etype},
+        'identifiers': {'wikisource': ['fr99999']},
+        'key': ekey,
+    }
+    mock_site.save(existing)
+
+    rec = {
+        'title': 'A Tale',
+        'source_records': ['wikisource:fr99999'],
+    }
+    pool = build_pool(rec)
+    assert pool == {'wikisource': ['/books/OL1M']}
+    assert find_match(rec, pool) == '/books/OL1M'
