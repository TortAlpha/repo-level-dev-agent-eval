+def get_wikisource_id(rec: dict) -> str | None:
+    """
+    Extract the Wikisource identifier from a record's source_records, if present.
+
+    Wikisource source records have the format ``wikisource:<identifier>``.
+
+    :param dict rec: Edition record
+    :return: The Wikisource identifier, or None if no Wikisource source record is present.
+    """
+    for source_record in rec.get('source_records', []):
+        if source_record.startswith('wikisource:'):
+            return source_record[len('wikisource:') :]
+    return None
