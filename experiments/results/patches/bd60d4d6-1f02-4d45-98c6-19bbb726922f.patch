@@ -0,0 +1,79 @@
+"""Tests for Wikisource edition matching behavior."""
+
+from openlibrary.catalog.add_book import build_pool, get_wikisource_id
+
+
+def test_get_wikisource_id_extracts_identifier():
+    rec = {'source_records': ['wikisource:fr12345']}
+    assert get_wikisource_id(rec) == 'fr12345'
+
+
+def test_get_wikisource_id_none_when_absent():
+    rec = {'source_records': ['ia:test_item']}
+    assert get_wikisource_id(rec) is None
+
+
+def test_build_pool_wikisource_no_match_is_empty(mock_site):
+    """A Wikisource record with no matching edition must produce an empty pool."""
+    # Existing edition sharing bibliographic details but without a wikisource identifier.
+    etype = '/type/edition'
+    ekey = mock_site.new_key(etype)
+    existing = {
+        'title': 'A Tale',
+        'type': {'key': etype},
+        'lccn': ['123'],
+        'oclc_numbers': ['456'],
+        'ocaid': 'tale00tale',
+        'isbn_13': ['9780190906764'],
+        'key': ekey,
+    }
+    mock_site.save(existing)
+
+    rec = {
+        'title': 'A Tale',
+        'lccn': ['123'],
+        'oclc_numbers': ['456'],
+        'ocaid': 'tale00tale',
+        'isbn_13': ['9780190906764'],
+        'source_records': ['wikisource:fr99999'],
+    }
+    assert build_pool(rec) == {}
+
+
+def test_build_pool_wikisource_matches_only_same_identifier(mock_site):
+    """A Wikisource record must only match editions with the same wikisource identifier."""
+    etype = '/type/edition'
+    ekey = mock_site.new_key(etype)
+    existing = {
+        'title': 'A Tale',
+        'type': {'key': etype},
+        'identifiers': {'wikisource': ['fr99999']},
+        'key': ekey,
+    }
+    mock_site.save(existing)
+
+    rec = {
+        'title': 'A Tale',
+        'source_records': ['wikisource:fr99999'],
+    }
+    pool = build_pool(rec)
+    assert pool == {'wikisource': ['/books/OL1M']}
+
+
+def test_build_pool_wikisource_does_not_match_other_identifier(mock_site):
+    """A Wikisource record must not match an edition with a different wikisource identifier."""
+    etype = '/type/edition'
+    ekey = mock_site.new_key(etype)
+    existing = {
+        'title': 'A Tale',
+        'type': {'key': etype},
+        'identifiers': {'wikisource': ['fr11111']},
+        'key': ekey,
+    }
+    mock_site.save(existing)
+
+    rec = {
+        'title': 'A Tale',
+        'source_records': ['wikisource:fr99999'],
+    }
+    assert build_pool(rec) == {}
