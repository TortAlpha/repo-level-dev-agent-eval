index 0000000000000000000000000000000000000000..f5bcbddd421a47f277d4f5114b82b1953e73b14d
--- /dev/null
+++ b/h11/tests/test_content_length_limits.py
@@ -0,0 +1,29 @@
+import pytest
+
+import h11
+from h11._connection import CLIENT
+from h11._headers import _MAX_CONTENT_LENGTH_DIGITS, normalize_and_validate
+from h11._util import LocalProtocolError
+
+
+def test_headers_accept_maximum_allowed_content_length_digits():
+    digits = b"7" * _MAX_CONTENT_LENGTH_DIGITS
+    normalize_and_validate([(b"Content-Length", digits)])
+
+
+def test_headers_reject_too_many_content_length_digits():
+    digits = b"7" * (_MAX_CONTENT_LENGTH_DIGITS + 1)
+    with pytest.raises(LocalProtocolError) as excinfo:
+        normalize_and_validate([(b"Content-Length", digits)])
+    assert "bad Content-Length" in str(excinfo.value)
+
+@pytest.mark.parametrize("extra", [1, 5, 50])
+def test_connection_rejects_oversized_content_length_header(extra):
+    conn = h11.Connection(CLIENT)
+    digits = b"8" * (_MAX_CONTENT_LENGTH_DIGITS + extra)
+    crlf = b"\r\n"
+    raw = b"HTTP/1.1 200 OK" + crlf + b"Content-Length: " + digits + crlf + crlf
+    conn.receive_data(raw)
+    with pytest.raises(h11.ProtocolError) as excinfo:
+        conn.next_event()
+    assert "bad Content-Length" in str(excinfo.value)
