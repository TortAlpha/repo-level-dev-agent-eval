+++ b/src/croniter/tests/test_croniter_expand_month.py
@@ -0,0 +1,20 @@
+import unittest
+from datetime import datetime
+
+from croniter import croniter
+
+
+class ExpandFromStartTimeMonthExactMultipleTest(unittest.TestCase):
+    def test_exact_multiple_month_parses_and_advances(self):
+        pattern = "0 0 1 */3 *"
+        for start_month in (3, 6, 9, 12):
+            ret = croniter(
+                pattern,
+                start_time=datetime(2024, start_month, 1),
+                expand_from_start_time=True,
+            ).get_next(datetime)
+            self.assertEqual(ret, datetime(2024 + (start_month + 3 > 12), ((start_month + 3 - 1) % 12) + 1, 1))
+
+
+if __name__ == "__main__":
+    unittest.main()
