diff --git a/tests/test_zip_object_empty.py b/tests/test_zip_object_empty.py
new file mode 100644
index 0000000..d822480
--- /dev/null
+++ b/tests/test_zip_object_empty.py
@@ -0,0 +1,36 @@
+"""Tests for empty-input handling in zip_object and zip_object_deep."""
+import pydash as _
+
+
+def test_zip_object_empty_keys_only():
+    assert _.zip_object([]) == {}
+
+
+def test_zip_object_empty_keys_and_values():
+    assert _.zip_object([], []) == {}
+
+
+def test_zip_object_deep_empty_keys_only():
+    assert _.zip_object_deep([]) == {}
+
+
+def test_zip_object_deep_empty_keys_and_values():
+    assert _.zip_object_deep([], []) == {}
+
+
+def test_zip_object_deep_nonempty_unchanged():
+    expected = {"a": {"b": {"c": 1, "d": 2}}}
+    assert _.zip_object_deep(["a.b.c", "a.b.d"], [1, 2]) == expected
+
+
+def test_zip_object_deep_nonempty_pairs_unchanged():
+    expected = {"a": {"b": {"c": 1, "d": 2}}}
+    assert _.zip_object_deep([["a.b.c", 1], ["a.b.d", 2]]) == expected
+
+
+def test_zip_object_nonempty_unchanged():
+    assert _.zip_object(["moe", "larry"], [30, 40]) == {"moe": 30, "larry": 40}
+
+
+def test_zip_object_nonempty_pairs_unchanged():
+    assert _.zip_object([["moe", 30], ["larry", 40]]) == {"moe": 30, "larry": 40}
