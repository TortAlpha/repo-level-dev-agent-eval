+"""Regression tests for KeyInfo structured key representation."""
+
+import pytest
+
+from qutebrowser.qt.core import Qt
+from qutebrowser.keyinput import keyutils
+
+
+def test_key_info_to_qt():
+    info = keyutils.KeyInfo(Qt.Key.Key_A, Qt.KeyboardModifier.ShiftModifier)
+    qt_value = info.to_qt()
+    if keyutils.QKeyCombination is None:
+        assert qt_value == Qt.Key.Key_A | Qt.KeyboardModifier.ShiftModifier
+    else:
+        assert isinstance(qt_value, keyutils.QKeyCombination)
+        assert qt_value.key() == Qt.Key.Key_A
+        assert qt_value.keyboardModifiers() == Qt.KeyboardModifier.ShiftModifier
+
+
+def test_key_info_to_qt_no_modifiers():
+    info = keyutils.KeyInfo(Qt.Key.Key_A, Qt.KeyboardModifier.NoModifier)
+    qt_value = info.to_qt()
+    if keyutils.QKeyCombination is None:
+        assert qt_value == Qt.Key.Key_A
+    else:
+        assert isinstance(qt_value, keyutils.QKeyCombination)
+        assert qt_value.key() == Qt.Key.Key_A
+        assert qt_value.keyboardModifiers() == Qt.KeyboardModifier.NoModifier
+
+
+@pytest.mark.parametrize('key, modifiers, strip, expected_key, expected_modifiers', [
+    (Qt.Key.Key_A,
+     Qt.KeyboardModifier.ShiftModifier | Qt.KeyboardModifier.ControlModifier,
+     Qt.KeyboardModifier.ShiftModifier,
+     Qt.Key.Key_A, Qt.KeyboardModifier.ControlModifier),
+    (Qt.Key.Key_A, Qt.KeyboardModifier.ShiftModifier,
+     Qt.KeyboardModifier.ControlModifier,
+     Qt.Key.Key_A, Qt.KeyboardModifier.ShiftModifier),
+    (Qt.Key.Key_A, Qt.KeyboardModifier.ShiftModifier,
+     Qt.KeyboardModifier.ShiftModifier,
+     Qt.Key.Key_A, Qt.KeyboardModifier.NoModifier),
+    (Qt.Key.Key_A, Qt.KeyboardModifier.NoModifier,
+     Qt.KeyboardModifier.ShiftModifier,
+     Qt.Key.Key_A, Qt.KeyboardModifier.NoModifier),
+])
+def test_key_info_with_stripped_modifiers(key, modifiers, strip,
+                                          expected_key, expected_modifiers):
+    info = keyutils.KeyInfo(key, modifiers)
+    stripped = info.with_stripped_modifiers(strip)
+    assert stripped.key == expected_key
+    assert stripped.modifiers == expected_modifiers
+    # original is unchanged
+    assert info.modifiers == modifiers
+
+
+def test_key_info_with_stripped_modifiers_all():
+    modifiers = (Qt.KeyboardModifier.ShiftModifier |
+                 Qt.KeyboardModifier.ControlModifier |
+                 Qt.KeyboardModifier.AltModifier)
+    info = keyutils.KeyInfo(Qt.Key.Key_X, modifiers)
+    stripped = info.with_stripped_modifiers(modifiers)
+    assert stripped.key == Qt.Key.Key_X
+    assert stripped.modifiers == Qt.KeyboardModifier.NoModifier
