     from qutebrowser.qt.core import QKeyCombination
 except ImportError:
-    pass  # Qt 6 only
+    QKeyCombination = None  # Qt 5
 
 from qutebrowser.utils import utils
 
@@ -453,6 +453,19 @@ class KeyInfo:
         """Get the key as an integer (with key/modifiers)."""
         return int(self.key) | int(self.modifiers)
 
+    def to_qt(self) -> Union[int, 'QKeyCombination']:
+        """Get something suitable for a QKeySequence.
+
+        Returns an integer for Qt5 or a QKeyCombination for Qt6.
+        """
+        if QKeyCombination is None:
+            return int(self.key) | int(self.modifiers)
+        return QKeyCombination(self.modifiers, self.key)
+
+    def with_stripped_modifiers(self, modifiers: _ModifierType) -> 'KeyInfo':
+        """Create a new KeyInfo with specified modifiers removed."""
+        return KeyInfo(self.key, self.modifiers & ~modifiers)
+
 
