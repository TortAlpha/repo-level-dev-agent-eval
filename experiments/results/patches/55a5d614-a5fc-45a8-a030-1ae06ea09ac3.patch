@@ -0,0 +1,19 @@
+import pytest
+
+from parse import parse
+
+
+def test_precision0_float_no_decimal():
+    assert parse("a {:.0f} b", "a 12 b")[0] == 12.0
+
+
+def test_precision0_float_zero_padded():
+    assert parse("foo_{:02.0f}t", "foo_20t")[0] == 20.0
+
+
+def test_precision0_float_rejects_decimal():
+    assert parse("a {:.0f} b", "a 12.0 b") is None
+
+
+def test_precision0_float_negative():
+    assert parse("{:.0f}", "-7")[0] == -7.0
