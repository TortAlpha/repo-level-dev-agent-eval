diff --git a/tests/test_autospec_cachedmethod.py b/tests/test_autospec_cachedmethod.py
new file mode 100644
index 0000000000000000000000000000000000000000..84913355dc51f198fa9223230fb53259f82c5739
--- /dev/null
+++ b/tests/test_autospec_cachedmethod.py
@@ -0,0 +1,28 @@
+import unittest
+import unittest.mock
+import warnings
+
+from cachetools import Cache, cachedmethod
+
+
+class SomeClass:
+    def __init__(self):
+        self.cache = Cache(10)
+
+    @cachedmethod(lambda self: self.cache)
+    def get(self, value):
+        return value
+
+
+class AutospecCachedMethodTest(unittest.TestCase):
+    def test_autospec_no_warnings(self):
+        with warnings.catch_warnings(record=True) as caught:
+            warnings.simplefilter("always")
+            unittest.mock.create_autospec(SomeClass, instance=True)
+        self.assertEqual(caught, [])
+
+    def test_real_instance_behavior_unchanged(self):
+        obj = SomeClass()
+        self.assertEqual(obj.get(1), 1)
+        self.assertEqual(obj.get(1), 1)  # cached
+        self.assertEqual(obj.cache[(1,)], 1)
