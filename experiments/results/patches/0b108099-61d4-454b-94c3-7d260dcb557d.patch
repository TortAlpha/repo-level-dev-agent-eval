@@ -0,0 +1,23 @@
+import pytest
+
+from boltons.strutils import bytes2human
+
+
+def test_exact_powers_rollover():
+    assert bytes2human(1024) == '1K'
+    assert bytes2human(1024 ** 2) == '1M'
+    assert bytes2human(1024 ** 3) == '1G'
+
+
+def test_below_boundary_stays_smaller():
+    assert bytes2human(1023) == '1023B'
+
+
+def test_zero_and_midrange():
+    assert bytes2human(0) == '0B'
+    assert bytes2human(2048) == '2K'
+
+
+def test_precision_unchanged():
+    assert bytes2human(1536, ndigits=1) == '1.5K'
+    assert bytes2human(0, ndigits=2) == '0.00B'
