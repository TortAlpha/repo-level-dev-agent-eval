diff --git a/tests/test_numeric_ticks.py b/tests/test_numeric_ticks.py
new file mode 100644
index 0000000000000000000000000000000000000000..0416ae967c246403a8d30e998e5866704b5299b9
--- /dev/null
+++ b/tests/test_numeric_ticks.py
@@ -0,0 +1,31 @@
+import datetime
+import fractions
+
+from freezegun import freeze_time
+
+
+def test_frozen_datetime_factory_tick_with_fraction():
+    with freeze_time("Jan 14th, 2012, 00:00:00") as ft:
+        ft.tick(fractions.Fraction(1, 2))
+        assert ft() == datetime.datetime(2012, 1, 14, 0, 0, 0, 500000)
+
+
+def test_step_tick_time_factory_tick_with_fraction():
+    with freeze_time("Jan 14th, 2012, 00:00:00", auto_tick_seconds=1) as ft:
+        # Access the factory directly (the `ft` object for auto_tick_seconds)
+        # In freezegun, auto_tick_seconds creates a StepTickTimeFactory.
+        # The object behaves like the factory, so `tick` accepts delta.
+        ft.tick(fractions.Fraction(1, 2))
+        assert ft() >= datetime.datetime(2012, 1, 14, 0, 0, 0, 500000)
+
+
+def test_step_tick_time_factory_tick_with_int():
+    with freeze_time("Jan 14th, 2012, 00:00:00", auto_tick_seconds=1) as ft:
+        ft.tick(2)
+        assert ft() >= datetime.datetime(2012, 1, 14, 0, 0, 2)
+
+
+def test_step_tick_time_factory_tick_with_float():
+    with freeze_time("Jan 14th, 2012, 00:00:00", auto_tick_seconds=1) as ft:
+        ft.tick(0.5)
+        assert ft() >= datetime.datetime(2012, 1, 14, 0, 0, 0, 500000)
