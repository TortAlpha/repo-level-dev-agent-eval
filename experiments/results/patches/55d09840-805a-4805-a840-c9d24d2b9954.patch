+def test_unregister_removes_all_implementations_on_same_hook(pm: PluginManager) -> None:
+    class Hooks:
+        @hookspec
+        def he_method(self): ...
+
+    pm.add_hookspecs(Hooks)
+
+    class Plugin:
+        @hookimpl
+        def he_method(self): ...
+
+        @hookimpl(specname="he_method")
+        def other_method(self): ...
+
+    plugin = Plugin()
+    pm.register(plugin)
+
+    hookcaller = pm.hook.he_method
+    assert len(hookcaller.get_hookimpls()) == 2
+
+    pm.unregister(plugin)
+    assert len(hookcaller.get_hookimpls()) == 0
+
+
+def test_get_hookcallers_no_duplicates_for_multiple_implementations(
+    pm: PluginManager,
+) -> None:
