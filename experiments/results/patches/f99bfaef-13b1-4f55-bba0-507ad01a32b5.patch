+import pytest
+from datetime import datetime
+from croniter import croniter
+
+
+class TestAnchoredMonthLowerBound:
+    """Regression tests for month lower-bound in expand_from_start_time.
+
+    When the start month is an exact multiple of the step (e.g. June=6 with
+    step=3, since 6 % 3 == 0), the anchored lower bound must stay within the
+    valid 1-12 range and not yield 0 (which the expander rejects as out of
+    range).  The day-of-month field, also 1-based, already computes its anchored
+    lower bound correctly; the month field must match that semantics.
+    """
+
+    @pytest.mark.parametrize("month,year", [
+        (3, 2024),    # March   (3 % 3 == 0)
+        (6, 2024),    # June    (6 % 3 == 0)
+        (9, 2024),    # September (9 % 3 == 0)
+        (12, 2024),   # December (12 % 3 == 0)
+        (5, 2024),    # May (non-multiple, must not regress)
+    ])
+    def test_anchored_month_step_3_parses(self, month, year):
+        """Parsing `0 0 1 */3 *` anchored at any month must not raise."""
+        start = datetime(year, month, 1, 0, 0, 0)
+        # Should not raise CroniterBadCronError: out of range
+        c = croniter("0 0 1 */3 *", start, expand_from_start_time=True)
+        nxt = c.get_next(datetime)
+        assert nxt is not None
+        # The next fire must be a valid date after the start.
+        assert 1 <= nxt.month <= 12
+        assert nxt > start
+
+    def test_anchored_month_june_step_3_next_values(self):
+        """June 2024 with step 3 should produce valid subsequent months."""
+        start = datetime(2024, 6, 1, 0, 0, 0)
+        c = croniter("0 0 1 */3 *", start, expand_from_start_time=True)
+        vals = []
+        nxt = start
+        for _ in range(4):
+            nxt = c.get_next(datetime)
+            vals.append(nxt.month)
+        # Every produced month must be in 1-12 (never 0 or out of range).
+        for m in vals:
+            assert 1 <= m <= 12
+
+    @pytest.mark.parametrize("step", [1, 2, 3, 4, 6, 12])
+    def test_anchored_month_all_steps_june(self, step):
+        """June with any divisor step must parse without error."""
+        start = datetime(2024, 6, 1, 0, 0, 0)
+        c = croniter(f"0 0 1 */{step} *", start, expand_from_start_time=True)
+        nxt = c.get_next(datetime)
+        assert nxt is not None
+        assert 1 <= nxt.month <= 12
+
+    def test_non_anchored_month_still_works(self):
+        """Without expand_from_start_time, `*/3` must still parse normally."""
+        start = datetime(2024, 6, 1, 0, 0, 0)
+        c = croniter("0 0 1 */3 *", start, expand_from_start_time=False)
+        nxt = c.get_next(datetime)
+        assert nxt is not None
+        assert 1 <= nxt.month <= 12
