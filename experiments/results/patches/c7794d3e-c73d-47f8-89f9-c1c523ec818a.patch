+from w3lib._url import _urlsplit
+
+
+def test_urlsplit_ipv6_query_fragment():
+    result = _urlsplit("http://[::1]:8080/path?query=1#frag")
+    assert result.path == "/path"
+    assert result.query == "query=1"
+    assert result.fragment == "frag"
+    assert result.hostname == "::1"
+    assert result.port == 8080
