+import pytest
+from datetime import datetime
+from croniter import croniter, CroniterBadCronError
+
+
+def test_expand_from_start_time_month_step_anchored():
+    # When start month is divisible by the step, parsing should succeed
+    base = datetime(2024, 6, 1)
+    it = croniter("0 0 1 */3 *", base, expand_from_start_time=True)
+    # first occurrence should be the base itself
+    assert it.get_next(datetime) == base
+    # next occurrence should be three months later
+    assert it.get_next(datetime) == datetime(2024, 9, 1)
