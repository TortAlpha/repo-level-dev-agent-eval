@@ -0,0 +1,41 @@
+import io
+
+from dotenv.parser import parse_stream
+
+
+def _bindings(text):
+    return list(parse_stream(io.StringIO(text)))
+
+
+def test_leading_utf8_bom_stripped_from_first_key():
+    text = "\ufeffFIRST=value1\nSECOND=value2\n"
+    bindings = _bindings(text)
+    assert bindings[0].key == "FIRST"
+    assert bindings[0].value == "value1"
+    assert bindings[1].key == "SECOND"
+    assert bindings[1].value == "value2"
+
+
+def test_leading_utf8_bom_excluded_from_original_string():
+    text = "\ufeffFIRST=value1\nSECOND=value2\n"
+    bindings = _bindings(text)
+    assert "\ufeff" not in bindings[0].original.string
+    assert bindings[0].original.string.startswith("FIRST")
+    assert bindings[0].original.line == 1
+
+
+def test_no_bom_unchanged():
+    text = "FIRST=value1\nSECOND=value2\n"
+    bindings = _bindings(text)
+    assert bindings[0].key == "FIRST"
+    assert bindings[0].value == "value1"
+    assert bindings[0].original.string == "FIRST=value1\n"
+    assert bindings[1].key == "SECOND"
+    assert bindings[1].value == "value2"
+
+
+def test_bom_not_stripped_when_not_at_start():
+    text = "FIRST=\ufeffvalue1\nSECOND=value2\n"
+    bindings = _bindings(text)
+    assert bindings[0].key == "FIRST"
+    assert bindings[0].value == "\ufeffvalue1"
