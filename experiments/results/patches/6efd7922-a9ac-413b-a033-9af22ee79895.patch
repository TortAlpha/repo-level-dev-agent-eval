+#!/usr/bin/env python
+
+"""Tests for naturalsize unit-boundary rounding carry-over."""
+
+from __future__ import annotations
+
+import pytest
+
+import humanize
+
+
+@pytest.mark.parametrize(
+    "test_args, expected",
+    [
+        ([999999], "1.0 MB"),
+        ([1048575, True], "1.0 MiB"),
+        ([1048575, False, True], "1.0M"),
+        ([999999, False, False, "%.0f"], "1 MB"),
+        ([999999 * 1000**9], "1000.0 QB"),
+        ([-999999], "-1.0 MB"),
+    ],
+)
+def test_naturalsize_boundary(test_args: list, expected: str) -> None:
+    assert humanize.naturalsize(*test_args) == expected
