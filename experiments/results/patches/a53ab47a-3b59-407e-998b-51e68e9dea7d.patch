@@ -0,0 +1,31 @@
+from datetime import datetime
+
+import pytest
+
+from croniter import croniter
+
+
+def test_anchored_month_range_when_start_month_is_multiple_of_step():
+    # June (6 % 3 == 0) used to fail with out-of-range because the anchored
+    # lower bound for the month field was computed as 0.
+    cr = croniter("0 0 1 */3 *", datetime(2024, 6, 1), expand_from_start_time=True)
+    # The anchored range for months should stay within 1-12 and include June.
+    months = list(cr.expanded[3])
+    assert months == [3, 6, 9, 12]
+
+
+@pytest.mark.parametrize("month", [3, 6, 9, 12])
+def test_anchored_month_range_step_3_for_each_multiple_month(month):
+    cr = croniter("0 0 1 */3 *", datetime(2024, month, 1), expand_from_start_time=True)
+    assert list(cr.expanded[3]) == [3, 6, 9, 12]
+
+
+def test_anchored_month_range_step_4():
+    # April (4 % 4 == 0) anchors to {4, 8, 12}.
+    cr = croniter("0 0 1 */4 *", datetime(2024, 4, 1), expand_from_start_time=True)
+    assert list(cr.expanded[3]) == [4, 8, 12]
+
+
+def test_non_anchored_month_range_unchanged():
+    cr = croniter("0 0 1 */3 *", datetime(2024, 6, 1))
+    assert list(cr.expanded[3]) == [1, 4, 7, 10]
