+def _field_pattern_datetime(format_spec, name):
+    """Build regex pattern and converter for datetime fields with strftime-style format specifiers."""
+    directive_map = {
+        '%Y': r'\d{4}',
+        '%m': r'\d{1,2}',
+        '%d': r'\d{1,2}',
+        '%H': r'\d{1,2}',
+        '%M': r'\d{1,2}',
+        '%S': r'\d{1,2}',
+        '%f': r'\d{1,6}',
+        '%I': r'\d{1,2}',
+        '%p': r'(?:AM|PM)',
+        '%z': r'[+-]\d{2}(?:\d{2}|:\d{2})',
+        '%b': MONTHS_PAT,
+        '%B': ALL_MONTHS_PAT,
+    }
+    regex = ''
+    has_date = has_time = has_zone = False
+    i = 0
+    while i < len(format_spec):
+        if format_spec[i] == '%':
+            if i + 1 >= len(format_spec):
+                raise ValueError("Incomplete datetime format specifier %r" % format_spec)
+            code = format_spec[i:i+2]
+            if code not in directive_map:
+                raise ValueError("Unsupported datetime directive %r" % code)
+            regex += directive_map[code]
+            if code in ('%Y', '%m', '%d', '%b', '%B'):
+                has_date = True
+            if code in ('%H', '%I', '%M', '%S', '%f', '%p'):
+                has_time = True
+            if code == '%z':
+                has_time = True
+                has_zone = True
+            i += 2
+        else:
+            regex += re.escape(format_spec[i])
+            i += 1
+    pattern = r"(?P<%s>%s)" % (name, regex)
+    def conv(string, match, **kwargs):
+        value = match.group(name)
+        dt = datetime.strptime(value, format_spec)
+        if has_date and not has_time:
+            return dt.date()
+        if has_time and not has_date:
+            return dt.timetz() if has_zone else dt.time()
+        return dt
+    return pattern, conv
+
