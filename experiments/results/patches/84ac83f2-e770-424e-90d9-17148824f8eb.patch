@@ -0,0 +1,49 @@
+import pytest
+from datetime import date, time, datetime, timezone, timedelta
+from parse import parse
+
+@pytest.mark.parametrize("fmt, text, expected", [
+    ("%Y-%m-%d", "1997-07-16", date(1997, 7, 16)),
+    ("%Y-%b-%d", "1997-Feb-16", date(1997, 2, 16)),
+    ("%Y-%B-%d", "1997-February-16", date(1997, 2, 16)),
+])
+def test_date_only(fmt, text, expected):
+    result = parse(f"{{:{fmt}}}", text)[0]
+    assert result == expected
+    assert isinstance(result, date)
+
+@pytest.mark.parametrize("fmt, text, expected", [
+    ("%H:%M", "23:45", time(23, 45)),
+    ("%I:%M %p", "11:05 PM", time(23, 5)),
+    ("%H:%M:%S.%f", "00:00:01.234", time(0, 0, 1, 234000)),
+])
+def test_time_only(fmt, text, expected):
+    result = parse(f"{{:{fmt}}}", text)[0]
+    assert result == expected
+    assert isinstance(result, time)
+
+@pytest.mark.parametrize("fmt, text, expected", [
+    ("%Y-%m-%dT%H:%M%z", "2020-01-02T03:04+0500", datetime(2020, 1, 2, 3, 4, tzinfo=timezone(timedelta(hours=5)))),
+    ("%Y-%m-%d %H:%M%z", "2020-01-02 03:04-02:30", datetime(2020, 1, 2, 3, 4, tzinfo=timezone(timedelta(hours=-2, minutes=-30)))),
+    ("%Y-%m-%dT%H:%M%z", "2020-01-02T03:04+05:30", datetime(2020, 1, 2, 3, 4, tzinfo=timezone(timedelta(hours=5, minutes=30)))),
+])
+def test_datetime_with_timezone(fmt, text, expected):
+    result = parse(f"{{:{fmt}}}", text)[0]
+    assert result == expected
+    assert isinstance(result, datetime)
+
+def test_mixed_fields():
+    fmt = "User {name} logged in at {:%Y-%m-%d %H:%M}"
+    name, ts = parse(fmt, "User alice logged in at 2021-12-31 23:59")
+    assert name == "alice"
+    assert ts == datetime(2021, 12, 31, 23, 59)
+
+def test_multiple_datetime_fields():
+    fmt = "Start: {:%H:%M}, End: {:%H:%M}"
+    start, end = parse(fmt, "Start: 09:00, End: 17:30")
+    assert start == time(9, 0)
+    assert end == time(17, 30)
+
+def test_unsupported_directive():
+    with pytest.raises(ValueError):
+        parse("{:%Y-%m-%d %Z}", "2021-01-01 UTC")
