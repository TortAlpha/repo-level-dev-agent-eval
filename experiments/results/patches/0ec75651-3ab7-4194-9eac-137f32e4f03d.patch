@@ -0,0 +1,21 @@
+import unittest
+
+from more_itertools import numeric_range
+
+
+class NumericRangeReversedEmptyTests(unittest.TestCase):
+    def test_reversed_empty(self):
+        cases = [
+            ((0,), []),
+            ((0, 0), []),
+            ((0, 0, 1), []),
+            ((5, 5), []),
+            ((5, 5, 1), []),
+        ]
+        for args, expected in cases:
+            with self.subTest(args=args):
+                self.assertEqual(expected, list(reversed(numeric_range(*args))))
+
+
+if __name__ == "__main__":
+    unittest.main()
