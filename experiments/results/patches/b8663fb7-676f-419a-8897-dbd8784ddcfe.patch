@@ -0,0 +1,13 @@
+import pytest
+from w3lib.url import parse_url, canonicalize_url
+
+
+def test_parse_url_preserves_fragment_with_ipv6_netloc_query():
+    parsed = parse_url("http://[::1]?query#fragment")
+    assert parsed.query == "query"
+    assert parsed.fragment == "fragment"
+
+
+def test_canonicalize_url_removes_fragment_with_ipv6_netloc_query():
+    result = canonicalize_url("http://[::1]?query#fragment")
+    assert "#" not in result
