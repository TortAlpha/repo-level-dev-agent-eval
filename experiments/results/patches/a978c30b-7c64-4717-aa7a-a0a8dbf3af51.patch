@@ -0,0 +1,17 @@
+import parse
+
+
+def test_precision0_float_without_decimal():
+    result = parse.parse("a {:.0f} b", "a 12 b")
+    assert result is not None
+    assert result.fixed[0] == 12.0
+
+
+def test_precision0_float_with_zero_padding():
+    result = parse.parse("foo_{:02.0f}t", "foo_20t")
+    assert result is not None
+    assert result.fixed[0] == 20.0
+
+
+def test_precision0_float_requires_exact_match():
+    assert parse.parse("a {:.0f} b", "a 12.0 b") is None
