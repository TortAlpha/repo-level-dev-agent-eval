+    def test_reference_ordering_definitions_out_of_order(self):
+        """Footnote numbering should follow reference order, not definition order."""
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                foo[^first] bar[^last]
+
+                [^last]: Last definition
+                [^first]: First definition
+                """
+            ),
+            '<p>foo<sup id="fnref:first"><a class="footnote-ref" href="#fn:first">1</a></sup> '
+            'bar<sup id="fnref:last"><a class="footnote-ref" href="#fn:last">2</a></sup></p>\n'
+            '<div class="footnote">\n'
+            '<hr />\n'
+            '<ol>\n'
+            '<li id="fn:first">\n'
+            '<p>First definition&#160;<a class="footnote-backref" href="#fnref:first"'
+            ' title="Jump back to footnote 1 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '<li id="fn:last">\n'
+            '<p>Last definition&#160;<a class="footnote-backref" href="#fnref:last"'
+            ' title="Jump back to footnote 2 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '</ol>\n'
+            '</div>'
+        )
+
     def test_backlink_text(self):
