diff --git a/tests/test_urlsplit_fragment.py b/tests/test_urlsplit_fragment.py
new file mode 100644
index 0000000000000000000000000000000000000000..4931c07c62da7612362dad5a8e0b7ae166cfdc95
--- /dev/null
+++ b/tests/test_urlsplit_fragment.py
@@ -0,0 +1,25 @@
+from w3lib._url import _urlsplit
+
+
+def test_urlsplit_ipv6_query_fragment():
+    result = _urlsplit("//[::1]:8080?query#frag")
+    assert result.netloc == "[::1]:8080"
+    assert result.path == ""
+    assert result.query == "query"
+    assert result.fragment == "frag"
+
+
+def test_urlsplit_ipv6_path_query_fragment():
+    result = _urlsplit("http://[::1]:8080/path?query#frag")
+    assert result.netloc == "[::1]:8080"
+    assert result.path == "/path"
+    assert result.query == "query"
+    assert result.fragment == "frag"
+
+
+def test_urlsplit_normal_url_still_works():
+    result = _urlsplit("http://example.com/path?query#frag")
+    assert result.netloc == "example.com"
+    assert result.path == "/path"
+    assert result.query == "query"
+    assert result.fragment == "frag"
