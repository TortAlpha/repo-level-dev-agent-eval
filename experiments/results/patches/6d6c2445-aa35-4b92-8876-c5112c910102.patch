+#!/usr/bin/env python
+
+"""Regression tests for naturalsize rounding at unit boundaries."""
+
+from __future__ import annotations
+
+import pytest
+
+import humanize
+
+
+@pytest.mark.parametrize(
+    "test_args, expected",
+    [
+        ([999999.999], "1.0 MB"),
+        ([1023.999 * 1024, True], "1.0 MiB"),
+        ([1023.999 * 1024, False, True], "1.0M"),
+        ([999999.999, False, False, "%.2f"], "1.00 MB"),
+        ([1000**10 * 999.999], "1000.0 QB"),
+    ],
+)
+def test_naturalsize_boundary(test_args, expected):
+    assert humanize.naturalsize(*test_args) == expected
+
+    if isinstance(test_args[0], (int, float)):
+        test_args[0] = -test_args[0]
+    else:
+        test_args[0] = f"-{test_args[0]}"
+
+    assert humanize.naturalsize(*test_args) == "-" + expected
