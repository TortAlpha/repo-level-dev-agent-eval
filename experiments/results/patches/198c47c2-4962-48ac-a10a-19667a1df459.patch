diff --git a/tests/test_url_ipv6_fragment.py b/tests/test_url_ipv6_fragment.py
new file mode 100644
index 0000000000000000000000000000000000000000..ae0c2d09f399273c946131297333c208efabe90d
--- /dev/null
+++ b/tests/test_url_ipv6_fragment.py
@@ -0,0 +1,38 @@
+import pytest
+from w3lib._url import _urlsplit
+from w3lib.url import canonicalize_url
+
+
+def test_urlsplit_ipv6_query_fragment():
+    url = '//[::1]?a=1#b=2'
+    scheme, netloc, path, query, fragment = _urlsplit(url, allow_fragments=True)
+    assert scheme == ''
+    assert netloc == '[::1]'
+    assert path == ''
+    assert query == 'a=1'
+    assert fragment == 'b=2'
+
+
+def test_canonicalize_url_ipv6_query_fragment():
+    url = 'http://[::1]?a=1#b=2'
+    canon = canonicalize_url(url)
+    assert canon == 'http://[::1]/?a=1'
+
+
+def test_urlsplit_ipv6_without_fragment():
+    url = '//[::1]?a=1'
+    scheme, netloc, path, query, fragment = _urlsplit(url, allow_fragments=True)
+    assert fragment == ''
+    assert query == 'a=1'
+
+
+def test_urlsplit_ipv6_without_query():
+    url = '//[::1]#b'
+    scheme, netloc, path, query, fragment = _urlsplit(url, allow_fragments=True)
+    assert query == ''
+    assert fragment == 'b'
+
+
+def test_urlsplit_ipv6_mismatched_brackets():
+    with pytest.raises(ValueError):
+        _urlsplit('//[::1?foo', allow_fragments=True)
