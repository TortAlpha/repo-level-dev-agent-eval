diff --git a/tests/test_tick_numeric_delta.py b/tests/test_tick_numeric_delta.py
new file mode 100644
index 0000000..e73ce60
--- /dev/null
+++ b/tests/test_tick_numeric_delta.py
@@ -0,0 +1,60 @@
+import datetime
+import fractions
+
+from freezegun.api import FrozenDateTimeFactory, StepTickTimeFactory, TickingDateTimeFactory
+
+
+def test_frozen_datetime_factory_tick_fraction_delta() -> None:
+    initial = datetime.datetime(year=1, month=7, day=12, hour=15, minute=6, second=3)
+    factory = FrozenDateTimeFactory(initial)
+    expected = initial + datetime.timedelta(seconds=1.5)
+    assert factory.tick(fractions.Fraction(3, 2)) == expected
+    assert factory() == expected
+
+
+def test_ticking_datetime_factory_tick_fraction_delta() -> None:
+    initial = datetime.datetime(year=1, month=7, day=12, hour=15, minute=6, second=3)
+    start = datetime.datetime.now()
+    factory = TickingDateTimeFactory(initial, start)
+    expected = initial + datetime.timedelta(seconds=2.5)
+    assert factory.tick(fractions.Fraction(5, 2)) == expected
+
+
+def test_step_tick_time_factory_tick_numeric_delta() -> None:
+    initial = datetime.datetime(year=1, month=7, day=12, hour=15, minute=6, second=3)
+    factory = StepTickTimeFactory(initial, step_width=60.0)
+    expected = initial + datetime.timedelta(seconds=10)
+    assert factory.tick(10) == expected
+    assert factory() == expected
+
+
+def test_step_tick_time_factory_tick_fraction_delta() -> None:
+    initial = datetime.datetime(year=1, month=7, day=12, hour=15, minute=6, second=3)
+    factory = StepTickTimeFactory(initial, step_width=60.0)
+    expected = initial + datetime.timedelta(seconds=1.5)
+    assert factory.tick(fractions.Fraction(3, 2)) == expected
+    assert factory() == expected
+
+
+def test_step_tick_time_factory_tick_default_uses_step_width() -> None:
+    initial = datetime.datetime(year=1, month=7, day=12, hour=15, minute=6, second=3)
+    factory = StepTickTimeFactory(initial, step_width=60.0)
+    expected = initial + datetime.timedelta(seconds=60)
+    assert factory.tick() == expected
+    assert factory() == expected
+
+
+def test_frozen_datetime_factory_tick_timedelta_unchanged() -> None:
+    initial = datetime.datetime(year=1, month=7, day=12, hour=15, minute=6, second=3)
+    factory = FrozenDateTimeFactory(initial)
+    expected = initial + datetime.timedelta(seconds=10)
+    assert factory.tick(delta=datetime.timedelta(seconds=10)) == expected
+    assert factory() == expected
+
+
+def test_step_tick_time_factory_tick_timedelta_unchanged() -> None:
+    initial = datetime.datetime(year=1, month=7, day=12, hour=15, minute=6, second=3)
+    factory = StepTickTimeFactory(initial, step_width=60.0)
+    expected = initial + datetime.timedelta(seconds=10)
+    assert factory.tick(delta=datetime.timedelta(seconds=10)) == expected
+    assert factory() == expected
