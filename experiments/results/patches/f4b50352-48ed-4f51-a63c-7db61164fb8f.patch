diff --git a/tests/test_strftime.py b/tests/test_strftime.py
new file mode 100644
index 0000000..8698538
--- /dev/null
+++ b/tests/test_strftime.py
@@ -0,0 +1,46 @@
+from datetime import date, datetime, time
+import parse
+
+
+def test_strftime_date():
+    r = parse.parse("a {:%Y-%m-%d} b", "a 1997-07-16 b")
+    assert r[0] == date(1997, 7, 16)
+
+
+def test_strftime_date_named():
+    r = parse.parse("a {when:%Y-%m-%d} b", "a 1997-07-16 b")
+    assert r.named["when"] == date(1997, 7, 16)
+
+
+def test_strftime_date_month_name():
+    r = parse.parse("a {:%Y-%b-%d} b", "a 1997-Feb-16 b")
+    assert r[0] == date(1997, 2, 16)
+
+
+def test_strftime_datetime():
+    r = parse.parse("{:%Y-%m-%d %H:%M:%S}", "1997-07-16 19:20:30")
+    assert r[0] == datetime(1997, 7, 16, 19, 20, 30)
+
+
+def test_strftime_time():
+    r = parse.parse("{:%H:%M:%S}", "19:20:30")
+    assert r[0] == time(19, 20, 30)
+
+
+def test_strftime_tz():
+    r = parse.parse("{:%Y-%m-%d %H:%M:%S%z}", "1997-07-16 19:20:30+0200")
+    dt = r[0]
+    assert dt.tzinfo is not None
+    assert dt.utcoffset().total_seconds() == 2 * 3600
+
+
+def test_strftime_mixed():
+    r = parse.parse("{:%Y-%m-%d} {num:d}", "1997-07-16 42")
+    assert r[0] == date(1997, 7, 16)
+    assert r["num"] == 42
+
+
+def test_strftime_repeated():
+    r = parse.parse("{:%Y-%m-%d} {:%Y-%m-%d}", "1997-07-16 1997-07-16")
+    assert r[0] == date(1997, 7, 16)
+    assert r[1] == date(1997, 7, 16)
