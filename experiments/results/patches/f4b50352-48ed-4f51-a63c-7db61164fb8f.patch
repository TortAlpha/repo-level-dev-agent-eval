+# strftime/strptime directive sets for determining return type
+_DATE_DIRECTIVES = set("YymdbBaAjUW")
+_TIME_DIRECTIVES = set("HIMSpf")
+_TZ_DIRECTIVES = set("zZ")
+_STRFTIME_DIRECTIVES = _DATE_DIRECTIVES | _TIME_DIRECTIVES | _TZ_DIRECTIVES | set("%cxX")
+
+# mapping from strftime directive to regex pattern (non-capturing groups)
+_STRFTIME_PATTERNS = {
+    "Y": r"\d{4}",
+    "y": r"\d{2}",
+    "m": r"\d{2}",
+    "d": r"\d{2}",
+    "b": r"(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)",
+    "B": r"(?:January|February|March|April|May|June|July|August|September|October|November|December)",
+    "a": r"(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun)",
+    "A": r"(?:Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday)",
+    "H": r"\d{2}",
+    "I": r"\d{2}",
+    "M": r"\d{2}",
+    "S": r"\d{2}",
+    "f": r"\d{1,6}",
+    "p": r"(?:AM|PM)",
+    "z": r"(?:[-+]\d{2}(?::?\d{2})?|Z)",
+    "Z": r"[A-Za-z/_]+",
+    "j": r"\d{3}",
+    "U": r"\d{2}",
+    "W": r"\d{2}",
+    "c": r".+?",
+    "x": r".+?",
+    "X": r".+?",
+    "%": r"%",
+}
+
+
+def _is_strftime_format(format):
+    """Return True if *format* is a strftime/strptime-style datetime spec."""
+    i = 0
+    n = len(format)
+    while i < n - 1:
+        if format[i] == "%" and format[i + 1] in _STRFTIME_DIRECTIVES:
+            return True
+        i += 1
+    return False
+
+
+def _strptime_regex(format):
+    """Build a regex pattern from a strftime/strptime format spec."""
+    parts = []
+    i = 0
+    n = len(format)
+    while i < n:
+        if format[i] == "%" and i + 1 < n:
+            directive = format[i + 1]
+            if directive in _STRFTIME_PATTERNS:
+                parts.append(_STRFTIME_PATTERNS[directive])
+            else:
+                parts.append(re.escape("%" + directive))
+            i += 2
+        else:
+            parts.append(re.escape(format[i]))
+            i += 1
+    return "".join(parts)
+
+
+def _strptime_convert(format):
+    """Return a converter that parses matched text via datetime.strptime."""
+    has_date = False
+    has_time = False
+    i = 0
+    n = len(format)
+    while i < n - 1:
+        if format[i] == "%":
+            d = format[i + 1]
+            if d == "%":
+                i += 2
+                continue
+            if d in _DATE_DIRECTIVES:
+                has_date = True
+            elif d in _TIME_DIRECTIVES or d in _TZ_DIRECTIVES:
+                has_time = True
+            i += 2
+        else:
+            i += 1
+
+    def convert(string, match):
+        dt = datetime.strptime(string, format)
+        if has_time and not has_date:
+            return dt.time()
+        if has_date and not has_time:
+            return dt.date()
+        return dt
+
+    return convert
+
 
