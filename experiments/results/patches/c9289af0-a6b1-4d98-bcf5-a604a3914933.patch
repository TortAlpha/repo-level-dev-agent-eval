@@ -0,0 +1,34 @@
+from __future__ import annotations
+
+from unittest import TestCase
+
+import more_itertools as mi
+
+
+class TestSubfactorial(TestCase):
+    """Tests for ``subfactorial()``."""
+
+    def test_known_values(self):
+        self.assertEqual(mi.subfactorial(0), 1)
+        self.assertEqual(mi.subfactorial(1), 0)
+        self.assertEqual(mi.subfactorial(2), 1)
+        self.assertEqual(mi.subfactorial(3), 2)
+        self.assertEqual(mi.subfactorial(4), 9)
+        self.assertEqual(mi.subfactorial(5), 44)
+
+    def test_cross_check_derangements(self):
+        for n in range(0, 9):
+            expected = sum(1 for _ in mi.derangements(range(n)))
+            self.assertEqual(mi.subfactorial(n), expected)
+
+    def test_type_error_float(self):
+        with self.assertRaises(TypeError):
+            mi.subfactorial(1.0)
+
+    def test_type_error_str(self):
+        with self.assertRaises(TypeError):
+            mi.subfactorial('1')
+
+    def test_value_error_negative(self):
+        with self.assertRaises(ValueError):
+            mi.subfactorial(-1)
