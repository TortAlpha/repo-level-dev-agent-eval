+def subfactorial(n):
+    """Return the subfactorial of *n*, the number of derangements of *n* items.
+
+    The subfactorial of *n* counts the number of permutations of *n*
+    elements that leave no element in its original position (OEIS A000166).
+
+        >>> subfactorial(0)
+        1
+        >>> subfactorial(1)
+        0
+        >>> subfactorial(2)
+        1
+        >>> subfactorial(3)
+        2
+        >>> subfactorial(4)
+        9
+        >>> subfactorial(5)
+        44
+
+    Non-integer input raises a :exc:`TypeError`; negative input raises a
+    :exc:`ValueError`.
+    """
+    if not isinstance(n, int) or isinstance(n, bool):
+        raise TypeError(f'expected int, got {type(n).__name__}')
+    if n < 0:
+        raise ValueError('n must be non-negative')
+    a, b = 1, 0  # !0, !1
+    for k in range(2, n + 1):
+        a, b = b, (k - 1) * (a + b)
+    return b if n >= 1 else a
+
