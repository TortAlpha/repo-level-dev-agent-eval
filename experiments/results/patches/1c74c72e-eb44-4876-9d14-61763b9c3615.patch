index 0000000000000000000000000000000000000000..628fdcc9ff5ee42ac525a8185f6d8db0be089f62
--- /dev/null
+++ b/tests/test_wait_exponential_jitter.py
@@ -0,0 +1,48 @@
+from datetime import timedelta
+
+import pytest
+
+from tenacity import RetryCallState
+from tenacity.wait import wait_exponential_jitter
+
+
+def make_retry_state(previous_attempt_number, delay_since_first_attempt=0):
+    retry_state = RetryCallState(None, None, (), {})
+    retry_state.attempt_number = previous_attempt_number
+    retry_state.set_result(None)
+    return retry_state
+
+
+def test_min_lower_bounds_wait():
+    wait = wait_exponential_jitter(initial=1, max=60, jitter=1, min=10)
+    for attempt in range(1, 5):
+        result = wait(make_retry_state(attempt))
+        assert result >= 10
+
+
+def test_min_does_not_affect_values_above_min():
+    wait = wait_exponential_jitter(initial=1, max=60, jitter=1, min=10)
+    result = wait(make_retry_state(6))
+    assert 32 <= result <= 33
+    result = wait(make_retry_state(7))
+    assert result == 60
+
+
+def test_timedelta_parameters_accepted():
+    wait = wait_exponential_jitter(
+        initial=1,
+        max=timedelta(seconds=5),
+        jitter=timedelta(seconds=1),
+        min=timedelta(seconds=2),
+    )
+    assert wait(make_retry_state(1)) == 2
+    assert wait(make_retry_state(7)) == 5
+
+
+def test_plain_numbers_still_work():
+    wait = wait_exponential_jitter(initial=1, max=5, jitter=1)
+    assert wait(make_retry_state(7)) == 5
+
+
+if __name__ == "__main__":
+    pytest.main([__file__])
