+import unittest
+from datetime import datetime
+from croniter import croniter
+
+
+class TestMonthAnchorExactMultiple(unittest.TestCase):
+    def test_exact_multiples_of_step_parse_and_anchor(self):
+        expr = "0 0 1 */3 *"
+        # Start months that are exact multiples of 3 should parse and anchor correctly.
+        expected_next = {
+            3: datetime(2024, 6, 1),
+            6: datetime(2024, 9, 1),
+            9: datetime(2024, 12, 1),
+            12: datetime(2025, 3, 1),
+        }
+        for month, nxt in expected_next.items():
+            start = datetime(2024, month, 1)
+            it = croniter(expr, start, expand_from_start_time=True)
+            self.assertEqual(it.get_next(datetime), nxt, f"next for month {month}")
+
+        expected_prev = {
+            3: datetime(2023, 12, 1),
+            6: datetime(2024, 3, 1),
+            9: datetime(2024, 6, 1),
+            12: datetime(2024, 9, 1),
+        }
+        for month, prv in expected_prev.items():
+            start = datetime(2024, month, 1)
+            it = croniter(expr, start, expand_from_start_time=True)
+            self.assertEqual(it.get_prev(datetime), prv, f"prev for month {month}")
+
+    def test_june_specific_case_from_task(self):
+        # The exact case from the task description must not raise.
+        it = croniter("0 0 1 */3 *", datetime(2024, 6, 1), expand_from_start_time=True)
+        self.assertEqual(it.get_next(datetime), datetime(2024, 9, 1))
+
+
+if __name__ == "__main__":
+    unittest.main()
