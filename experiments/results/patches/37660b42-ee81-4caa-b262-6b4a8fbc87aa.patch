diff --git a/tests/test_window_functions.py b/tests/test_window_functions.py
new file mode 100644
index 0000000..1f964a1
--- /dev/null
+++ b/tests/test_window_functions.py
@@ -0,0 +1,60 @@
+import sqlparse
+from sqlparse.sql import Function, Identifier, Parenthesis
+
+
+def parse_one(sql):
+    return sqlparse.parse(sql)[0]
+
+
+def find_function(stmt):
+    for token in stmt.tokens:
+        if isinstance(token, Function):
+            return token
+        if token.is_group:
+            func = find_function(token)
+            if func is not None:
+                return func
+    return None
+
+
+def test_get_window_none_without_over():
+    func = find_function(parse_one('SELECT foo(5) FROM t'))
+    assert func is not None
+    assert func.get_window() is None
+
+
+def test_get_window_named():
+    func = find_function(parse_one('SELECT foo(5) OVER win1 FROM t'))
+    assert func is not None
+    window = func.get_window()
+    assert isinstance(window, Identifier)
+    assert window.get_real_name() == 'win1'
+
+
+def test_get_window_inline():
+    func = find_function(parse_one('SELECT foo(5) OVER (PARTITION BY c1) FROM t'))
+    assert func is not None
+    window = func.get_window()
+    assert isinstance(window, Parenthesis)
+    assert 'PARTITION BY c1' in window.value
+
+
+def test_parameters_with_over_named():
+    func = find_function(parse_one('SELECT foo(5) OVER win1 FROM t'))
+    params = func.get_parameters()
+    assert len(params) == 1
+    assert params[0].value == '5'
+
+
+def test_parameters_with_over_inline():
+    func = find_function(parse_one('SELECT foo(5) OVER (PARTITION BY c1) FROM t'))
+    params = func.get_parameters()
+    assert len(params) == 1
+    assert params[0].value == '5'
+
+
+def test_parameters_without_over():
+    func = find_function(parse_one('SELECT foo(5) FROM t'))
+    params = func.get_parameters()
+    assert len(params) == 1
+    assert params[0].value == '5'
