+    def get_window(self):
+        """Return the window of the function if it has an OVER clause.
+
+        Returns the window identifier for a named window (e.g.
+        ``foo(5) OVER win1``), the parenthesised window definition for an
+        inline window (e.g. ``foo(5) OVER (PARTITION BY c1)``), or ``None``
+        when the function has no ``OVER`` clause.
+        """
+        for token in self.tokens:
+            if isinstance(token, Over):
+                # The window is the first non-whitespace token after OVER.
+                _, window = token.token_next_by(
