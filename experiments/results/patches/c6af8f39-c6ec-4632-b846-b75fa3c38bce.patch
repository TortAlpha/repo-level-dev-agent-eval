+    def get_window(self):
+        """Return the window of the function if an OVER clause is present.
+
+        Returns the window identifier for a named window (e.g.
+        ``foo(5) OVER win1``), the parenthesised window definition for an
+        inline window (e.g. ``foo(5) OVER (PARTITION BY c1)``) or ``None``
+        when the function has no OVER clause.
+        """
+        over = self.token_next_by(i=Over)[1]
+        if over is None:
+            return None
+        for token in over.tokens:
+            if token.match(T.Keyword, 'OVER'):
+                continue
+            if token.is_whitespace:
+                continue
+            return token
+        return None
