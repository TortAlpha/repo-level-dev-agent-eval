--- /dev/null
+++ b/tests/test_urlsplit_ipv6_regression.py
@@ -0,0 +1,64 @@
+from __future__ import annotations
+
+from urllib.parse import urlsplit as urllib_urlsplit
+
+import pytest
+
+from w3lib._url import _urlsplit
+from w3lib.url import canonicalize_url
+
+
+class TestUrlsplitIPv6Fragment:
+    """Regression tests for _urlsplit early-exit with IPv6 netloc + query + fragment."""
+
+    @pytest.mark.parametrize(
+        "url",
+        [
+            "http://[::1]?q#f",
+            "http://[::1]/path?q#f",
+            "http://[::1]#f?q",
+        ],
+    )
+    def test_urlsplit_matches_urllib(self, url: str) -> None:
+        ours = _urlsplit(url)
+        theirs = urllib_urlsplit(url)
+        assert ours.scheme == theirs.scheme
+        assert ours.netloc == theirs.netloc
+        assert ours.path == theirs.path
+        assert ours.query == theirs.query
+        assert ours.fragment == theirs.fragment
+
+    def test_fragment_not_folded_into_query_no_path(self) -> None:
+        # http://[::1]?q#f  -> query="q", fragment="f"
+        result = _urlsplit("http://[::1]?q#f")
+        assert result.scheme == "http"
+        assert result.netloc == "[::1]"
+        assert result.path == ""
+        assert result.query == "q"
+        assert result.fragment == "f"
+        assert result.query != "q#f"
+
+    def test_fragment_not_folded_into_query_with_path(self) -> None:
+        # http://[::1]/path?q#f  -> query="q", fragment="f"
+        result = _urlsplit("http://[::1]/path?q#f")
+        assert result.scheme == "http"
+        assert result.netloc == "[::1]"
+        assert result.path == "/path"
+        assert result.query == "q"
+        assert result.fragment == "f"
+
+    def test_fragment_before_query(self) -> None:
+        # http://[::1]#f?q  -> fragment="f?q", query=""
+        result = _urlsplit("http://[::1]#f?q")
+        assert result.scheme == "http"
+        assert result.netloc == "[::1]"
+        assert result.path == ""
+        assert result.query == ""
+        assert result.fragment == "f?q"
+
+    def test_canonicalize_url_removes_fragment(self) -> None:
+        canonical = canonicalize_url("http://[::1]?q#f")
+        assert "#f" not in canonical
+        assert canonical == "http://[::1]/?q="
+        # The fragment must not have been folded into the query.
+        assert "q#f" not in canonical
