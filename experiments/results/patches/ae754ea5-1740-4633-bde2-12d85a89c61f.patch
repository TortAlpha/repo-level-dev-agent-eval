@@ -0,0 +1,30 @@
+"""Tests for ``more_itertools.subfactorial``."""
+
+import more_itertools as mi
+from more_itertools import ilen
+
+from unittest import TestCase
+
+
+class SubfactorialTests(TestCase):
+    def test_sequence(self):
+        expected = [1, 0, 1, 2, 9, 44, 265, 1854, 14833, 133496]
+        actual = [mi.subfactorial(n) for n in range(len(expected))]
+        self.assertEqual(actual, expected)
+
+    def test_matches_derangements(self):
+        for n in range(8):
+            with self.subTest(n=n):
+                self.assertEqual(
+                    mi.subfactorial(n), ilen(mi.derangements('.' * n))
+                )
+
+    def test_non_integer(self):
+        for value in [1.0, '1', 1.5, None]:
+            with self.subTest(value=value):
+                with self.assertRaises(TypeError):
+                    mi.subfactorial(value)
+
+    def test_negative(self):
+        with self.assertRaises(ValueError):
+            mi.subfactorial(-1)
