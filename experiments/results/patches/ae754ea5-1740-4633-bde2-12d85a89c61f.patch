+def subfactorial(n):
+    """Return the subfactorial of *n*, the number of derangements of *n* items.
+
+    The subfactorial of *n* counts the permutations of *n* elements that leave
+    no element in its original position (OEIS A000166):
+
+        >>> subfactorial(0)
+        1
+        >>> subfactorial(1)
+        0
+        >>> subfactorial(2)
+        1
+        >>> subfactorial(3)
+        2
+        >>> subfactorial(4)
+        9
+        >>> subfactorial(5)
+        44
+
+    *n* must be a non-negative integer; otherwise a :exc:`TypeError` is raised.
+    """
+    if not isinstance(n, int) or isinstance(n, bool):
+        raise TypeError('n must be a non-negative integer')
+    if n < 0:
+        raise ValueError('n must be a non-negative integer')
+    a, b = 1, 0
+    for _ in range(n):
+        a, b = b, (a + b) * (_ + 1)
+    return a
+
+
