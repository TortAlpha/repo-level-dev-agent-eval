diff --git a/testing/test_pluginmanager_multiple_impls.py b/testing/test_pluginmanager_multiple_impls.py
new file mode 100644
index 0000000000000000000000000000000000000000..8459747616178468987560b699b1f09aa9aeaaac
--- /dev/null
+++ b/testing/test_pluginmanager_multiple_impls.py
@@ -0,0 +1,54 @@
+import pytest
+from pluggy._manager import PluginManager
+from pluggy import HookspecMarker, HookimplMarker
+from pluggy._callers import HookCaller
+
+hookspec = HookspecMarker("test")
+hookimpl = HookimplMarker("test")
+
+def test_get_hookcallers_no_duplicates_and_unregister_clears_all():
+    pm = PluginManager("test")
+
+    class Spec:
+        @hookspec
+        def myhook(self, x):
+            """a hook specification"""
+            pass
+
+    pm.add_hookspecs(Spec)
+
+    class PluginMultiple:
+        @hookimpl
+        def myhook(self, x):
+            return x + 1
+
+        @hookimpl(specname="myhook")
+        def alias(self, x):
+            return x + 2
+
+    # Instantiate and register the plugin with two implementations on the same hook
+    plugin = PluginMultiple()
+    name = pm.register(plugin)
+
+    # Before unregister: get_hookcallers(plugin) should list only one HookCaller
+    hook_callers = pm.get_hookcallers(plugin)
+    assert isinstance(hook_callers, list)
+    assert len(hook_callers) == 1
+    hc = hook_callers[0]
+    assert isinstance(hc, HookCaller)
+    assert hc.name == "myhook"
+
+    # Both implementations should run when calling the hook
+    results = pm.hook.myhook(x=10)
+    assert set(results) == {11, 12}
+
+    # Unregistering should remove all implementations of that plugin
+    removed = pm.unregister(plugin=plugin)
+    assert removed == name
+    # Plugin is no longer registered
+    assert pm.get_name(plugin) is None
+    # get_hookcallers for an unregistered plugin returns None
+    assert pm.get_hookcallers(plugin) is None
+    # Calling the hook now yields no results
+    results_after = pm.hook.myhook(x=10)
+    assert results_after == []
