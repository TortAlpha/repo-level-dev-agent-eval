+    # If the formatted mantissa rounds to the base (e.g., 1000.0 from 999.95),
+    # advance the suffix (exponent) so the value is shown at the next unit.
+    while exp < len(suffix):
+        mantissa = abs(bytes_ / (base**exp))  # positive magnitude for comparison
+        try:
+            formatted = format % mantissa
+            if float(formatted) >= base:
+                exp += 1
+            else:
+                break
+        except (ValueError, TypeError):
+            # custom/non-numeric format strings fall back to original behavior
+            break
     space = "" if gnu else " "
