+#!/usr/bin/env python
+
+"""Tests for naturalsize rounding at unit boundaries."""
+
+from __future__ import annotations
+
+import pytest
+
+import humanize
+
+
+@pytest.mark.parametrize(
+    "test_args, expected",
+    [
+        ([1000**2 - 1], "1.0 MB"),
+        ([1024**2 - 1, True], "1.0 MiB"),
+        ([1024**2 - 1, False, True], "1.0M"),
+        ([10**30], "1.0 QB"),  # already at largest suffix, unchanged
+    ],
+)
+def test_naturalsize_rounding_carries_suffix(test_args, expected):
+    assert humanize.naturalsize(*test_args) == expected
