diff --git a/h11/tests/test_content_length_pathological.py b/h11/tests/test_content_length_pathological.py
new file mode 100644
index 0000000000000000000000000000000000000000..6701652837bfb97bd8b4f5f59502cbfe8c91dfd8
--- /dev/null
+++ b/h11/tests/test_content_length_pathological.py
@@ -0,0 +1,42 @@
+import pytest
+
+from .._headers import normalize_and_validate
+from .._util import LocalProtocolError
+
+
+def test_pathological_content_length_rejected() -> None:
+    # An absurdly long Content-Length digit string must be rejected promptly
+    # as a protocol error rather than reaching int() conversion.
+    with pytest.raises(LocalProtocolError):
+        normalize_and_validate([("Content-Length", b"1" * 10_000)])
+
+    # Just over the limit is also rejected.
+    with pytest.raises(LocalProtocolError):
+        normalize_and_validate([("Content-Length", b"9" * 17)])
+
+
+def test_normal_content_length_still_works() -> None:
+    # Normal valid values continue to pass.
+    assert normalize_and_validate([("Content-Length", "0")]) == [
+        (b"content-length", b"0")
+    ]
+    assert normalize_and_validate([("Content-Length", "1")]) == [
+        (b"content-length", b"1")
+    ]
+    assert normalize_and_validate([("Content-Length", "10000")]) == [
+        (b"content-length", b"10000")
+    ]
+    # The maximum allowed digit count (16) still works.
+    assert normalize_and_validate([("Content-Length", b"9" * 16)]) == [
+        (b"content-length", b"9" * 16)
+    ]
+    # Comma-separated identical values still work after stripping.
+    assert normalize_and_validate([("Content-Length", "0 , 0")]) == [
+        (b"content-length", b"0")
+    ]
+
+
+def test_pathological_content_length_via_str() -> None:
+    # Same protection when the value is provided as str.
+    with pytest.raises(LocalProtocolError):
+        normalize_and_validate([("Content-Length", "1" * 10_000)])
