@@ -0,0 +1,34 @@
+"""Regression tests for naturalsize rounding at unit boundaries."""
+
+from __future__ import annotations
+
+import humanize
+
+
+def test_decimal_boundary_carry() -> None:
+    assert humanize.naturalsize(999999) == "1.0 MB"
+    assert humanize.naturalsize(999950) == "1.0 MB"
+    assert humanize.naturalsize(999949) == "999.9 kB"
+
+
+def test_decimal_boundary_carry_negative() -> None:
+    assert humanize.naturalsize(-999999) == "-1.0 MB"
+
+
+def test_binary_boundary_carry() -> None:
+    assert humanize.naturalsize(1024**2 - 1, binary=True) == "1.0 MiB"
+    assert humanize.naturalsize(1024**2 - 1, gnu=True) == "1.0M"
+
+
+def test_binary_boundary_carry_negative() -> None:
+    assert humanize.naturalsize(-(1024**2 - 1), binary=True) == "-1.0 MiB"
+
+
+def test_largest_suffix_unchanged() -> None:
+    assert humanize.naturalsize(10**34 * 3) == "30000.0 QB"
+    assert humanize.naturalsize(1024**10 * 40, binary=True) == "40.0 QiB"
+
+
+def test_non_crossing_unchanged() -> None:
+    assert humanize.naturalsize(999949) == "999.9 kB"
+    assert humanize.naturalsize(1024 * 1023, binary=True) == "1023.0 KiB"
