@@ -0,0 +1,49 @@
+import datetime
+import unittest
+
+from croniter import croniter
+
+
+class TestMonthLowerBoundFix(unittest.TestCase):
+    def test_month_step_exact_multiple_parses(self):
+        # June (6 % 3 == 0) previously raised CroniterBadCronError
+        it = croniter(
+            "0 0 1 */3 *",
+            datetime.datetime(2024, 6, 1),
+            expand_from_start_time=True,
+        )
+        self.assertEqual(it.get_next(datetime.datetime), datetime.datetime(2024, 9, 1))
+
+    def test_month_step_exact_multiple_prev(self):
+        it = croniter(
+            "0 0 1 */3 *",
+            datetime.datetime(2024, 6, 1),
+            expand_from_start_time=True,
+        )
+        self.assertEqual(it.get_prev(datetime.datetime), datetime.datetime(2024, 3, 1))
+
+    def test_month_step_exact_multiple_other_steps(self):
+        for start, step, expected_next in [
+            (datetime.datetime(2024, 3, 1), 3, datetime.datetime(2024, 6, 1)),
+            (datetime.datetime(2024, 9, 1), 3, datetime.datetime(2024, 12, 1)),
+            (datetime.datetime(2024, 12, 1), 3, datetime.datetime(2025, 3, 1)),
+            (datetime.datetime(2024, 4, 1), 2, datetime.datetime(2024, 6, 1)),
+            (datetime.datetime(2024, 6, 1), 2, datetime.datetime(2024, 8, 1)),
+            (datetime.datetime(2024, 8, 1), 2, datetime.datetime(2024, 10, 1)),
+            (datetime.datetime(2024, 10, 1), 2, datetime.datetime(2024, 12, 1)),
+            (datetime.datetime(2024, 12, 1), 2, datetime.datetime(2025, 2, 1)),
+        ]:
+            it = croniter(
+                f"0 0 1 */{step} *",
+                start,
+                expand_from_start_time=True,
+            )
+            self.assertEqual(it.get_next(datetime.datetime), expected_next)
+
+    def test_non_anchored_behavior_unchanged(self):
+        it = croniter("0 0 1 */3 *", datetime.datetime(2024, 6, 1))
+        self.assertEqual(it.get_next(datetime.datetime), datetime.datetime(2024, 7, 1))
+
+
+if __name__ == "__main__":
+    unittest.main()
