+++ b/tests/test_bom_regression.py
@@ -0,0 +1,13 @@
+import io
+
+from dotenv.parser import parse_stream
+
+
+def test_parse_stream_strips_leading_bom():
+    test_input = "\ufeffFIRST=value1\nSECOND=value2\n"
+    result = parse_stream(io.StringIO(test_input))
+
+    bindings = list(result)
+    assert [b.key for b in bindings] == ["FIRST", "SECOND"]
+    assert bindings[0].original.string == "FIRST=value1\n"
+    assert bindings[0].original.line == 1
