+        expected = [8.5, 8.5, 7.5, 6.5]
+        self.assertListEqual(list(mi.running_min(iterable)), expected)
+
+    def test_running_max_default(self):
+        iterable = [8.5, 9.5, 7.5, 6.5]
+        expected = [8.5, 9.5, 9.5, 9.5]
+        self.assertListEqual(list(mi.running_max(iterable)), expected)
+
+    def test_running_min_window(self):
+        iterable = [4, 2, 1, 3, 5]
+        expected = [4, 2, 1, 1, 3]
+        self.assertListEqual(list(mi.running_min(iterable, maxlen=2)), expected)
+
+    def test_running_max_window(self):
+        iterable = [1, 4, 2, 5, 3]
+        expected = [1, 4, 4, 5, 5]
+        self.assertListEqual(list(mi.running_max(iterable, maxlen=3)), expected)
+
+    def test_running_window_validation(self):
+        with self.assertRaises(TypeError):
+            list(mi.running_min([1, 2], maxlen=1.5))
+        with self.assertRaises(ValueError):
+            list(mi.running_max([1, 2], maxlen=0))
