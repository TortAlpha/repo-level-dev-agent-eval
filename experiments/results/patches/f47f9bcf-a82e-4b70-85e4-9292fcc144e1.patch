+def _validate_window_maxlen(maxlen):
+    if not isinstance(maxlen, int):
+        raise TypeError('maxlen must be an integer')
+    if maxlen <= 0:
+        raise ValueError('maxlen must be greater than zero')
+    return maxlen
+
+
+def running_min(iterable, *, maxlen=None):
+    """Yield the running minimum of *iterable*.
+
+    With the default ``maxlen=None``, each value is the minimum seen so far.
+    When *maxlen* is provided, restrict the minimum to the last ``maxlen``
+    elements.
+    """
+    if maxlen is None:
+        current = _marker
+        for element in iterable:
+            if current is _marker or element < current:
+                current = element
+            yield current
+        return
+
+    maxlen = _validate_window_maxlen(maxlen)
+    queue = deque()
+    for index, element in enumerate(iterable):
+        while queue and queue[-1][0] > element:
+            queue.pop()
+        queue.append((element, index))
+        threshold = index - maxlen
+        while queue and queue[0][1] <= threshold:
+            queue.popleft()
+        yield queue[0][0]
+
+
+def running_max(iterable, *, maxlen=None):
+    """Yield the running maximum of *iterable*.
+
+    With the default ``maxlen=None``, each value is the maximum seen so far.
+    When *maxlen* is provided, restrict the maximum to the last ``maxlen``
+    elements.
+    """
+    if maxlen is None:
+        current = _marker
+        for element in iterable:
+            if current is _marker or current < element:
+                current = element
+            yield current
+        return
+
+    maxlen = _validate_window_maxlen(maxlen)
+    queue = deque()
+    for index, element in enumerate(iterable):
+        while queue and queue[-1][0] < element:
+            queue.pop()
+        queue.append((element, index))
+        threshold = index - maxlen
+        while queue and queue[0][1] <= threshold:
+            queue.popleft()
+        yield queue[0][0]
+
+
