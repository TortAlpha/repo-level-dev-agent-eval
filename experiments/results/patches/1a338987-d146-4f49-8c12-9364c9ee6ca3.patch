@@ -0,0 +1,13 @@
+from parse import parse
+
+
+def test_precision_zero_float_no_decimal():
+    assert parse("a {:.0f} b", "a 12 b")[0] == 12.0
+
+
+def test_precision_zero_float_with_width():
+    assert parse("foo_{:02.0f}t", "foo_20t")[0] == 20.0
+
+
+def test_precision_zero_float_rejects_decimal():
+    assert parse("a {:.0f} b", "a 12.0 b") is None
