--- /dev/null
+++ b/tests/test_wait_exponential_jitter_min.py
@@ -0,0 +1,22 @@
+import datetime
+
+import tenacity
+from tests.test_tenacity import make_retry_state
+
+
+def test_wait_exponential_jitter_min_bound() -> None:
+    fn = tenacity.wait_exponential_jitter(initial=1, max=60, min=30)
+    for _ in range(1000):
+        assert fn(make_retry_state(1, 0)) >= 30
+
+
+def test_wait_exponential_jitter_timedelta() -> None:
+    fn = tenacity.wait_exponential_jitter(
+        initial=1,
+        max=datetime.timedelta(seconds=60),
+        jitter=datetime.timedelta(seconds=1),
+        min=datetime.timedelta(seconds=30),
+    )
+    for _ in range(1000):
+        assert fn(make_retry_state(1, 0)) >= 30
+        assert fn(make_retry_state(7, 0)) == 60
