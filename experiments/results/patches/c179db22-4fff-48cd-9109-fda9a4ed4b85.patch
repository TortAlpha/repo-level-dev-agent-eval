+#!/usr/bin/env python
+
+"""Regression tests for naturalsize rounding at unit boundaries."""
+
+from __future__ import annotations
+
+import pytest
+
+import humanize
+
+
+@pytest.mark.parametrize(
+    "args, expected",
+    [
+        ([999999.95], "1.0 MB"),
+        ([1048575.95, True], "1.0 MiB"),
+        ([1048575.95, False, True], "1.0M"),
+    ],
+)
+def test_naturalsize_rounding_carryover(args: list[float | int | bool], expected: str) -> None:
+    assert humanize.naturalsize(*args) == expected
+
+
+def test_naturalsize_negative_rounding_carryover() -> None:
+    assert humanize.naturalsize(-999999.95) == "-1.0 MB"
+    assert humanize.naturalsize(-1048575.95, True) == "-1.0 MiB"
