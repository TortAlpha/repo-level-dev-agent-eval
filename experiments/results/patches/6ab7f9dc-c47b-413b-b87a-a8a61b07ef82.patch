--- /dev/null
+++ b/h11/tests/test_content_length_limit.py
@@ -0,0 +1,31 @@
+import pytest
+
+from .._headers import normalize_and_validate
+from .._util import LocalProtocolError
+
+
+def test_normal_content_length_still_works() -> None:
+    assert normalize_and_validate([("Content-Length", "0")]) == [
+        (b"content-length", b"0")
+    ]
+    assert normalize_and_validate([("Content-Length", "42")]) == [
+        (b"content-length", b"42")
+    ]
+    # A large but reasonable value should still be accepted.
+    assert normalize_and_validate(
+        [("Content-Length", "9223372036854775807")]
+    ) == [(b"content-length", b"9223372036854775807")]
+
+
+def test_pathologically_long_content_length_rejected() -> None:
+    # A crafted very long digit string must be rejected promptly as a
+    # protocol error, not parsed as a huge integer.
+    with pytest.raises(LocalProtocolError):
+        normalize_and_validate([("Content-Length", "9" * 100)])
+
+
+def test_too_large_content_length_rejected() -> None:
+    # A value that is syntactically valid but unreasonably large must be
+    # rejected as a protocol error.
+    with pytest.raises(LocalProtocolError):
+        normalize_and_validate([("Content-Length", "9223372036854775808")])
