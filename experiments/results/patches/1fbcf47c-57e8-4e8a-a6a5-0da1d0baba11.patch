+import datetime
+import unittest
+from unittest import mock
+
+import tenacity
+from tenacity import RetryCallState
+
+
+def make_retry_state(
+    previous_attempt_number,
+    delay_since_first_attempt,
+    last_result=None,
+    upcoming_sleep=0,
+):
+    retry_state = RetryCallState(None, None, (), {})
+    retry_state.attempt_number = previous_attempt_number
+    if last_result is not None:
+        retry_state.outcome = last_result
+    else:
+        retry_state.set_result(None)
+    retry_state.upcoming_sleep = upcoming_sleep
+    # Use the same approach as the original test file
+    import time
+    retry_state.start_time = time.monotonic() - delay_since_first_attempt
+    return retry_state
+
+
+class TestWaitExponentialJitterMin(unittest.TestCase):
+    def test_wait_exponential_jitter_min_floors_wait(self) -> None:
+        fn = tenacity.wait_exponential_jitter(initial=1, max=60, min=5)
+        with mock.patch("random.uniform", return_value=0):
+            for attempt in (1, 2, 3):
+                rs = make_retry_state(attempt, 0)
+                wait = fn(rs)
+                self.assertGreaterEqual(wait, 5)
+
+    def test_wait_exponential_jitter_timedelta_params(self) -> None:
+        fn = tenacity.wait_exponential_jitter(
+            max=datetime.timedelta(seconds=60),
+            jitter=datetime.timedelta(seconds=1),
+            min=datetime.timedelta(seconds=5),
+        )
+        # Attributes should be numeric (seconds)
+        self.assertIsInstance(fn.max, (int, float))
+        self.assertIsInstance(fn.jitter, (int, float))
+        self.assertIsInstance(fn.min, (int, float))
+        self.assertEqual(fn.max, 60)
+        self.assertEqual(fn.jitter, 1)
+        self.assertEqual(fn.min, 5)
+        # Should work when called
+        with mock.patch("random.uniform", return_value=0):
+            rs = make_retry_state(1, 0)
+            wait = fn(rs)
+            self.assertGreaterEqual(wait, 5)
+
+    def test_wait_exponential_jitter_min_default_zero(self) -> None:
+        fn = tenacity.wait_exponential_jitter(initial=1, max=60)
+        self.assertEqual(fn.min, 0)
+        with mock.patch("random.uniform", return_value=0):
+            rs = make_retry_state(1, 0)
+            wait = fn(rs)
+            self.assertEqual(wait, 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
