+++ b/tests/test_tick_delta_numeric.py
@@ -0,0 +1,68 @@
+import datetime
+
+from fractions import Fraction
+
+from freezegun import freeze_time
+
+
+START = datetime.datetime(2012, 1, 14, 12, 0, 0)
+
+
+def test_frozen_factory_int_delta():
+    with freeze_time(START) as ft:
+        result = ft.tick(1)
+        assert result == datetime.datetime(2012, 1, 14, 12, 0, 1)
+        assert ft() == result
+
+
+def test_frozen_factory_float_delta():
+    with freeze_time(START) as ft:
+        result = ft.tick(1.5)
+        assert result == datetime.datetime(2012, 1, 14, 12, 0, 1, 500000)
+        assert ft() == result
+
+
+def test_frozen_factory_fraction_delta():
+    with freeze_time(START) as ft:
+        result = ft.tick(Fraction(3, 2))
+        assert result == datetime.datetime(2012, 1, 14, 12, 0, 1, 500000)
+        assert ft() == result
+
+
+def test_frozen_factory_timedelta_delta():
+    with freeze_time(START) as ft:
+        result = ft.tick(datetime.timedelta(seconds=2))
+        assert result == datetime.datetime(2012, 1, 14, 12, 0, 2)
+        assert ft() == result
+
+
+def test_step_factory_int_delta():
+    with freeze_time(START, auto_tick_seconds=1) as ft:
+        result = ft.tick(2)
+        assert result == datetime.datetime(2012, 1, 14, 12, 0, 2)
+        assert ft() == datetime.datetime(2012, 1, 14, 12, 0, 2)
+        assert ft() == datetime.datetime(2012, 1, 14, 12, 0, 3)
+
+
+def test_step_factory_float_delta():
+    with freeze_time(START, auto_tick_seconds=1) as ft:
+        result = ft.tick(1.5)
+        assert result == datetime.datetime(2012, 1, 14, 12, 0, 1, 500000)
+        assert ft() == datetime.datetime(2012, 1, 14, 12, 0, 1, 500000)
+        assert ft() == datetime.datetime(2012, 1, 14, 12, 0, 2, 500000)
+
+
+def test_step_factory_fraction_delta():
+    with freeze_time(START, auto_tick_seconds=1) as ft:
+        result = ft.tick(Fraction(3, 2))
+        assert result == datetime.datetime(2012, 1, 14, 12, 0, 1, 500000)
+        assert ft() == datetime.datetime(2012, 1, 14, 12, 0, 1, 500000)
+        assert ft() == datetime.datetime(2012, 1, 14, 12, 0, 2, 500000)
+
+
+def test_step_factory_timedelta_delta():
+    with freeze_time(START, auto_tick_seconds=1) as ft:
+        result = ft.tick(datetime.timedelta(seconds=2))
+        assert result == datetime.datetime(2012, 1, 14, 12, 0, 2)
+        assert ft() == datetime.datetime(2012, 1, 14, 12, 0, 2)
+        assert ft() == datetime.datetime(2012, 1, 14, 12, 0, 3)
