+def running_statistics(iterable, *, maxlen=None):
+    """Yield stats summarizing the running window of *iterable*."""
+    if maxlen is not None:
+        if not isinstance(maxlen, int):
+            raise TypeError('maxlen must be an integer')
+        if maxlen <= 0:
+            raise ValueError('maxlen must be positive')
+    window = deque()
+    sorted_window = []
+    total = 0.0
+    iterator = iter(iterable)
+    for value in iterator:
+        window.append(value)
+        insort(sorted_window, value)
+        total += float(value)
+        if maxlen is not None and len(window) > maxlen:
+            removed = window.popleft()
+            idx = bisect_left(sorted_window, removed)
+            sorted_window.pop(idx)
+            total -= float(removed)
+        size = len(window)
+        if size % 2 == 1:
+            median = sorted_window[size // 2]
+        else:
+            middle = size // 2
+            median = (sorted_window[middle - 1] + sorted_window[middle]) / 2
+        mean = total / size
+        yield Stats(
+            size=size,
+            minimum=sorted_window[0],
+            median=median,
+            maximum=sorted_window[-1],
+            mean=mean,
+        )
+
