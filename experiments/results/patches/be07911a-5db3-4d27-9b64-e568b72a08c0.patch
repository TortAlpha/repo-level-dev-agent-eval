+class RunningStatisticsTests(TestCase):
+    def test_unbounded_window(self):
+        iterator = mi.running_statistics([4, 3, 7])
+        self.assertEqual(
+            next(iterator),
+            mi.Stats(size=1, minimum=4, median=4, maximum=4, mean=4.0),
+        )
+        self.assertEqual(
+            next(iterator),
+            mi.Stats(size=2, minimum=3, median=3.5, maximum=4, mean=3.5),
+        )
+        self.assertEqual(
+            next(iterator),
+            mi.Stats(size=3, minimum=3, median=4, maximum=7, mean=14 / 3),
+        )
+
+    def test_bounded_window(self):
+        iterator = mi.running_statistics(range(1, 6), maxlen=3)
+        expected = [
+            mi.Stats(size=1, minimum=1, median=1, maximum=1, mean=1.0),
+            mi.Stats(size=2, minimum=1, median=1.5, maximum=2, mean=1.5),
+            mi.Stats(size=3, minimum=1, median=2, maximum=3, mean=2.0),
+            mi.Stats(size=3, minimum=2, median=3, maximum=4, mean=3.0),
+            mi.Stats(size=3, minimum=3, median=4, maximum=5, mean=4.0),
+        ]
+        self.assertEqual(list(iterator), expected)
+
+    def test_invalid_maxlen(self):
+        with self.assertRaises(TypeError):
+            list(mi.running_statistics([1], maxlen=2.5))
+        with self.assertRaises(ValueError):
+            list(mi.running_statistics([1], maxlen=0))
+
