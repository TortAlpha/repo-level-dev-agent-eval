@@ -0,0 +1,21 @@
+import pytest
+from parse import parse
+
+
+def test_precision0_float_without_decimal():
+    # Should accept integers when precision=0 and return float
+    result = parse("a {:.0f} b", "a 12 b")
+    assert result is not None
+    assert result[0] == 12.0
+
+
+def test_precision0_float_without_decimal_with_width_and_zero_fill():
+    # Should accept zero-padded integers when precision=0
+    result = parse("foo_{:02.0f}t", "foo_20t")
+    assert result is not None
+    assert result[0] == 20.0
+
+
+def test_precision0_float_decimal_point_fails():
+    # Should not match when input has a decimal point
+    assert parse("a {:.0f} b", "a 12.0 b") is None
