+# -*- coding: utf-8 -*-
+# Copyright 2024 Ansible Project
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import annotations
+
+import pytest
+
+from ansible.module_utils.common.text.formatters import human_to_bytes
+
+
+@pytest.mark.parametrize(
+    'test_input',
+    [
+        '10 BBQ sticks please',
+        '1 EBOOK please',
+        '3 prettybytes',
+        '12,000 MB',
+        u'1\u200b000 MB',  # U+200B zero-width space
+        u'8\U00016b59B',  # 8 + ogham digit nine + B
+        u'\u1c54 MB',  # Myanmar digit four + MB
+    ]
+)
+def test_human_to_bytes_rejects_malformed_inputs(test_input):
+    'Malformed inputs from the strict parsing issue must raise ValueError.'
+    with pytest.raises(ValueError):
+        human_to_bytes(test_input)
