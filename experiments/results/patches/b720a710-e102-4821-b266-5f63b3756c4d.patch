+def subfactorial(n):
+    """Return the number of derangements (subfactorial) of *n* items.
+
+    For *n* > 0, the subfactorial is ``round(math.factorial(n) / math.e)``.
+    """
+    if not isinstance(n, int):
+        raise TypeError(
+            "n must be an integer, got {}".format(type(n).__name__)
+        )
+
+    if n < 0:
+        raise ValueError("n must be non-negative")
+
+    if n == 0:
+        return 1
+
+    if n == 1:
+        return 0
+
+    prev_two, prev_one = 1, 0
+    for i in range(2, n + 1):
+        current = (i - 1) * (prev_one + prev_two)
+        prev_two, prev_one = prev_one, current
+
+    return prev_one
+
+
