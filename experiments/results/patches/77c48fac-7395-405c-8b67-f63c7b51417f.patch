@@ -0,0 +1,19 @@
+import pytest
+from toolz.itertoolz import partition_all
+
+
+def test_partition_all_bad_len():
+    class BadLen:
+        def __init__(self, data, length):
+            self.data = data
+            self.length = length
+        def __iter__(self):
+            return iter(self.data)
+        def __len__(self):
+            return self.length
+    with pytest.raises(LookupError):
+        list(partition_all(4, BadLen([1, 2, 3, 4, 5], 7)))
+    with pytest.raises(LookupError):
+        list(partition_all(4, BadLen([1, 2, 3, 4, 5], 3)))
+    with pytest.raises(LookupError):
+        list(partition_all(4, BadLen([1, 2, 3, 4, 5], 8)))
