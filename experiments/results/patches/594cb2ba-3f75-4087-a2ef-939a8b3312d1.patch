+class strftime_convert:
+    """Convert text using a strptime format specification."""
+
+    DATE_DIRECTIVES = set("aAwdbBmyYjUVWGucx")
+    TIME_DIRECTIVES = set("HIpMSfXc")
+    TIMEZONE_DIRECTIVES = set("zZ")
+    DIRECTIVES = DATE_DIRECTIVES | TIME_DIRECTIVES | TIMEZONE_DIRECTIVES
+
+    def __init__(self, format):
+        self.format = format
+        directives = self._directives(format)
+        self.has_date = bool(directives & self.DATE_DIRECTIVES)
+        self.has_time = bool(directives & self.TIME_DIRECTIVES)
+        self.has_timezone = bool(directives & self.TIMEZONE_DIRECTIVES)
+
+    @staticmethod
+    def _directives(format):
+        directives = set()
+        index = 0
+        while index < len(format):
+            if format[index] != "%":
+                index += 1
+                continue
+            index += 1
+            if index < len(format) and format[index] == "%":
+                index += 1
+                continue
+            if index < len(format) and format[index] in "EO":
+                index += 1
+            if index < len(format):
+                directives.add(format[index])
+                index += 1
+        return directives
+
+    def __call__(self, string, match):
+        value = datetime.strptime(string, self.format)
+        if self.has_date and not self.has_time and not self.has_timezone:
+            return value.date()
+        if not self.has_date:
+            return value.timetz() if self.has_timezone else value.time()
+        return value
+
