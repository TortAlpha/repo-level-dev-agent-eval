diff --git a/tests/test_strftime.py b/tests/test_strftime.py
new file mode 100644
index 0000000000000000000000000000000000000000..29f7bbf32c1f169b81d6d1f353fb6471bfe666e6
--- /dev/null
+++ b/tests/test_strftime.py
@@ -0,0 +1,24 @@
+from datetime import date, datetime, time, timedelta, timezone
+
+from parse import parse
+
+
+def test_strftime_date_formats_return_dates():
+    assert parse("a {:%Y-%m-%d} b", "a 1997-07-16 b")[0] == date(1997, 7, 16)
+    assert parse("a {:%Y-%b-%d} b", "a 1997-Feb-16 b")[0] == date(1997, 2, 16)
+
+
+def test_strftime_time_and_timezone_formats():
+    assert parse("at {:%H:%M}", "at 14:30")[0] == time(14, 30)
+    assert parse("at {:%Y-%m-%d %H:%M:%S%z}", "at 1997-07-16 14:30:45+0230")[0] == datetime(
+        1997, 7, 16, 14, 30, 45, tzinfo=timezone(timedelta(hours=2, minutes=30))
+    )
+
+
+def test_multiple_strftime_fields_mix_with_existing_types():
+    result = parse(
+        "{start:%Y-%m-%d} at {clock:%H:%M}, count {count:d}",
+        "1997-07-16 at 14:30, count 3",
+    )
+
+    assert result.named == {"start": date(1997, 7, 16), "clock": time(14, 30), "count": 3}
