diff --git a/tests/test_wait_exponential_jitter_min.py b/tests/test_wait_exponential_jitter_min.py
new file mode 100644
index 0000000..dd4f415
--- /dev/null
+++ b/tests/test_wait_exponential_jitter_min.py
@@ -0,0 +1,55 @@
+import datetime
+import unittest
+
+import tenacity
+from tenacity import RetryCallState
+
+
+def make_retry_state(previous_attempt_number, delay_since_first_attempt=0):
+    retry_state = RetryCallState(None, None, (), {})  # type: ignore[arg-type]
+    retry_state.attempt_number = previous_attempt_number
+    retry_state.set_result(None)
+    retry_state.upcoming_sleep = 0
+    start = retry_state.start_time
+    retry_state.outcome_timestamp = start + delay_since_first_attempt
+    return retry_state
+
+
+class TestWaitExponentialJitterMin(unittest.TestCase):
+    def test_min_bound_enforced(self) -> None:
+        fn = tenacity.wait_exponential_jitter(initial=1, max=60, min=10)
+        for _ in range(1000):
+            self.assertEqual(fn(make_retry_state(1, 0)), 10)
+            self.assertEqual(fn(make_retry_state(2, 0)), 10)
+            self.assertEqual(fn(make_retry_state(3, 0)), 10)
+            self.assertEqual(fn(make_retry_state(4, 0)), 10)
+
+    def test_min_bound_with_max(self) -> None:
+        fn = tenacity.wait_exponential_jitter(initial=1, max=5, min=3)
+        for _ in range(1000):
+            self.assertGreaterEqual(fn(make_retry_state(1, 0)), 3)
+            self.assertLessEqual(fn(make_retry_state(1, 0)), 5)
+
+    def test_timedelta_min_max_jitter(self) -> None:
+        fn = tenacity.wait_exponential_jitter(
+            initial=1,
+            max=datetime.timedelta(seconds=60),
+            jitter=datetime.timedelta(seconds=1),
+            min=datetime.timedelta(seconds=10),
+        )
+        for _ in range(1000):
+            self.assertEqual(fn(make_retry_state(1, 0)), 10)
+            self.assertEqual(fn(make_retry_state(2, 0)), 10)
+            self.assertEqual(fn(make_retry_state(3, 0)), 10)
+            self.assertEqual(fn(make_retry_state(4, 0)), 10)
+
+    def test_plain_numbers_backward_compat(self) -> None:
+        fn = tenacity.wait_exponential_jitter(max=60)
+        for _ in range(1000):
+            self.assertGreaterEqual(fn(make_retry_state(1, 0)), 1)
+            self.assertLessEqual(fn(make_retry_state(1, 0)), 2)
+            self.assertEqual(fn(make_retry_state(7, 0)), 60)
+
+
+if __name__ == "__main__":
+    unittest.main()
