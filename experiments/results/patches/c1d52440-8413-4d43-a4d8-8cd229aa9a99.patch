@@ -0,0 +1,37 @@
+import datetime
+from fractions import Fraction
+import pytest
+
+from freezegun import freeze_time
+
+
+@pytest.mark.parametrize("delta, expected", [
+    (0, datetime.timedelta(seconds=0)),
+    (0.0, datetime.timedelta(seconds=0)),
+    (Fraction(0, 1), datetime.timedelta(seconds=0)),
+    (3, datetime.timedelta(seconds=3)),
+    (2.75, datetime.timedelta(seconds=2.75)),
+    (Fraction(5, 2), datetime.timedelta(seconds=2.5)),
+    (-4, datetime.timedelta(seconds=-4)),
+    (Fraction(-1, 4), datetime.timedelta(seconds=-0.25)),
+    (datetime.timedelta(minutes=2), datetime.timedelta(minutes=2)),
+])
+def test_tick_delta_with_tick_option(delta, expected):
+    start = datetime.datetime(2020, 1, 1, 0, 0, 0)
+    with freeze_time(start, tick=True) as frozen:
+        # before ticking, now() should be at the start
+        assert datetime.datetime.now() == start
+        # tick by delta and verify return value and now()
+        result = frozen.tick(delta)
+        assert isinstance(result, datetime.datetime)
+        assert result == start + expected
+        assert datetime.datetime.now() == result
+
+
+def test_default_tick_is_one_second_for_tick_option():
+    start = datetime.datetime(2020, 1, 1, 12, 0, 0)
+    with freeze_time(start, tick=True) as frozen:
+        # default tick with no args should advance by 1 second
+        result = frozen.tick()
+        assert result == start + datetime.timedelta(seconds=1)
+        assert datetime.datetime.now() == result
