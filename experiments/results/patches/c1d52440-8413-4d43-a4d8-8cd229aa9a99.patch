--- /dev/null
+++ b/tests/test_numeric_delta_tick.py
@@ -0,0 +1,41 @@
+import datetime
+from fractions import Fraction
+
+import pytest
+
+from freezegun import freeze_time
+
+
+@pytest.mark.parametrize("delta, expected", [
+    (10, datetime.timedelta(seconds=10)),
+    (2.5, datetime.timedelta(seconds=2.5)),
+    (Fraction(3, 2), datetime.timedelta(seconds=1.5)),
+    (datetime.timedelta(minutes=1), datetime.timedelta(minutes=1)),
+])
+def test_tick_delta_without_auto(delta, expected):
+    start = datetime.datetime(2000, 1, 1, 0, 0, 0)
+    with freeze_time(start) as frozen:
+        result = frozen.tick(delta)
+        # tick() should return the new frozen time relative to the start
+        assert isinstance(result, datetime.datetime)
+        assert result == start + expected
+        # now() should match the returned value
+        assert datetime.datetime.now() == result
+
+
+@pytest.mark.parametrize("delta, expected", [
+    (5, datetime.timedelta(seconds=5)),
+    (3.25, datetime.timedelta(seconds=3.25)),
+    (Fraction(7, 2), datetime.timedelta(seconds=3.5)),
+    (datetime.timedelta(hours=2), datetime.timedelta(hours=2)),
+])
+def test_tick_delta_with_auto(delta, expected):
+    start = datetime.datetime(2001, 6, 1, 12, 0, 0)
+    # auto_tick_seconds > 0 selects StepTickTimeFactory
+    with freeze_time(start, auto_tick_seconds=1) as frozen:
+        result = frozen.tick(delta)
+        # tick() should return the new frozen time relative to the start
+        assert isinstance(result, datetime.datetime)
+        assert result == start + expected
+        # now() should return the same value (before auto-step)
+        assert datetime.datetime.now() == result
