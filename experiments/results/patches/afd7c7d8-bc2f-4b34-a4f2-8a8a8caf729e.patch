--- /dev/null
+++ b/tests/test_urlsplit_ipv6_fragment.py
@@ -0,0 +1,85 @@
+"""Regression tests for _urlsplit fragment detection with IPv6 netlocs."""
+
+from w3lib._url import _urlsplit
+from w3lib.url import safe_url_string, canonicalize_url
+
+
+def test_urlsplit_ipv6_query_fragment():
+    url = "http://[::1]?q=1#frag"
+    result = _urlsplit(url)
+    assert result.scheme == "http"
+    assert result.netloc == "[::1]"
+    assert result.path == ""
+    assert result.query == "q=1"
+    assert result.fragment == "frag"
+
+
+def test_urlsplit_ipv6_path_query_fragment():
+    url = "http://[::1]/path?q=1#frag"
+    result = _urlsplit(url)
+    assert result.scheme == "http"
+    assert result.netloc == "[::1]"
+    assert result.path == "/path"
+    assert result.query == "q=1"
+    assert result.fragment == "frag"
+
+
+def test_safe_url_string_ipv6_query_fragment():
+    url = "http://[::1]?q=1#frag"
+    assert safe_url_string(url) == "http://[::1]?q=1#frag"
+
+
+def test_safe_url_string_ipv6_path_query_fragment():
+    url = "http://[::1]/path?q=1#frag"
+    assert safe_url_string(url) == "http://[::1]/path?q=1#frag"
+
+
+def test_canonicalize_url_ipv6_query_fragment():
+    # canonicalize_url removes fragments by default
+    url = "http://[::1]?q=1#frag"
+    assert canonicalize_url(url) == "http://[::1]/?q=1"
+
+
+def test_canonicalize_url_ipv6_path_query_fragment():
+    url = "http://[::1]/path?q=1#frag"
+    assert canonicalize_url(url) == "http://[::1]/path?q=1"
+
+
+def test_canonicalize_url_ipv6_keep_fragment():
+    url = "http://[::1]?q=1#frag"
+    assert canonicalize_url(url, keep_fragments=True) == "http://[::1]/?q=1#frag"
+
+
+def test_canonicalize_url_ipv6_path_keep_fragment():
+    url = "http://[::1]/path?q=1#frag"
+    assert canonicalize_url(url, keep_fragments=True) == "http://[::1]/path?q=1#frag"
+
+
+def test_urlsplit_normal_url_unchanged():
+    url = "http://example.com/path?q=1#frag"
+    result = _urlsplit(url)
+    assert result.scheme == "http"
+    assert result.netloc == "example.com"
+    assert result.path == "/path"
+    assert result.query == "q=1"
+    assert result.fragment == "frag"
+
+
+def test_urlsplit_ipv6_no_fragment():
+    url = "http://[::1]?q=1"
+    result = _urlsplit(url)
+    assert result.scheme == "http"
+    assert result.netloc == "[::1]"
+    assert result.path == ""
+    assert result.query == "q=1"
+    assert result.fragment == ""
+
+
+def test_urlsplit_ipv6_no_query():
+    url = "http://[::1]/path#frag"
+    result = _urlsplit(url)
+    assert result.scheme == "http"
+    assert result.netloc == "[::1]"
+    assert result.path == "/path"
+    assert result.query == ""
+    assert result.fragment == "frag"
