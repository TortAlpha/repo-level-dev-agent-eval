@@ -0,0 +1,43 @@
+import io
+
+from dotenv.parser import Binding, Original, parse_stream
+
+
+def test_parse_stream_strips_leading_utf8_bom():
+    content = "\ufeffFIRST=value1\nSECOND=value2"
+    result = list(parse_stream(io.StringIO(content)))
+
+    assert result == [
+        Binding(
+            key="FIRST",
+            value="value1",
+            original=Original(string="FIRST=value1\n", line=1),
+            error=False,
+        ),
+        Binding(
+            key="SECOND",
+            value="value2",
+            original=Original(string="SECOND=value2", line=2),
+            error=False,
+        ),
+    ]
+
+
+def test_parse_stream_without_bom_unchanged():
+    content = "FIRST=value1\nSECOND=value2"
+    result = list(parse_stream(io.StringIO(content)))
+
+    assert result == [
+        Binding(
+            key="FIRST",
+            value="value1",
+            original=Original(string="FIRST=value1\n", line=1),
+            error=False,
+        ),
+        Binding(
+            key="SECOND",
+            value="value2",
+            original=Original(string="SECOND=value2", line=2),
+            error=False,
+        ),
+    ]
