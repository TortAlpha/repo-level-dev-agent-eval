+def test_unregister_plugin_with_multiple_hookimpls(pm: PluginManager) -> None:
+    class Hooks:
+        @hookspec
+        def he_multiimpl(self, value: int) -> int:
+            return value
+
+    pm.add_hookspecs(Hooks)
+
+    class Plugin:
+        @hookimpl
+        def he_multiimpl(self, value: int) -> int:
+            return value + 1
+
+        @hookimpl(specname="he_multiimpl")
+        def he_multiimpl_alias(self, value: int) -> int:
+            return value + 2
+
+    plugin = Plugin()
+    pm.register(plugin)
+    assert len(pm.hook.he_multiimpl.get_hookimpls()) == 2
+
+    pm.unregister(plugin)
+    assert pm.hook.he_multiimpl.get_hookimpls() == []
+    assert pm.get_hookcallers(plugin) is None
+
+
+def test_get_hookcallers_dedups_multiple_impls(pm: PluginManager) -> None:
+    class Hooks:
+        @hookspec
+        def he_multiimpl(self, value: int) -> int:
+            return value
+
+    pm.add_hookspecs(Hooks)
+
+    class Plugin:
+        @hookimpl
+        def he_multiimpl(self, value: int) -> int:
+            return value + 1
+
+        @hookimpl(specname="he_multiimpl")
+        def he_multiimpl_alias(self, value: int) -> int:
+            return value + 2
+
+    plugin = Plugin()
+    pm.register(plugin)
+
+    hookcallers = pm.get_hookcallers(plugin)
+    assert hookcallers is not None
+    assert hookcallers == [pm.hook.he_multiimpl]
+
