+import pytest
+from humanize import naturalsize
+
+
+def test_decimal_boundary_rounds_up():
+    # 999950 is just below 1,000,000; rounding to one decimal gives 1000.0 kB
+    # which should carry over to 1.0 MB.
+    assert naturalsize(999950) == "1.0 MB"
+    assert naturalsize(-999950) == "-1.0 MB"
+
+
+def test_binary_boundary_rounds_up():
+    # 1024**2 - 1 = 1048575; dividing by 1024 gives 1023.999... -> 1024.0 KiB
+    # which should carry over to 1.0 MiB.
+    assert naturalsize(1024**2 - 1, binary=True) == "1.0 MiB"
+    assert naturalsize(-(1024**2 - 1), binary=True) == "-1.0 MiB"
+
+
+def test_gnu_boundary_rounds_up():
+    # GNU mode uses binary units (1024) and no space. 1024**2 - 1 should
+    # round up from 1024.0K to 1.0M.
+    assert naturalsize(1024**2 - 1, gnu=True) == "1.0M"
+    assert naturalsize(-(1024**2 - 1), gnu=True) == "-1.0M"
+
+
+def test_largest_suffix_does_not_advance():
+    # 10**30 is exactly 1.0 QB (quettabyte) in decimal; it must not become
+    # 1000.0 RB or similar.
+    assert naturalsize(10**30) == "1.0 QB"
+    assert naturalsize(-10**30) == "-1.0 QB"
+
+
+def test_non_boundary_values_unchanged():
+    # Values that do not cross a rounded boundary keep their suffix.
+    assert naturalsize(999949) == "999.9 kB"
+    # 1024**2 - 100 = 1048476 -> 1023.9 KiB (does not round up to 1024.0)
+    assert naturalsize(1024**2 - 100, binary=True) == "1023.9 KiB"
+    assert naturalsize(1024**2 - 100, gnu=True) == "1023.9K"
