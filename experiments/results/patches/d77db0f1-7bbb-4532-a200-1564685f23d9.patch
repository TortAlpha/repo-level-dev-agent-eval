index 0000000..a13aeef
--- /dev/null
+++ b/testing/test_regression_multi_impl.py
@@ -0,0 +1,51 @@
+"""Regression tests for plugin removal with multiple hook implementations."""
+
+import pytest
+import pluggy
+
+
+hookspec = pluggy.HookspecMarker("project")
+hookimpl = pluggy.HookimplMarker("project")
+
+
+@pytest.fixture
+def pm():
+    return pluggy.PluginManager("project")
+
+
+class Spec:
+    @hookspec
+    def hook(self):
+        pass
+
+
+class Plugin:
+    @hookimpl
+    def hook(self):
+        return "a"
+
+    @hookimpl(specname="hook")
+    def other_hook(self):
+        return "b"
+
+
+def test_unregister_removes_all_implementations(pm):
+    pm.add_hookspecs(Spec)
+    plugin = Plugin()
+    pm.register(plugin)
+    # Both implementations should be registered.
+    assert len(pm.hook.hook.get_hookimpls()) == 2
+    pm.unregister(plugin)
+    # All implementations belonging to the plugin should be removed.
+    assert len(pm.hook.hook.get_hookimpls()) == 0
+
+
+def test_get_hookcallers_no_duplicates(pm):
+    pm.add_hookspecs(Spec)
+    plugin = Plugin()
+    pm.register(plugin)
+    callers = pm.get_hookcallers(plugin)
+    assert callers is not None
+    # Only one HookCaller for the single hook, despite two implementations.
+    assert len(callers) == 1
+    assert callers[0].name == "hook"
