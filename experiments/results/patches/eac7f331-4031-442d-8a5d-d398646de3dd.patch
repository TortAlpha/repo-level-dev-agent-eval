diff --git a/tests/test_window.py b/tests/test_window.py
new file mode 100644
index 0000000..19df571
--- /dev/null
+++ b/tests/test_window.py
@@ -0,0 +1,48 @@
+import sqlparse
+from sqlparse.sql import Function, Identifier, Parenthesis, Name
+
+
+def _func(sql):
+    return sqlparse.parse(sql)[0].tokens[0]
+
+
+def test_get_parameters_no_over():
+    f = _func('foo(5)')
+    assert isinstance(f, Function)
+    params = f.get_parameters()
+    assert len(params) == 1
+
+
+def test_get_parameters_named_window():
+    f = _func('foo(5) OVER win1')
+    assert isinstance(f, Function)
+    params = f.get_parameters()
+    assert len(params) == 1
+
+
+def test_get_parameters_inline_window():
+    f = _func('foo(5) OVER (PARTITION BY c1)')
+    assert isinstance(f, Function)
+    params = f.get_parameters()
+    assert len(params) == 1
+
+
+def test_get_window_none():
+    f = _func('foo(5)')
+    assert isinstance(f, Function)
+    assert f.get_window() is None
+
+
+def test_get_window_named():
+    f = _func('foo(5) OVER win1')
+    assert isinstance(f, Function)
+    w = f.get_window()
+    assert w is not None
+    assert w.normalized == 'win1'
+
+
+def test_get_window_inline():
+    f = _func('foo(5) OVER (PARTITION BY c1)')
+    assert isinstance(f, Function)
+    w = f.get_window()
+    assert isinstance(w, Parenthesis)
