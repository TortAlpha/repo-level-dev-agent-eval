+def subfactorial(n):
+    """Return the number of derangements of *n* items.
+
+    A derangement is a permutation of *n* elements that leaves no element in
+    its original position (OEIS A000166).
+
+    ``subfactorial(n)`` agrees with ``len(list(derangements(range(n))))``.
+
+    Examples:
+
+        >>> subfactorial(5)
+        44
+
+    ``n`` must be a non-negative integer.
+    """
+    if not isinstance(n, Integral):
+        raise TypeError('n must be an integer')
+
+    n = int(n)
+
+    if n < 0:
+        raise ValueError('n must be >= 0')
+    if n == 0:
+        return 1
+
+    prev_prev = 1
+    prev = 0
+    for i in range(2, n + 1):
+        prev_prev, prev = prev, (i - 1) * (prev + prev_prev)
+    return prev
+
