index 0000000000000000000000000000000000000000..6ad0996dd039d842bc9328ae310c36fce4eec284
--- /dev/null
+++ b/tests/test_tick_numeric.py
@@ -0,0 +1,45 @@
+import datetime
+import fractions
+
+import pytest
+
+from freezegun import freeze_time
+from freezegun.api import FrozenDateTimeFactory, StepTickTimeFactory
+
+
+@pytest.mark.parametrize(
+    "delta",
+    [
+        0.5,
+        1.5,
+        -1.5,
+        fractions.Fraction(3, 2),
+        2,
+        -2,
+    ],
+)
+def test_frozen_tick_accepts_numeric_delta(delta):
+    factory = FrozenDateTimeFactory(datetime.datetime(2020, 1, 1, 0, 0, 0))
+    result = factory.tick(delta)
+    assert result == datetime.datetime(2020, 1, 1, 0, 0, 0) + datetime.timedelta(seconds=float(delta))
+
+
+def test_step_tick_accepts_numeric_delta():
+    factory = StepTickTimeFactory(datetime.datetime(2020, 1, 1, 0, 0, 0), 1)
+    result = factory.tick(2)
+    assert result == datetime.datetime(2020, 1, 1, 0, 0, 2)
+
+
+def test_ticking_tick_accepts_numeric_delta():
+    from freezegun.api import TickingDateTimeFactory
+    import datetime as dt
+
+    factory = TickingDateTimeFactory(dt.datetime(2020, 1, 1, 0, 0, 0), dt.datetime(2020, 1, 1, 0, 0, 0))
+    result = factory.tick(1.5)
+    assert result == dt.datetime(2020, 1, 1, 0, 0, 1, 500000)
+
+
+def test_frozen_tick_accepts_timedelta():
+    factory = FrozenDateTimeFactory(datetime.datetime(2020, 1, 1, 0, 0, 0))
+    result = factory.tick(datetime.timedelta(seconds=5))
+    assert result == datetime.datetime(2020, 1, 1, 0, 0, 5)
