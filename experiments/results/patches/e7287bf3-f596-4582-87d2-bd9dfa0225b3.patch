+++ b/tests/test_window_keyword.py
@@ -0,0 +1,20 @@
+import sqlparse
+from sqlparse import tokens
+
+
+def test_window_keyword_uppercase():
+    parsed = sqlparse.parse('WINDOW w AS')[0]
+    first = parsed.tokens[0]
+    assert first.ttype is tokens.Keyword
+
+
+def test_window_keyword_lowercase():
+    parsed = sqlparse.parse('window w as')[0]
+    first = parsed.tokens[0]
+    assert first.ttype is tokens.Keyword
+
+
+def test_window_keyword_mixedcase():
+    parsed = sqlparse.parse('Window w As')[0]
+    first = parsed.tokens[0]
+    assert first.ttype is tokens.Keyword
