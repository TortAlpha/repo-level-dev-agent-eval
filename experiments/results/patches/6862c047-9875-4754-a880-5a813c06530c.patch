@@ -0,0 +1,29 @@
+# -*- coding: utf-8 -*-
+# (c) 2020 Ansible Project
+# GNU General Public License v3.0+ (see COPYING or https://www.gnu.org/licenses/gpl-3.0.txt)
+
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+import pytest
+
+from ansible.module_utils.common.sys_info import get_distribution
+from ansible.module_utils.common.sys_info import get_distribution_version
+
+
+@pytest.mark.parametrize('system,expected_name,release,expected_version', [
+    ('Darwin', 'Darwin', '19.6.0', '19.6.0'),
+    ('SunOS', 'Solaris', '11.4', '11.4'),
+    ('FreeBSD', 'Freebsd', '12.1', '12.1'),
+])
+def test_get_distribution_non_linux(system, expected_name, release, expected_version, mocker):
+    mocker.patch('platform.system', return_value=system)
+    mocker.patch('platform.release', return_value=release)
+    assert get_distribution() == expected_name
+    assert get_distribution_version() == expected_version
+
+
+def test_get_distribution_unknown_non_linux_still_none(mocker):
+    mocker.patch('platform.system', return_value='Foo')
+    assert get_distribution() is None
+    assert get_distribution_version() is None
