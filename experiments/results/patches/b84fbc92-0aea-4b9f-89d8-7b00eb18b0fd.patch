+# -*- coding: utf-8 -*-
+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+import pytest
+
+from units.compat.mock import Mock, patch
+
+from ansible.module_utils.facts.network.linux import LinuxNetwork
+
+
+V4_OUTPUT = """local 127.0.0.0/8 dev lo proto kernel scope host src 127.0.0.1
+local 127.0.0.1 dev lo proto kernel scope host src 127.0.0.1
+local 192.168.0.1 dev eth0 proto kernel scope host src 192.168.0.1
+local 192.168.1.0/24 dev eth0 proto kernel scope host src 192.168.0.1
+broadcast 127.255.255.255 dev lo table local proto kernel scope link src 127.0.0.1
+"""
+
+V6_OUTPUT = """local ::1 dev lo proto kernel scope host src ::1
+local fe80::/64 dev eth0 proto kernel scope host src fe80::1
+"""
+
+
+def make_linux_network():
+    module = Mock()
+    module.get_bin_path = Mock(return_value='/sbin/ip')
+    module.warn = Mock()
+    return LinuxNetwork(module=module, load_on_init=False)
+
+
+def run_command_map(rc_v4=0, out_v4=V4_OUTPUT, rc_v6=0, out_v6=V6_OUTPUT):
+    def _run_command(args, errors=None):
+        if '-4' in args:
+            return (rc_v4, out_v4, '')
+        if '-6' in args:
+            return (rc_v6, out_v6, '')
+        return (0, '', '')
+    return _run_command
+
+
+def test_get_locally_reachable_ips_v4_v6():
+    net = make_linux_network()
+    net.module.run_command = Mock(side_effect=run_command_map())
+    result = net.get_locally_reachable_ips('/sbin/ip')
+    assert result['ipv4'] == ['127.0.0.0/8', '127.0.0.1', '192.168.0.1', '192.168.1.0/24']
+    assert result['ipv6'] == ['::1', 'fe80::/64']
+
+
+def test_get_locally_reachable_ips_none_ip_path():
+    net = make_linux_network()
+    result = net.get_locally_reachable_ips(None)
+    assert result == {'ipv4': [], 'ipv6': []}
+    assert net.module.warn.called
+
+
+def test_get_locally_reachable_ips_command_failure():
+    net = make_linux_network()
+    net.module.run_command = Mock(side_effect=run_command_map(rc_v4=1, out_v4='', rc_v6=1, out_v6=''))
+    result = net.get_locally_reachable_ips('/sbin/ip')
+    assert result == {'ipv4': [], 'ipv6': []}
+    assert net.module.warn.called
+
+
+def test_get_locally_reachable_ips_dedup_and_sort():
+    net = make_linux_network()
+    v4 = """local 192.168.1.0/24 dev eth0 proto kernel scope host src 192.168.0.1
+local 192.168.1.0/24 dev eth0 proto kernel scope host src 192.168.0.1
+local 10.0.0.0/8 dev eth1 proto kernel scope host src 10.0.0.1
+"""
+    net.module.run_command = Mock(side_effect=run_command_map(out_v4=v4, out_v6=''))
+    result = net.get_locally_reachable_ips('/sbin/ip')
+    assert result['ipv4'] == ['10.0.0.0/8', '192.168.1.0/24']
+    assert result['ipv6'] == []
+
+
+def test_populate_includes_locally_reachable_ips():
+    net = make_linux_network()
+    with patch.object(LinuxNetwork, 'get_default_interfaces', return_value=({}, {})):
+        with patch.object(LinuxNetwork, 'get_interfaces_info', return_value=({}, {'all_ipv4_addresses': [], 'all_ipv6_addresses': []})):
+            with patch.object(LinuxNetwork, 'get_locally_reachable_ips', return_value={'ipv4': ['127.0.0.0/8'], 'ipv6': ['::1']}) as mock_lr:
+                facts = net.populate()
+                assert 'locally_reachable_ips' in facts
+                assert facts['locally_reachable_ips'] == {'ipv4': ['127.0.0.0/8'], 'ipv6': ['::1']}
+                mock_lr.assert_called_once()
