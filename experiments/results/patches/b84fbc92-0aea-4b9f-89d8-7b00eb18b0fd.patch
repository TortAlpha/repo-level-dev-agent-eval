+    def get_locally_reachable_ips(self, ip_path):
+        result = {'ipv4': [], 'ipv6': []}
+        if not ip_path:
+            try:
+                self.module.warn('Unable to collect locally reachable IP ranges: ip command not found')
+            except Exception:
+                pass
+            return result
+
+        families = (
+            ('ipv4', [ip_path, '-4', 'route', 'show', 'table', 'local', 'scope', 'host']),
+            ('ipv6', [ip_path, '-6', 'route', 'show', 'table', 'local', 'scope', 'host']),
+        )
+
+        for family, command in families:
+            if family == 'ipv6' and not socket.has_ipv6:
+                continue
+            try:
+                rc, out, err = self.module.run_command(command, errors='surrogate_then_replace')
+            except Exception:
+                try:
+                    self.module.warn('Unable to collect locally reachable %s IP ranges: command failed' % family)
+                except Exception:
+                    pass
+                continue
+            if rc != 0 or not out:
+                try:
+                    self.module.warn('Unable to collect locally reachable %s IP ranges: no data' % family)
+                except Exception:
+                    pass
+                continue
+
+            entries = set()
+            for line in out.splitlines():
+                try:
+                    tokens = line.split()
+                    if 'local' not in tokens:
+                        continue
+                    idx = tokens.index('local')
+                    if idx + 1 >= len(tokens):
+                        continue
+                    addr = tokens[idx + 1]
+                    if '/' in addr:
+                        network = ipaddress.ip_network(addr, strict=False)
+                        if network.prefixlen == network.max_prefixlen:
+                            entries.add(str(network.network_address))
+                        else:
+                            entries.add(str(network))
+                    else:
+                        address = ipaddress.ip_address(addr)
+                        entries.add(str(address))
+                except Exception:
+                    continue
+
+            try:
+                result[family] = sorted(entries, key=lambda x: ipaddress.ip_network(x, strict=False))
+            except Exception:
+                result[family] = sorted(entries)
+
+        return result
+
