+def strftime_to_regex(fmt):
+    """Convert a strftime/strptime format string to a non-capturing regex."""
+    parts = []
+    i = 0
+    n = len(fmt)
+    while i < n:
+        c = fmt[i]
+        if c == '%':
+            if i + 1 < n:
+                d = fmt[i + 1]
+                if d == '%':
