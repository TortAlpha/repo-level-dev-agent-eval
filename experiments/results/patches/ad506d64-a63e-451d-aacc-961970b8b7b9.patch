+# -*- encoding: utf8 -*-
+"""Tests for strftime/strptime-style datetime format support in parse."""
+
+import unittest
+from datetime import date, datetime, time, timedelta
+
+import parse
+
+
+class TestStrftimeFormats(unittest.TestCase):
+    def test_date_ymd(self):
+        res = parse.parse("a {:%Y-%m-%d} b", "a 1997-07-16 b")
+        self.assertIsNotNone(res)
+        self.assertEqual(res[0], date(1997, 7, 16))
+
+    def test_date_yb(self):
+        res = parse.parse("a {:%Y-%b-%d} b", "a 1997-Feb-16 b")
+        self.assertIsNotNone(res)
+        self.assertEqual(res[0], date(1997, 2, 16))
+
+    def test_time_hms(self):
+        res = parse.parse("a {:%H:%M:%S} b", "a 12:30:45 b")
+        self.assertIsNotNone(res)
+        self.assertEqual(res[0], time(12, 30, 45))
+
+    def test_datetime_with_tz(self):
+        res = parse.parse(
+            "a {:%Y-%m-%dT%H:%M:%S%z} b", "a 1997-07-16T12:30:45+0500 b"
+        )
+        self.assertIsNotNone(res)
+        value = res[0]
+        self.assertIsInstance(value, datetime)
+        self.assertEqual(value.utcoffset(), timedelta(hours=5))
+        self.assertEqual(
+            value.replace(tzinfo=None), datetime(1997, 7, 16, 12, 30, 45)
+        )
+
+    def test_mix_date_time(self):
+        res = parse.parse(
+            "{:%Y-%m-%d} {:%H:%M:%S}", "1997-07-16 12:30:45"
+        )
+        self.assertIsNotNone(res)
+        self.assertEqual(
+            tuple(res.fixed), (date(1997, 7, 16), time(12, 30, 45))
+        )
+
+    def test_percentage_regression(self):
+        res = parse.parse("a {:%} b", "a 50% b")
+        self.assertIsNotNone(res)
+        self.assertEqual(res[0], 0.5)
+
+    def test_mix_with_other_types(self):
+        res = parse.parse(
+            "{:%Y-%m-%d} {:d} {:%H:%M:%S}", "1997-07-16 42 12:30:45"
+        )
+        self.assertIsNotNone(res)
+        self.assertEqual(
+            tuple(res.fixed), (date(1997, 7, 16), 42, time(12, 30, 45))
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()
