diff --git a/openlibrary/tests/core/test_wikidata_statement_values.py b/openlibrary/tests/core/test_wikidata_statement_values.py
new file mode 100644
index 000000000..cc8b3cd8b
--- /dev/null
+++ b/openlibrary/tests/core/test_wikidata_statement_values.py
@@ -0,0 +1,71 @@
+from datetime import datetime
+
+from openlibrary.core import wikidata
+
+
+def make_entity() -> wikidata.WikidataEntity:
+    return wikidata.WikidataEntity.from_dict(
+        {
+            'id': 'Q42',
+            'type': 'str',
+            'labels': {'en': ''},
+            'descriptions': {'en': ''},
+            'aliases': {'en': ['']},
+            'statements': {},
+            'sitelinks': {},
+        },
+        datetime.now(),
+    )
+
+
+def test_get_statement_values_multiple_preserve_order() -> None:
+    entity = make_entity()
+    entity.statements = {
+        'P31': [
+            {'value': {'content': 'Q5'}},
+            {'value': {'content': 'Q12345'}},
+        ]
+    }
+    assert entity.get_statement_values('P31') == ['Q5', 'Q12345']
+
+
+def test_get_statement_values_single() -> None:
+    entity = make_entity()
+    entity.statements = {'P569': [{'value': {'content': '1952-03-11'}}]}
+    assert entity.get_statement_values('P569') == ['1952-03-11']
+
+
+def test_get_statement_values_skips_invalid_entries() -> None:
+    entity = make_entity()
+    entity.statements = {
+        'P19': [
+            {'value': {'content': 'London'}},
+            {'value': {'content': ''}},
+            {'value': {}},
+            {},
+            {'value': {'content': 'Paris'}},
+            {'value': {'content': 12345}},
+            {'value': {'content': None}},
+            {'value': None},
+            None,
+        ]
+    }
+    assert entity.get_statement_values('P19') == ['London', 'Paris']
+
+
+def test_get_statement_values_empty_statement_list() -> None:
+    entity = make_entity()
+    entity.statements = {'P123': []}
+    assert entity.get_statement_values('P123') == []
+
+
+def test_get_statement_values_missing_property() -> None:
+    entity = make_entity()
+    entity.statements = {'P31': [{'value': {'content': 'Q5'}}]}
+    assert entity.get_statement_values('P999') == []
+
+
+def test_get_statement_values_no_statements() -> None:
+    entity = make_entity()
+    entity.statements = {}
+    assert entity.get_statement_values('P31') == []
