@@ -0,0 +1,25 @@
+import io
+
+from dotenv import dotenv_values
+from dotenv.parser import Binding, Original, parse_stream
+
+
+def test_dotenv_values_strips_leading_bom():
+    stream = io.StringIO("\ufeffFIRST=value1\nSECOND=value2\n")
+    assert dotenv_values(stream=stream) == {"FIRST": "value1", "SECOND": "value2"}
+
+
+def test_parse_stream_strips_leading_bom():
+    result = parse_stream(io.StringIO("\ufeffFIRST=value1\nSECOND=value2\n"))
+    assert list(result) == [
+        Binding(key="FIRST", value="value1", original=Original(string="FIRST=value1\n", line=1), error=False),
+        Binding(key="SECOND", value="value2", original=Original(string="SECOND=value2\n", line=2), error=False),
+    ]
+
+
+def test_parse_stream_preserves_internal_bom():
+    result = parse_stream(io.StringIO("FIRST=\ufeffvalue1\nSECOND=value2\n"))
+    assert list(result) == [
+        Binding(key="FIRST", value="\ufeffvalue1", original=Original(string="FIRST=\ufeffvalue1\n", line=1), error=False),
+        Binding(key="SECOND", value="value2", original=Original(string="SECOND=value2\n", line=2), error=False),
+    ]
