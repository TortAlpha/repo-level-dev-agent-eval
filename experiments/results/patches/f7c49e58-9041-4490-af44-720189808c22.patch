index 0000000000000000000000000000000000000000..d8ab9e9f40a893b0b919201f5df4d8cb388efcd4
--- /dev/null
+++ b/tests/test_wait_exponential_jitter.py
@@ -0,0 +1,44 @@
+import datetime
+import random
+
+from tenacity import wait_exponential_jitter
+from tenacity._utils import to_seconds
+
+
+class DummyRetryState:
+    def __init__(self, attempt_number):
+        self.attempt_number = attempt_number
+
+
+def test_min_bound_enforced(monkeypatch):
+    # Force jitter to zero so the bare exponential value is deterministic
+    monkeypatch.setattr(random, "uniform", lambda a, b: 0.0)
+    w = wait_exponential_jitter(initial=1, exp_base=2, jitter=1, min=5, max=100)
+    # Attempt 1: exp=1*2**0=1 +0 < min => returns min
+    assert w(DummyRetryState(attempt_number=1)) == 5.0
+    # Attempt 4: exp=1*2**3=8 +0 > min => returns the exp value
+    assert w(DummyRetryState(attempt_number=4)) == 8.0
+
+
+def test_timedelta_support(monkeypatch):
+    # Force jitter to its maximum for deterministic total
+    monkeypatch.setattr(random, "uniform", lambda a, b: b)
+    initial = 1
+    exp_base = 2
+    jitter_td = datetime.timedelta(seconds=3)
+    min_td = datetime.timedelta(seconds=2)
+    max_td = datetime.timedelta(seconds=20)
+    w = wait_exponential_jitter(
+        initial=initial,
+        exp_base=exp_base,
+        jitter=jitter_td,
+        min=min_td,
+        max=max_td,
+    )
+    # Attempt 1: exp=1*2**0=1 + jitter 3 = 4 => between min=2 and max=20
+    assert w(DummyRetryState(attempt_number=1)) == 4.0
+    # Attempt 4: exp=1*2**3=8 + jitter 3 = 11 => still within bounds
+    assert w(DummyRetryState(attempt_number=4)) == 11.0
+    # Very large attempt -> exp overflows to inf -> clipped to max
+    result = w(DummyRetryState(attempt_number=1000))
+    assert result == to_seconds(max_td)
