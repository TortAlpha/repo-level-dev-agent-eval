+++ b/tests/test_wait_exponential_jitter_timedelta_bounds.py
@@ -0,0 +1,52 @@
+import datetime
+import tenacity.wait as wait_module
+import pytest
+
+
+def test_wait_exponential_jitter_timedelta_conversion_and_bounds(monkeypatch):
+    # Stub out random.uniform to inspect its args and return a fixed jitter
+    def stub_uniform(a, b):
+        # a should be 0.0
+        assert isinstance(a, float) and a == 0.0
+        # jitter (b) must have been converted from timedelta to float seconds
+        assert isinstance(b, float) and b == 2.0
+        return 1.5
+
+    monkeypatch.setattr(wait_module.random, 'uniform', stub_uniform)
+
+    w = wait_module.wait_exponential_jitter(
+        initial=1,
+        exp_base=3,
+        jitter=datetime.timedelta(seconds=2),
+        min=datetime.timedelta(seconds=5),
+        max=datetime.timedelta(seconds=10),
+    )
+
+    class DummyState:
+        pass
+
+    # attempt_number=2: 1*3^1 + 1.5 = 4.5 -> lower bound to 5.0
+    DummyState.attempt_number = 2
+    assert w(DummyState) == 5.0
+
+    # attempt_number=3: 1*3^2 + 1.5 = 10.5 -> upper bound to 10.0
+    DummyState.attempt_number = 3
+    assert w(DummyState) == 10.0
+
+
+def test_wait_exponential_jitter_timedelta_smoke(monkeypatch):
+    # Verify timedelta args don't cause type errors and result is float within bounds
+    wait_module.random.seed(0)
+
+    w = wait_module.wait_exponential_jitter(
+        jitter=datetime.timedelta(seconds=0.5),
+        min=datetime.timedelta(seconds=0.1),
+        max=datetime.timedelta(seconds=2.0),
+    )
+
+    class DummyState:
+        attempt_number = 1
+
+    val = w(DummyState)
+    assert isinstance(val, float)
+    assert 0.1 <= val <= 2.0
