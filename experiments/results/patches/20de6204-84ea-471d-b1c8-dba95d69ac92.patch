             mock_get_from_cache.assert_not_called()
 
 
+def test_get_statement_values() -> None:
+    entity = createWikidataEntity()
+    entity.statements = {
+        'P31': [
+            {'value': {'content': 'Q5'}},
+            {'value': {'content': 'Q1234'}},
+            {'value': {}},
+            {},
+            {'value': {'content': ''}},
+            {'value': {'content': 123}},
+            {'value': {'content': 'Q6'}},
+        ],
+        'P123': [],
+    }
+
+    # Missing property returns empty list
+    assert entity.get_statement_values('P999') == []
+
+    # Empty statement list returns empty list
+    assert entity.get_statement_values('P123') == []
+
+    # Valid values are collected in order, invalid entries skipped
+    assert entity.get_statement_values('P31') == ['Q5', 'Q1234', 'Q6']
+
