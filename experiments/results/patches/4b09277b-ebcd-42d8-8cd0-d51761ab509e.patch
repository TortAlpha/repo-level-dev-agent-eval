@@ -0,0 +1,65 @@
+import io
+
+import pytest
+
+from dotenv.parser import Binding, Original, parse_stream
+
+
+@pytest.mark.parametrize(
+    "test_input,expected",
+    [
+        (
+            "\ufeffa=b\nSECOND=value2",
+            [
+                Binding(
+                    key="a",
+                    value="b",
+                    original=Original(string="a=b\n", line=1),
+                    error=False,
+                ),
+                Binding(
+                    key="SECOND",
+                    value="value2",
+                    original=Original(string="SECOND=value2", line=2),
+                    error=False,
+                ),
+            ],
+        ),
+        (
+            "\ufeffa=b",
+            [
+                Binding(
+                    key="a",
+                    value="b",
+                    original=Original(string="a=b", line=1),
+                    error=False,
+                )
+            ],
+        ),
+        (
+            "a=b",
+            [
+                Binding(
+                    key="a",
+                    value="b",
+                    original=Original(string="a=b", line=1),
+                    error=False,
+                )
+            ],
+        ),
+        (
+            "a\ufeff=b",
+            [
+                Binding(
+                    key="a\ufeff",
+                    value="b",
+                    original=Original(string="a\ufeff=b", line=1),
+                    error=False,
+                )
+            ],
+        ),
+    ],
+)
+def test_parse_stream_bom_strip(test_input, expected):
+    stream = io.StringIO(test_input)
+    assert list(parse_stream(stream)) == expected
