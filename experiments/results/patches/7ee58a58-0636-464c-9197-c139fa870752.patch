+++ b/sqlparse/sql.py
@@ -633,6 +633,21 @@ class Function(NameAliasMixin, TokenList):
                 result.append(token)
         return result
 
+    def get_window(self):
+        """Return the window of the function.
+        
+        For a named window (foo(5) OVER win1), returns the window identifier.
+        For an inline window (foo(5) OVER (PARTITION BY c1)), returns the 
+        parenthesised window definition.
+        Returns None when the function has no OVER clause.
+        """
+        # Look for OVER clause after the function call
+        for i, token in enumerate(self.tokens):
+            if isinstance(token, Over):
+                # Return the Over token which contains the window definition
+                return token
+        return None
+
 
 class Begin(TokenList):
     """A BEGIN/END block."""
