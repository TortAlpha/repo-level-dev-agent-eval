+++ b/tests/test_over.py
@@ -0,0 +1,50 @@
+"""Tests for Function.get_window() and OVER clause handling."""
+import sqlparse
+from sqlparse.sql import Function, Identifier, Parenthesis
+
+
+def _func(sql):
+    return sqlparse.parse(sql)[0].tokens[0]
+
+
+def test_get_window_none():
+    f = _func('foo(5)')
+    assert isinstance(f, Function)
+    assert f.get_window() is None
+
+
+def test_get_window_named():
+    f = _func('foo(5) OVER win1')
+    assert isinstance(f, Function)
+    win = f.get_window()
+    assert win is not None
+    assert win.value == 'win1'
+
+
+def test_get_window_inline():
+    f = _func('foo(5) OVER (PARTITION BY c1)')
+    assert isinstance(f, Function)
+    win = f.get_window()
+    assert isinstance(win, Parenthesis)
+    assert 'PARTITION BY c1' in win.value
+
+
+def test_parameters_with_named_window():
+    f = _func('foo(5) OVER win1')
+    params = f.get_parameters()
+    assert len(params) == 1
+    assert params[0].value == '5'
+
+
+def test_parameters_with_inline_window():
+    f = _func('foo(5) OVER (PARTITION BY c1)')
+    params = f.get_parameters()
+    assert len(params) == 1
+    assert params[0].value == '5'
+
+
+def test_parameters_without_window():
+    f = _func('foo(5)')
+    params = f.get_parameters()
+    assert len(params) == 1
+    assert params[0].value == '5'
