diff --git a/tests/test_ticking_numeric_delta.py b/tests/test_ticking_numeric_delta.py
new file mode 100644
index 0000000000000000000000000000000000000000..592f4a3196f9a509c5d8bdabfe1d023013781bcc
--- /dev/null
+++ b/tests/test_ticking_numeric_delta.py
@@ -0,0 +1,53 @@
+import datetime
+from fractions import Fraction
+import pytest
+from freezegun import freeze_time
+from freezegun.api import StepTickTimeFactory
+
+
+def test_tick_fraction_seconds():
+    dt = datetime.datetime(2010, 1, 1)
+    with freeze_time(dt) as frozen:
+        ts = frozen.tick(Fraction(1, 2))
+        # Expect half a second
+        assert ts == dt + datetime.timedelta(seconds=0.5)
+
+
+def test_tick_float_seconds():
+    dt = datetime.datetime(2010, 1, 1)
+    with freeze_time(dt) as frozen:
+        ts = frozen.tick(1.5)
+        # Expect one and a half seconds
+        assert ts == dt + datetime.timedelta(seconds=1.5)
+
+
+def test_tick_zero_seconds():
+    dt = datetime.datetime(2010, 1, 1)
+    with freeze_time(dt) as frozen:
+        ts = frozen.tick(0)
+        # Zero seconds should leave time unchanged
+        assert ts == dt
+
+
+def test_auto_tick_fraction_seconds():
+    dt = datetime.datetime(2010, 1, 1)
+    stf = StepTickTimeFactory(dt, Fraction(3, 2))
+    ts = stf.tick()
+    # Expect one and a half seconds
+    assert ts == dt + datetime.timedelta(seconds=1.5)
+
+
+def test_auto_tick_float_seconds():
+    dt = datetime.datetime(2010, 1, 1)
+    stf = StepTickTimeFactory(dt, 2.75)
+    ts = stf.tick()
+    # Expect two and three-quarter seconds
+    assert ts == dt + datetime.timedelta(seconds=2.75)
+
+
+def test_auto_tick_zero_seconds():
+    dt = datetime.datetime(2010, 1, 1)
+    stf = StepTickTimeFactory(dt, 0)
+    ts = stf.tick()
+    # Zero seconds should leave time unchanged
+    assert ts == dt
