+def match_current_rt(rt, direction, current, rt_commands):
+    '''Compare desired route-target state to current config and append commands.'''
+    rt_value = rt['rt']
+    rt_state = rt.get('state', 'present')
+
+    directions = [direction] if direction != 'both' else ['import', 'export']
+
+    for direct in directions:
+        line = 'route-target %s %s' % (direct, rt_value)
+        present = line in current
+
+        if rt_state == 'present' and not present:
+            cmd = line
+            if cmd not in rt_commands:
+                rt_commands.append(cmd)
+        elif rt_state == 'absent' and present:
+            cmd = 'no ' + line
+            if cmd not in rt_commands:
+                rt_commands.append(cmd)
+
+    return rt_commands
+
