+from __future__ import (absolute_import, division, print_function)
+__metaclass__ = type
+
+from units.compat.mock import patch
+from ansible.modules.network.nxos import nxos_vrf_af
+from .nxos_module import TestNxosModule, set_module_args
+
+
+class TestNxosVrfafRouteTargetsModule(TestNxosModule):
+
+    module = nxos_vrf_af
+
+    def setUp(self):
+        super(TestNxosVrfafRouteTargetsModule, self).setUp()
+
+        self.mock_load_config = patch('ansible.modules.network.nxos.nxos_vrf_af.load_config')
+        self.load_config = self.mock_load_config.start()
+
+        self.mock_get_config = patch('ansible.modules.network.nxos.nxos_vrf_af.get_config')
+        self.get_config = self.mock_get_config.start()
+
+    def tearDown(self):
+        super(TestNxosVrfafRouteTargetsModule, self).tearDown()
+        self.mock_load_config.stop()
+        self.mock_get_config.stop()
+
+    def load_fixtures(self, commands=None, device=''):
+        self.load_config.return_value = None
+
+    def test_route_targets_present_new(self):
+        set_module_args(dict(vrf='ntc', afi='ipv4', state='present',
+                             route_targets=[dict(rt='1:1'), dict(rt='2:2')]))
+        result = self.execute_module(changed=True)
+        self.assertEqual(sorted(result['commands']), sorted(['vrf context ntc',
+                                                             'address-family ipv4 unicast',
+                                                             'route-target import 1:1',
+                                                             'route-target export 1:1',
+                                                             'route-target import 2:2',
+                                                             'route-target export 2:2']))
+
+    def test_route_targets_import_export(self):
+        set_module_args(dict(vrf='ntc', afi='ipv4', state='present',
+                             route_targets=[dict(rt='1:1', direction='import'),
+                                            dict(rt='2:2', direction='export')]))
+        result = self.execute_module(changed=True)
+        self.assertEqual(sorted(result['commands']), sorted(['vrf context ntc',
+                                                             'address-family ipv4 unicast',
+                                                             'route-target import 1:1',
+                                                             'route-target export 2:2']))
+
+    def test_route_targets_idempotent(self):
+        self.get_config.return_value = ('vrf context ntc\n'
+                                        '  address-family ipv4 unicast\n'
+                                        '    route-target import 1:1\n'
+                                        '    route-target export 1:1\n')
+        set_module_args(dict(vrf='ntc', afi='ipv4', state='present',
+                             route_targets=[dict(rt='1:1')]))
+        result = self.execute_module(changed=False)
+        self.assertEqual(result['commands'], [])
+
+    def test_route_targets_absent(self):
+        self.get_config.return_value = ('vrf context ntc\n'
+                                        '  address-family ipv4 unicast\n'
+                                        '    route-target import 1:1\n'
+                                        '    route-target export 1:1\n'
+                                        '    route-target import 2:2\n'
+                                        '    route-target export 2:2\n')
+        set_module_args(dict(vrf='ntc', afi='ipv4', state='present',
+                             route_targets=[dict(rt='2:2', state='absent')]))
+        result = self.execute_module(changed=True)
+        self.assertEqual(sorted(result['commands']), sorted(['vrf context ntc',
+                                                             'address-family ipv4 unicast',
+                                                             'no route-target import 2:2',
+                                                             'no route-target export 2:2']))
+
+    def test_route_targets_mixed(self):
+        self.get_config.return_value = ('vrf context ntc\n'
+                                        '  address-family ipv4 unicast\n'
+                                        '    route-target import 1:1\n'
+                                        '    route-target export 1:1\n')
+        set_module_args(dict(vrf='ntc', afi='ipv4', state='present',
+                             route_targets=[dict(rt='1:1'),
+                                            dict(rt='2:2', direction='import'),
+                                            dict(rt='3:3', state='absent')]))
+        result = self.execute_module(changed=True)
+        self.assertEqual(sorted(result['commands']), sorted(['vrf context ntc',
+                                                             'address-family ipv4 unicast',
+                                                             'route-target import 2:2']))
+
+    def test_match_current_rt_helper(self):
+        rt_commands = []
+        rt = dict(rt='1:1', direction='both', state='present')
+        result = nxos_vrf_af.match_current_rt(rt, 'both', '', rt_commands)
+        self.assertEqual(result, ['route-target import 1:1', 'route-target export 1:1'])
+
+        rt_commands = []
+        current = 'route-target import 1:1\nroute-target export 1:1\n'
+        rt = dict(rt='1:1', direction='both', state='absent')
+        result = nxos_vrf_af.match_current_rt(rt, 'both', current, rt_commands)
+        self.assertEqual(result, ['no route-target import 1:1', 'no route-target export 1:1'])
