+#!/usr/bin/env python
+
+"""Tests for naturalsize rounding carry-over at unit boundaries."""
+
+from __future__ import annotations
+
+import pytest
+
+import humanize
+
+
+@pytest.mark.parametrize(
+    "test_args, expected",
+    [
+        # Decimal: value that rounds up to next unit
+        ([999950000], "1.0 GB"),
+        ([999950], "1.0 MB"),
+        ([1000**2 - 1], "1.0 MB"),
+        # Binary: value that rounds up to next unit
+        ([1024**2 - 1, True], "1.0 MiB"),
+        ([1024**3 - 1, True], "1.0 GiB"),
+        # GNU binary
+        ([1024**2 - 1, False, True], "1.0M"),
+        ([1024**3 - 1, False, True], "1.0G"),
+        # Values not crossing a rounded boundary keep behavior
+        ([999940000], "999.9 MB"),
+        ([1024**2 - 100, True], "1023.9 KiB"),
+        # At largest suffix, do not advance when rounding reaches base
+        ([10**33 * 0.99995], "1000.0 QB"),
+        ([1024**11, True], "1024.0 QiB"),
+    ],
+)
+def test_naturalsize_rounding_boundary(test_args: list[int] | list[int | bool], expected: str) -> None:
+    assert humanize.naturalsize(*test_args) == expected
+
+    # Retest with negative input when it's an int
+    if isinstance(test_args[0], int):
+        neg_args = list(test_args)
+        neg_args[0] *= -1
+        assert humanize.naturalsize(*neg_args) == "-" + expected
