@@ -0,0 +1,20 @@
+import humanize
+
+def test_naturalsize_rounding_at_largest_suffix_decimal():
+    # A value that truly rounds to 1000.0 at the largest QB suffix should
+    # stay at QB (no next suffix).  10**33 - 1 / 1000**10 = 999.999... -> 1000.0
+    assert humanize.naturalsize(10**33 - 1) == "1000.0 QB"
+
+def test_naturalsize_rounding_at_largest_suffix_binary():
+    # 1024**11 - 1 / 1024**10 = 1023.999... -> 1024.0 QiB
+    assert humanize.naturalsize(1024**11 - 1, binary=True) == "1024.0 QiB"
+
+def test_naturalsize_rounding_carry_over_decimal():
+    assert humanize.naturalsize(999950000) == "1.0 GB"
+
+def test_naturalsize_rounding_carry_over_binary():
+    assert humanize.naturalsize(1024**3 - 1, binary=True) == "1.0 GiB"
+
+
+def test_naturalsize_rounding_carry_over_gnu():
+    assert humanize.naturalsize(1024**3 - 1, gnu=True) == "1.0G"
