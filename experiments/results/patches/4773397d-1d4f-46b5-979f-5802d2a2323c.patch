@@ -0,0 +1,74 @@
+"""Regression tests for Wikisource import edition matching."""
+
+from openlibrary.catalog.add_book import build_pool, find_quick_match
+
+
+def test_build_pool_wikisource_only_matches_wikisource_identifier(mock_site) -> None:
+    """
+    A Wikisource source record must only match existing editions that share the
+    same Wikisource identifier, and must not fall back to bibliographic matching.
+    """
+    etype = '/type/edition'
+    existing = {
+        'key': mock_site.new_key(etype),
+        'type': {'key': etype},
+        'title': 'Wikisource Book',
+        'isbn_10': ['0190906766'],
+        'lccn': ['123'],
+        'oclc_numbers': ['456'],
+        'ocaid': 'test00test',
+        'source_records': ['ia:test00test'],
+    }
+    mock_site.save(existing)
+
+    # No wikisource identifier on the existing edition: pool must be empty.
+    rec = {
+        'title': 'Wikisource Book',
+        'isbn_10': ['0190906766'],
+        'lccn': ['123'],
+        'oclc_numbers': ['456'],
+        'ocaid': 'test00test',
+        'source_records': ['wikisource:abc'],
+    }
+    assert build_pool(rec) == {}
+
+    # Existing edition with a matching wikisource identifier: pool must match it.
+    existing['identifiers'] = {'wikisource': 'abc'}
+    mock_site.save(existing)
+    pool = build_pool(rec)
+    assert pool == {'wikisource': [existing['key']]}
+
+
+def test_find_quick_match_wikisource_only_matches_wikisource_identifier(
+    mock_site,
+) -> None:
+    """
+    find_quick_match must not match a Wikisource record against an existing
+    edition unless that edition shares the same Wikisource identifier.
+    """
+    etype = '/type/edition'
+    existing = {
+        'key': mock_site.new_key(etype),
+        'type': {'key': etype},
+        'title': 'Wikisource Book',
+        'isbn_10': ['0190906766'],
+        'lccn': ['123'],
+        'oclc_numbers': ['456'],
+        'ocaid': 'test00test',
+        'source_records': ['ia:test00test'],
+    }
+    mock_site.save(existing)
+
+    rec = {
+        'title': 'Wikisource Book',
+        'isbn_10': ['0190906766'],
+        'lccn': ['123'],
+        'oclc_numbers': ['456'],
+        'ocaid': 'test00test',
+        'source_records': ['wikisource:abc'],
+    }
+    assert find_quick_match(rec) is None
+
+    existing['identifiers'] = {'wikisource': 'abc'}
+    mock_site.save(existing)
+    assert find_quick_match(rec) == existing['key']
