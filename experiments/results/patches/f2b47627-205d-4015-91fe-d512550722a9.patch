@@ -0,0 +1,25 @@
+"""Additional naturalsize tests for boundary rounding."""
+
+from __future__ import annotations
+
+import humanize
+
+
+def test_decimal_boundary_rounding() -> None:
+    value = 1000**2 - 0.5
+    assert humanize.naturalsize(value) == "1.0 MB"
+
+
+def test_binary_boundary_rounding() -> None:
+    value = 1024**2 - 0.5
+    assert humanize.naturalsize(value, True) == "1.0 MiB"
+
+
+def test_gnu_boundary_rounding() -> None:
+    value = 1024**2 - 0.5
+    assert humanize.naturalsize(value, False, True) == "1.0M"
+
+
+def test_max_suffix_does_not_bump() -> None:
+    value = 1000**10 * 999.95
+    assert humanize.naturalsize(value) == "1000.0 QB"
