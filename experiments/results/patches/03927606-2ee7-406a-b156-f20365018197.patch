+from parse import parse
+
+# Test precision-0 floats
+print(parse('a {:.0f} b', 'a 12 b')[0])  # Should print 12.0
+print(parse('foo_{:02.0f}t', 'foo_20t')[0])  # Should print 20.0
+
+# Test that decimal points still fail for precision-0
+print(parse('a {:.0f} b', 'a 12.0 b'))  # Should print None
+
+# Test normal float behavior
+print(parse('a {:.2f} b', 'a 12.34 b')[0])  # Should print 12.34
+print(parse('a {:.2f} b', 'a 12 b'))  # Should print None
