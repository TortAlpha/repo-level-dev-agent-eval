@@ -0,0 +1,65 @@
+import pytest
+
+from tinydb import TinyDB
+from tinydb.storages import MemoryStorage
+
+
+@pytest.fixture
+def db():
+    db_ = TinyDB(storage=MemoryStorage)
+    db_.drop_tables()
+    db_.insert({'a': 1})
+    db_.insert({'a': 2})
+    yield db_
+
+
+def test_update_skips_missing_doc_ids(db):
+    updated = db.update({'a': 99}, doc_ids=[1, 99])
+    assert updated == [1]
+    assert db.all() == [{'a': 99}, {'a': 2}]
+
+
+def test_update_missing_before_existing(db):
+    updated = db.update({'a': 99}, doc_ids=[99, 2])
+    assert updated == [2]
+    assert db.all() == [{'a': 1}, {'a': 99}]
+
+
+def test_update_all_missing(db):
+    updated = db.update({'a': 99}, doc_ids=[99, 100])
+    assert updated == []
+    assert db.all() == [{'a': 1}, {'a': 2}]
+
+
+def test_remove_skips_missing_doc_ids(db):
+    removed = db.remove(doc_ids=[1, 99])
+    assert removed == [1]
+    assert db.all() == [{'a': 2}]
+
+
+def test_remove_missing_before_existing(db):
+    removed = db.remove(doc_ids=[99, 2])
+    assert removed == [2]
+    assert db.all() == [{'a': 1}]
+
+
+def test_remove_all_missing(db):
+    removed = db.remove(doc_ids=[99, 100])
+    assert removed == []
+    assert db.all() == [{'a': 1}, {'a': 2}]
+
+
+def test_update_query_unchanged(db):
+    updated = db.update({'a': 99}, where('a') == 1)
+    assert updated == [1]
+    assert db.all() == [{'a': 99}, {'a': 2}]
+
+
+def test_update_all_unchanged(db):
+    updated = db.update({'a': 99})
+    assert sorted(updated) == [1, 2]
+    assert db.all() == [{'a': 99}, {'a': 99}]
+
+
+# provide ``where`` for the query-based tests
+from tinydb import where  # noqa: E402
