+
+
+def test_deep_parenthesis_nesting():
+    # Pathological deep nesting should not crash or RecursionError
+    s = "SELECT " + "(" * 200 + "1" + ")" * 200
+    parsed = sqlparse.parse(s)[0]
+    assert str(parsed) == s
+
+
+def test_large_flat_token_list():
+    # Pathological large token list should not crash or hang
+    items = ["x"] * 2000
+    s = "SELECT " + ",".join(items)
+    parsed = sqlparse.parse(s)[0]
+    assert str(parsed) == s
