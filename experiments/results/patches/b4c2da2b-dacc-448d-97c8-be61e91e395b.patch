diff --git a/testing/test_plugin_removal_multiple_impls.py b/testing/test_plugin_removal_multiple_impls.py
new file mode 100644
index 0000000000000000000000000000000000000000..067cd513c67270466d07d2640816839c521f8990
--- /dev/null
+++ b/testing/test_plugin_removal_multiple_impls.py
@@ -0,0 +1,57 @@
+import pytest
+
+from pluggy import HookimplMarker
+from pluggy import HookspecMarker
+from pluggy import PluginManager
+
+
+def test_unregister_multiple_impls_same_hook_and_get_hookcallers_dedup() -> None:
+    hookspec = HookspecMarker("example")
+    hookimpl = HookimplMarker("example")
+
+    class Hooks:
+        @hookspec
+        def hello(self, arg: int) -> str: ...
+
+    pm = PluginManager("example")
+    pm.add_hookspecs(Hooks)
+
+    class MyPlugin:
+        @hookimpl
+        def hello(self, arg: int) -> str:
+            return "direct"
+
+        @hookimpl(specname="hello")
+        def hello_alias(self, arg: int) -> str:
+            return "alias"
+
+    plugin = MyPlugin()
+    pm.register(plugin)
+
+    # get_hookcallers must not report the same hookcaller twice for one plugin.
+    hookcallers = pm.get_hookcallers(plugin)
+    assert hookcallers is not None
+    assert len(hookcallers) == 1
+    hookcaller = hookcallers[0]
+    assert hookcaller.name == "hello"
+
+    # Before unregistering, both implementations from this plugin are present.
+    impls_before = hookcaller.get_hookimpls()
+    assert [impl.plugin for impl in impls_before].count(plugin) == 2
+
+    class OtherPlugin:
+        @hookimpl
+        def hello(self, arg: int) -> str:
+            return "other"
+
+    other = OtherPlugin()
+    pm.register(other)
+
+    # Unregistering must remove *every* implementation belonging to the plugin.
+    pm.unregister(plugin)
+    remaining_impls = hookcaller.get_hookimpls()
+    assert all(impl.plugin is not plugin for impl in remaining_impls)
+    assert any(impl.plugin is other for impl in remaining_impls)
+
+    # Unregistered plugins no longer have hook callers.
+    assert pm.get_hookcallers(plugin) is None
