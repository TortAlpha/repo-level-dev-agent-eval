--- /dev/null
+++ b/tests/test_precision0_float.py
@@ -0,0 +1,15 @@
+import parse
+
+def test_precision0_float_no_decimal():
+    result = parse.parse("a {:.0f} b", "a 12 b")
+    assert result is not None
+    assert result[0] == 12.0
+
+def test_precision0_float_with_width():
+    result = parse.parse("foo_{:02.0f}t", "foo_20t")
+    assert result is not None
+    assert result[0] == 20.0
+
+def test_precision0_float_rejects_decimal():
+    result = parse.parse("a {:.0f} b", "a 12.0 b")
+    assert result is None
