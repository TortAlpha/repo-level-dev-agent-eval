+
+
+class RunningStatisticsTests(TestCase):
+    def test_unbounded(self):
+        it = mi.running_statistics(iter([4, 3, 7]))
+        self.assertEqual(
+            next(it), mi.Stats(size=1, minimum=4, median=4, maximum=4, mean=4.0)
+        )
+        self.assertEqual(
+            next(it), mi.Stats(size=2, minimum=3, median=3.5, maximum=4, mean=3.5)
+        )
+        self.assertEqual(
+            next(it),
+            mi.Stats(size=3, minimum=3, median=4, maximum=7, mean=14 / 3),
+        )
+
+    def test_empty(self):
+        self.assertEqual(list(mi.running_statistics(iter([]))), [])
+
+    def test_maxlen(self):
+        # Sliding window of the last 2 elements
+        it = mi.running_statistics(iter([4, 3, 7, 1]), maxlen=2)
+        self.assertEqual(
+            next(it), mi.Stats(size=1, minimum=4, median=4, maximum=4, mean=4.0)
+        )
+        self.assertEqual(
+            next(it), mi.Stats(size=2, minimum=3, median=3.5, maximum=4, mean=3.5)
+        )
+        self.assertEqual(
+            next(it), mi.Stats(size=2, minimum=3, median=5.0, maximum=7, mean=5.0)
+        )
+        self.assertEqual(
+            next(it), mi.Stats(size=2, minimum=1, median=4.0, maximum=7, mean=4.0)
+        )
+
+    def test_maxlen_one(self):
+        it = mi.running_statistics(iter([4, 3, 7]), maxlen=1)
+        self.assertEqual(
+            next(it), mi.Stats(size=1, minimum=4, median=4, maximum=4, mean=4.0)
+        )
+        self.assertEqual(
+            next(it), mi.Stats(size=1, minimum=3, median=3, maximum=3, mean=3.0)
+        )
+        self.assertEqual(
+            next(it), mi.Stats(size=1, minimum=7, median=7, maximum=7, mean=7.0)
+        )
+
+    def test_negative_maxlen(self):
+        with self.assertRaises(ValueError):
+            list(mi.running_statistics(iter([1]), maxlen=-1))
+
