+Stats = namedtuple('Stats', ['size', 'minimum', 'median', 'maximum', 'mean'])
+
+
+def running_statistics(iterable, *, maxlen=None):
+    """Yield running statistics over an iterable.
+
+    After each element of *iterable* is consumed, yield a :class:`Stats`
+    namedtuple summarizing the values seen so far:
+
+        ``Stats(size, minimum, median, maximum, mean)``
+
+    When *maxlen* is a positive integer, every statistic is computed over a
+    sliding window of at most the last *maxlen* elements.
+
+        >>> it = running_statistics(iter([4, 3, 7]))
+        >>> next(it)
+        Stats(size=1, minimum=4, median=4, maximum=4, mean=4.0)
+        >>> next(it)
+        Stats(size=2, minimum=3, median=3.5, maximum=4, mean=3.5)
+        >>> next(it)  # doctest: +ELLIPSIS
+        Stats(size=3, minimum=3, median=4, maximum=7, mean=4.666...)
+
+    """
+    if maxlen is not None and maxlen < 0:
+        raise ValueError('maxlen must be non-negative')
+
+    data = deque(maxlen=maxlen) if maxlen is not None else []
+    sorted_data = []
+
+    for value in iterable:
+        if maxlen is not None and len(data) == maxlen:
+            old = data[0]
+            data.append(value)
+            # Remove the old value from the sorted window
+            i = bisect_left(sorted_data, old)
+            del sorted_data[i]
+            insort(sorted_data, value)
+        else:
+            data.append(value)
+            insort(sorted_data, value)
+
+        n = len(sorted_data)
+        minimum = sorted_data[0]
+        maximum = sorted_data[-1]
+        mean = fsum(sorted_data) / n
+        if n % 2 == 1:
+            median = sorted_data[n // 2]
+        else:
+            median = (sorted_data[n // 2 - 1] + sorted_data[n // 2]) / 2
+
+        yield Stats(n, minimum, median, maximum, mean)
