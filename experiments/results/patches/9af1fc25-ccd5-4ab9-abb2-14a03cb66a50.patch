diff --git a/tests/test_create_table_lowercase.py b/tests/test_create_table_lowercase.py
new file mode 100644
index 0000000..f7e874b
--- /dev/null
+++ b/tests/test_create_table_lowercase.py
@@ -0,0 +1,44 @@
+"""Regression tests for case-insensitive CREATE TABLE grouping."""
+import sqlparse
+from sqlparse import sql
+
+
+def _token_type_names(p):
+    names = []
+    for tok in p.tokens:
+        if tok.is_whitespace:
+            continue
+        names.append(type(tok).__name__)
+    return names
+
+
+def _assert_create_table_structure(p):
+    # For `CREATE TABLE foo (id integer, name text)` the table name `foo` is
+    # grouped as an sql.Identifier and the column definitions are grouped as an
+    # sql.Parenthesis.
+    ident = None
+    paren = None
+    for tok in p.tokens:
+        if isinstance(tok, sql.Identifier):
+            ident = tok
+        elif isinstance(tok, sql.Parenthesis):
+            paren = tok
+    assert ident is not None, 'Expected an Identifier group for the table name'
+    assert ident.get_real_name() == 'foo'
+    assert paren is not None, 'Expected a Parenthesis group for column defs'
+
+
+def test_create_table_uppercase():
+    p = sqlparse.parse('CREATE TABLE foo (id integer, name text)')[0]
+    _assert_create_table_structure(p)
+
+
+def test_create_table_lowercase():
+    p = sqlparse.parse('create table foo (id integer, name text)')[0]
+    _assert_create_table_structure(p)
+
+
+def test_create_table_lowercase_matches_uppercase():
+    lower = sqlparse.parse('create table foo (id integer, name text)')[0]
+    upper = sqlparse.parse('CREATE TABLE foo (id integer, name text)')[0]
+    assert _token_type_names(lower) == _token_type_names(upper)
