diff --git a/tests/test_window_functions.py b/tests/test_window_functions.py
new file mode 100644
index 0000000..d85795e
--- /dev/null
+++ b/tests/test_window_functions.py
@@ -0,0 +1,35 @@
+import sqlparse
+from sqlparse.sql import Function, Identifier, Parenthesis
+
+
+def test_get_window_named():
+    f = sqlparse.parse('foo(5) OVER win1')[0].tokens[0]
+    assert isinstance(f, Function)
+    w = f.get_window()
+    assert isinstance(w, Identifier)
+    assert str(w) == 'win1'
+
+
+def test_get_window_inline():
+    f = sqlparse.parse('foo(5) OVER (PARTITION BY c1)')[0].tokens[0]
+    assert isinstance(f, Function)
+    w = f.get_window()
+    assert isinstance(w, Parenthesis)
+
+
+def test_get_window_none():
+    f = sqlparse.parse('foo(5)')[0].tokens[0]
+    assert isinstance(f, Function)
+    assert f.get_window() is None
+
+
+def test_parameters_with_over_named():
+    f = sqlparse.parse('foo(5) OVER win1')[0].tokens[0]
+    params = f.get_parameters()
+    assert len(params) == 1
+
+
+def test_parameters_with_over_inline():
+    f = sqlparse.parse('foo(5) OVER (PARTITION BY c1)')[0].tokens[0]
+    params = f.get_parameters()
+    assert len(params) == 1
