@@ -0,0 +1,50 @@
+import io
+
+import dotenv
+from dotenv.parser import Binding, Original, parse_stream
+
+
+def test_parse_stream_strips_leading_utf8_bom():
+    result = list(parse_stream(io.StringIO("\ufeffFIRST=value1\nSECOND=value2")))
+
+    assert result == [
+        Binding(
+            key="FIRST",
+            value="value1",
+            original=Original(string="FIRST=value1\n", line=1),
+            error=False,
+        ),
+        Binding(
+            key="SECOND",
+            value="value2",
+            original=Original(string="SECOND=value2", line=2),
+            error=False,
+        ),
+    ]
+
+
+def test_dotenv_values_strips_leading_utf8_bom_from_stream():
+    result = dotenv.dotenv_values(
+        stream=io.StringIO("\ufeffFIRST=value1\nSECOND=value2")
+    )
+
+    assert result == {"FIRST": "value1", "SECOND": "value2"}
+
+
+def test_parse_stream_unchanged_without_bom():
+    result = list(parse_stream(io.StringIO("FIRST=value1\nSECOND=value2")))
+
+    assert result == [
+        Binding(
+            key="FIRST",
+            value="value1",
+            original=Original(string="FIRST=value1\n", line=1),
+            error=False,
+        ),
+        Binding(
+            key="SECOND",
+            value="value2",
+            original=Original(string="SECOND=value2", line=2),
+            error=False,
+        ),
+    ]
