+"""Regression tests for --disable-features handling in qtargs."""
+
+import pytest
+
+from qutebrowser import qutebrowser
+from qutebrowser.config import qtargs
+from qutebrowser.utils import usertypes
+from helpers import utils
+
+
+class TestDisableFeatures:
+
+    @pytest.fixture
+    def parser(self, mocker):
+        parser = qutebrowser.get_argparser()
+        mocker.patch.object(parser, 'exit', side_effect=Exception)
+        return parser
+
+    @pytest.fixture(autouse=True)
+    def reduce_args(self, monkeypatch, config_stub):
+        monkeypatch.setattr(qtargs.qtutils, 'qVersion', lambda: '5.15.0')
+        config_stub.val.content.headers.referer = 'always'
+        config_stub.val.scrolling.bar = 'never'
+        monkeypatch.setattr(qtargs.utils, 'is_linux', False)
+        monkeypatch.setattr(qtargs.objects, 'backend',
+                            usertypes.Backend.QtWebEngine)
+
+    def test_prefix_constants(self):
+        assert qtargs.feature_enable_prefix == '--enable-features='
+        assert qtargs.feature_disable_prefix == '--disable-features='
+
+    @pytest.mark.parametrize('via_commandline', [True, False])
+    def test_disable_features_propagated(self, config_stub, parser,
+                                         via_commandline):
+        flag = '--disable-features=SomeFeature'
+        config_stub.val.qt.args = ([] if via_commandline else [flag[2:]])
+        parsed = parser.parse_args(['--qt-flag', flag[2:]]
+                                   if via_commandline else [])
+        args = qtargs.qt_args(parsed)
+        assert flag in args
+
+    @pytest.mark.parametrize('via_commandline', [True, False])
+    def test_disable_features_comma_list(self, config_stub, parser,
+                                          via_commandline):
+        flag = '--disable-features=SomeFeature,OtherFeature'
+        config_stub.val.qt.args = ([] if via_commandline else [flag[2:]])
+        parsed = parser.parse_args(['--qt-flag', flag[2:]]
+                                   if via_commandline else [])
+        args = qtargs.qt_args(parsed)
+        assert flag in args
+
+    @pytest.mark.parametrize('via_commandline', [True, False])
+    def test_enable_and_disable_together(self, config_stub, parser,
+                                         via_commandline):
+        enable_flag = '--enable-features=CustomFeature'
+        disable_flag = '--disable-features=SomeFeature'
+        config_stub.val.qt.args = (
+            [] if via_commandline else [enable_flag[2:], disable_flag[2:]]
+        )
+        parsed = parser.parse_args(
+            ['--qt-flag', enable_flag[2:], '--qt-flag', disable_flag[2:]]
+            if via_commandline else []
+        )
+        args = qtargs.qt_args(parsed)
+
+        enable_args = [a for a in args
+                       if a.startswith(qtargs.feature_enable_prefix)]
+        disable_args = [a for a in args
+                        if a.startswith(qtargs.feature_disable_prefix)]
+        assert len(enable_args) == 1
+        assert enable_args[0] == enable_flag
+        assert disable_args == [disable_flag]
+
+    @pytest.mark.parametrize('via_commandline', [True, False])
+    def test_disable_features_separate_from_enable(self, config_stub, parser,
+                                                    via_commandline):
+        enable_flag = '--enable-features=CustomFeature'
+        disable_flag = '--disable-features=SomeFeature'
+        config_stub.val.qt.args = (
+            [] if via_commandline else [enable_flag[2:], disable_flag[2:]]
+        )
+        parsed = parser.parse_args(
+            ['--qt-flag', enable_flag[2:], '--qt-flag', disable_flag[2:]]
+            if via_commandline else []
+        )
+        args = qtargs.qt_args(parsed)
+
+        for arg in args:
+            assert not arg.startswith('--enable-features=SomeFeature')
+            assert not arg.startswith('--disable-features=CustomFeature')
