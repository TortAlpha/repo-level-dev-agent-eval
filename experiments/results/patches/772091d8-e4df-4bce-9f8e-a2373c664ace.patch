diff --git a/tests/test_parse.py b/tests/test_parse.py
index 84071c6..ef8197a 100644
--- a/tests/test_parse.py
+++ b/tests/test_parse.py
@@ -438,6 +438,43 @@ class TestParse(unittest.TestCase):
         y("a {:b} b", "a +1010 b", 10)
         y("a {:x} b", "a +1010 b", 0x1010)
 
+    def test_strftime_formats(self):
+        from datetime import date, datetime, time
+
+        # date-only formats produce date objects
+        r = parse.parse("a {:%Y-%m-%d} b", "a 1997-07-16 b")
+        self.assertEqual(r[0], date(1997, 7, 16))
+
+        r = parse.parse("a {:%Y-%b-%d} b", "a 1997-Feb-16 b")
+        self.assertEqual(r[0], date(1997, 2, 16))
+
+        r = parse.parse("a {:%d/%m/%Y} b", "a 16/07/1997 b")
+        self.assertEqual(r[0], date(1997, 7, 16))
+
+        # time-only formats produce time objects
+        r = parse.parse("a {:%H:%M:%S} b", "a 19:20:30 b")
+        self.assertEqual(r[0], time(19, 20, 30))
+
+        # datetime formats produce datetime objects
+        r = parse.parse("a {:%Y-%m-%d %H:%M:%S} b", "a 1997-07-16 19:20:30 b")
+        self.assertEqual(r[0], datetime(1997, 7, 16, 19, 20, 30))
+
+        # timezone directive produces datetime with tzinfo
+        r = parse.parse("a {:%Y-%m-%dT%H:%M%z} b", "a 1997-07-16T19:20+0100 b")
+        self.assertEqual(
+            r[0],
+            datetime(1997, 7, 16, 19, 20, tzinfo=parse.FixedTzOffset(60, "+0100")),
+        )
+
+        # several fields mixed with other types
+        r = parse.parse(
+            "{:%Y-%m-%d} {:d} {:%H:%M}",
+            "1997-07-16 42 19:20",
+        )
+        self.assertEqual(r[0], date(1997, 7, 16))
+        self.assertEqual(r[1], 42)
+        self.assertEqual(r[2], time(19, 20))
+
     def test_two_datetimes(self):
         r = parse.parse("a {:ti} {:ti} b", "a 1997-07-16 2012-08-01 b")
         self.assertEqual(len(r.fixed), 2)
