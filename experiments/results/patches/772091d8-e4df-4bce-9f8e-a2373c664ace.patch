--- a/parse.py
+++ b/parse.py
@@ -283,6 +283,85 @@ class RepeatedNameError(ValueError):
 # note: I don't use r'' here because Sublime Text 2 syntax highlight has a fit
 REGEX_SAFETY = re.compile(r"([?\\\\.[\]()*+\^$!\|])")
 
+# strftime/strptime directive -> (regex, has_date, has_time, has_tz)
+# has_date: directive contributes date components (year/month/day)
+# has_time: directive contributes time components (hour/minute/second)
+# has_tz: directive contributes timezone information
+_STRFTIME_DIRECTIVES = {
+    "%a": (r"[A-Za-z]{3}", False, False, False),
+    "%A": (r"[A-Za-z]+", False, False, False),
+    "%w": (r"[0-6]", False, False, False),
+    "%d": (r"\d{1,2}", True, False, False),
+    "%b": (r"[A-Za-z]{3}", True, False, False),
+    "%B": (r"[A-Za-z]+", True, False, False),
+    "%m": (r"\d{1,2}", True, False, False),
+    "%y": (r"\d{2}", True, False, False),
+    "%Y": (r"\d{4}", True, False, False),
+    "%H": (r"\d{1,2}", False, True, False),
+    "%I": (r"\d{1,2}", False, True, False),
+    "%p": (r"[AP]M", False, True, False),
+    "%M": (r"\d{1,2}", False, True, False),
+    "%S": (r"\d{1,2}", False, True, False),
+    "%f": (r"\d{1,6}", False, True, False),
+    "%z": (r"[+-]\d{2}:?\d{2}|Z", False, False, True),
+    "%Z": (r"[A-Za-z]+", False, False, True),
+    "%j": (r"\d{1,3}", True, False, False),
+    "%U": (r"\d{1,2}", False, False, False),
+    "%W": (r"\d{1,2}", False, False, False),
+    "%c": (r".+?", True, True, False),
+    "%x": (r".+?", True, False, False),
+    "%X": (r".+?", False, True, False),
+    "%%": (r"%", False, False, False),
+}
+
+
+def _strptime_convert(format):
+    """Build a converter and regex for a strftime/strptime format spec."""
+    regex_parts = []
+    has_date = False
+    has_time = False
+    has_tz = False
+    i = 0
+    n = len(format)
+    while i < n:
+        if format[i] == "%" and i + 1 < n:
+            directive = format[i : i + 2]
+            if directive in _STRFTIME_DIRECTIVES:
+                pat, d, t, z = _STRFTIME_DIRECTIVES[directive]
+                regex_parts.append(pat)
+                has_date = has_date or d
+                has_time = has_time or t
+                has_tz = has_tz or z
+                i += 2
+                continue
+        ch = format[i]
+        if ch in ".\\+?*[](){}^$!|":
+            regex_parts.append("\\" + ch)
+        else:
+            regex_parts.append(ch)
+        i += 1
+
+    regex = "".join(regex_parts)
+    if has_tz:
+        result_type = "datetime"
+    elif has_time and has_date:
+        result_type = "datetime"
+    elif has_time:
+        result_type = "time"
+    else:
+        result_type = "date"
+
+    def converter(string, match):
+        value = datetime.strptime(string, format)
+        if result_type == "date":
+            return value.date()
+        elif result_type == "time":
+            return value.time()
+        return value
+
+    return regex, converter
+
+
 # allowed field types
 ALLOWED_TYPES = set(list("nbox%fFegwWdDsSl") + ["t" + c for c in "ieahgcts"])
 
