diff --git a/tests/test_syntax/extensions/test_footnotes_order.py b/tests/test_syntax/extensions/test_footnotes_order.py
new file mode 100644
index 0000000..aa29643
--- /dev/null
+++ b/tests/test_syntax/extensions/test_footnotes_order.py
@@ -0,0 +1,66 @@
+"""Tests for footnote numbering by order of reference."""
+
+from markdown.test_tools import TestCase
+
+
+class TestFootnotesOrder(TestCase):
+
+    default_kwargs = {'extensions': ['footnotes']}
+    maxDiff = None
+
+    def test_order_by_reference(self):
+        """Footnotes should be numbered and listed in order of first reference."""
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                first[^first]
+
+                last[^last]
+
+                [^last]: Last footnote
+                [^first]: First footnote
+                """
+            ),
+            '<p>first<sup id="fnref:first"><a class="footnote-ref" href="#fn:first">1</a></sup></p>\n'
+            '<p>last<sup id="fnref:last"><a class="footnote-ref" href="#fn:last">2</a></sup></p>\n'
+            '<div class="footnote">\n'
+            '<hr />\n'
+            '<ol>\n'
+            '<li id="fn:first">\n'
+            '<p>First footnote&#160;<a class="footnote-backref" href="#fnref:first"'
+            ' title="Jump back to footnote 1 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '<li id="fn:last">\n'
+            '<p>Last footnote&#160;<a class="footnote-backref" href="#fnref:last"'
+            ' title="Jump back to footnote 2 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '</ol>\n'
+            '</div>'
+        )
+
+    def test_unreferenced_footnote_appended_last(self):
+        """Unreferenced footnotes are listed after referenced ones in definition order."""
+        self.assertMarkdownRenders(
+            self.dedent(
+                """
+                first[^first]
+
+                [^first]: First footnote
+                [^unused]: Unused footnote
+                """
+            ),
+            '<p>first<sup id="fnref:first"><a class="footnote-ref" href="#fn:first">1</a></sup></p>\n'
+            '<div class="footnote">\n'
+            '<hr />\n'
+            '<ol>\n'
+            '<li id="fn:first">\n'
+            '<p>First footnote&#160;<a class="footnote-backref" href="#fnref:first"'
+            ' title="Jump back to footnote 1 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '<li id="fn:unused">\n'
+            '<p>Unused footnote&#160;<a class="footnote-backref" href="#fnref:unused"'
+            ' title="Jump back to footnote 2 in the text">&#8617;</a></p>\n'
+            '</li>\n'
+            '</ol>\n'
+            '</div>'
+        )
