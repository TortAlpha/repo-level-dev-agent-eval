diff --git a/tests/test_tick_numeric_delta.py b/tests/test_tick_numeric_delta.py
new file mode 100644
index 0000000000000000000000000000000000000000..c3ac50f565715601e2c6a68af22a9b42433f3608
--- /dev/null
+++ b/tests/test_tick_numeric_delta.py
@@ -0,0 +1,87 @@
+import datetime
+import fractions
+
+import pytest
+
+from freezegun import freeze_time
+
+
+def test_frozen_factory_tick_int_delta() -> None:
+    with freeze_time("2020-01-01 00:00:00") as ft:
+        ft.tick(30)
+        assert ft() == datetime.datetime(2020, 1, 1, 0, 0, 30)
+
+
+def test_frozen_factory_tick_float_delta() -> None:
+    with freeze_time("2020-01-01 00:00:00") as ft:
+        ft.tick(12.5)
+        assert ft() == datetime.datetime(2020, 1, 1, 0, 0, 12, 500000)
+
+
+def test_frozen_factory_tick_fraction_delta() -> None:
+    with freeze_time("2020-01-01 00:00:00") as ft:
+        ft.tick(fractions.Fraction(1, 2))
+        assert ft() == datetime.datetime(2020, 1, 1, 0, 0, 0, 500000)
+
+
+def test_frozen_factory_tick_timedelta_unchanged() -> None:
+    with freeze_time("2020-01-01 00:00:00") as ft:
+        ft.tick(datetime.timedelta(minutes=2))
+        assert ft() == datetime.datetime(2020, 1, 1, 0, 2)
+
+
+def test_step_tick_factory_tick_int_delta() -> None:
+    with freeze_time("2020-01-01 00:00:00", auto_tick_seconds=15) as ft:
+        ft.tick(30)
+        assert ft() == datetime.datetime(2020, 1, 1, 0, 0, 30)
+
+
+def test_step_tick_factory_tick_float_delta() -> None:
+    with freeze_time("2020-01-01 00:00:00", auto_tick_seconds=15) as ft:
+        ft.tick(12.5)
+        assert ft() == datetime.datetime(2020, 1, 1, 0, 0, 12, 500000)
+
+
+def test_step_tick_factory_tick_fraction_delta() -> None:
+    with freeze_time("2020-01-01 00:00:00", auto_tick_seconds=15) as ft:
+        ft.tick(fractions.Fraction(1, 2))
+        assert ft() == datetime.datetime(2020, 1, 1, 0, 0, 0, 500000)
+
+
+def test_step_tick_factory_auto_tick_unchanged() -> None:
+    with freeze_time("2020-01-01 00:00:00", auto_tick_seconds=15) as ft:
+        first = datetime.datetime.now()
+        second = datetime.datetime.now()
+        assert first + datetime.timedelta(seconds=15) == second
+
+
+def test_step_tick_factory_tick_timedelta_unchanged() -> None:
+    with freeze_time("2020-01-01 00:00:00", auto_tick_seconds=15) as ft:
+        ft.tick(datetime.timedelta(minutes=2))
+        assert ft() == datetime.datetime(2020, 1, 1, 0, 2)
+
+
+@pytest.mark.skipif(
+    "not hasattr(datetime, 'UTC')",
+    reason="tick=True requires CPython monotonic support",
+)
+def test_ticking_factory_tick_int_delta() -> None:
+    with freeze_time("2020-01-01 00:00:00", tick=True) as ft:
+        before = ft()
+        ft.tick(30)
+        after = ft()
+        delta = after - before
+        assert datetime.timedelta(seconds=29) < delta < datetime.timedelta(seconds=31)
+
+
+@pytest.mark.skipif(
+    "not hasattr(datetime, 'UTC')",
+    reason="tick=True requires CPython monotonic support",
+)
+def test_ticking_factory_tick_fraction_delta() -> None:
+    with freeze_time("2020-01-01 00:00:00", tick=True) as ft:
+        before = ft()
+        ft.tick(fractions.Fraction(1, 2))
+        after = ft()
+        delta = after - before
+        assert datetime.timedelta(seconds=0.4) < delta < datetime.timedelta(seconds=0.6)
