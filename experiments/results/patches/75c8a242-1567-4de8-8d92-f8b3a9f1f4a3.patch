+    def get_statement_values(self, property_id: str) -> list[str]:
+        """
+        Retrieve all valid string values associated with a given property.
+
+        Iterates over the statement objects for the requested property and
+        collects the string in ``value.content``. Preserves the original order
+        and skips items missing the expected nested fields or with a
+        non-string/empty ``content``. Returns an empty list when the property
+        is absent or no valid values are present.
+        """
+        statements = self.statements.get(property_id)
+        if not statements:
+            return []
+        values: list[str] = []
+        for statement in statements:
+            if not isinstance(statement, dict):
+                continue
+            value = statement.get('value')
+            if not isinstance(value, dict):
+                continue
+            content = value.get('content')
+            if isinstance(content, str) and content:
+                values.append(content)
+        return values
+
