diff --git a/openlibrary/tests/core/test_wikidata.py b/openlibrary/tests/core/test_wikidata.py
index e448c7d85..80385effb 100644
--- a/openlibrary/tests/core/test_wikidata.py
+++ b/openlibrary/tests/core/test_wikidata.py
@@ -118,3 +118,43 @@ def test_get_wikipedia_link() -> None:
         'es',
     )
     assert entity_no_english.get_wikipedia_link('en') is None
+
+
+def test_get_statement_values_multiple_valid() -> None:
+    entity = createWikidataEntity()
+    entity.statements = {
+        'P31': [
+            {'value': {'content': 'Q5'}},
+            {'value': {'content': 'Q1234'}},
+        ]
+    }
+    assert entity.get_statement_values('P31') == ['Q5', 'Q1234']
+
+
+def test_get_statement_values_skips_malformed() -> None:
+    entity = createWikidataEntity()
+    entity.statements = {
+        'P31': [
+            {'value': {'content': 'Q5'}},
+            {'value': {}},
+            {},
+            {'value': {'content': ''}},
+            {'value': {'content': None}},
+            {'value': {'content': 42}},
+            'not a dict',
+            {'value': {'content': 'Q6'}},
+        ]
+    }
+    assert entity.get_statement_values('P31') == ['Q5', 'Q6']
+
+
+def test_get_statement_values_absent_property() -> None:
+    entity = createWikidataEntity()
+    entity.statements = {'P31': [{'value': {'content': 'Q5'}}]}
+    assert entity.get_statement_values('P999') == []
+
+
+def test_get_statement_values_empty_list() -> None:
+    entity = createWikidataEntity()
+    entity.statements = {'P31': []}
+    assert entity.get_statement_values('P31') == []
