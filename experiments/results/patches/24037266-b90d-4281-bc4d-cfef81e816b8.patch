+# along with qutebrowser.  If not, see <https://www.gnu.org/licenses/>.
+
+"""Tests for the new KeyInfo public methods."""
+
+from qutebrowser.qt.core import Qt
+try:
+    from qutebrowser.qt.core import QKeyCombination
+except ImportError:
+    QKeyCombination = None
+
+from qutebrowser.keyinput import keyutils
+
+
+def test_key_info_to_qt():
+    info = keyutils.KeyInfo(Qt.Key.Key_A, Qt.KeyboardModifier.ControlModifier)
+    result = info.to_qt()
+    if QKeyCombination is None:
+        # Qt5: integer
+        assert isinstance(result, int)
+        assert result == int(Qt.Key.Key_A) | int(Qt.KeyboardModifier.ControlModifier)
+    else:
+        # Qt6: QKeyCombination
+        assert isinstance(result, QKeyCombination)
+        assert result.key() == Qt.Key.Key_A
+        assert result.keyboardModifiers() == Qt.KeyboardModifier.ControlModifier
+
+
+def test_key_info_to_qt_no_modifiers():
+    info = keyutils.KeyInfo(Qt.Key.Key_B, Qt.KeyboardModifier.NoModifier)
+    result = info.to_qt()
+    if QKeyCombination is None:
+        assert isinstance(result, int)
+        assert result == int(Qt.Key.Key_B)
+    else:
+        assert isinstance(result, QKeyCombination)
+        assert result.key() == Qt.Key.Key_B
+        assert result.keyboardModifiers() == Qt.KeyboardModifier.NoModifier
+
+
+def test_key_info_with_stripped_modifiers():
+    info = keyutils.KeyInfo(
+        Qt.Key.Key_A,
+        Qt.KeyboardModifier.ControlModifier | Qt.KeyboardModifier.ShiftModifier,
+    )
+    stripped = info.with_stripped_modifiers(Qt.KeyboardModifier.ShiftModifier)
+    assert stripped.key == Qt.Key.Key_A
+    assert stripped.modifiers == Qt.KeyboardModifier.ControlModifier
+    # Original unchanged
+    assert info.modifiers == (
+        Qt.KeyboardModifier.ControlModifier | Qt.KeyboardModifier.ShiftModifier
+    )
+
+
+def test_key_info_with_stripped_modifiers_all():
+    info = keyutils.KeyInfo(
+        Qt.Key.Key_A,
+        Qt.KeyboardModifier.ControlModifier | Qt.KeyboardModifier.AltModifier,
+    )
+    stripped = info.with_stripped_modifiers(
+        Qt.KeyboardModifier.ControlModifier | Qt.KeyboardModifier.AltModifier
+    )
+    assert stripped.key == Qt.Key.Key_A
+    assert stripped.modifiers == Qt.KeyboardModifier.NoModifier
+
+
+def test_key_info_with_stripped_modifiers_none_stripped():
+    info = keyutils.KeyInfo(Qt.Key.Key_A, Qt.KeyboardModifier.ControlModifier)
+    stripped = info.with_stripped_modifiers(Qt.KeyboardModifier.ShiftModifier)
+    assert stripped.key == Qt.Key.Key_A
+    assert stripped.modifiers == Qt.KeyboardModifier.ControlModifier
+
+
+def test_key_sequence_uses_key_info_to_qt():
+    """Ensure KeySequence can be built from KeyInfo and round-trips."""
+    info = keyutils.KeyInfo(Qt.Key.Key_A, Qt.KeyboardModifier.ControlModifier)
+    seq = keyutils.KeySequence(info)
+    assert len(seq) == 1
+    result_infos = list(seq)
+    assert len(result_infos) == 1
+    assert result_infos[0].key == Qt.Key.Key_A
+    assert result_infos[0].modifiers == Qt.KeyboardModifier.ControlModifier
