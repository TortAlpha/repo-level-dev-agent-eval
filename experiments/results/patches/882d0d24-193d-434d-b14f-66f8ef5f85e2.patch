index 00000000..ae9a95dd
--- /dev/null
+++ b/tests/dialects/test_clickhouse_group_concat.py
@@ -0,0 +1,19 @@
+import unittest
+
+from sqlglot import exp, parse_one
+
+
+class TestClickHouseGroupConcat(unittest.TestCase):
+    def test_parametric_group_concat(self):
+        sql = "SELECT groupConcat(', ')(part_name) FROM system.parts"
+        expr = parse_one(sql, dialect="clickhouse")
+
+        group_concat = expr.selects[0]
+        self.assertIsInstance(group_concat, exp.GroupConcat)
+        self.assertEqual(group_concat.this.name, "part_name")
+        self.assertEqual(group_concat.args["separator"].name, ", ")
+        self.assertEqual(expr.sql(dialect="clickhouse"), sql)
+
+
+if __name__ == "__main__":
+    unittest.main()
