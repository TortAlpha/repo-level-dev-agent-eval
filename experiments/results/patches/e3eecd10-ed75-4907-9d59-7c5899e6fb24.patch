+# -*- encoding: utf8 -*-
+"""Tests for strftime-style datetime format specifications."""
+
+import unittest
+from datetime import date, datetime, time, timedelta
+
+import parse
+
+
+class TestStrftime(unittest.TestCase):
+    def test_date_basic(self):
+        self.assertEqual(parse.parse("a {:%Y-%m-%d} b", "a 1997-07-16 b")[0], date(1997, 7, 16))
+
+    def test_date_month_name(self):
+        self.assertEqual(parse.parse("a {:%Y-%b-%d} b", "a 1997-Feb-16 b")[0], date(1997, 2, 16))
+
+    def test_datetime_with_time(self):
+        self.assertEqual(parse.parse("{:%Y-%m-%d %H:%M:%S}", "1997-07-16 12:30:45")[0], datetime(1997, 7, 16, 12, 30, 45))
+
+    def test_datetime_timezone(self):
+        result = parse.parse("{:%Y-%m-%d %H:%M:%S %z}", "1997-07-16 12:30:45 +0530")[0]
+        self.assertEqual(result.utcoffset(), timedelta(hours=5, minutes=30))
+
+    def test_mixed_with_other_fields(self):
+        fields = parse.parse("{:d} {:%Y-%m-%d}", "42 1997-07-16")
+        self.assertEqual(fields, (42, date(1997, 7, 16)))
+
+    def test_time_only(self):
+        self.assertEqual(parse.parse("{:%H:%M}", "12:30")[0], time(12, 30))
+
+
+if __name__ == "__main__":
+    unittest.main()
