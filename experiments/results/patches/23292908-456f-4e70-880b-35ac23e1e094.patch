+def _parse_datetime(string, match, fmt):
+    dt = datetime.strptime(string, fmt)
+    # determine if only date, time, or datetime
+    has_date = any(d in fmt for d in ["%Y", "%y", "%m", "%B", "%b", "%d", "%j"])
+    has_time = any(t in fmt for t in ["%H", "%I", "%M", "%S", "%f", "%p"])
+    has_tz = "%z" in fmt or "%Z" in fmt
+    if has_time or has_tz:
+        if not has_date:
+            return dt.time()
+        return dt
+    return dt.date()
