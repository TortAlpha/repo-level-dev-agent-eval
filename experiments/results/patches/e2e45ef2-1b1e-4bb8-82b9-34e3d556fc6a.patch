new file mode 100644
index 0000000000000000000000000000000000000000..b2d591aa66a242fbe990ff0775ad5401c470f7d2
--- /dev/null
+++ b/tests/test_missing_doc_ids.py
@@ -0,0 +1,84 @@
+import pytest
+
+from tinydb import TinyDB, where
+from tinydb.storages import MemoryStorage
+
+
+@pytest.fixture(params=['memory', 'json'])
+def db(request, tmp_path):
+    if request.param == 'memory':
+        return TinyDB(storage=MemoryStorage)
+    else:
+        return TinyDB(tmp_path / 'db.json')
+
+
+def test_update_skips_missing_doc_ids(db):
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+
+    result = db.update({'a': 99}, doc_ids=[1, 99])
+
+    assert result == [1]
+    assert db.all() == [{'a': 99}, {'a': 2}]
+
+
+def test_update_missing_before_existing(db):
+    db.insert({'a': 1})
+
+    result = db.update({'a': 99}, doc_ids=[99, 1])
+
+    assert result == [1]
+    assert db.all() == [{'a': 99}]
+
+
+def test_update_all_missing_returns_empty(db):
+    result = db.update({'a': 99}, doc_ids=[1, 2])
+
+    assert result == []
+    assert db.all() == []
+
+
+def test_remove_skips_missing_doc_ids(db):
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+
+    result = db.remove(doc_ids=[1, 99])
+
+    assert result == [1]
+    assert db.all() == [{'a': 2}]
+
+
+def test_remove_missing_before_existing(db):
+    db.insert({'a': 1})
+
+    result = db.remove(doc_ids=[99, 1])
+
+    assert result == [1]
+    assert db.all() == []
+
+
+def test_remove_all_missing_returns_empty(db):
+    result = db.remove(doc_ids=[1, 2])
+
+    assert result == []
+    assert db.all() == []
+
+
+def test_update_query_behavior_unchanged(db):
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+
+    result = db.update({'a': 99}, where('a') == 1)
+
+    assert result == [1]
+    assert db.all() == [{'a': 99}, {'a': 2}]
+
+
+def test_remove_query_behavior_unchanged(db):
+    db.insert({'a': 1})
+    db.insert({'a': 2})
+
+    result = db.remove(where('a') == 1)
+
+    assert result == [1]
+    assert db.all() == [{'a': 2}]
