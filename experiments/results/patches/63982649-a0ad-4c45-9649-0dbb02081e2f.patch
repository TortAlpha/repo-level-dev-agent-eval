diff --git a/tests/test_ticking_numeric.py b/tests/test_ticking_numeric.py
new file mode 100644
index 0000000000000000000000000000000000000000..ef18ea9ffdeaf76ea256c7a6878e024b2b5985b9
--- /dev/null
+++ b/tests/test_ticking_numeric.py
@@ -0,0 +1,74 @@
+import datetime
+import fractions
+
+from freezegun import freeze_time
+
+
+def test_frozen_datetime_factory_tick_int() -> None:
+    with freeze_time("Jan 14th, 2012, 00:00:00") as ft:
+        result = ft.tick(10)
+        assert result == datetime.datetime(2012, 1, 14, 0, 0, 10)
+        assert datetime.datetime.now() == datetime.datetime(2012, 1, 14, 0, 0, 10)
+
+
+def test_frozen_datetime_factory_tick_float() -> None:
+    with freeze_time("Jan 14th, 2012, 00:00:00") as ft:
+        result = ft.tick(10.5)
+        assert result == datetime.datetime(2012, 1, 14, 0, 0, 10, 500000)
+        assert datetime.datetime.now() == datetime.datetime(2012, 1, 14, 0, 0, 10, 500000)
+
+
+def test_frozen_datetime_factory_tick_fraction() -> None:
+    with freeze_time("Jan 14th, 2012, 00:00:00") as ft:
+        result = ft.tick(fractions.Fraction(5, 2))
+        assert result == datetime.datetime(2012, 1, 14, 0, 0, 2, 500000)
+        assert datetime.datetime.now() == datetime.datetime(2012, 1, 14, 0, 0, 2, 500000)
+
+
+def test_frozen_datetime_factory_tick_timedelta_still_works() -> None:
+    with freeze_time("Jan 14th, 2012, 00:00:00") as ft:
+        result = ft.tick(datetime.timedelta(minutes=2))
+        assert result == datetime.datetime(2012, 1, 14, 0, 2, 0)
+        assert datetime.datetime.now() == datetime.datetime(2012, 1, 14, 0, 2, 0)
+
+
+def test_step_tick_factory_tick_int() -> None:
+    with freeze_time("Jan 14th, 2012, 00:00:00", auto_tick_seconds=60) as ft:
+        result = ft.tick(10)
+        assert result == datetime.datetime(2012, 1, 14, 0, 0, 10)
+        assert datetime.datetime.now() == datetime.datetime(2012, 1, 14, 0, 0, 10)
+
+
+def test_step_tick_factory_tick_float() -> None:
+    with freeze_time("Jan 14th, 2012, 00:00:00", auto_tick_seconds=60) as ft:
+        result = ft.tick(10.5)
+        assert result == datetime.datetime(2012, 1, 14, 0, 0, 10, 500000)
+        assert datetime.datetime.now() == datetime.datetime(2012, 1, 14, 0, 0, 10, 500000)
+
+
+def test_step_tick_factory_tick_fraction() -> None:
+    with freeze_time("Jan 14th, 2012, 00:00:00", auto_tick_seconds=60) as ft:
+        result = ft.tick(fractions.Fraction(1, 2))
+        assert result == datetime.datetime(2012, 1, 14, 0, 0, 0, 500000)
+        assert datetime.datetime.now() == datetime.datetime(2012, 1, 14, 0, 0, 0, 500000)
+
+
+def test_step_tick_factory_default_tick_advances_by_step_width() -> None:
+    with freeze_time("Jan 14th, 2012, 00:00:00", auto_tick_seconds=60) as ft:
+        result = ft.tick()
+        assert result == datetime.datetime(2012, 1, 14, 0, 1, 0)
+        assert datetime.datetime.now() == datetime.datetime(2012, 1, 14, 0, 1, 0)
+
+
+def test_step_tick_factory_tick_zero_does_not_advance_by_step_width() -> None:
+    with freeze_time("Jan 14th, 2012, 00:00:00", auto_tick_seconds=60) as ft:
+        result = ft.tick(0)
+        assert result == datetime.datetime(2012, 1, 14, 0, 0, 0)
+        assert datetime.datetime.now() == datetime.datetime(2012, 1, 14, 0, 0, 0)
+
+
+def test_step_tick_factory_tick_timedelta_still_works() -> None:
+    with freeze_time("Jan 14th, 2012, 00:00:00", auto_tick_seconds=60) as ft:
+        result = ft.tick(datetime.timedelta(minutes=2))
+        assert result == datetime.datetime(2012, 1, 14, 0, 2, 0)
+        assert datetime.datetime.now() == datetime.datetime(2012, 1, 14, 0, 2, 0)
