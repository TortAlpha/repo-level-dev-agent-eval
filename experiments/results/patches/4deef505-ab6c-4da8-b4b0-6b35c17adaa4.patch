+
+
+class TestRunningStatistics(TestCase):
+    def test_unbounded(self):
+        it = mi.running_statistics(iter([4, 3, 7]))
+        self.assertEqual(
+            next(it), mi.Stats(size=1, minimum=4, median=4, maximum=4, mean=4.0)
+        )
+        self.assertEqual(
+            next(it), mi.Stats(size=2, minimum=3, median=3.5, maximum=4, mean=3.5)
+        )
+        self.assertEqual(
+            next(it),
+            mi.Stats(size=3, minimum=3, median=4, maximum=7, mean=14 / 3),
+        )
+
+    def test_empty(self):
+        self.assertEqual(list(mi.running_statistics(iter([]))), [])
+
+    def test_maxlen(self):
+        it = mi.running_statistics(iter([1, 2, 3, 4, 5]), maxlen=3)
+        self.assertEqual(
+            next(it), mi.Stats(size=1, minimum=1, median=1, maximum=1, mean=1.0)
+        )
+        self.assertEqual(
+            next(it), mi.Stats(size=2, minimum=1, median=1.5, maximum=2, mean=1.5)
+        )
+        self.assertEqual(
+            next(it), mi.Stats(size=3, minimum=1, median=2, maximum=3, mean=2.0)
+        )
+        self.assertEqual(
+            next(it), mi.Stats(size=3, minimum=2, median=3, maximum=4, mean=3.0)
+        )
+        self.assertEqual(
+            next(it), mi.Stats(size=3, minimum=3, median=4, maximum=5, mean=4.0)
+        )
+
+    def test_maxlen_one(self):
+        it = mi.running_statistics(iter([5, 1, 9]), maxlen=1)
+        self.assertEqual(
+            next(it), mi.Stats(size=1, minimum=5, median=5, maximum=5, mean=5.0)
+        )
+        self.assertEqual(
+            next(it), mi.Stats(size=1, minimum=1, median=1, maximum=1, mean=1.0)
+        )
+        self.assertEqual(
+            next(it), mi.Stats(size=1, minimum=9, median=9, maximum=9, mean=9.0)
+        )
+
+    def test_negative_maxlen(self):
+        with self.assertRaises(ValueError):
+            list(mi.running_statistics(iter([1]), maxlen=-1))
