+
+Stats = namedtuple('Stats', ['size', 'minimum', 'median', 'maximum', 'mean'])
+
+
+def running_statistics(iterable, *, maxlen=None):
+    """Yield running statistics over *iterable*.
+
+    After each element of *iterable* is consumed, yield a :class:`Stats`
+    namedtuple summarizing the values seen so far::
+
+        Stats(size, minimum, median, maximum, mean)
+
+    When *maxlen* is a positive integer, every statistic is computed over a
+    sliding window of at most the last *maxlen* elements.
+
+    """
+    if maxlen is not None and maxlen < 0:
+        raise ValueError('maxlen must be non-negative')
+
+    window = deque(maxlen=maxlen) if maxlen else deque()
+    sorted_window = []
+    total = 0.0
+
+    for value in iterable:
+        if maxlen and len(window) == maxlen:
+            old = window[0]
+            total -= old
+            pos = bisect.bisect_left(sorted_window, old)
+            del sorted_window[pos]
+
+        window.append(value)
+        total += value
+        bisect.insort(sorted_window, value)
+
+        size = len(sorted_window)
+        minimum = sorted_window[0]
+        maximum = sorted_window[-1]
+        mean = total / size
+        if size % 2 == 1:
+            median = sorted_window[size // 2]
+        else:
+            median = (sorted_window[size // 2 - 1] + sorted_window[size // 2]) / 2
+
+        yield Stats(size, minimum, median, maximum, mean)
