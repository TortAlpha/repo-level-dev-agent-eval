@@ -0,0 +1,25 @@
+"""Regression tests for naturalsize rounding at unit boundaries."""
+
+from __future__ import annotations
+
+import humanize
+
+
+def test_decimal_boundary_carryover() -> None:
+    # 999.95 kB rounds to 1000.0 kB, which should carry over to 1.0 MB.
+    assert humanize.naturalsize(999950) == "1.0 MB"
+
+
+def test_binary_boundary_carryover() -> None:
+    # 1023.95 KiB rounds to 1024.0 KiB, which should carry over to 1.0 MiB.
+    assert humanize.naturalsize(1023.95 * 1024, True) == "1.0 MiB"
+
+
+def test_gnu_boundary_carryover() -> None:
+    # 1023.95K rounds to 1024.0K, which should carry over to 1.0M.
+    assert humanize.naturalsize(1023.95 * 1024, False, True) == "1.0M"
+
+
+def test_largest_suffix_no_carryover() -> None:
+    # At the largest suffix, values should not advance beyond it.
+    assert humanize.naturalsize(1000**10 * 999.95).endswith("QB")
