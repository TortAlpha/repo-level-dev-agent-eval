@@ -0,0 +1,22 @@
+import pytest
+import parse
+
+
+def test_precision0_float_no_decimal():
+    assert parse.parse("a {:.0f} b", "a 12 b")[0] == 12.0
+
+
+def test_precision0_float_width_no_decimal():
+    assert parse.parse("foo_{:02.0f}t", "foo_20t")[0] == 20.0
+
+
+def test_precision0_float_rejects_decimal():
+    assert parse.parse("a {:.0f} b", "a 12.0 b") is None
+
+
+def test_float_with_decimal_unchanged():
+    assert parse.parse("a {:.2f} b", "a 12.30 b")[0] == 12.30
+
+
+def test_float_no_precision_unchanged():
+    assert parse.parse("a {:f} b", "a 12.0 b")[0] == 12.0
