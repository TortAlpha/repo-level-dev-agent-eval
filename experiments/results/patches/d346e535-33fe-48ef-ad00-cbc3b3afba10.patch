diff --git a/tests/test_groupconcat_clickhouse.py b/tests/test_groupconcat_clickhouse.py
new file mode 100644
index 00000000..2e34d9e8
--- /dev/null
+++ b/tests/test_groupconcat_clickhouse.py
@@ -0,0 +1,20 @@
+import sqlglot
+from sqlglot import exp
+
+
+def test_clickhouse_parametric_group_concat():
+    sql = "SELECT groupConcat(', ')(part_name) FROM system.parts"
+    expr = sqlglot.parse_one(sql, dialect="clickhouse")
+
+    gc = expr.find(exp.GroupConcat)
+    assert gc is not None, "expected GroupConcat expression"
+    assert gc.this.name == "part_name", gc.this.name
+    assert gc.args["separator"].name == ", ", gc.args["separator"].name
+
+    assert expr.sql(dialect="clickhouse") == sql
+
+
+def test_clickhouse_non_parametric_group_concat_unchanged():
+    sql = "SELECT groupConcat(part_name) FROM system.parts"
+    expr = sqlglot.parse_one(sql, dialect="clickhouse")
+    assert expr.sql(dialect="clickhouse") == sql
