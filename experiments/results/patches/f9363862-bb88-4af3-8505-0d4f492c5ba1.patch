@@ -0,0 +1,30 @@
+import unittest
+from datetime import datetime
+
+from croniter import croniter
+from croniter.tests import base
+
+
+class ExpandFromStartTimeTest(base.TestCase):
+    def test_month_step_multiple_of_start_month(self):
+        # Regression: start month exactly divisible by step used to fail parsing.
+        # Anchored expansion: get_next returns the next occurrence after start.
+        cases = {
+            3: [6, 9, 12, 3],
+            6: [9, 12, 3, 6],
+            9: [12, 3, 6, 9],
+            12: [3, 6, 9, 12],
+        }
+        for start_month, expected_months in cases.items():
+            itr = croniter("0 0 1 */3 *", datetime(2024, start_month, 1), expand_from_start_time=True)
+            months = [itr.get_next(datetime).month for _ in range(4)]
+            self.assertEqual(months, expected_months)
+
+    def test_month_step_non_multiple_still_works(self):
+        itr = croniter("0 0 1 */3 *", datetime(2024, 1, 1), expand_from_start_time=True)
+        self.assertEqual(itr.get_next(datetime).month, 4)
+        self.assertEqual(itr.get_next(datetime).month, 7)
+
+
+if __name__ == "__main__":
+    unittest.main()
