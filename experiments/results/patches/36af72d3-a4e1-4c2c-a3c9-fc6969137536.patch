diff --git a/h11/tests/test_content_length_guard.py b/h11/tests/test_content_length_guard.py
new file mode 100644
index 0000000..7e12426
--- /dev/null
+++ b/h11/tests/test_content_length_guard.py
@@ -0,0 +1,45 @@
+import pytest
+
+from .._headers import normalize_and_validate
+from .._util import LocalProtocolError
+
+
+def test_content_length_too_long_rejected() -> None:
+    # An excessively long Content-Length value should be rejected promptly
+    # as an h11.ProtocolError (LocalProtocolError), not passed to int().
+    with pytest.raises(LocalProtocolError) as excinfo:
+        normalize_and_validate([("Content-Length", b"9" * 20)])
+    assert "too long" in str(excinfo.value)
+
+    with pytest.raises(LocalProtocolError):
+        normalize_and_validate([("Content-Length", b"1" * 100)])
+
+    with pytest.raises(LocalProtocolError):
+        normalize_and_validate([("Content-Length", b"9" * 17)])
+
+
+def test_content_length_valid_values_accepted() -> None:
+    # Normal valid Content-Length values should continue to work.
+    assert normalize_and_validate([("Content-Length", b"0")]) == [
+        (b"content-length", b"0")
+    ]
+    assert normalize_and_validate([("Content-Length", b"100")]) == [
+        (b"content-length", b"100")
+    ]
+    # 16 digits is the boundary and should still be accepted.
+    assert normalize_and_validate([("Content-Length", b"9999999999999999")]) == [
+        (b"content-length", b"9999999999999999")
+    ]
+    assert normalize_and_validate([("Content-Length", b"1234567890123456")]) == [
+        (b"content-length", b"1234567890123456")
+    ]
+
+
+def test_content_length_str_values() -> None:
+    # str values should also be rejected when too long.
+    with pytest.raises(LocalProtocolError):
+        normalize_and_validate([("Content-Length", "9" * 20)])
+
+    assert normalize_and_validate([("Content-Length", "100")]) == [
+        (b"content-length", b"100")
+    ]
