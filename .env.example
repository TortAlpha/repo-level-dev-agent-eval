MODEL_PROVIDER=openrouter
AGENT_MODE=single

TEMPERATURE=0.2
MAX_TOKENS=4096
REQUEST_TIMEOUT_SECONDS=120
MAX_RETRIES=2

MAX_ITERATIONS=5
TEST_TIMEOUT_SECONDS=600
SHELL_TIMEOUT_SECONDS=300

DOCKER_ENABLED=true
DOCKER_IMAGE=
DOCKER_NETWORK_DISABLED=true

BENCHMARK_DIR=eval/tasks
WORKSPACES_DIR=experiments/workspaces
RESULTS_DIR=experiments/results

LOGGER_ENABLED=true
LOGGER_LEVEL=INFO

LANGSMITH_API_KEY=
LANGSMITH_PROJECT_NAME=repo-level-dev-agent-eval
LANGSMITH_TRACING_ENABLED=false
LANGSMITH_TRACING_ENDPOINT=https://eu.api.smith.langchain.com

LOCAL_API_URL=http://localhost:1234/v1
LOCAL_API_KEY=dummy
LOCAL_MODEL_NAME=

OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=openai/gpt-4o-mini
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=repo-level-dev-agent-eval
