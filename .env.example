MODEL_PROVIDER=openrouter
AGENT_MODE=single

TEMPERATURE=0.2
MAX_TOKENS=4096
REQUEST_TIMEOUT_SECONDS=120
MAX_RETRIES=2

MAX_ITERATIONS=5
MAX_COST_USD=
TEST_TIMEOUT_SECONDS=600
SHELL_TIMEOUT_SECONDS=300
COMPACTION_MODE=summarize
CONTEXT_BUDGET_TOKENS=

# Strong single-agent progress guard. Set false (or use the runner's
# --no-single-research-guard) to reproduce the legacy unbounded loop.
SINGLE_RESEARCH_GUARD_ENABLED=true
SINGLE_RESEARCH_WARNING_STEPS=12
SINGLE_RESEARCH_HARD_LIMIT=20
SINGLE_COMPATIBILITY_GUARD_ENABLED=true
SINGLE_DECOMPOSITION_MAX_SUBTASKS=8
SINGLE_DECOMPOSITION_IMPLEMENTATION_WARNING_STEPS=8
SINGLE_DECOMPOSITION_IMPLEMENTATION_HARD_LIMIT=14
SINGLE_DECOMPOSITION_VERIFICATION_STEP_RESERVE=20
SINGLE_DECOMPOSITION_MAX_REPAIR_CYCLES=2
SINGLE_POST_PLAN_RESEARCH_WARNING_STEPS=5
SINGLE_POST_PLAN_RESEARCH_HARD_LIMIT=8

# Optional multi-agent role routing. Blank values preserve one shared model.
ROLE_MODEL_ORCHESTRATOR=
ROLE_MODEL_PLANNER=
ROLE_MODEL_DEVELOPER=
ROLE_MODEL_TESTER=
ROLE_MODEL_REVIEWER=
DEVELOPER_ESCALATION_MODEL=
DEVELOPER_ESCALATE_AFTER_NO_EDIT_EPISODES=1
DEVELOPER_ESCALATE_AFTER_FAILED_TESTS=1

DOCKER_ENABLED=true
DOCKER_IMAGE=
DOCKER_NETWORK_DISABLED=true

BENCHMARK_DIR=eval/tasks
WORKSPACES_DIR=experiments/workspaces
RESULTS_DIR=experiments/results

LOGGER_ENABLED=true
LOGGER_LEVEL=INFO

LANGSMITH_API_KEY=
LANGSMITH_PROJECT_NAME=repo-level-dev-agent-eval
LANGSMITH_TRACING_ENABLED=false
LANGSMITH_TRACING_ENDPOINT=https://eu.api.smith.langchain.com

LOCAL_API_URL=http://localhost:1234/v1
LOCAL_API_KEY=dummy
LOCAL_MODEL_NAME=
LOCAL_CONTEXT_WINDOW_TOKENS=8192

OPENROUTER_API_KEY=
OPENROUTER_MODEL_NAME=openai/gpt-4o-mini
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_CONTEXT_WINDOW_TOKENS=128000
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=repo-level-dev-agent-eval
